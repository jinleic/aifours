  "duty_contract": {
    "order": "Transcriber reads S0 and the duty release manifest, writes a native-clock pre-body ACK (known contacts with the lane, excluded sources) BEFORE opening any image, then views ONLY the listed images.",
    "output": "book-literal-<lane>-v1.md in the transcriber root: (1) verbatim Chinese transcription of the complete problem entry (title, contributor/affiliation line, body, displayed formulas, printed references) with page/column/line coordinates; (2) sentence-aligned literal English rendering; (3) inventory of every printed definition, symbol, parameter, quantifier and stated question, quoted; (4) illegible or uncertain glyphs listed; (5) explicit statement that nothing beyond transcription was done; (6) image SHA256s and clocks.",
    "forbidden": "Interpretation, reformulation, proof, solution ideas, status/priority remarks, any other source or page, web, lane proof bodies, held records, contact with the lane owner, scientific computation, selected examples, writes outside the transcriber root.",
    "return": "Compact ACK to Main: output path, SHA256, LF, bytes, actual /bin/date clock."
  },
