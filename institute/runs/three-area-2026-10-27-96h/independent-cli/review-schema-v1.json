{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_self_report",
    "inputs_acknowledged",
    "per_manuscript",
    "findings",
    "chain_assessment",
    "standard_results_relied_on",
    "assumptions",
    "first_verification_step",
    "non_claims"
  ],
  "properties": {
    "model_self_report": {
      "type": "string",
      "description": "Which model you believe you are and whether you used any tool, web access or external source (expected: none)."
    },
    "inputs_acknowledged": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title_line",
          "line_count_seen"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title_line": {
            "type": "string"
          },
          "line_count_seen": {
            "type": "integer"
          }
        }
      }
    },
    "per_manuscript": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "main_claims",
          "verdict",
          "justification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "main_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verdict": {
            "type": "string",
            "enum": [
              "CORRECT_AS_WRITTEN_AT_STATED_SCOPE",
              "CORRECT_WITH_MINOR_ISSUES",
              "GAP_MAJOR",
              "DEFECT_FATAL",
              "NOT_A_PROOF_DOCUMENT"
            ]
          },
          "justification": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "manuscript_id",
          "lines",
          "severity",
          "confidence",
          "claim_quoted",
          "problem",
          "why_it_matters",
          "suggested_repair_or_check"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "manuscript_id": {
            "type": "string"
          },
          "lines": {
            "type": "string",
            "description": "Exact line numbers or ranges in the S<k>|<n>| numbering, e.g. \"S3|112-118\"."
          },
          "severity": {
            "type": "string",
            "enum": [
              "FATAL",
              "MAJOR",
              "MINOR"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "claim_quoted": {
            "type": "string",
            "description": "Verbatim text from the cited lines."
          },
          "problem": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "suggested_repair_or_check": {
            "type": "string"
          }
        }
      }
    },
    "chain_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_is_established",
        "what_is_not_established",
        "circularity_or_hidden_dependencies",
        "consistency_of_erratum_and_addenda"
      ],
      "properties": {
        "what_is_established": {
          "type": "string"
        },
        "what_is_not_established": {
          "type": "string"
        },
        "circularity_or_hidden_dependencies": {
          "type": "string"
        },
        "consistency_of_erratum_and_addenda": {
          "type": "string"
        }
      }
    },
    "standard_results_relied_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_verification_step": {
      "type": "string"
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
