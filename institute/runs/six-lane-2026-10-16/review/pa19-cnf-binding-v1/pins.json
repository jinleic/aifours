  "pass1_writer": {
   "function": "encode_e1.CNF.write",
   "source": "def write(self, path):\n        with open(path, \"w\") as f:\n            f.write(\"p cnf %d %d\\n\" % (self.nv, len(self.clauses)))\n            for cl in self.clauses:\n                f.write(\" \".join(map(str, cl)) + \" 0\\n\")",
   "note": "pass 1 (run_cases.py) wrote the CNF with CNF.write; equality with cnf_bytes_of is tested only through the pass-1 hash comparison"
  }
