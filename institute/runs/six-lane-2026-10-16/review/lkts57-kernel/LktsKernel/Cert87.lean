/-- Constituent `i` is exactly the set of genuine triples whose point set is a row of
KTS `i` of the raw certificate. -/
theorem lkts87_blocks_spec (i : Fin 85) (T : Triple 87) :
    T ∈ blocksOf 87 data87 i ↔
      ∃ c : Fin 43, ∃ r : Fin 29, T.val = rowSet 87 (rowAt data87 i c r) :=
  Iff.rfl

