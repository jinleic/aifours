import LktsKernel.Generic
import LktsKernel.Data57

/-!
# LKTS(57): kernel-checked existence from the pinned raw certificate

`data57` is generated by `gen_data.py` from `review/lkts57-construction-snapshot-v1/lkts57_g513.txt`
(SHA-256 09a9d8ca0602ed28541e170ada7f096871311c29fd4515b6fea3e25f72b05f09).  Every check below
is evaluated by the Lean kernel (`decide +kernel`, no `native_decide`, no `ofReduceBool`).
The semantic conclusion comes from the data-independent theorem `isLKTS_of_check`.
-/

namespace Kirkman.KernelCert

/-- Shape, row validity, class point partitions and system pair partitions of all 55 systems. -/
theorem data57_ok : dataOK 57 data57 = true := by decide +kernel

/-! Cross-system row distinctness, in four code windows of width 46300 covering `[0, 57^3)`. -/

theorem data57_chunk0 : chunkOK 57 (46300 * 0) (46300 * (0 + 1)) 0 (allRows data57) = true := by
  decide +kernel
theorem data57_chunk1 : chunkOK 57 (46300 * 1) (46300 * (1 + 1)) 0 (allRows data57) = true := by
  decide +kernel
theorem data57_chunk2 : chunkOK 57 (46300 * 2) (46300 * (2 + 1)) 0 (allRows data57) = true := by
  decide +kernel
theorem data57_chunk3 : chunkOK 57 (46300 * 3) (46300 * (3 + 1)) 0 (allRows data57) = true := by
  decide +kernel

theorem data57_chunks :
    ∀ k, k < 4 → chunkOK 57 (46300 * k) (46300 * (k + 1)) 0 (allRows data57) = true := by
  intro k hk
  match k, hk with
  | 0, _ => exact data57_chunk0
  | 1, _ => exact data57_chunk1
  | 2, _ => exact data57_chunk2
  | 3, _ => exact data57_chunk3
  | n + 4, h => exact absurd h (by omega)

theorem data57_cover : 57 * 57 * 57 ≤ 46300 * 4 := by decide

theorem data57_card : (57 - 2) * ((57 - 1) / 2 * (57 / 3)) = Nat.choose 57 3 := by decide +kernel

/-- The 55 constituents named by the raw certificate form a large set of Kirkman triple
systems, in the sense of the frozen definition `Kirkman.IsLKTS`. -/
theorem lkts57_isLKTS : IsLKTS (blocksOf 57 data57) :=
  isLKTS_of_check 57 4 46300 data57 data57_ok data57_chunks data57_cover data57_card

/-- Constituent `i` is exactly the set of genuine triples whose point set is a row of KTS `i`. -/
theorem lkts57_blocks_spec (i : Fin 55) (T : Triple 57) :
    T ∈ blocksOf 57 data57 i ↔
      ∃ c : Fin 28, ∃ r : Fin 19, T.val = rowSet 57 (rowAt data57 i c r) :=
  Iff.rfl

/-- **LKTS(57) exists.** -/
theorem exists_lkts57 : ∃ B : Fin 55 → Kirkman.Blocks 57, Kirkman.IsLKTS B :=
  ⟨blocksOf 57 data57, lkts57_isLKTS⟩

end Kirkman.KernelCert

