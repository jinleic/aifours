import McdKernel.Data38
import McdKernel.Counts

/-!
# mcDSQS(38): kernel-checked existence

`blocks38`, `col38_x` and `colour38` come from `McdKernel.Data38`, generated by `gen_lean.py`
from the raw certificate `review/mcdsqs38-parent-inputs-v1/mcdsqs38_g342_s0.txt` (SHA-256
`973f93e4646e48df64b70b3a64811afcdc87b10a1767222f54ffe65d3a303f1c`): the BLOCKS section and
every `POINT x` section, verbatim.  No symmetry of the certificate is used: every block and every
colour class at every point is checked.

Every `decide +kernel` below is evaluated by the Lean kernel (no `native_decide`, no
`Lean.ofReduceBool`).  The semantic conclusions come from the data-independent theorems
`isSQS_of_check`, `colouring_of_check` and `sts_of_check` (`McdKernel.Check`) and from
`McdKernel.Counts`; the target notions are defined in `McdKernel.Target`.
-/

namespace Mcd.Kernel

open Mcd.Counts

universe u

/-- Shape of the raw data: 2109 blocks; 38 `POINT` sections of 19 classes each. -/
theorem data38_shape :
    blocks38.length = 2109 ∧ colour38.length = 38 ∧
      ∀ x < 38, (colour38.getD x []).length = 19 := by
  decide +kernel

/-- Every listed number is below 38 (blocks `a < b < c < d < 38`, triples `a < b < c < 38`), so
no reduction modulo 38 happens. -/
theorem data38_range :
    (∀ b ∈ blocks38, b.1 < b.2.1 ∧ b.2.1 < b.2.2.1 ∧ b.2.2.1 < b.2.2.2 ∧ b.2.2.2 < 38) ∧
      ∀ x < 38, ∀ e ∈ (colour38.getD x []).flatten, e.1 < e.2.1 ∧ e.2.1 < e.2.2 ∧ e.2.2 < 38 := by
  decide +kernel

/-- One kernel evaluation of the SQS checker. -/
theorem blocks38_sqsCheck : sqsCheck 38 blocks38 = true := by
  decide +kernel

/-- Kernel evaluations of the colouring checker at the points `0, ..., 9`. -/
theorem colour38_check_a :
    (List.range' 0 10).all (fun x => colCheck 38 blocks38 x (colour38.getD x [])) = true := by
  decide +kernel

/-- Kernel evaluations of the colouring checker at the points `10, ..., 19`. -/
theorem colour38_check_b :
    (List.range' 10 10).all (fun x => colCheck 38 blocks38 x (colour38.getD x [])) = true := by
  decide +kernel

/-- Kernel evaluations of the colouring checker at the points `20, ..., 29`. -/
theorem colour38_check_c :
    (List.range' 20 10).all (fun x => colCheck 38 blocks38 x (colour38.getD x [])) = true := by
  decide +kernel

/-- Kernel evaluations of the colouring checker at the points `30, ..., 37`. -/
theorem colour38_check_d :
    (List.range' 30 8).all (fun x => colCheck 38 blocks38 x (colour38.getD x [])) = true := by
  decide +kernel

theorem colour38_check (x : ℕ) (hx : x < 38) :
    colCheck 38 blocks38 x (colour38.getD x []) = true := by
  have hall : ∀ s n, (List.range' s n).all
      (fun x => colCheck 38 blocks38 x (colour38.getD x [])) = true → s ≤ x → x < s + n →
      colCheck 38 blocks38 x (colour38.getD x []) = true := by
    intro s n h h1 h2
    exact List.all_eq_true.mp h x (List.mem_range'_1.mpr ⟨h1, h2⟩)
  by_cases h10 : x < 10
  · exact hall 0 10 colour38_check_a (by omega) (by omega)
  by_cases h20 : x < 20
  · exact hall 10 10 colour38_check_b (by omega) (by omega)
  by_cases h30 : x < 30
  · exact hall 20 10 colour38_check_c (by omega) (by omega)
  · exact hall 30 8 colour38_check_d (by omega) (by omega)

/-- One kernel evaluation of the coloured-STS checker on the raw `POINT 37` section, read on
`Fin 37` (its numbers are `0, ..., 36`). -/
theorem col38_37_stsCheck : stsColCheck 37 col38_37 = true := by
  decide +kernel

/-- The explicit block set: the raw block lines. -/
def mcdsqs38 : Finset (Finset (Fin 38)) := blockSet 38 blocks38

/-- The explicit colouring at `x`: the classes of the raw `POINT x` section. -/
def colouring38 (x : Fin 38) : Finset (Finset (Finset (Fin 38))) :=
  classSet 38 (colour38.getD x.val [])

theorem mcdsqs38_spec (X : Finset (Fin 38)) : X ∈ mcdsqs38 ↔ ∃ b ∈ blocks38, quad 38 b = X :=
  mem_blockSet

theorem isSQS_mcdsqs38 : IsSQS mcdsqs38 :=
  isSQS_of_check blocks38_sqsCheck

/-- **Every explicit colouring.**  At every point `x`, the classes of the raw `POINT x` section
form a 19-colouring of the derived design. -/
theorem colouring38_spec (x : Fin 38) :
    IsColouring (derivedBlocks mcdsqs38 x) (colouring38 x) ∧ (colouring38 x).card = 19 := by
  have h := colouring_of_check (quadOK_of_sqsCheck blocks38_sqsCheck) x.isLt
    (colour38_check x.val x.isLt)
  rw [pt_val_self] at h
  exact ⟨h.1, h.2.trans (data38_shape.2.2 x.val x.isLt)⟩

/-- **Root (1).**  An SQS on `Fin 38` whose derived design at every point has a 19-colouring. -/
theorem coloured38 : TargetColoured 38 19 :=
  ⟨mcdsqs38, isSQS_mcdsqs38, fun x => ⟨colouring38 x, colouring38_spec x⟩⟩

/-- An STS on `Fin 37` with a 19-colouring: the triples and classes of the raw `POINT 37`
section, read on `Fin 37`. -/
theorem sts37_witness : ∃ S : Finset (Finset (Fin 37)), IsSTS S ∧
    ∃ C : Finset (Finset (Finset (Fin 37))), IsColouring S C ∧ C.card = 19 := by
  obtain ⟨h1, h2, h3⟩ := sts_of_check col38_37_stsCheck
  refine ⟨_, h1, _, h2, ?_⟩
  rw [h3]
  decide +kernel

/-- **χ′(37) = 19.** -/
theorem chiPrime_37 : chiPrime 37 = 19 :=
  chiPrime_eq_of colourLowerBound_37 sts37_witness

/-- **The explicit block set is an mcDSQS(38).** -/
theorem isMcDSQS_mcdsqs38 : IsMcDSQS mcdsqs38 :=
  ⟨isSQS_mcdsqs38, fun x =>
    ⟨colouring38 x, (colouring38_spec x).1, (colouring38_spec x).2.trans chiPrime_37.symm⟩⟩

/-- **An mcDSQS(38) exists** (on the point set `Fin 38`). -/
theorem exists_mcdsqs38 : TargetMc 38 :=
  ⟨mcdsqs38, isMcDSQS_mcdsqs38⟩

end Mcd.Kernel
