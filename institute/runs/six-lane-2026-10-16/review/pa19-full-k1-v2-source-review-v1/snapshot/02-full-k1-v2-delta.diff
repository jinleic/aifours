+    class Sink:
+        def __init__(self,fail_write=False,fail_close=False): self.fail_write,self.fail_close = fail_write,fail_close
+        def write(self,data):
+            if self.fail_write: raise BrokenPipeError('CONTROL proof write')
+            return len(data)
+        def close(self):
