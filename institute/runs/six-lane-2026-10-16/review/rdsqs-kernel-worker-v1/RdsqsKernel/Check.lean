import RdsqsKernel.Generic
import Mathlib.Algebra.Group.Fin.Basic
import Mathlib.Data.ZMod.Defs

/-!
# A kernel-checkable certificate for an RDSQS generated by a translation seed

Raw data is a list of raw classes, each a list of raw triples `(a, b, c)` of natural numbers
(the lines of the raw certificate's `POINT 0` section).  The semantic objects they name, on the
points `Fin v` (residues modulo `v`, with the usual `+`, `-`, `*` modulo `v`):

* `pt v n`: the residue of `n` modulo `v`; `tri v e = {pt v a, pt v b, pt v c}`;
* `seedTriples v d`: the set of all `tri v e` over all listed triples `e`;
* `seedClasses v d`: the set of classes, class `i` being the set of `tri v e` for `e` in raw
  class `i`;
* `blocks v d = Generic.blocksOf (seedTriples v d)`: all translates `({0} ∪ t) + a`
  (`mem_blocks` restates this with `Finset.image`);
* `resAt v d m x`: the image of `seedClasses v d` under `y ↦ m * y + x`.

The Boolean checker `seedCheck` uses only `Nat` arithmetic, `Fin v` arithmetic (`Nat` arithmetic on
the values), list recursion and bitwise operations on `Nat`, which the Lean kernel evaluates on
literals.  It checks:

1. every listed triple satisfies `0 < a < b < c < v`;
2. inserting the codes `p * v + q` of the three pairs `p < q` of every listed triple one by one
   into a bitmask never meets a bit already set, and ends at the mask of all codes `p * v + q`
   with `0 < p < q < v` (every pair of nonzero points lies in exactly one listed triple, and no
   triple is listed twice);
3. for every raw class, inserting the three points of each of its triples never meets a set bit
   and ends at the mask of `1, ..., v - 1` (each class partitions the nonzero points);
4. closure: for every listed triple `{a, b, c}` and each of its points, say `a`, the translate
   `{-a, b - a, c - a}` is a listed triple (looked up in a bitmask of codes of the six orderings
   of every listed triple).

`multCheck v d m m'` checks that `y ↦ m' * y` inverts `y ↦ m * y` on `Fin v` and that every
listed triple multiplied by `m` is a listed triple.

`seed_of_check` (data-independent) turns `seedCheck v d = true` into the hypotheses
`Generic.SeedOK` and `Generic.SeedResolution`; `isRDSQS_of_check` and `resAt_of_check` then give
the target notions for the explicit objects `blocks v d` and `resAt v d m x`.
-/

namespace Rdsqs.Kernel

open Rdsqs.Generic

set_option linter.unusedSectionVars false

/-- A raw triple `(a, b, c)`: one triple line `a b c` of the raw certificate. -/
abbrev RawTriple := ℕ × ℕ × ℕ

/-! ## The semantic objects named by raw data -/

section Semantics

variable (v : ℕ) [NeZero v]

/-- The residue of the raw number `n` modulo `v`, as a point of `Fin v`. -/
def pt (n : ℕ) : Fin v := ⟨n % v, Nat.mod_lt _ (Nat.pos_of_neZero v)⟩

/-- The point set `{a, b, c}` (residues modulo `v`) named by the raw triple `(a, b, c)`. -/
def tri (e : RawTriple) : Finset (Fin v) := {pt v e.1, pt v e.2.1, pt v e.2.2}

/-- The seed: the set of all listed triples, over all raw classes.  (`seedTriples`,
`seedClasses`, `resAt` and `Generic.blocksOf` are irreducible, so that elaboration never
evaluates them on concrete data; proofs use their equation lemmas.) -/
@[irreducible] def seedTriples (d : List (List RawTriple)) : Finset (Finset (Fin v)) :=
  (d.flatten.map (tri v)).toFinset

/-- The seed classes: class `i` is the set of the triples listed in raw class `i`. -/
@[irreducible] def seedClasses (d : List (List RawTriple)) : Finset (Finset (Finset (Fin v))) :=
  (d.map fun c => (c.map (tri v)).toFinset).toFinset

/-- The explicit block set: all translates `({0} ∪ t) + a`, `t` in the seed, `a ∈ Fin v`. -/
def blocks (d : List (List RawTriple)) : Finset (Finset (Fin v)) :=
  blocksOf (seedTriples v d)

/-- The explicit resolution at `x` for the multiplier `m`: the image of the seed classes under
the affine map `y ↦ m * y + x` (applied to every point of every triple of every class). -/
@[irreducible] def resAt (d : List (List RawTriple)) (m : ℕ) (x : Fin v) :
    Finset (Finset (Finset (Fin v))) :=
  (seedClasses v d).image fun P => P.image fun T => T.image fun y => pt v m * y + x

end Semantics

/-! ## The Boolean checker -/

section Checker

/-- `0 < a < b < c < v`. -/
def rangeOK (v : ℕ) (e : RawTriple) : Bool :=
  decide (0 < e.1) && decide (e.1 < e.2.1) && decide (e.2.1 < e.2.2) && decide (e.2.2 < v)

/-- The three raw points of a raw triple. -/
def pts (e : RawTriple) : List ℕ := [e.1, e.2.1, e.2.2]

/-- The codes `p * v + q` of the three pairs of a raw triple `a < b < c`. -/
def pairCodes (v : ℕ) (e : RawTriple) : List ℕ :=
  [e.1 * v + e.2.1, e.1 * v + e.2.2, e.2.1 * v + e.2.2]

/-- Insert the codes of `l` one by one into the bitmask `m`; `none` as soon as a bit is already
set. -/
def insertAll : List ℕ → ℕ → Option ℕ
  | [], m => some m
  | c :: l, m => if m.testBit c then none else insertAll l (m ||| 2 ^ c)

/-- Bitwise union of a list of naturals. -/
def orAll (l : List ℕ) : ℕ := l.foldl (· ||| ·) 0

/-- The nonzero points `1, ..., v - 1`. -/
def pointList (v : ℕ) : List ℕ := (List.range v).filter fun p => decide (0 < p)

/-- The codes `p * v + q` of all pairs `0 < p < q < v`. -/
def pairList (v : ℕ) : List ℕ :=
  (List.range v).flatMap fun p =>
    ((List.range v).filter fun q => decide (0 < p) && decide (p < q)).map fun q => p * v + q

/-- Bits `1, ..., v - 1`. -/
def pointMask (v : ℕ) : ℕ := orAll ((pointList v).map (2 ^ ·))

/-- Bits `p * v + q` for `0 < p < q < v`. -/
def pairMask (v : ℕ) : ℕ := orAll ((pairList v).map (2 ^ ·))

/-- The code of an ordered triple of points. -/
def fcode {v : ℕ} (x y z : Fin v) : ℕ := (x.val * v + y.val) * v + z.val

/-- The codes of the six orderings of `(x, y, z)`. -/
def permCodes {v : ℕ} (x y z : Fin v) : List ℕ :=
  [fcode x y z, fcode x z y, fcode y x z, fcode y z x, fcode z x y, fcode z y x]

/-- The codes of all orderings of all listed triples. -/
def tripleCodes (v : ℕ) [NeZero v] (l : List RawTriple) : List ℕ :=
  l.flatMap fun e => permCodes (pt v e.1) (pt v e.2.1) (pt v e.2.2)

/-- Bitmask of `tripleCodes`: `(x, y, z)` has its bit set iff `{x, y, z}` is a listed triple. -/
def tripleMask (v : ℕ) [NeZero v] (l : List RawTriple) : ℕ :=
  orAll ((tripleCodes v l).map (2 ^ ·))

/-- Closure test for one triple `{a, b, c}`: `{-a, b - a, c - a}`, `{-b, a - b, c - b}` and
`{-c, a - c, b - c}` all have their bit set in `M`. -/
def closedOK (v : ℕ) [NeZero v] (M : ℕ) (e : RawTriple) : Bool :=
  M.testBit (fcode (0 - pt v e.1) (pt v e.2.1 - pt v e.1) (pt v e.2.2 - pt v e.1)) &&
    M.testBit (fcode (0 - pt v e.2.1) (pt v e.1 - pt v e.2.1) (pt v e.2.2 - pt v e.2.1)) &&
    M.testBit (fcode (0 - pt v e.2.2) (pt v e.1 - pt v e.2.2) (pt v e.2.1 - pt v e.2.2))

/-- Multiplier test for one triple: `{m a, m b, m c}` has its bit set in `M`. -/
def multOK (v : ℕ) [NeZero v] (M m : ℕ) (e : RawTriple) : Bool :=
  M.testBit (fcode (pt v m * pt v e.1) (pt v m * pt v e.2.1) (pt v m * pt v e.2.2))

/-- `y ↦ m' * y` and `y ↦ m * y` are inverse maps of `Fin v`. -/
def unitOK (v : ℕ) [NeZero v] (m m' : ℕ) : Bool :=
  (List.range v).all fun n =>
    pt v m' * (pt v m * pt v n) == pt v n && pt v m * (pt v m' * pt v n) == pt v n

/-- The seed checker (items 1–4 of the module documentation). -/
def seedCheck (v : ℕ) [NeZero v] (d : List (List RawTriple)) : Bool :=
  d.flatten.all (rangeOK v) &&
    insertAll (d.flatten.flatMap (pairCodes v)) 0 == some (pairMask v) &&
    d.all (fun c => insertAll (c.flatMap pts) 0 == some (pointMask v)) &&
    d.flatten.all (closedOK v (tripleMask v d.flatten))

/-- The multiplier checker. -/
def multCheck (v : ℕ) [NeZero v] (d : List (List RawTriple)) (m m' : ℕ) : Bool :=
  unitOK v m m' && d.flatten.all (multOK v (tripleMask v d.flatten) m)

end Checker

/-! ## List and bit lemmas -/

section Lemmas

theorem testBit_foldl_or (l : List ℕ) (a k : ℕ) :
    (l.foldl (· ||| ·) a).testBit k = true ↔
      a.testBit k = true ∨ ∃ m ∈ l, m.testBit k = true := by
  induction l generalizing a with
  | nil => simp
  | cons m l ih =>
    rw [List.foldl_cons, ih, Nat.testBit_or, Bool.or_eq_true]
    simp only [List.mem_cons, exists_eq_or_imp]
    tauto

theorem testBit_orAll_pow (l : List ℕ) (k : ℕ) :
    (orAll (l.map (2 ^ ·))).testBit k = true ↔ k ∈ l := by
  rw [orAll, testBit_foldl_or]
  simp [Nat.testBit_two_pow]

theorem insertAll_spec : ∀ (l : List ℕ) (m m' : ℕ), insertAll l m = some m' →
    l.Nodup ∧ (∀ c ∈ l, m.testBit c = false) ∧
      ∀ k, m'.testBit k = (m.testBit k || decide (k ∈ l)) := by
  intro l
  induction l with
  | nil =>
    intro m m' h
    simp only [insertAll, Option.some.injEq] at h
    subst h
    simp
  | cons c l ih =>
    intro m m' h
    simp only [insertAll] at h
    split at h
    · exact absurd h (by simp)
    · rename_i hc
      obtain ⟨hnd, hfresh, hbits⟩ := ih _ _ h
      refine ⟨List.nodup_cons.mpr ⟨?_, hnd⟩, ?_, ?_⟩
      · intro hcl
        have h1 := hfresh c hcl
        simp [Nat.testBit_or] at h1
      · intro c' hc'
        rcases List.mem_cons.mp hc' with rfl | hc'
        · simpa using hc
        · have h1 := hfresh c' hc'
          rw [Nat.testBit_or, Bool.or_eq_false_iff] at h1
          exact h1.1
      · intro k
        rw [hbits k, Nat.testBit_or, Nat.testBit_two_pow]
        by_cases hk : k = c
        · subst hk
          simp
        · have hck : c ≠ k := fun h' => hk h'.symm
          simp [hk, hck]

theorem insertAll_zero_eq {l L : List ℕ} (h : insertAll l 0 = some (orAll (L.map (2 ^ ·)))) :
    l.Nodup ∧ ∀ k, k ∈ l ↔ k ∈ L := by
  obtain ⟨hnd, -, hbits⟩ := insertAll_spec l 0 _ h
  refine ⟨hnd, fun k => ?_⟩
  rw [← testBit_orAll_pow L k, hbits k]
  simp

theorem mem_pointList {v k : ℕ} : k ∈ pointList v ↔ 0 < k ∧ k < v := by
  simp [pointList, and_comm]

theorem mem_pairList {v k : ℕ} :
    k ∈ pairList v ↔ ∃ p q, 0 < p ∧ p < q ∧ q < v ∧ p * v + q = k := by
  simp only [pairList, List.mem_flatMap, List.mem_range, List.mem_map, List.mem_filter,
    Bool.and_eq_true, decide_eq_true_eq]
  constructor
  · rintro ⟨p, -, q, ⟨hq, hp, hpq⟩, rfl⟩
    exact ⟨p, q, hp, hpq, hq, rfl⟩
  · rintro ⟨p, q, hp, hpq, hq, rfl⟩
    exact ⟨p, by omega, q, ⟨hq, hp, hpq⟩, rfl⟩

theorem mul_add_inj {v a b c d : ℕ} (hb : b < v) (hd : d < v) (h : a * v + b = c * v + d) :
    a = c ∧ b = d := by
  have hv : 0 < v := by omega
  have h1 : ∀ x y : ℕ, y < v → (x * v + y) % v = y := by
    intro x y hy
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hy]
  have h2 : ∀ x y : ℕ, y < v → (x * v + y) / v = x := by
    intro x y hy
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hv, Nat.div_eq_of_lt hy, Nat.zero_add]
  exact ⟨by rw [← h2 a b hb, ← h2 c d hd, h], by rw [← h1 a b hb, ← h1 c d hd, h]⟩

theorem fcode_inj {v : ℕ} {x y z x' y' z' : Fin v} (h : fcode x y z = fcode x' y' z') :
    x = x' ∧ y = y' ∧ z = z' := by
  unfold fcode at h
  obtain ⟨h1, h2⟩ := mul_add_inj z.isLt z'.isLt h
  obtain ⟨h3, h4⟩ := mul_add_inj y.isLt y'.isLt h1
  exact ⟨Fin.ext h3, Fin.ext h4, Fin.ext h2⟩

theorem eq_of_mem_permCodes {v : ℕ} {x y z a b c : Fin v} (h : fcode x y z ∈ permCodes a b c) :
    ({x, y, z} : Finset (Fin v)) = {a, b, c} := by
  simp only [permCodes, List.mem_cons, List.not_mem_nil, or_false] at h
  rcases h with h | h | h | h | h | h <;> obtain ⟨rfl, rfl, rfl⟩ := fcode_inj h <;>
    (ext w; simp only [Finset.mem_insert, Finset.mem_singleton]) <;> tauto

theorem eq_of_mem_of_nodup_flatMap {α β : Type*} {f : α → List β} :
    ∀ {l : List α}, (l.flatMap f).Nodup → ∀ {a b : α} {c : β}, a ∈ l → b ∈ l → c ∈ f a →
      c ∈ f b → a = b
  | [], _, _, _, _, ha, _, _, _ => absurd ha List.not_mem_nil
  | x :: l, hnd, a, b, c, ha, hb, hca, hcb => by
    rw [List.flatMap_cons, List.nodup_append] at hnd
    obtain ⟨-, hnd', hdisj⟩ := hnd
    rcases List.mem_cons.mp ha with rfl | ha' <;> rcases List.mem_cons.mp hb with rfl | hb'
    · rfl
    · exact absurd rfl (hdisj c hca c (List.mem_flatMap.mpr ⟨b, hb', hcb⟩))
    · exact absurd rfl (hdisj c hcb c (List.mem_flatMap.mpr ⟨a, ha', hca⟩))
    · exact eq_of_mem_of_nodup_flatMap hnd' ha' hb' hca hcb

theorem nodup_of_nodup_flatMap {α β : Type*} {f : α → List β} (hne : ∀ a, f a ≠ []) :
    ∀ {l : List α}, (l.flatMap f).Nodup → l.Nodup
  | [], _ => List.nodup_nil
  | x :: l, hnd => by
    rw [List.flatMap_cons, List.nodup_append] at hnd
    obtain ⟨-, hnd', hdisj⟩ := hnd
    refine List.nodup_cons.mpr ⟨fun hx => ?_, nodup_of_nodup_flatMap hne hnd'⟩
    obtain ⟨c, hc⟩ := List.exists_mem_of_ne_nil _ (hne x)
    exact hdisj c hc c (List.mem_flatMap.mpr ⟨x, hx, hc⟩) rfl

end Lemmas

/-! ## Soundness -/

section Soundness

variable {v : ℕ} [NeZero v]

theorem pt_val {n : ℕ} (h : n < v) : (pt v n).val = n := Nat.mod_eq_of_lt h

theorem pt_val_self (y : Fin v) : pt v y.val = y := Fin.ext (Nat.mod_eq_of_lt y.isLt)

theorem rangeOK_iff {e : RawTriple} :
    rangeOK v e = true ↔ 0 < e.1 ∧ e.1 < e.2.1 ∧ e.2.1 < e.2.2 ∧ e.2.2 < v := by
  simp [rangeOK, and_assoc]

theorem mem_tri {e : RawTriple} (he : rangeOK v e = true) {y : Fin v} :
    y ∈ tri v e ↔ y.val = e.1 ∨ y.val = e.2.1 ∨ y.val = e.2.2 := by
  obtain ⟨h1, h2, h3, h4⟩ := rangeOK_iff.mp he
  simp only [tri, Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff,
    pt_val (show e.1 < v by omega), pt_val (show e.2.1 < v by omega), pt_val h4]

theorem tri_card {e : RawTriple} (he : rangeOK v e = true) : (tri v e).card = 3 := by
  obtain ⟨h1, h2, h3, h4⟩ := rangeOK_iff.mp he
  rw [Finset.card_eq_three]
  refine ⟨pt v e.1, pt v e.2.1, pt v e.2.2, ?_, ?_, ?_, rfl⟩ <;>
    simp only [ne_eq, Fin.ext_iff, pt_val (show e.1 < v by omega),
      pt_val (show e.2.1 < v by omega), pt_val h4] <;> omega

theorem zero_not_mem_tri {e : RawTriple} (he : rangeOK v e = true) : (0 : Fin v) ∉ tri v e := by
  have hR := rangeOK_iff.mp he
  rw [mem_tri he, Fin.val_zero]
  omega

theorem mem_seedTriples {d : List (List RawTriple)} {t : Finset (Fin v)} :
    t ∈ seedTriples v d ↔ ∃ e ∈ d.flatten, tri v e = t := by
  simp only [seedTriples, List.mem_toFinset, List.mem_map]

theorem mem_seedClasses {d : List (List RawTriple)} {P : Finset (Finset (Fin v))} :
    P ∈ seedClasses v d ↔ ∃ c ∈ d, (c.map (tri v)).toFinset = P := by
  simp only [seedClasses, List.mem_toFinset, List.mem_map]

theorem mem_of_testBit {l : List RawTriple} {x y z : Fin v}
    (h : (tripleMask v l).testBit (fcode x y z) = true) :
    ∃ e ∈ l, ({x, y, z} : Finset (Fin v)) = tri v e := by
  rw [tripleMask, testBit_orAll_pow] at h
  obtain ⟨e, he, hk⟩ := List.mem_flatMap.mp h
  exact ⟨e, he, eq_of_mem_permCodes hk⟩

/-- The translate of `{0, a, b, c}` by `-a`, minus `0`, is `{-a, b - a, c - a}`. -/
theorem erase_relabel_insert {G : Type*} [AddCommGroup G] [DecidableEq G] {a b c : G}
    (ha : a ≠ 0) (hb : b ≠ a) (hc : c ≠ a) :
    (relabel (Equiv.addRight (-a)) (insert 0 ({a, b, c} : Finset G))).erase 0 =
      {0 - a, b - a, c - a} := by
  ext y
  simp only [Finset.mem_erase, mem_relabel_addRight, Finset.mem_insert, Finset.mem_singleton,
    sub_neg_eq_add, zero_sub]
  constructor
  · rintro ⟨hy, h | h | h | h⟩
    · exact Or.inl (eq_neg_of_add_eq_zero_left h)
    · exact absurd (add_eq_right.mp h) hy
    · exact Or.inr (Or.inl (eq_sub_of_add_eq h))
    · exact Or.inr (Or.inr (eq_sub_of_add_eq h))
  · rintro (rfl | rfl | rfl)
    · exact ⟨neg_ne_zero.mpr ha, Or.inl (neg_add_cancel a)⟩
    · exact ⟨sub_ne_zero.mpr hb, Or.inr (Or.inr (Or.inl (sub_add_cancel b a)))⟩
    · exact ⟨sub_ne_zero.mpr hc, Or.inr (Or.inr (Or.inr (sub_add_cancel c a)))⟩

/-- **Soundness of the seed checker.**  No hypothesis is a semantic property of the data. -/
theorem seed_of_check {d : List (List RawTriple)} (h : seedCheck v d = true) :
    SeedOK (seedTriples v d) ∧ SeedResolution (seedTriples v d) (seedClasses v d) := by
  simp only [seedCheck, Bool.and_eq_true, List.all_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨hr, hp⟩, hc⟩, hcl⟩ := h
  obtain ⟨hpnd, hpmem⟩ := insertAll_zero_eq hp
  have hpos : ∀ y : Fin v, y ≠ 0 → 0 < y.val := by
    intro y hy
    rcases Nat.eq_zero_or_pos y.val with h0 | h0
    · exact absurd (Fin.ext (by rw [h0, Fin.val_zero])) hy
    · exact h0
  -- Two points of a listed triple give one of its pair codes.
  have pairs_of_mem : ∀ e ∈ d.flatten, ∀ y z : Fin v, y.val < z.val → y ∈ tri v e →
      z ∈ tri v e → y.val * v + z.val ∈ pairCodes v e := by
    intro e he y z hyz hy hz
    have hR := rangeOK_iff.mp (hr e he)
    rw [mem_tri (hr e he)] at hy hz
    simp only [pairCodes, List.mem_cons, List.not_mem_nil, or_false]
    rcases hy with hy | hy | hy <;> rcases hz with hz | hz | hz <;>
      first
      | (exfalso; omega)
      | simp [hy, hz]
  -- A pair of distinct points lies in at most one listed triple (value-level).
  have pair_val_unique : ∀ e ∈ d.flatten, ∀ e' ∈ d.flatten, ∀ y z : Fin v, y ≠ z →
      y ∈ tri v e → z ∈ tri v e → y ∈ tri v e' → z ∈ tri v e' → e = e' := by
    intro e he e' he' y z hyz hy hz hy' hz'
    rcases lt_or_gt_of_ne (Fin.val_ne_of_ne hyz) with hlt | hlt
    · exact eq_of_mem_of_nodup_flatMap hpnd he he' (pairs_of_mem e he y z hlt hy hz)
        (pairs_of_mem e' he' y z hlt hy' hz')
    · exact eq_of_mem_of_nodup_flatMap hpnd he he' (pairs_of_mem e he z y hlt hz hy)
        (pairs_of_mem e' he' z y hlt hz' hy')
  -- A pair of distinct nonzero points lies in some listed triple.
  have pair_ex : ∀ y z : Fin v, y ≠ 0 → y.val < z.val →
      ∃ e ∈ d.flatten, y ∈ tri v e ∧ z ∈ tri v e := by
    intro y z hy hlt
    have hk : y.val * v + z.val ∈ pairList v :=
      mem_pairList.mpr ⟨y.val, z.val, hpos y hy, hlt, z.isLt, rfl⟩
    obtain ⟨e, he, hke⟩ := List.mem_flatMap.mp ((hpmem _).mpr hk)
    have hR := rangeOK_iff.mp (hr e he)
    refine ⟨e, he, ?_⟩
    rw [mem_tri (hr e he), mem_tri (hr e he)]
    simp only [pairCodes, List.mem_cons, List.not_mem_nil, or_false] at hke
    rcases hke with h' | h' | h'
    · obtain ⟨h1, h2⟩ := mul_add_inj z.isLt (by omega) h'
      exact ⟨Or.inl h1, Or.inr (Or.inl h2)⟩
    · obtain ⟨h1, h2⟩ := mul_add_inj z.isLt (by omega) h'
      exact ⟨Or.inl h1, Or.inr (Or.inr h2)⟩
    · obtain ⟨h1, h2⟩ := mul_add_inj z.isLt (by omega) h'
      exact ⟨Or.inr (Or.inl h1), Or.inr (Or.inr h2)⟩
  -- No triple is listed twice.
  have hflat : d.flatten.Nodup :=
    nodup_of_nodup_flatMap (f := pairCodes v) (fun e => by simp [pairCodes]) hpnd
  have hflat' : (d.flatMap id).Nodup := by rwa [List.flatMap_id]
  -- Equal listed triples are equal raw triples.
  have tri_inj : ∀ e ∈ d.flatten, ∀ e' ∈ d.flatten, tri v e = tri v e' → e = e' := by
    intro e he e' he' heq
    have hR := rangeOK_iff.mp (hr e he)
    have h1 : pt v e.1 ∈ tri v e := by simp [tri]
    have h2 : pt v e.2.1 ∈ tri v e := by simp [tri]
    have hne : pt v e.1 ≠ pt v e.2.1 := by
      intro h'
      have := congrArg Fin.val h'
      rw [pt_val (by omega), pt_val (by omega)] at this
      omega
    exact pair_val_unique e he e' he' _ _ hne h1 h2 (heq ▸ h1) (heq ▸ h2)
  -- Every point of `Fin v` other than `0` lies in exactly one triple of each raw class.
  have class_cover : ∀ c ∈ d, ∀ y : Fin v, y ≠ 0 →
      ∃! T, T ∈ (c.map (tri v)).toFinset ∧ y ∈ T := by
    intro c hcd y hy
    obtain ⟨hcnd, hcmem⟩ := insertAll_zero_eq (hc c hcd)
    have hcf : ∀ e ∈ c, e ∈ d.flatten := fun e he => List.mem_flatten.mpr ⟨c, hcd, he⟩
    have hyc : y.val ∈ c.flatMap pts := (hcmem _).mpr (mem_pointList.mpr ⟨hpos y hy, y.isLt⟩)
    obtain ⟨e, he, hye⟩ := List.mem_flatMap.mp hyc
    have hye' : y ∈ tri v e := by
      rw [mem_tri (hr e (hcf e he))]
      simpa [pts, eq_comm] using hye
    refine ⟨tri v e, ⟨List.mem_toFinset.mpr (List.mem_map_of_mem he), hye'⟩, ?_⟩
    rintro T ⟨hT, hyT⟩
    obtain ⟨e', he', rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hT)
    have hye'' : y.val ∈ pts e' := by
      rw [mem_tri (hr e' (hcf e' he'))] at hyT
      simpa [pts, eq_comm] using hyT
    rw [eq_of_mem_of_nodup_flatMap hcnd he' he hye'' hye]
  refine ⟨⟨?_, ?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_⟩⟩
  · -- every seed triple is a 3-subset
    intro t ht
    obtain ⟨e, he, rfl⟩ := mem_seedTriples.mp ht
    exact tri_card (hr e he)
  · -- no seed triple contains `0`
    intro t ht
    obtain ⟨e, he, rfl⟩ := mem_seedTriples.mp ht
    exact zero_not_mem_tri (hr e he)
  · -- every pair of distinct nonzero points lies in some seed triple
    intro y z hy hz hyz
    rcases lt_or_gt_of_ne (Fin.val_ne_of_ne hyz) with hlt | hlt
    · obtain ⟨e, he, hye, hze⟩ := pair_ex y z hy hlt
      exact ⟨tri v e, mem_seedTriples.mpr ⟨e, he, rfl⟩, hye, hze⟩
    · obtain ⟨e, he, hze, hye⟩ := pair_ex z y hz hlt
      exact ⟨tri v e, mem_seedTriples.mpr ⟨e, he, rfl⟩, hye, hze⟩
  · -- ... and in at most one
    intro t ht t' ht' y z hyz hy hz hy' hz'
    obtain ⟨e, he, rfl⟩ := mem_seedTriples.mp ht
    obtain ⟨e', he', rfl⟩ := mem_seedTriples.mp ht'
    rw [pair_val_unique e he e' he' y z hyz hy hz hy' hz']
  · -- closure under translation
    intro t ht a ha
    obtain ⟨e, he, rfl⟩ := mem_seedTriples.mp ht
    have hR := rangeOK_iff.mp (hr e he)
    have hA : pt v e.1 ≠ 0 := by
      intro h'
      have := congrArg Fin.val h'
      rw [pt_val (by omega), Fin.val_zero] at this
      omega
    have hB : pt v e.2.1 ≠ 0 := by
      intro h'
      have := congrArg Fin.val h'
      rw [pt_val (by omega), Fin.val_zero] at this
      omega
    have hC : pt v e.2.2 ≠ 0 := by
      intro h'
      have := congrArg Fin.val h'
      rw [pt_val (by omega), Fin.val_zero] at this
      omega
    have hAB : pt v e.1 ≠ pt v e.2.1 := by
      intro h'
      have := congrArg Fin.val h'
      rw [pt_val (by omega), pt_val (by omega)] at this
      omega
    have hAC : pt v e.1 ≠ pt v e.2.2 := by
      intro h'
      have := congrArg Fin.val h'
      rw [pt_val (by omega), pt_val (by omega)] at this
      omega
    have hBC : pt v e.2.1 ≠ pt v e.2.2 := by
      intro h'
      have := congrArg Fin.val h'
      rw [pt_val (by omega), pt_val (by omega)] at this
      omega
    have hce := hcl e he
    simp only [closedOK, Bool.and_eq_true] at hce
    obtain ⟨⟨h1, h2⟩, h3⟩ := hce
    simp only [tri, Finset.mem_insert, Finset.mem_singleton] at ha
    rcases ha with rfl | rfl | rfl
    · rw [show tri v e = {pt v e.1, pt v e.2.1, pt v e.2.2} from rfl,
        erase_relabel_insert hA (Ne.symm hAB) (Ne.symm hAC)]
      obtain ⟨e', he', heq⟩ := mem_of_testBit h1
      exact mem_seedTriples.mpr ⟨e', he', heq.symm⟩
    · have hperm : tri v e = {pt v e.2.1, pt v e.1, pt v e.2.2} := Finset.insert_comm _ _ _
      rw [hperm, erase_relabel_insert hB hAB (Ne.symm hBC)]
      obtain ⟨e', he', heq⟩ := mem_of_testBit h2
      exact mem_seedTriples.mpr ⟨e', he', heq.symm⟩
    · have hperm : tri v e = {pt v e.2.2, pt v e.1, pt v e.2.1} := by
        ext w
        simp only [tri, Finset.mem_insert, Finset.mem_singleton]
        tauto
      rw [hperm, erase_relabel_insert hC hAC hBC]
      obtain ⟨e', he', heq⟩ := mem_of_testBit h3
      exact mem_seedTriples.mpr ⟨e', he', heq.symm⟩
  · -- every class consists of seed triples
    intro P hP T hT
    obtain ⟨c, hcd, rfl⟩ := mem_seedClasses.mp hP
    obtain ⟨e, he, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hT)
    exact mem_seedTriples.mpr ⟨e, List.mem_flatten.mpr ⟨c, hcd, he⟩, rfl⟩
  · -- every class partitions the nonzero points
    intro P hP y hy
    obtain ⟨c, hcd, rfl⟩ := mem_seedClasses.mp hP
    exact class_cover c hcd y hy
  · -- every seed triple lies in exactly one class
    intro T hT
    obtain ⟨e, he, rfl⟩ := mem_seedTriples.mp hT
    obtain ⟨c, hcd, hec⟩ := List.mem_flatten.mp he
    refine ⟨(c.map (tri v)).toFinset,
      ⟨mem_seedClasses.mpr ⟨c, hcd, rfl⟩, List.mem_toFinset.mpr (List.mem_map_of_mem hec)⟩, ?_⟩
    rintro P ⟨hP, hTP⟩
    obtain ⟨c', hc'd, rfl⟩ := mem_seedClasses.mp hP
    obtain ⟨e', he'c', heq⟩ := List.mem_map.mp (List.mem_toFinset.mp hTP)
    have he' : e' ∈ d.flatten := List.mem_flatten.mpr ⟨c', hc'd, he'c'⟩
    obtain rfl : e' = e := tri_inj e' he' e he heq
    rw [eq_of_mem_of_nodup_flatMap (f := id) hflat' hc'd hcd he'c' hec]

/-- The multiplication map `y ↦ m * y`, an additive automorphism of `Fin v` when `unitOK`. -/
def mulEquiv (v : ℕ) [NeZero v] (m m' : ℕ) (h : unitOK v m m' = true) : Fin v ≃+ Fin v where
  toFun y := pt v m * y
  invFun y := pt v m' * y
  left_inv y := by
    have h1 := (List.all_eq_true.mp h) y.val (List.mem_range.mpr y.isLt)
    simp only [Bool.and_eq_true, beq_iff_eq, pt_val_self] at h1
    exact h1.1
  right_inv y := by
    have h1 := (List.all_eq_true.mp h) y.val (List.mem_range.mpr y.isLt)
    simp only [Bool.and_eq_true, beq_iff_eq, pt_val_self] at h1
    exact h1.2
  map_add' x y := mul_add _ _ _

theorem mult_of_check {d : List (List RawTriple)} {m m' : ℕ} (h : multCheck v d m m' = true) :
    ∃ hu : unitOK v m m' = true, ∀ t ∈ seedTriples v d,
      relabel (mulEquiv v m m' hu).toEquiv t ∈ seedTriples v d := by
  simp only [multCheck, Bool.and_eq_true, List.all_eq_true] at h
  obtain ⟨hu, hm⟩ := h
  refine ⟨hu, fun t ht => ?_⟩
  obtain ⟨e, he, rfl⟩ := mem_seedTriples.mp ht
  obtain ⟨e', he', heq⟩ := mem_of_testBit (hm e he)
  have himg : relabel (mulEquiv v m m' hu).toEquiv (tri v e) =
      {pt v m * pt v e.1, pt v m * pt v e.2.1, pt v m * pt v e.2.2} := by
    simp only [relabel, tri, Finset.map_insert, Finset.map_singleton]
    rfl
  rw [himg, heq]
  exact mem_seedTriples.mpr ⟨e', he', rfl⟩

/-- The explicit blocks are the translates of `{0} ∪ t`, `t` a listed triple. -/
theorem mem_blocks {d : List (List RawTriple)} {X : Finset (Fin v)} :
    X ∈ blocks v d ↔ ∃ a : Fin v, ∃ e ∈ d.flatten, X = (insert 0 (tri v e)).image (· + a) := by
  rw [blocks, mem_blocksOf]
  constructor
  · rintro ⟨a, t, ht, rfl⟩
    obtain ⟨e, he, rfl⟩ := mem_seedTriples.mp ht
    exact ⟨a, e, he, by rw [relabel, Finset.map_eq_image]; rfl⟩
  · rintro ⟨a, e, he, rfl⟩
    exact ⟨a, tri v e, mem_seedTriples.mpr ⟨e, he, rfl⟩, by rw [relabel, Finset.map_eq_image]; rfl⟩

/-- **The explicit block set is an RDSQS.** -/
theorem isRDSQS_of_check {d : List (List RawTriple)} (h : seedCheck v d = true) :
    IsRDSQS (blocks v d) :=
  isRDSQS_blocksOf (seed_of_check h).1 (seed_of_check h).2

/-- **The explicit resolutions.**  For every multiplier passing `multCheck` and every point `x`,
`resAt v d m x` resolves the derived design of `blocks v d` at `x`. -/
theorem resAt_of_check {d : List (List RawTriple)} (h : seedCheck v d = true) {m m' : ℕ}
    (hm : multCheck v d m m' = true) (x : Fin v) :
    IsDerivedResolution (blocks v d) x (resAt v d m x) := by
  obtain ⟨hu, hμ⟩ := mult_of_check hm
  have hres := isDerivedResolution_affine (seed_of_check h).1 (seed_of_check h).2
    (mulEquiv v m m' hu) hμ x
  have hconv : ∀ T : Finset (Fin v),
      relabel ((mulEquiv v m m' hu).toEquiv.trans (Equiv.addRight x)) T =
        T.image fun y => pt v m * y + x := by
    intro T
    rw [relabel, Finset.map_eq_image]
    rfl
  have hR : resAt v d m x =
      (seedClasses v d).image fun P =>
        P.image (relabel ((mulEquiv v m m' hu).toEquiv.trans (Equiv.addRight x))) := by
    unfold resAt
    congr 1
    funext P
    congr 1
    funext T
    exact (hconv T).symm
  rw [hR]
  exact hres

end Soundness

