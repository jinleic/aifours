import RdsqsKernel.Data52
import RdsqsKernel.Counts

/-!
# RDSQS(52): kernel-checked existence

`data52` and `mults52` come from `RdsqsKernel.Data52`, generated by `gen_lean.py` from the raw
certificate `review/rdsqs52-parent-inputs-v1/rdsqs52_z52_m23.txt` (SHA-256
`7ae0a828b5af08b4bd9b423564981d85e3703886553638024fdc812f564989a6`; `data52` is its `POINT 0`
section verbatim) and the seed `review/rdsqs52-parent-replay-v1/rdsqs52_z52_m23_seed.json`
(SHA-256 `a0fe9247f93d1f16007eff24b65c3dddf0f409c33f847f8a7382399b09dcefce`; multiplier
generator 23).

Every `decide +kernel` below is evaluated by the Lean kernel (no `native_decide`, no
`Lean.ofReduceBool`).  The semantic conclusions come from the data-independent theorems
`isRDSQS_of_check` and `resAt_of_check` (`RdsqsKernel.Check`, built on `RdsqsKernel.Generic`)
and the counting lemmas of `RdsqsKernel.Counts`; the target notions are defined in
`RdsqsKernel.Target`.
-/

namespace Rdsqs.Kernel

open Rdsqs.Generic Rdsqs.Counts

universe u

/-- Shape of the raw data: 25 classes of 17 triples each. -/
theorem data52_shape : data52.length = 25 ∧ ∀ c ∈ data52, c.length = 17 := by
  decide +kernel

/-- Every listed triple is `0 < a < b < c < 52`: no reduction modulo 52 happens. -/
theorem data52_range :
    ∀ e ∈ data52.flatten, 0 < e.1 ∧ e.1 < e.2.1 ∧ e.2.1 < e.2.2 ∧ e.2.2 < 52 := by
  decide +kernel

/-- The multipliers: the powers of 23 modulo 52, each with its inverse. -/
theorem mults52_eq : mults52 = [(1, 1), (23, 43), (9, 29), (51, 51), (29, 9), (43, 23)] := rfl

/-- One kernel evaluation of the seed checker. -/
theorem data52_seedCheck : seedCheck 52 data52 = true := by
  decide +kernel

/-- One kernel evaluation of the multiplier checker, for every listed multiplier. -/
theorem data52_multCheck : ∀ p ∈ mults52, multCheck 52 data52 p.1 p.2 = true := by
  decide +kernel

/-- The explicit block set: all translates of `{0} ∪ t`, `t` a triple of the raw `POINT 0`
section. -/
def rdsqs52 : Finset (Finset (Fin 52)) := blocks 52 data52

theorem rdsqs52_spec (X : Finset (Fin 52)) :
    X ∈ rdsqs52 ↔ ∃ a : Fin 52, ∃ e ∈ data52.flatten, X = (insert 0 (tri 52 e)).image (· + a) :=
  mem_blocks

theorem isSQS_rdsqs52 : IsSQS rdsqs52 :=
  (isRDSQS_of_check data52_seedCheck).1

/-- **The explicit block set is an RDSQS(52).** -/
theorem isRDSQS_rdsqs52 : IsRDSQS rdsqs52 :=
  isRDSQS_of_check data52_seedCheck

/-- **Every explicit resolution.**  For every point `x` and every listed multiplier `m`, the image
of the raw `POINT 0` classes under `y ↦ m * y + x` resolves the derived design at `x`. -/
theorem rdsqs52_resolutions (x : Fin 52) (m m' : ℕ) (hm : (m, m') ∈ mults52) :
    IsDerivedResolution rdsqs52 x (resAt 52 data52 m x) :=
  resAt_of_check data52_seedCheck (data52_multCheck (m, m') hm) x

/-- **An RDSQS(52) exists** (on the point set `Fin 52`). -/
theorem exists_rdsqs52 : Target 52 :=
  ⟨rdsqs52, isRDSQS_rdsqs52⟩

/-- Every 52-element type carries an RDSQS(52). -/
theorem exists_rdsqs52_all : TargetAll.{u} 52 :=
  targetAll_of_target exists_rdsqs52

/-- The existence statement with every forced count written out. -/
theorem counts_rdsqs52 : TargetCounts 52 := by
  have h1m : ((1, 1) : ℕ × ℕ) ∈ mults52 := by
    rw [mults52_eq]
    exact List.mem_cons_self
  have hres := fun x : Fin 52 => rdsqs52_resolutions x 1 1 h1m
  refine ⟨rdsqs52, isSQS_rdsqs52, ?_, fun x => ⟨fun T hT => derived_card_three isSQS_rdsqs52 hT,
    ?_, resAt 52 data52 1 x, hres x, ?_, ?_⟩⟩
  · have h := card_blocks_mul isSQS_rdsqs52
    rw [Fintype.card_fin] at h
    have hc : Nat.choose 52 3 = 22100 := by decide +kernel
    omega
  · have h := card_derived_mul isSQS_rdsqs52 x
    rw [Fintype.card_fin] at h
    have hc : Nat.choose (52 - 1) 2 = 1275 := by decide +kernel
    omega
  · have h1 := card_resolution_mul isSQS_rdsqs52 (hres x)
    have h2 := card_derived_mul isSQS_rdsqs52 x
    rw [Fintype.card_fin] at h1 h2
    have hc : Nat.choose (52 - 1) 2 = 1275 := by decide +kernel
    omega
  · intro P hP
    have h := card_class_mul isSQS_rdsqs52 ((hres x).1 P hP)
    rw [Fintype.card_fin] at h
    omega

end Rdsqs.Kernel
