import RdsqsKernel.Data76
import RdsqsKernel.Counts

/-!
# RDSQS(76): kernel-checked existence

`data76` and `mults76` come from `RdsqsKernel.Data76`, generated by `gen_lean.py` from the raw
certificate `review/rdsqs76-parent-inputs-v1/rdsqs76_z76_m3_sample0.txt` (SHA-256
`2f75b37c0439aa9f9c57861505a2e865997dd02249349b708880916d477a75aa`; `data76` is its `POINT 0`
section verbatim) and the seed `review/rdsqs76-parent-inputs-v1/rdsqs76_z76_m3_sample0_seed.json`
(SHA-256 `8d5860f640d1d49163496f996aad97af1e4674855cc2a1c6883327cb272ba0ad`; multiplier
generator 3).  EXPLORATORY: correctness only; no novelty or open-status claim.

Every `decide +kernel` below is evaluated by the Lean kernel (no `native_decide`, no
`Lean.ofReduceBool`).  The semantic conclusions come from the data-independent theorems
`isRDSQS_of_check` and `resAt_of_check` (`RdsqsKernel.Check`, built on `RdsqsKernel.Generic`)
and the counting lemmas of `RdsqsKernel.Counts`; the target notions are defined in
`RdsqsKernel.Target`.
-/

namespace Rdsqs.Kernel

open Rdsqs.Generic Rdsqs.Counts

universe u

/-- Shape of the raw data: 37 classes of 25 triples each. -/
theorem data76_shape : data76.length = 37 ∧ ∀ c ∈ data76, c.length = 25 := by
  decide +kernel

/-- Every listed triple is `0 < a < b < c < 76`: no reduction modulo 76 happens. -/
theorem data76_range :
    ∀ e ∈ data76.flatten, 0 < e.1 ∧ e.1 < e.2.1 ∧ e.2.1 < e.2.2 ∧ e.2.2 < 76 := by
  decide +kernel

/-- The multipliers: the powers of 3 modulo 76, each with its inverse. -/
theorem mults76_eq : mults76 = [(1, 1), (3, 51), (9, 17), (27, 31), (5, 61), (15, 71), (45, 49),
    (59, 67), (25, 73), (75, 75), (73, 25), (67, 59), (49, 45), (71, 15), (61, 5), (31, 27),
    (17, 9), (51, 3)] := rfl

/-- One kernel evaluation of the seed checker. -/
theorem data76_seedCheck : seedCheck 76 data76 = true := by
  decide +kernel

/-- One kernel evaluation of the multiplier checker, for every listed multiplier. -/
theorem data76_multCheck : ∀ p ∈ mults76, multCheck 76 data76 p.1 p.2 = true := by
  decide +kernel

/-- The explicit block set: all translates of `{0} ∪ t`, `t` a triple of the raw `POINT 0`
section. -/
def rdsqs76 : Finset (Finset (Fin 76)) := blocks 76 data76

theorem rdsqs76_spec (X : Finset (Fin 76)) :
    X ∈ rdsqs76 ↔ ∃ a : Fin 76, ∃ e ∈ data76.flatten, X = (insert 0 (tri 76 e)).image (· + a) :=
  mem_blocks

theorem isSQS_rdsqs76 : IsSQS rdsqs76 :=
  (isRDSQS_of_check data76_seedCheck).1

/-- **The explicit block set is an RDSQS(76).** -/
theorem isRDSQS_rdsqs76 : IsRDSQS rdsqs76 :=
  isRDSQS_of_check data76_seedCheck

/-- **Every explicit resolution.**  For every point `x` and every listed multiplier `m`, the image
of the raw `POINT 0` classes under `y ↦ m * y + x` resolves the derived design at `x`. -/
theorem rdsqs76_resolutions (x : Fin 76) (m m' : ℕ) (hm : (m, m') ∈ mults76) :
    IsDerivedResolution rdsqs76 x (resAt 76 data76 m x) :=
  resAt_of_check data76_seedCheck (data76_multCheck (m, m') hm) x

/-- **An RDSQS(76) exists** (on the point set `Fin 76`). -/
theorem exists_rdsqs76 : Target 76 :=
  ⟨rdsqs76, isRDSQS_rdsqs76⟩

/-- Every 76-element type carries an RDSQS(76). -/
theorem exists_rdsqs76_all : TargetAll.{u} 76 :=
  targetAll_of_target exists_rdsqs76

/-- The existence statement with every forced count written out. -/
theorem counts_rdsqs76 : TargetCounts 76 := by
  have h1m : ((1, 1) : ℕ × ℕ) ∈ mults76 := by
    rw [mults76_eq]
    exact List.mem_cons_self
  have hres := fun x : Fin 76 => rdsqs76_resolutions x 1 1 h1m
  refine ⟨rdsqs76, isSQS_rdsqs76, ?_, fun x => ⟨fun T hT => derived_card_three isSQS_rdsqs76 hT,
    ?_, resAt 76 data76 1 x, hres x, ?_, ?_⟩⟩
  · have h := card_blocks_mul isSQS_rdsqs76
    rw [Fintype.card_fin] at h
    have hc : Nat.choose 76 3 = 70300 := by decide +kernel
    omega
  · have h := card_derived_mul isSQS_rdsqs76 x
    rw [Fintype.card_fin] at h
    have hc : Nat.choose (76 - 1) 2 = 2775 := by decide +kernel
    omega
  · have h1 := card_resolution_mul isSQS_rdsqs76 (hres x)
    have h2 := card_derived_mul isSQS_rdsqs76 x
    rw [Fintype.card_fin] at h1 h2
    have hc : Nat.choose (76 - 1) 2 = 2775 := by decide +kernel
    omega
  · intro P hP
    have h := card_class_mul isSQS_rdsqs76 ((hres x).1 P hP)
    rw [Fintype.card_fin] at h
    omega

end Rdsqs.Kernel
