import RdsqsKernel.Target
import Mathlib.Algebra.Group.Equiv.Defs
import Mathlib.Algebra.Group.Units.Equiv
import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Fintype.EquivFin
import Mathlib.Data.Finset.Union
import Mathlib.Logic.Equiv.Fin.Basic

/-!
# Generic lemmas: relabelling, and SQS generated by a translation seed

Nothing here mentions the order 52 or any data.

* `relabel e X`: the image `e(X)` of a block under a bijection `e : V ≃ W` of point types.
  `isSQS_relabel`, `isDerivedResolution_relabel` and `isRDSQS_relabel` transport the target
  notions along `e`; `targetAll_of_target` gives `Target v → TargetAll v`.
  `isDerivedResolution_perm`: a permutation `σ` of the points that maps every block of `B` to a
  block of `B` maps a resolution of the derived design at `x` to one at `σ x`.
* For a finite additive commutative group `G` and a set `S` of 3-subsets of `G` (the *seed*),
  `blocksOf S` is the set of all translates `{0} ∪ t + a` (`t ∈ S`, `a ∈ G`).  `SeedOK S` lists
  finite conditions on `S` alone: every `t ∈ S` is a 3-subset avoiding `0`; every pair of
  distinct nonzero points lies in exactly one `t ∈ S` (an STS on `G \ {0}`); and the closure
  condition: for `t ∈ S` and `a ∈ t`, the translate `({0} ∪ t) - a`, minus `0`, is again in `S`.
  `SeedResolution S R0`: `R0` is a set of subsets of `S`, each partitioning `G \ {0}`, and
  every `t ∈ S` lies in exactly one member of `R0`.
* `isSQS_blocksOf`: `SeedOK S → IsSQS (blocksOf S)` (the closure condition makes the blocks
  through `0` exactly the `{0} ∪ t`; the pair condition then gives one block per 3-subset after
  translating it to contain `0`).
* `derivedBlocks_blocksOf_zero`: the derived design at `0` has block set `S`.
* `isDerivedResolution_affine`: for every additive automorphism `μ` of `G` with `μ(S) ⊆ S` and
  every point `x`, the image of `R0` under `y ↦ μ y + x` resolves the derived design at `x`.
  `isRDSQS_blocksOf` is the special case `μ = id`.
-/

namespace Rdsqs.Generic

open Finset

/-! ## Relabelling along a bijection of point types -/

section Relabel

variable {V W U : Type*} [DecidableEq V] [DecidableEq W] [DecidableEq U]

/-- The image `e(X)` of the block `X` under the bijection `e` of point types. -/
def relabel (e : V ≃ W) (X : Finset V) : Finset W :=
  X.map e.toEmbedding

omit [DecidableEq V] [DecidableEq W] in
theorem mem_relabel {e : V ≃ W} {X : Finset V} {w : W} : w ∈ relabel e X ↔ e.symm w ∈ X :=
  Finset.mem_map_equiv

omit [DecidableEq V] [DecidableEq W] in
theorem apply_mem_relabel {e : V ≃ W} {X : Finset V} {x : V} : e x ∈ relabel e X ↔ x ∈ X := by
  rw [mem_relabel, Equiv.symm_apply_apply]

omit [DecidableEq V] [DecidableEq W] in
theorem relabel_injective (e : V ≃ W) : Function.Injective (relabel e) :=
  Finset.map_injective _

omit [DecidableEq V] [DecidableEq W] in
theorem card_relabel (e : V ≃ W) (X : Finset V) : (relabel e X).card = X.card :=
  Finset.card_map _

omit [DecidableEq V] [DecidableEq W] in
theorem relabel_subset_relabel {e : V ≃ W} {X Y : Finset V} :
    relabel e X ⊆ relabel e Y ↔ X ⊆ Y :=
  Finset.map_subset_map

omit [DecidableEq V] [DecidableEq W] in
theorem relabel_relabel_symm (e : V ≃ W) (Y : Finset W) : relabel e (relabel e.symm Y) = Y := by
  ext w
  simp [mem_relabel]

omit [DecidableEq V] [DecidableEq W] in
theorem relabel_symm_relabel (e : V ≃ W) (X : Finset V) : relabel e.symm (relabel e X) = X := by
  ext x
  simp [mem_relabel]

theorem relabel_erase (e : V ≃ W) (X : Finset V) (x : V) :
    relabel e (X.erase x) = (relabel e X).erase (e x) :=
  Finset.map_erase _ _ _

omit [DecidableEq V] [DecidableEq W] [DecidableEq U] in
theorem relabel_relabel (e : V ≃ W) (f : W ≃ U) (X : Finset V) :
    relabel f (relabel e X) = relabel (e.trans f) X := by
  simp only [relabel, Finset.map_map]
  rfl

omit [DecidableEq V] in
theorem isSQS_relabel (e : V ≃ W) {B : Finset (Finset V)} (h : IsSQS B) :
    IsSQS (B.image (relabel e)) := by
  refine ⟨?_, ?_⟩
  · intro X hX
    obtain ⟨X0, hX0, rfl⟩ := Finset.mem_image.mp hX
    rw [card_relabel]
    exact h.1 X0 hX0
  · intro T hT
    have hT0 : (relabel e.symm T).card = 3 := by
      rw [card_relabel]
      exact hT
    obtain ⟨X0, ⟨hX0, hsub⟩, huniq⟩ := h.2 _ hT0
    refine ⟨relabel e X0, ⟨Finset.mem_image_of_mem _ hX0, ?_⟩, ?_⟩
    · have := (relabel_subset_relabel (e := e)).mpr hsub
      rwa [relabel_relabel_symm] at this
    · rintro Y ⟨hY, hTY⟩
      obtain ⟨Y0, hY0, rfl⟩ := Finset.mem_image.mp hY
      have hsub' : relabel e.symm T ⊆ Y0 := by
        have := (relabel_subset_relabel (e := e.symm)).mpr hTY
        rwa [relabel_symm_relabel] at this
      rw [huniq Y0 ⟨hY0, hsub'⟩]

theorem derivedBlocks_relabel (e : V ≃ W) (B : Finset (Finset V)) (x : V) :
    derivedBlocks (B.image (relabel e)) (e x) = (derivedBlocks B x).image (relabel e) := by
  ext T
  simp only [derivedBlocks, Finset.mem_image, Finset.mem_filter]
  constructor
  · rintro ⟨X, ⟨⟨X0, hX0, rfl⟩, hx⟩, rfl⟩
    exact ⟨X0.erase x, ⟨X0, ⟨hX0, apply_mem_relabel.mp hx⟩, rfl⟩, relabel_erase e X0 x⟩
  · rintro ⟨T0, ⟨X0, ⟨hX0, hx⟩, rfl⟩, rfl⟩
    exact ⟨relabel e X0, ⟨⟨X0, hX0, rfl⟩, apply_mem_relabel.mpr hx⟩, (relabel_erase e X0 x).symm⟩

theorem isDerivedResolution_relabel (e : V ≃ W) {B : Finset (Finset V)} {x : V}
    {R : Finset (Finset (Finset V))} (h : IsDerivedResolution B x R) :
    IsDerivedResolution (B.image (relabel e)) (e x) (R.image fun P => P.image (relabel e)) := by
  obtain ⟨hcls, hpart⟩ := h
  refine ⟨?_, ?_⟩
  · intro P' hP'
    obtain ⟨P, hP, rfl⟩ := Finset.mem_image.mp hP'
    obtain ⟨hsub, hcov⟩ := hcls P hP
    refine ⟨?_, ?_⟩
    · intro T' hT'
      obtain ⟨T, hT, rfl⟩ := Finset.mem_image.mp hT'
      rw [derivedBlocks_relabel]
      exact Finset.mem_image_of_mem _ (hsub hT)
    · intro w hw
      have hy : e.symm w ≠ x := by
        intro h'
        apply hw
        rw [← h', Equiv.apply_symm_apply]
      obtain ⟨T, ⟨hT, hyT⟩, huniq⟩ := hcov _ hy
      refine ⟨relabel e T, ⟨Finset.mem_image_of_mem _ hT, mem_relabel.mpr hyT⟩, ?_⟩
      rintro T2' ⟨hT2', hwT2'⟩
      obtain ⟨T2, hT2, rfl⟩ := Finset.mem_image.mp hT2'
      rw [huniq T2 ⟨hT2, mem_relabel.mp hwT2'⟩]
  · intro T' hT'
    rw [derivedBlocks_relabel] at hT'
    obtain ⟨T, hT, rfl⟩ := Finset.mem_image.mp hT'
    obtain ⟨P, ⟨hP, hTP⟩, huniq⟩ := hpart T hT
    refine ⟨P.image (relabel e), ⟨Finset.mem_image_of_mem _ hP, Finset.mem_image_of_mem _ hTP⟩, ?_⟩
    rintro P2' ⟨hP2', hTP2'⟩
    obtain ⟨P2, hP2, rfl⟩ := Finset.mem_image.mp hP2'
    obtain ⟨T3, hT3, hT3eq⟩ := Finset.mem_image.mp hTP2'
    obtain rfl : T3 = T := relabel_injective e hT3eq
    rw [huniq P2 ⟨hP2, hT3⟩]

theorem isRDSQS_relabel (e : V ≃ W) {B : Finset (Finset V)} (h : IsRDSQS B) :
    IsRDSQS (B.image (relabel e)) := by
  refine ⟨isSQS_relabel e h.1, fun w => ?_⟩
  obtain ⟨R, hR⟩ := h.2 (e.symm w)
  have hR' := isDerivedResolution_relabel e hR
  rw [Equiv.apply_symm_apply] at hR'
  exact ⟨_, hR'⟩

/-- An `RDSQS` on `Fin v` gives one on every `v`-element type (relabelling along a bijection). -/
theorem targetAll_of_target {v : ℕ} (h : Target v) : TargetAll.{u_1} v := by
  intro V' _ _ hV
  obtain ⟨B, hB⟩ := h
  exact ⟨_, isRDSQS_relabel ((finCongr hV.symm).trans (Fintype.equivFin V').symm) hB⟩

/-- A permutation that maps every block of `B` to a block of `B` maps `B` onto `B`. -/
theorem image_relabel_eq_of_mapsTo (σ : Equiv.Perm V) {B : Finset (Finset V)}
    (h : ∀ X ∈ B, relabel σ X ∈ B) : B.image (relabel σ) = B := by
  apply Finset.eq_of_subset_of_card_le
  · intro Y hY
    obtain ⟨X, hX, rfl⟩ := Finset.mem_image.mp hY
    exact h X hX
  · rw [Finset.card_image_of_injective _ (relabel_injective σ)]

/-- A permutation that maps every block of `B` to a block of `B` maps a resolution of the derived
design at `x` to a resolution of the derived design at `σ x`. -/
theorem isDerivedResolution_perm (σ : Equiv.Perm V) {B : Finset (Finset V)}
    (hB : ∀ X ∈ B, relabel σ X ∈ B) {x : V} {R : Finset (Finset (Finset V))}
    (h : IsDerivedResolution B x R) :
    IsDerivedResolution B (σ x) (R.image fun P => P.image (relabel σ)) := by
  have h' := isDerivedResolution_relabel σ h
  rwa [image_relabel_eq_of_mapsTo σ hB] at h'

end Relabel

/-! ## SQS generated by a translation seed -/

section Translate

variable {G : Type*} [AddCommGroup G] [DecidableEq G]

omit [DecidableEq G] in
theorem mem_relabel_addRight {a : G} {X : Finset G} {y : G} :
    y ∈ relabel (Equiv.addRight a) X ↔ y - a ∈ X := by
  simp only [mem_relabel, Equiv.addRight_symm, Equiv.coe_addRight, sub_eq_add_neg]

omit [DecidableEq G] in
theorem relabel_addRight_addRight (a b : G) (X : Finset G) :
    relabel (Equiv.addRight b) (relabel (Equiv.addRight a) X) =
      relabel (Equiv.addRight (a + b)) X := by
  ext y
  simp only [mem_relabel_addRight]
  rw [sub_sub, add_comm b a]

omit [DecidableEq G] in
theorem relabel_addRight_zero (X : Finset G) : relabel (Equiv.addRight (0 : G)) X = X := by
  ext y
  simp [mem_relabel_addRight]

end Translate

section Seed

variable {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]

/-- The blocks generated by the seed `S`: all translates `{0} ∪ t + a` (`t ∈ S`, `a ∈ G`).
Irreducible, so that elaboration never tries to evaluate it on a concrete seed; it is used only
through `mem_blocksOf`. -/
@[irreducible] def blocksOf (S : Finset (Finset G)) : Finset (Finset G) :=
  Finset.univ.biUnion fun a => (S.image (insert 0)).image (relabel (Equiv.addRight a))

theorem mem_blocksOf {S : Finset (Finset G)} {X : Finset G} :
    X ∈ blocksOf S ↔ ∃ a : G, ∃ t ∈ S, relabel (Equiv.addRight a) (insert 0 t) = X := by
  simp only [blocksOf, Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image]
  constructor
  · rintro ⟨a, _, ⟨t, ht, rfl⟩, rfl⟩
    exact ⟨a, t, ht, rfl⟩
  · rintro ⟨a, t, ht, rfl⟩
    exact ⟨a, _, ⟨t, ht, rfl⟩, rfl⟩

theorem addRight_mem_blocksOf {S : Finset (Finset G)} {X : Finset G} (hX : X ∈ blocksOf S)
    (b : G) : relabel (Equiv.addRight b) X ∈ blocksOf S := by
  obtain ⟨a, t, ht, rfl⟩ := mem_blocksOf.mp hX
  exact mem_blocksOf.mpr ⟨a + b, t, ht, (relabel_addRight_addRight a b _).symm⟩

/-- Finite conditions on a seed `S` of 3-subsets of `G`. -/
structure SeedOK (S : Finset (Finset G)) : Prop where
  card_eq : ∀ t ∈ S, t.card = 3
  zero_not_mem : ∀ t ∈ S, (0 : G) ∉ t
  pair_exists : ∀ y z : G, y ≠ 0 → z ≠ 0 → y ≠ z → ∃ t ∈ S, y ∈ t ∧ z ∈ t
  pair_unique : ∀ t ∈ S, ∀ t' ∈ S, ∀ y z : G, y ≠ z → y ∈ t → z ∈ t → y ∈ t' → z ∈ t' → t = t'
  closed : ∀ t ∈ S, ∀ a ∈ t, (relabel (Equiv.addRight (-a)) (insert 0 t)).erase 0 ∈ S

/-- `R0` resolves the seed: its members are subsets of `S` partitioning `G \ {0}`, and every
`t ∈ S` lies in exactly one member of `R0`. -/
structure SeedResolution (S : Finset (Finset G)) (R0 : Finset (Finset (Finset G))) : Prop where
  sub : ∀ P ∈ R0, P ⊆ S
  cover : ∀ P ∈ R0, ∀ y : G, y ≠ 0 → ∃! T, T ∈ P ∧ y ∈ T
  part : ∀ T ∈ S, ∃! P, P ∈ R0 ∧ T ∈ P

variable {S : Finset (Finset G)}

/-- A generated block through `0` is `{0} ∪ t` with `t ∈ S`. -/
theorem erase_zero_mem (h : SeedOK S) {X : Finset G} (hX : X ∈ blocksOf S) (h0 : (0 : G) ∈ X) :
    X.erase 0 ∈ S := by
  obtain ⟨a, t, ht, rfl⟩ := mem_blocksOf.mp hX
  have h0' : -a ∈ insert 0 t := by
    have h1 := mem_relabel_addRight.mp h0
    rwa [zero_sub] at h1
  rcases Finset.mem_insert.mp h0' with ha | ha
  · obtain rfl : a = 0 := neg_eq_zero.mp ha
    rw [relabel_addRight_zero, Finset.erase_insert (h.zero_not_mem t ht)]
    exact ht
  · have h1 := h.closed t ht (-a) ha
    rwa [neg_neg] at h1

theorem card_of_mem_blocksOf (h : SeedOK S) {X : Finset G} (hX : X ∈ blocksOf S) :
    X.card = 4 := by
  obtain ⟨a, t, ht, rfl⟩ := mem_blocksOf.mp hX
  rw [card_relabel, Finset.card_insert_of_notMem (h.zero_not_mem t ht), h.card_eq t ht]

/-- **The generated blocks form an SQS.** -/
theorem isSQS_blocksOf (h : SeedOK S) : IsSQS (blocksOf S) := by
  refine ⟨fun X hX => card_of_mem_blocksOf h hX, ?_⟩
  intro T hT
  obtain ⟨p, q, r, hpq, hpr, hqr, rfl⟩ := Finset.card_eq_three.mp hT
  have hy : q - p ≠ 0 := sub_ne_zero.mpr (Ne.symm hpq)
  have hz : r - p ≠ 0 := sub_ne_zero.mpr (Ne.symm hpr)
  have hyz : q - p ≠ r - p := fun h' => hqr (sub_left_inj.mp h')
  obtain ⟨t, ht, hyt, hzt⟩ := h.pair_exists _ _ hy hz hyz
  have hsub : ({p, q, r} : Finset G) ⊆ relabel (Equiv.addRight p) (insert 0 t) := by
    intro w hw
    rw [mem_relabel_addRight]
    simp only [Finset.mem_insert, Finset.mem_singleton] at hw
    rcases hw with rfl | rfl | rfl
    · rw [sub_self]
      exact Finset.mem_insert_self _ _
    · exact Finset.mem_insert_of_mem hyt
    · exact Finset.mem_insert_of_mem hzt
  refine ⟨_, ⟨mem_blocksOf.mpr ⟨p, t, ht, rfl⟩, hsub⟩, ?_⟩
  have key : ∀ Y ∈ blocksOf S, ({p, q, r} : Finset G) ⊆ Y →
      relabel (Equiv.addRight (-p)) Y = insert 0 t := by
    intro Y hY hTY
    have hY' := addRight_mem_blocksOf hY (-p)
    have h0 : (0 : G) ∈ relabel (Equiv.addRight (-p)) Y := by
      rw [mem_relabel_addRight, zero_sub, neg_neg]
      exact hTY (by simp)
    have hyY : q - p ∈ relabel (Equiv.addRight (-p)) Y := by
      rw [mem_relabel_addRight, sub_neg_eq_add, sub_add_cancel]
      exact hTY (by simp)
    have hzY : r - p ∈ relabel (Equiv.addRight (-p)) Y := by
      rw [mem_relabel_addRight, sub_neg_eq_add, sub_add_cancel]
      exact hTY (by simp)
    have hS := erase_zero_mem h hY' h0
    have heq := h.pair_unique _ hS t ht _ _ hyz (Finset.mem_erase.mpr ⟨hy, hyY⟩)
      (Finset.mem_erase.mpr ⟨hz, hzY⟩) hyt hzt
    rw [← heq, Finset.insert_erase h0]
  rintro Y ⟨hY, hTY⟩
  apply relabel_injective (Equiv.addRight (-p))
  rw [key Y hY hTY, relabel_addRight_addRight, add_neg_cancel, relabel_addRight_zero]

/-- The derived design of the generated SQS at `0` has block set `S`. -/
theorem derivedBlocks_blocksOf_zero (h : SeedOK S) : derivedBlocks (blocksOf S) 0 = S := by
  ext T
  simp only [derivedBlocks, Finset.mem_image, Finset.mem_filter]
  constructor
  · rintro ⟨X, ⟨hX, h0⟩, rfl⟩
    exact erase_zero_mem h hX h0
  · intro hT
    refine ⟨insert 0 T, ⟨?_, Finset.mem_insert_self _ _⟩,
      Finset.erase_insert (h.zero_not_mem T hT)⟩
    exact mem_blocksOf.mpr ⟨0, T, hT, relabel_addRight_zero _⟩

theorem isDerivedResolution_zero (h : SeedOK S) {R0 : Finset (Finset (Finset G))}
    (hR : SeedResolution S R0) : IsDerivedResolution (blocksOf S) 0 R0 := by
  refine ⟨fun P hP => ⟨?_, hR.cover P hP⟩, ?_⟩
  · rw [derivedBlocks_blocksOf_zero h]
    exact hR.sub P hP
  · rw [derivedBlocks_blocksOf_zero h]
    exact hR.part

/-- An additive automorphism of `G` mapping `S` into `S` maps generated blocks to generated
blocks. -/
theorem aut_mem_blocksOf (μ : G ≃+ G) (hμ : ∀ t ∈ S, relabel μ.toEquiv t ∈ S) {X : Finset G}
    (hX : X ∈ blocksOf S) : relabel μ.toEquiv X ∈ blocksOf S := by
  obtain ⟨a, t, ht, rfl⟩ := mem_blocksOf.mp hX
  refine mem_blocksOf.mpr ⟨μ a, relabel μ.toEquiv t, hμ t ht, ?_⟩
  have h1 : insert 0 (relabel μ.toEquiv t) = relabel μ.toEquiv (insert 0 t) := by
    simp only [relabel, Finset.map_insert]
    congr 1
    simp
  rw [h1, relabel_relabel, relabel_relabel]
  congr 1
  ext y
  simp

/-- **Resolutions at every point.**  For an additive automorphism `μ` with `μ(S) ⊆ S` and a point
`x`, the image of the seed resolution `R0` under `y ↦ μ y + x` resolves the derived design of
the generated SQS at `x`. -/
theorem isDerivedResolution_affine (h : SeedOK S) {R0 : Finset (Finset (Finset G))}
    (hR : SeedResolution S R0) (μ : G ≃+ G) (hμ : ∀ t ∈ S, relabel μ.toEquiv t ∈ S) (x : G) :
    IsDerivedResolution (blocksOf S) x
      (R0.image fun P => P.image (relabel (μ.toEquiv.trans (Equiv.addRight x)))) := by
  have hB : ∀ X ∈ blocksOf S, relabel (μ.toEquiv.trans (Equiv.addRight x)) X ∈ blocksOf S := by
    intro X hX
    rw [← relabel_relabel]
    exact addRight_mem_blocksOf (aut_mem_blocksOf μ hμ hX) x
  have h' := isDerivedResolution_perm (μ.toEquiv.trans (Equiv.addRight x)) hB
    (isDerivedResolution_zero h hR)
  have hx : (μ.toEquiv.trans (Equiv.addRight x)) 0 = x := by simp
  rwa [hx] at h'

/-- **The generated blocks form an RDSQS** (resolutions by translation alone). -/
theorem isRDSQS_blocksOf (h : SeedOK S) {R0 : Finset (Finset (Finset G))}
    (hR : SeedResolution S R0) : IsRDSQS (blocksOf S) := by
  refine ⟨isSQS_blocksOf h, fun x => ⟨_, isDerivedResolution_affine h hR (AddEquiv.refl G) ?_ x⟩⟩
  intro t ht
  have h1 : relabel (AddEquiv.refl G).toEquiv t = t := by
    ext y
    simp [mem_relabel]
  rw [h1]
  exact ht

end Seed

end Rdsqs.Generic
