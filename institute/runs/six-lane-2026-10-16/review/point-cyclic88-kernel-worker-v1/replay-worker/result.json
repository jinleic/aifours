  "printed_audit_output": "def PC88.IsDesign.{u} : {V : Type u} → Finset (Finset V) → Prop :=\nfun {V} B => (∀ X ∈ B, X.card = 4) ∧ ∀ (x y : V), x ≠ y → ∃! X, X ∈ B ∧ x ∈ X ∧ y ∈ X\ndef PC88.IsParallelClass.{u} : {V : Type u} → Finset (Finset V) → Finset (Finset V) → Prop :=\nfun {V} B P => P ⊆ B ∧ ∀ (x : V), ∃! X, X ∈ P ∧ x ∈ X\ndef PC88.IsResolution.{u} : {V : Type u} → Finset (Finset V) → Finset (Finset (Finset V)) → Prop :=\nfun {V} B R => (∀ P ∈ R, PC88.IsParallelClass B P) ∧ ∀ X ∈ B, ∃! P, P ∈ R ∧ X ∈ P\ndef PC88.blockImage.{u} : {V : Type u} → Equiv.Perm V → Finset V → Finset V :=\nfun {V} σ X => Finset.map (Equiv.toEmbedding σ) X\ndef PC88.IsResolutionAut.{u} : {V : Type u} →\n  [DecidableEq V] → Finset (Finset V) → Finset (Finset (Finset V)) → Equiv.Perm V → Prop :=\nfun {V} [DecidableEq V] B R σ =>\n  Finset.image (PC88.blockImage σ) B = B ∧ ∀ P ∈ R, Finset.image (PC88.blockImage σ) P ∈ R\ndef PC88.IsFullCycle.{u} : {V : Type u} → [DecidableEq V] → [Fintype V] → Equiv.Perm V → Prop :=\nfun {V} [DecidableEq V] [Fintype V] σ => σ.IsCycle ∧ σ.support = Finset.univ\ndef PC88.IsPointCyclicResolution.{u} : {V : Type u} →\n  [DecidableEq V] → [Fintype V] → Finset (Finset V) → Finset (Finset (Finset V)) → Prop :=\nfun {V} [DecidableEq V] [Fintype V] B R =>\n  PC88.IsDesign B ∧ PC88.IsResolution B R ∧ ∃ σ, PC88.IsFullCycle σ ∧ PC88.IsResolutionAut B R σ\ndef PC88.Target.{u} : Prop :=\n∀ (V : Type u) [inst : Fintype V] [inst_1 : DecidableEq V],\n  Fintype.card V = 88 → ∀ (B : Finset (Finset V)) (R : Finset (Finset (Finset V))), ¬PC88.IsPointCyclicResolution B R\ndef PC88.CanonicalTarget : Prop :=\n∀ (B : Finset (Finset (ZMod 88))) (R : Finset (Finset (Finset (ZMod 88)))),\n  PC88.IsDesign B → PC88.IsResolution B R → ¬PC88.IsResolutionAut B R (Equiv.addRight 1)\ndef Equiv.Perm.IsCycle.{u_2} : {α : Type u_2} → Equiv.Perm α → Prop :=\nfun {α} f => ∃ x, f x ≠ x ∧ ∀ ⦃y : α⦄, f y ≠ y → f.SameCycle x y\ndef Equiv.Perm.SameCycle.{u_2} : {α : Type u_2} → Equiv.Perm α → α → α