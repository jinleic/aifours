+def stability_window():
+    """Main's long-job rule: 300 s of statvfs readings every 30 s, all >= 13.5e9 B, no earlier-to-later drop > 300 MB.
+    Stops early (not ok) on a low reading, a signal or the deadline."""
+    t0, readings, why = time.monotonic(), [], None
+    while True:
+        readings.append({"t": round(time.monotonic() - t0, 1), "at": K.now(), "free_bytes": K.free_bytes()})
+        if readings[-1]["free_bytes"] < STABILITY["min_free"]:
+            why = "reading below %d" % STABILITY["min_free"]
+            break
+        if STATE["signals"] or not deadline_ok():
+            why = "signal or deadline"
+            break
+        if time.monotonic() - t0 >= STABILITY["window_seconds"]:
+            break
+        time.sleep(STABILITY["every_seconds"])
+    vals = [r["free_bytes"] for r in readings]
+    max_drop = max([0] + [vals[i] - vals[j] for i in range(len(vals)) for j in range(i + 1, len(vals))])
+    if why is None and max_drop > STABILITY["max_drop"]:
+        why = "drop %d above %d" % (max_drop, STABILITY["max_drop"])
+    if why is None and readings[-1]["t"] < STABILITY["window_seconds"]:
+        why = "window shorter than %d s" % STABILITY["window_seconds"]
+    return {"ok": why is None, "why": why, "rule": STABILITY, "readings": readings, "max_drop": max_drop}
+
