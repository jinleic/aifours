import PC100Kernel.Data100

/-!
# A point-cyclic resolution of a 2-(100,4,1) design: kernel-checked existence

`cert100` comes from `PC100Kernel.Data100`, generated by `gen_lean.py` from the raw certificate
`certs/v100/pc100_t2.cert` of the lane (SHA-256
`971f722460020f5a572b4f17f1cffe249488b8de079badbfa0184b9a79b4f7c1`; `cert100` is the file verbatim,
grouped by class index), which `code/pc_expand.py` expanded from the compact seed
`certs/v100/pc100_t2.seed` (SHA-256 `ac727835e2f15075e0697206d81482b634ed76c5f7ff000adc58bef43b256245`).

Every `decide +kernel` below is evaluated by the Lean kernel (no `native_decide`, no
`Lean.ofReduceBool`).  The semantic conclusions come from the data-independent theorem
`sound_of_check` (`PC100Kernel.Check`) and the cycle lemmas `isFullCycle_shift`,
`cycleType_shift` (via Mathlib's `finRotate`); the target notions are defined in `PC100Kernel.Target`.
-/

namespace PC100.Kernel

/-- Shape of the raw data: 33 classes of 25 blocks each, 825 blocks in all. -/
theorem cert100_shape :
    cert100.length = 33 ∧ (∀ c ∈ cert100, c.length = 25) ∧ cert100.flatten.length = 825 := by
  decide +kernel

/-- Every listed block is `a < b < c < d < 100`: no reduction modulo 100 happens. -/
theorem cert100_range :
    ∀ e ∈ cert100.flatten, e.1 < e.2.1 ∧ e.2.1 < e.2.2.1 ∧ e.2.2.1 < e.2.2.2 ∧ e.2.2.2 < 100 := by
  decide +kernel

/-- One kernel evaluation of the certificate checker. -/
theorem cert100_check : certCheck 100 cert100 = true := by
  decide +kernel

/-- The explicit block set: the 825 blocks listed in the raw certificate. -/
def pc100Blocks : Finset (Finset (Fin 100)) := blocks 100 cert100

/-- The explicit resolution: the 33 classes listed in the raw certificate. -/
def pc100Classes : Finset (Finset (Finset (Fin 100))) := classes 100 cert100

theorem pc100Blocks_spec (X : Finset (Fin 100)) :
    X ∈ pc100Blocks ↔ ∃ e ∈ cert100.flatten, blk 100 e = X :=
  mem_blocks

theorem pc100Classes_spec (P : Finset (Finset (Fin 100))) :
    P ∈ pc100Classes ↔ ∃ c ∈ cert100, classOf 100 c = P :=
  mem_classes

/-- The certificate's block set is a 2-(100,4,1) design. -/
theorem isDesign241_pc100 : IsDesign241 pc100Blocks :=
  (sound_of_check cert100_check).1

/-- The certificate's classes form a resolution of it. -/
theorem isResolution_pc100 : IsResolution pc100Blocks pc100Classes :=
  (sound_of_check cert100_check).2.1

/-- `x ↦ x + 1` maps the block set onto itself and every class onto a class. -/
theorem shift_pc100 : IsResolutionAutomorphism pc100Blocks pc100Classes (shift 100) :=
  (sound_of_check cert100_check).2.2.1

/-- `x ↦ x + 1` permutes the 100 points in one cycle. -/
theorem isFullCycle_shift100 : IsFullCycle (shift 100) :=
  isFullCycle_shift 98

/-- The cycle type of `x ↦ x + 1` on `Fin 100` is `{100}`: one cycle of length 100. -/
theorem cycleType_shift100 : (shift 100).cycleType = {100} :=
  cycleType_shift 98

/-- 825 blocks, 33 classes, 25 blocks in every class. -/
theorem counts_pc100 : pc100Blocks.card = 825 ∧ pc100Classes.card = 33 ∧
    ∀ P ∈ pc100Classes, P.card = 25 := by
  obtain ⟨-, -, -, hb, hr, hp⟩ := sound_of_check cert100_check
  obtain ⟨hlen, hcl, hflat⟩ := cert100_shape
  refine ⟨?_, ?_, ?_⟩
  · rw [pc100Blocks, hb, hflat]
  · rw [pc100Classes, hr, hlen]
  · intro P hP
    obtain ⟨c, hc, rfl⟩ := mem_classes.mp hP
    rw [hp c hc, hcl c hc]

/-- **A point-cyclic resolution of a 2-(100,4,1) design exists** (on the point set `Fin 100`). -/
theorem exists_pc100 : Target 100 :=
  ⟨pc100Blocks, isDesign241_pc100, pc100Classes, isResolution_pc100, shift 100,
    isFullCycle_shift100, shift_pc100⟩

/-- The same with the automorphism named: `x ↦ x + 1` is one 100-cycle and preserves the design and
the resolution. -/
theorem exists_pc100_shift : TargetShift 100 :=
  ⟨isFullCycle_shift100, pc100Blocks, pc100Classes, isDesign241_pc100, isResolution_pc100,
    shift_pc100⟩

/-- The shift-preserved resolved design with all counts written out. -/
theorem counts_pc100_target : TargetCounts 100 := by
  obtain ⟨hb, hr, hp⟩ := counts_pc100
  refine ⟨pc100Blocks, pc100Classes, isDesign241_pc100, isResolution_pc100, shift_pc100, ?_, ?_, ?_⟩
  · rw [hb]
  · rw [hr]
  · intro P hP
    rw [hp P hP]

end PC100.Kernel
