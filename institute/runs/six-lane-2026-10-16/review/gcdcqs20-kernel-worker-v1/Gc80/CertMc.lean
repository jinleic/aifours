/-- The explicit block set: the raw block lines. -/
def mcdsqs80 : Finset (Finset (Fin 80)) := blockSet 80 blocksMc80

/-- The explicit colouring at `x`: the classes of the raw `POINT x` section. -/
def colouringMc80 (x : Fin 80) : Finset (Finset (Finset (Fin 80))) :=
  classSet 80 (colourMc80.getD x.val [])

theorem mcdsqs80_spec (X : Finset (Fin 80)) : X ∈ mcdsqs80 ↔ ∃ b ∈ blocksMc80, quad 80 b = X :=
  mem_blockSet

theorem mc_quadOK : ∀ b ∈ blocksMc80, quadOK 80 b = true :=
  (blockCheck_sound mc_blocks).1

/-- The 20540 raw block lines name 20540 distinct 4-subsets. -/
theorem card_mcdsqs80 : mcdsqs80.card = 20540 :=
  (blockCheck_sound mc_blocks).2

theorem mc_point_spec (x : Fin 80) :
    IsColouring (derivedBlocks mcdsqs80 x) (colouringMc80 x) ∧ (colouringMc80 x).card = 40 ∧
      (derivedBlocks mcdsqs80 x).card = 1027 ∧
      ∀ P : Finset (Fin 80), P.card = 2 → x ∉ P →
        ∃! T, T ∈ derivedBlocks mcdsqs80 x ∧ P ⊆ T := by
  have h := pointCheck_sound mc_quadOK x.isLt (mc_points x.val x.isLt)
  rw [pt_val_self] at h
  obtain ⟨h1, h2, h3, h4, -⟩ := h
  refine ⟨h1, h2, h3, fun P hP hxP => h4 P hP hxP ?_⟩
  obtain ⟨y, hy⟩ := Finset.card_pos.mp (by omega : 0 < P.card)
  exact ⟨y, hy, rfl⟩

/-- The explicit block set is an SQS on `Fin 80`. -/
theorem isSQS_mcdsqs80 : IsSQS mcdsqs80 := by
  refine isSQS_of_derived (fun X hX => ?_) fun x => (mc_point_spec x).2.2.2
  obtain ⟨b, hb, rfl⟩ := mem_blockSet.mp hX
  exact quad_card (mc_quadOK b hb)

/-- **Every explicit colouring.**  At every point `x`, the classes of the raw `POINT x` section
form a 40-colouring of the derived design (1027 triples). -/
theorem colouringMc80_spec (x : Fin 80) :
    IsColouring (derivedBlocks mcdsqs80 x) (colouringMc80 x) ∧ (colouringMc80 x).card = 40 :=
  ⟨(mc_point_spec x).1, (mc_point_spec x).2.1⟩

/-- An SQS on `Fin 80` whose derived design at every point has a 40-colouring. -/
theorem coloured80 : TargetColoured 80 40 :=
  ⟨mcdsqs80, isSQS_mcdsqs80, fun x => ⟨colouringMc80 x, colouringMc80_spec x⟩⟩

/-- One kernel evaluation of the coloured-STS checker on the raw `POINT 79` section, read on
`Fin 79` (its numbers are `0, ..., 78`). -/
theorem mc79_stsCheck : stsColCheck 79 colMc80_79 = true := by
  decide +kernel

/-- The raw `POINT 79` section has 40 classes. -/
theorem mc79_length : colMc80_79.length = 40 := by
  decide +kernel

/-- An STS on `Fin 79` with a 40-colouring: the triples and classes of the raw `POINT 79` section
of the mcDSQS(80) certificate, read on `Fin 79`. -/
theorem sts79_witness : ∃ S : Finset (Finset (Fin 79)), IsSTS S ∧
    ∃ C : Finset (Finset (Finset (Fin 79))), IsColouring S C ∧ C.card = 40 := by
  obtain ⟨h1, h2, h3⟩ := sts_of_check mc79_stsCheck
  exact ⟨_, h1, _, h2, h3.trans mc79_length⟩

/-- **χ′(79) = 40**: the lower bound over all colourings of all STS on 79 points, and the
witness. -/
theorem chiPrime_79 : chiPrime 79 = 40 :=
  chiPrime_eq_of colourLowerBound_79 sts79_witness

/-- **The explicit block set is an mcDSQS(80).** -/
theorem isMcDSQS_mcdsqs80 : IsMcDSQS mcdsqs80 :=
  ⟨isSQS_mcdsqs80, fun x =>
    ⟨colouringMc80 x, (colouringMc80_spec x).1, (colouringMc80_spec x).2.trans chiPrime_79.symm⟩⟩

/-- **An mcDSQS(80) exists** (on the point set `Fin 80`). -/
theorem exists_mcdsqs80 : TargetMc 80 :=
  ⟨mcdsqs80, isMcDSQS_mcdsqs80⟩

