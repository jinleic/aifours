/-!
# gcDCQS(20^4 : 0): kernel-checked existence for certificate A

`groupsGc80`, `blocksGc80`, `colGc80_x` and `colourGc80` come from `Gc80.DataGc*`, generated by
`gen_lean80.py` from the raw certificate `review/gcdcqs20-parent-inputs-v1/gcdcqs20-e1s1_p10.txt`
(SHA-256 `58b51b50b5281df613c5fae0a3b0178a374554a2f062e55bd8fc25250922a0ca`): the GROUPS and
BLOCKS sections and every `POINT x` section, verbatim.  No symmetry of the certificate is used:
every block and every colour class at every point is checked.

Kernel evaluations (`decide +kernel`): `gc_blocks` (`blockCheck`), `gcPt_0`, ..., `gcPt_79`
(`gcPointCheck` at every point, `Gc80.CertGcPts*`), `gc_groups_raw` (the raw GROUPS lines are
`{20 i, ..., 20 i + 19}`) and `card_grp80`.  The semantic conclusions come from the
data-independent theorems `blockCheck_sound`, `gcPointCheck_sound` (`Gc80.Check80`),
`isCQS0_of_derived`, `isHoleSTS_of_derived` (`Gc80.Derived`), and `chiPrime_79`
(`Gc80.CertMc`: the lower bound over ALL STS(79) and the mcDSQS(80) witness); the target notions
are defined in `Gc80.GcTarget` and `McdKernel.Target`.
-/

namespace Mcd.Kernel

/-- One kernel evaluation of the block-list checker: 19400 raw blocks `a < b < c < d < 80`, with
strictly increasing codes. -/
theorem gc_blocks : blockCheck 80 19400 blocksGc80 = true := by
  decide +kernel

/-- The raw GROUPS lines are `[20 i, ..., 20 i + 19]`, `i = 0, 1, 2, 3`. -/
theorem gc_groups_raw : groupsGc80 = (List.range 4).map fun i => List.range' (20 * i) 20 := by
  decide +kernel

/-- The target groups are the raw GROUPS lines. -/
theorem grp80_eq_raw {i : ℕ} (hi : i < 4) (y : Fin 80) :
    y ∈ grp80 i ↔ y.val ∈ groupsGc80.getD i [] := by
  rw [gc_groups_raw, mem_grp80, List.getD_eq_getElem?_getD, List.getElem?_map,
    List.getElem?_range hi]
  simp only [Option.map_some, Option.getD_some, List.mem_range'_1]

