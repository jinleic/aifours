/-- The explicit block set: the raw block lines. -/
def gcdcqs80 : Finset (Finset (Fin 80)) := blockSet 80 blocksGc80

/-- The explicit colouring at `x`: the classes of the raw `POINT x` section. -/
def colouringGc80 (x : Fin 80) : Finset (Finset (Finset (Fin 80))) :=
  classSet 80 (colourGc80.getD x.val [])

theorem gcdcqs80_spec (X : Finset (Fin 80)) : X ∈ gcdcqs80 ↔ ∃ b ∈ blocksGc80, quad 80 b = X :=
  mem_blockSet

theorem gc_quadOK : ∀ b ∈ blocksGc80, quadOK 80 b = true :=
  (blockCheck_sound gc_blocks).1

/-- The 19400 raw block lines name 19400 distinct 4-subsets. -/
theorem card_gcdcqs80 : gcdcqs80.card = 19400 :=
  (blockCheck_sound gc_blocks).2

/-- The hole at `x`, `G(x) \ {x}`, is the set named by `groupHole 20 x`. -/
theorem mem_hole80 (x y : Fin 80) :
    y ∈ (grp80 (x.val / 20)).erase x ↔ groupHole 20 x.val y.val = true := by
  rw [Finset.mem_erase, mem_grp80]
  simp only [groupHole, Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true',
    decide_eq_false_iff_not, ne_eq, Fin.ext_iff]
  omega

theorem gc_point_spec (x : Fin 80) :
    IsColouring (derivedBlocks gcdcqs80 x) (colouringGc80 x) ∧ (colouringGc80 x).card = 40 ∧
      (derivedBlocks gcdcqs80 x).card = 970 ∧
      (∀ P : Finset (Fin 80), P.card = 2 → x ∉ P → (∃ y ∈ P, groupHole 20 x.val y.val = false) →
        ∃! T, T ∈ derivedBlocks gcdcqs80 x ∧ P ⊆ T) ∧
      (∀ P : Finset (Fin 80), P.card = 2 → (∀ y ∈ P, groupHole 20 x.val y.val = true) →
        ∀ T ∈ derivedBlocks gcdcqs80 x, ¬ P ⊆ T) ∧
      ((colouringGc80 x).filter fun P => ∀ T ∈ P, Disjoint T ((grp80 (x.val / 20)).erase x)).card =
        10 := by
  have h := gcPointCheck_sound gc_quadOK x.isLt (gc_points x.val x.isLt) (mem_hole80 x)
  rw [pt_val_self] at h
  exact h

/-- At `x`: every 2-subset avoiding `x` and not inside the group of `x` lies in exactly one
derived block. -/
theorem gc_cov (x : Fin 80) (P : Finset (Fin 80)) (hP : P.card = 2) (hxP : x ∉ P)
    (hPG : ¬ P ⊆ grp80 (x.val / 20)) : ∃! T, T ∈ derivedBlocks gcdcqs80 x ∧ P ⊆ T := by
  refine (gc_point_spec x).2.2.2.1 P hP hxP ?_
  by_contra hcon
  refine hPG fun y hy => Finset.mem_of_mem_erase ((mem_hole80 x y).mpr ?_)
  cases h : groupHole 20 x.val y.val
  · exact absurd ⟨y, hy, h⟩ hcon
  · rfl

/-- At `x`: no 2-subset of `G(x) \ {x}` lies in any derived block. -/
theorem gc_hole (x : Fin 80) (P : Finset (Fin 80)) (hP : P.card = 2)
    (hPH : P ⊆ (grp80 (x.val / 20)).erase x) : ∀ T ∈ derivedBlocks gcdcqs80 x, ¬ P ⊆ T :=
  (gc_point_spec x).2.2.2.2.1 P hP fun y hy => (mem_hole80 x y).mp (hPH hy)

theorem gc_card4 : ∀ X ∈ gcdcqs80, X.card = 4 := by
  intro X hX
  obtain ⟨b, hb, rfl⟩ := mem_blockSet.mp hX
  exact quad_card (gc_quadOK b hb)

/-- The explicit block set is a CQS(20^4 : 0) with the groups `groups80`. -/
theorem isCQS0_gcdcqs80 : IsCQS0 groups80 gcdcqs80 :=
  isCQS0_of_derived (fun x => grp80 (x.val / 20)) isGroupPartition_groups80
    (fun _ hG _ hx => eq_grp80_of_mem hG hx) gc_card4 gc_cov gc_hole

/-- At every point the derived design is an STS(79, 19) with hole `G(x) \ {x}`. -/
theorem isHoleSTS_gc80 (x : Fin 80) :
    IsHoleSTS (Finset.univ.erase x) ((grp80 (x.val / 20)).erase x) (derivedBlocks gcdcqs80 x) :=
  isHoleSTS_of_derived gc_card4 (gc_cov x) (gc_hole x)

/-- Every group has 20 points. -/
theorem card_grp80 {i : ℕ} (hi : i < 4) : (grp80 i).card = 20 := by
  rcases (by omega : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3) with rfl | rfl | rfl | rfl <;> decide +kernel

theorem card_univ_erase80 (x : Fin 80) : (Finset.univ.erase x).card = 79 := by
  rw [Finset.card_erase_of_mem (Finset.mem_univ x), Finset.card_univ, Fintype.card_fin]

theorem card_hole80 (x : Fin 80) : ((grp80 (x.val / 20)).erase x).card = 19 := by
  rw [Finset.card_erase_of_mem (mem_grp80_self x), card_grp80 (by omega)]

/-- **Every explicit colouring.**  At every point `x`, the classes of the raw `POINT x` section
form a colouring of the derived design (970 triples) with 40 classes, exactly 10 of which avoid
`G(x) \ {x}`. -/
theorem colouringGc80_spec (x : Fin 80) :
    IsColouring (derivedBlocks gcdcqs80 x) (colouringGc80 x) ∧ (colouringGc80 x).card = 40 ∧
      ((colouringGc80 x).filter fun P => ∀ T ∈ P, Disjoint T ((grp80 (x.val / 20)).erase x)).card =
        10 :=
  ⟨(gc_point_spec x).1, (gc_point_spec x).2.1, (gc_point_spec x).2.2.2.2.2⟩

/-- At every point the derived design is a gcSTS(79, 19), with `r = χ′(79)` and
`s = χ′(79) - (79 - 19) / 2`. -/
theorem isGcSTS_gc80 (x : Fin 80) :
    IsGcSTS (Finset.univ.erase x) ((grp80 (x.val / 20)).erase x) (derivedBlocks gcdcqs80 x) := by
  refine ⟨isHoleSTS_gc80 x, colouringGc80 x, (colouringGc80_spec x).1, ?_, ?_⟩
  · rw [card_univ_erase80, chiPrime_79]
    exact (colouringGc80_spec x).2.1
  · rw [card_univ_erase80, card_hole80, chiPrime_79]
    exact (colouringGc80_spec x).2.2

/-- **The explicit block set is a gcDCQS(20^4 : 0).** -/
theorem isGcDCQS0_gcdcqs80 : IsGcDCQS0 groups80 gcdcqs80 :=
  ⟨isCQS0_gcdcqs80, fun G hG x hx => by
    rw [eq_grp80_of_mem hG hx]
    exact isGcSTS_gc80 x⟩

/-- **A gcDCQS(20^4 : 0) exists** (on `Fin 80`, groups `groups80`, empty stem). -/
theorem exists_gcdcqs80 : TargetGc80 :=
  ⟨gcdcqs80, isGcDCQS0_gcdcqs80⟩

/-- With the counts: 19400 blocks, and 970 derived blocks at every point. -/
theorem gc80_with_counts : ∃ A : Finset (Finset (Fin 80)), IsGcDCQS0 groups80 A ∧
    A.card = 19400 ∧ ∀ x : Fin 80, (derivedBlocks A x).card = 970 :=
  ⟨gcdcqs80, isGcDCQS0_gcdcqs80, card_gcdcqs80, fun x => (gc_point_spec x).2.2.1⟩

end Mcd.Kernel
