theorem cpcw122k6_oneMore_impossible : ¬ ∃ B : Fin 5 → Fin 6 → Fin 122, Cpcw.IsCPCW B :=
  Cpcw.not_exists_of_bound_lt (by decide) (by decide)

/-- Changed target: no perfect `(122, 6, 1)` code (every nonzero residue exactly once). -/
theorem cpcw122k6_perfect_impossible : ¬ ∃ m : ℕ, ∃ B : Fin m → Fin 6 → Fin 122,
    (∀ e : Fin 122, e.val ≠ 0 → (Cpcw.diffs B).count e = 1) ∧
      (∀ e : Fin 122, e.val = 0 → (Cpcw.diffs B).count e = 0) := by
  rintro ⟨m, B, h1, h0⟩
  have h := Cpcw.card_mul_eq_of_perfect h1 h0
  omega

