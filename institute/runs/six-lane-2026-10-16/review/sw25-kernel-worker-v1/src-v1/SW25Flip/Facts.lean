import SW25.Data
import SW25Flip.Data

/-!
# Negative control: the sign-flipped fixture violates the exact Gram property

`SW25Flip.W` (module `SW25Flip.Data`, generated by `gen_lean.py --write flip` from the same raw
witness) is checked here, by kernel reduction, to be the witness `SW25.W` with exactly the
symmetric pair of entries (0, 2), (2, 0) negated.  The mutation keeps the alphabet, symmetry and
every diagonal Gram entry (row weight 16), but the exact Gram statement used in
`SW25.exists_symmetric_weighing_matrix` (third conjunct, `SW25.W_gram`) is false for it.
This module must build; the expected-failure twin `SW25Flip.GramFails` must not.
-/

namespace SW25Flip

/-- The fixture is the witness with exactly the symmetric pair (0, 2), (2, 0) negated. -/
theorem W_eq_flip : ∀ i j : Fin 25,
    W i j = if (i.val = 0 ∧ j.val = 2) ∨ (i.val = 2 ∧ j.val = 0) then -SW25.W i j else SW25.W i j := by
  decide +kernel

/-- The flipped entries are nonzero in the witness, so the fixture really differs from it. -/
theorem flipped_entries : SW25.W 0 2 = 1 ∧ SW25.W 2 0 = 1 ∧ W 0 2 = -1 ∧ W 2 0 = -1 := by
  decide +kernel

/-- The fixture keeps the alphabet. -/
theorem W_entries : ∀ i j : Fin 25, W i j = -1 ∨ W i j = 0 ∨ W i j = 1 := by decide +kernel

/-- The fixture keeps symmetry. -/
theorem W_symm : ∀ i j : Fin 25, W i j = W j i := by decide +kernel

/-- The fixture keeps every diagonal Gram entry (row weight) at 16. -/
theorem W_gram_diag : ∀ i : Fin 25, ((List.finRange 25).map (fun k => W i k * W i k)).sum = 16 := by
  decide +kernel

/-- The exact Gram statement of the root is FALSE for the fixture (kernel-checked negation). -/
theorem not_W_gram : ¬ ∀ i j : Fin 25,
    ((List.finRange 25).map (fun k => W i k * W j k)).sum = if i = j then 16 else 0 := by
  decide +kernel

/-- The first violation in lexicographic order: rows 0 and 2 now have inner product -4. -/
theorem W_gram_0_2 : ((List.finRange 25).map (fun k => W 0 k * W 2 k)).sum = -4 := by decide +kernel

/-- Exactly 58 ordered pairs `(i, j)` violate the Gram statement for the fixture. -/
theorem gram_violations :
    ((List.finRange 25).flatMap (fun i => (List.finRange 25).filter (fun j =>
      ((List.finRange 25).map (fun k => W i k * W j k)).sum != if i = j then 16 else 0))).length = 58 := by
  decide +kernel

end SW25Flip

#print axioms SW25Flip.W_eq_flip
#print axioms SW25Flip.not_W_gram
#print axioms SW25Flip.gram_violations
