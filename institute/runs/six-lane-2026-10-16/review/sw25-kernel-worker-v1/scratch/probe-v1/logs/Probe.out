theorem Probe.exists_swm : ∃ W,
  (∀ (i j : Fin 4), W i j = -1 ∨ W i j = 0 ∨ W i j = 1) ∧
    (∀ (i j : Fin 4), W i j = W j i) ∧
      ∀ (i j : Fin 4), (List.map (fun k => W i k * W j k) (List.finRange 4)).sum = if i = j then 2 else 0 :=
Exists.intro Probe.W ⟨Probe.W_entries, ⟨Probe.W_symm, Probe.W_gram⟩⟩
'Probe.exists_swm' depends on axioms: [propext]
'Probe.not_Wf_gram' depends on axioms: [propext]
'Probe.W_table' depends on axioms: [propext]
'Probe.fin25' depends on axioms: [propext]
