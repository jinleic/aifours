+def _sticky(recon, pending):
+    """V2: every pid-only unknown, enumerated defensively from the raw reconciliation, independent of other checks."""
+    details = ['%s pid=%r' % (row['kind'], row['pid']) for row in pending]
+    coverage = recon['coverage_history']
+    _require(type(coverage) is list, 'coverage history not enumerable: unknowns cannot be excluded')
+    for entry in coverage:
+        observation = entry.get('observation') if type(entry) is dict else None
+        _require(type(observation) is list and len(observation) == 3,
+                 'coverage entry not enumerable: unknowns cannot be excluded')
+        details.append('coverage:%r pid=%r' % (observation[1], observation[0]))
+    helpers = recon['helpers']
+    _require(type(helpers) is list, 'helper reports not enumerable: unknowns cannot be excluded')
+    for report in helpers:
+        _require(type(report) is dict and 'identity' in report, 'helper report not enumerable')
+        if report['identity'] is None:
+            details.append('helper_without_identity pid=%r' % (report.get('pid'),))
+    main = recon['main_wait']
+    if main is not None and recon['main_identity'] is None:
+        details.append('main_child_without_identity pid=%r' % (main.get('pid') if type(main) is dict else None,))
+    return details
+
