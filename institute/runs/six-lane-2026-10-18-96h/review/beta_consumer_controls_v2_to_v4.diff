+def _escalates(error, primary):
+    """A cleanup failure never replaces an in-flight non-Exception BaseException primary.
+
+    With no primary every cleanup failure may propagate; with an ordinary-Exception
+    primary only a newly arising non-Exception BaseException escalates over it.
+    """
+    if primary is None:
+        return True
+    return isinstance(primary, Exception) and not isinstance(error, Exception)
+
