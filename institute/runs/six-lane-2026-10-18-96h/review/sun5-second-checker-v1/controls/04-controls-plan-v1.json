 "acceptance_rule_per_control": [
  "status and exit_code equal the expected values",
  "file_reasons: every expected prefix matches exactly one observed file reason and no other file reason occurs",
  "failed records: set of FAILED line numbers equals the expected keys; for each, the observed reason set equals the expected set exactly",
  "all other records are VERIFIED except exactly the expected WRITTEN_SD lines; UNVERIFIED = 0 (except I02/I03/I07)",
  "coverage.missing and coverage.overlap_events equal the expected values",
  "COMPLETE.json exists, binds RESULT.json and records.tsv sha256, pass_valid true only for P0/P1/P2/P3/I06"
 ],
 "settlement": "Any control whose observation differs from this frozen expectation is a CONTROL_DISCREPANCY: the P0 result may not be promoted until the parent reviews it; no re-freezing of expectations after observation. S15/S16 expectations are hand-derived (assignment witnesses given in notes); a discrepancy there is reviewed as such, never silently re-labelled.",
 "not_controls": "No incidental wiring/default/source-text tests. Controls are full-input fixtures exercising one intended reason each (or the stated coupled set where a structural edit necessarily also removes an orbit)."
}
