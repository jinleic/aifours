+            _require(id(node) not in seen, 'identities cycle/shared container')
+            seen.add(id(node))
+            _require(len(node) <= MAX_ROWS, 'identities container count')
+            cost += 2 * len(node) + 2
+            if kind is dict:
+                for key, child in node.items():
+                    _require(type(key) is str and len(key) <= 64, 'identity key must be exact string')
+                    cost += 6 * len(key) + 4
+                    stack.append((child, depth + 1))
+            else:
