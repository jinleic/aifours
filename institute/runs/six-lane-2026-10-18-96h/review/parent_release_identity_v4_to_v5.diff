+def _identities_copy(value):
+    """Exact JSON type preflight BEFORE any foreign dict-key hash/equality. Bounded detach eliminates live aliases.
+    Acyclic/shared-container-free, strings<=4096, int64 range, no float/subclasses, <=128MiB representation."""
+    stack, seen, nodes, cost = [(value, 0)], set(), 0, 0
+    while stack:
+        node, depth = stack.pop()
+        nodes += 1
+        _require(nodes <= MAX_IDENTITY_NODES and depth <= 16 and cost <= 128 << 20, 'identities cap')
+        kind = type(node)
