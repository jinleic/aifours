{
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "outcome": {
   "type": "string",
   "enum": [
    "solved",
    "refuted",
    "partial",
    "no-progress"
   ]
  },
  "summary": {
   "type": "string"
  },
  "claims": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "cid": {
      "type": "string"
     },
     "statement": {
      "type": "string"
     },
     "type": {
      "type": "string",
      "enum": [
       "theorem",
       "counterexample",
       "computation",
       "negative-result",
       "evidence"
      ]
     },
     "scope": {
      "type": "string",
      "enum": [
       "headline",
       "sub-question",
       "related"
      ]
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "verify_command": {
      "type": "string",
      "description": "reproduces the claim from this directory, or empty for a pure proof"
     },
     "check_command": {
      "type": "string",
      "description": "an independent check that does not import the producing code, or empty"
     },
     "control_command": {
      "type": "string",
      "description": "a negative control that must FAIL (exit nonzero), or empty"
     }
    },
    "required": [
     "cid",
     "statement",
     "type",
     "scope",
     "evidence",
     "verify_command",
     "check_command",
     "control_command"
    ]
   }
  },
  "next_step": {
   "type": "string"
  }
 },
 "required": [
  "outcome",
  "summary",
  "claims",
  "next_step"
 ]
}
