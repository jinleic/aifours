    29	def main():
    30	    geometry_count = identity_count = selection_count = 0
    31	    grid = [Q(i, 2) for i in range(-8, 9)]
    32	    for a, b in product(grid, repeat=2):
    33	        optimum_t, optimum_v = abs(a), abs(a)-abs(b)
    34	        target = (abs(a)+abs(b))/2
    35	        assert geometry(a, b, optimum_t, optimum_v) == target
    36	        for t, v in product(grid, repeat=2):
    37	            value = geometry(a, b, t, v)
    38	            assert value >= target
    39	            if value == target:
    40	                assert (t, v) == (optimum_t, optimum_v)
    41	            geometry_count += 1
    42	    for d, linear, error in product((Q(1, 10), Q(1, 100)), grid, (-1, 1)):
    43	        assert abs(d*linear) < 1
    44	        observed = loss(error+d*linear)-loss(Q(error))
    45	        predicted = 10*error*d*linear+(d*positive(linear) if error == 1 else 0)
    46	        assert observed == predicted
    47	        identity_count += 1
    48	    limit_counts = {-1: 0, 0: 0, 1: 0}
    49	    for a, b, ap, bp in product((-1, 1), repeat=4):
    50	        s1 = a if a == ap else 0
    51	        s2 = b if b == bp else 0
    52	        v = abs(s1)-abs(s2)
    53	        limit_counts[v] += 1
    54	        for e, ep, candidate in product((a, b), (ap, bp), grid):
    55	            optimum = e if e == ep else 0
    56	            optimum_value = loss(e-optimum)+loss(ep-optimum)+Q(1, 10)*abs(optimum)
    57	            value = loss(e-candidate)+loss(ep-candidate)+Q(1, 10)*abs(candidate)
    58	            assert value >= optimum_value
    59	            if value == optimum_value:
    60	                assert candidate == optimum
    61	            selection_count += 1
    62	    assert limit_counts == {-1: 4, 0: 8, 1: 4}
    63	    packing = []
    64	    for j in range(1, 7):
    65	        occupied, chosen = set(), []
    66	        powers = [4**k for k in range(1, j+1)]
    67	        for n in range(4**j, 4**(j+1)):
    68	            locations = {n+k for k in powers}
    69	            if locations.isdisjoint(occupied):
    70	                chosen.append(n)
    71	                occupied.update(locations)
    72	        denominator = j*(j-1)+1
    73	        assert len(chosen)*denominator >= 3*4**j
    74	        assert len(occupied) == j*len(chosen)
    75	        packing.append({"j": j, "selected_windows": len(chosen),
    76	                        "lower_bound": str(Q(3*4**j, denominator)),
    77	                        "distinct_error_indices": len(occupied)})
    78	    for e, ep in product((Q(-1, 4), Q(1, 4)), repeat=2):
    79	        lower, upper = max(2*(e-1), 2*(ep-1)), min(2*(e+1), 2*(ep+1))
    80	        assert lower <= Q(-3, 2) < 0 < Q(3, 2) <= upper
    81	    # Independent 2x2 calculation: two close quadratic minima can pool far away.
    82	    quadratic = []
    83	    for delta in (Q(1, 2), Q(1, 10), Q(1, 100)):
    84	        determinant = delta**4
    85	        y = delta**2/(delta**2+delta**4)
    86	        assert determinant > 0
    87	        assert y == 1/(1+delta**2)
    88	        quadratic.append({"half_minimizer_norm": str(delta),
    89	                          "pooled_minimizer_norm": str(y),
    90	                          "half_hessian_determinant": str(determinant)})
    91	    result = {"verdict": "PASS", "scope": "finite exact arithmetic, not an asymptotic proof",
    92	              "geometry_grid_checks": geometry_count,
    93	              "local_loss_identity_checks": identity_count,
    94	              "pooled_coordinate_grid_checks": selection_count,
    95	              "rademacher_limit_counts_out_of_16": limit_counts,
    96	              "disjoint_window_packings": packing,
    97	              "generic_convexity_counterexample": quadratic,
    98	              "script_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}
    99	    (ROOT/'evidence/exact-checks.json').write_text(json.dumps(result, indent=2)+'\n')

