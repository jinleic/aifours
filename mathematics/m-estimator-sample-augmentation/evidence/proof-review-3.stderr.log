    28	def fit_triangle(m, high_errors, positive_counts):
    29	    """Full finite-sample rho objective, aggregated by identical row/error.
    30	
    31	    Each low epigraph variable is divided by d, an exact conditioning change.
    32	    Its right side retains ALL three rho pieces, not only the local limit.
    33	    """
    34	    d = .2 / m
    35	    entries = []
    36	    for errors in high_errors:
    37	        for coordinate, error in enumerate(errors):
    38	            row = np.zeros(4)
    39	            row[coordinate] = 1
    40	            entries.append((row, int(error), 1., 1.))
    41	    copies = len(high_errors)
    42	    for r, form in enumerate(FORMS):
    43	        plus = int(positive_counts[r])
    44	        for error, count in ((1, plus), (-1, copies * m - plus)):
    45	            if count:
    46	                entries.append((-d * form, error, float(count), d))
    47	    width = 4 + len(entries)
    48	    cost = np.zeros(width)
    49	    rows, rhs = [], []
    50	    for index, (design, error, count, scale) in enumerate(entries):
    51	        cost[4 + index] = count * scale
    52	        for slope, intercept in ((-10., 0.), (10., 0.), (11., -1.)):
    53	            row = np.zeros(width)
    54	            row[:4] = -slope * design / scale
    55	            row[4 + index] = -1
    56	            rows.append(row)
    57	            rhs.append((-slope * error - intercept + rho(error)) / scale)
    58	    matrix, bound = np.array(rows), np.array(rhs)
    59	    result = linprog(cost, A_ub=matrix, b_ub=bound, bounds=[(None, None)] * width,
    60	                     method="highs-ds", options={"threads": 1,
    61	                         "primal_feasibility_tolerance": 1e-8,
    62	                         "dual_feasibility_tolerance": 1e-8})
    63	    if not result.success:
    64	        raise RuntimeError(result.message)
    65	    primal = max(0., float(np.max(matrix @ result.x - bound)))
    66	    dual = result.ineqlin.marginals
    67	    stationarity = float(np.max(np.abs(matrix.T @ dual - cost)))
    68	    dual_sign = max(0., float(np.max(dual)))
    69	    gap = abs(float(cost @ result.x - bound @ dual))
    70	    if max(primal, stationarity, dual_sign, gap) > 1e-6:
    71	        raise AssertionError((primal, stationarity, dual_sign, gap))
    72	    return result.x[:4], max(primal, stationarity, dual_sign, gap)
