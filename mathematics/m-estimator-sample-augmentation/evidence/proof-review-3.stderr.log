   102	def sliding_path(last_block=9):
   103	    last_index = 4 ** (last_block+1)
   104	    eps = RNG.choice(np.array([-1, 1], dtype=np.int8), size=2*last_index+1)
   105	    records = []
   106	    for j in range(1, last_block+1):
   107	        powers = 4 ** np.arange(1, j+1, dtype=np.int64)
   108	        first = float(np.mean(eps[powers]))
   109	        n_values = np.arange(4**j, 4**(j+1), dtype=np.int64)
   110	        sums = np.zeros(len(n_values), dtype=np.int16)
   111	        for index in powers:
   112	            sums += eps[n_values+index]
   113	        minimum, maximum = int(sums.min()), int(sums.max())
   114	        records.append({"j": j, "n_range": [int(n_values[0]), int(n_values[-1])],
   115	            "prefix_estimate": first, "second_block_min": minimum/j,
   116	            "second_block_max": maximum/j,
   117	            "pooled_min": (first+minimum/j)/2,
   118	            "pooled_max": (first+maximum/j)/2,
   119	            "all_plus_windows": int(np.sum(sums == j)),
   120	            "all_minus_windows": int(np.sum(sums == -j))})
   121	    return records
