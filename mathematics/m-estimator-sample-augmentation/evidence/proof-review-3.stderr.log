   124	def pointwise_trials(trials=20000):
   125	    records = []
   126	    for j in (4, 16, 64, 256):
   127	        first = (2*RNG.binomial(j, .5, trials)-j)/j
   128	        second = (2*RNG.binomial(j, .5, trials)-j)/j
   129	        pooled = (first+second)/2
   130	        records.append({"informative_rows": j, "trials": trials,
   131	            "prefix_mse": float(np.mean(first**2)),
   132	            "pooled_mse": float(np.mean(pooled**2)),
   133	            "theory_prefix_mse": 1/j, "theory_pooled_mse": 1/(2*j)})
   134	    return records
