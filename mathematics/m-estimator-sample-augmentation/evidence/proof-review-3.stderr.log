    19	RNG = np.random.default_rng(SEED)
    20	FORMS = np.array([[2, 0, -2, 0], [-2, 0, -2, 0], [0, 2, -2, 2],
    21	                  [0, -2, -2, 2], [0, 0, .5, 0], [0, 0, .5, -.5]], dtype=float)
