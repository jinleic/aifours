    75	def triangular_trials(trials=200):
    76	    records = []
    77	    for m in (30, 1000, 30000, 1000000):
    78	        errors = []
    79	        original_bad = pooled_bad = asymptotic_bad = 0
    80	        max_residual = 0.
    81	        for _ in range(trials):
    82	            high = RNG.choice([-1, 1], size=(2, 2))
    83	            counts = RNG.binomial(m, .5, size=(2, 6))
    84	            original, residual = fit_triangle(m, high[:1], counts[0])
    85	            pooled, residual2 = fit_triangle(m, high, counts.sum(axis=0))
    86	            max_residual = max(max_residual, residual, residual2)
    87	            s = np.where(high[0] == high[1], high[0], 0)
    88	            predicted_v = abs(s[0]) - abs(s[1])
    89	            original_bad += abs(original[3]) > .5
    90	            pooled_bad += abs(pooled[3]) > .5
    91	            asymptotic_bad += abs(predicted_v) > .5
    92	            errors.append(abs(pooled[3] - predicted_v))
    93	        records.append({"m": m, "n": 6*m+2, "trials": trials,
    94	            "original_v_bad_fraction": original_bad/trials,
    95	            "pooled_v_bad_fraction": pooled_bad/trials,
    96	            "same_draw_limit_bad_fraction": asymptotic_bad/trials,
    97	            "pooled_v_mean_error_to_limit": float(np.mean(errors)),
    98	            "max_lp_primal_dual_residual": max_residual})
    99	    return records
