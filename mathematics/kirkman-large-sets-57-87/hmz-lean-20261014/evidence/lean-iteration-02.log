          (∀ (g : G) (b : Kirkman.Sized v 3), key ((Kirkman.renameSized (act g) 3) b) = key b) →
            (∀ (b c : Kirkman.Triple v), key b = key c → ∃ g, (Kirkman.renameSized (act g) 3) b = c) →
              (∀ (b : Kirkman.Sized v 3) (g h : G),
