              (Eq.refl j))
          (Eq.symm h) hi ho)
      (Eq.refl i);
  ⟨Eq.mpr
      (id
        (congrFun'
          (congrArg Eq (Eq.trans Fintype.card_sum (congrArg (HAdd.hAdd (Fintype.card F)) (Fintype.card_prod A G))))
          (v - 2)))
      hcount,
    ⟨fun i =>
      Sum.casesOn (motive := fun t => i = t → Kirkman.IsKTS (Kirkman.developed act fixed base i)) i
        (fun f h => Eq.symm h ▸ hfixed f)
        (fun ag h => Eq.symm h ▸ Kirkman.isKTS_image (act ag.2) (base ag.1) (hbase ag.1)) (Eq.refl i),
      ⟨fun ⦃i j⦄ hij => Set.disjoint_left.mpr fun ⦃b⦄ hi hj => hij (index_unique i j b hi hj),
        Set.eq_univ_of_forall fun b =>
          Exists.casesOn (howners (key b)) fun i h =>
            And.casesOn h fun hi right =>
              Sum.casesOn (motive := fun t => i = t → b ∈ ⋃ i, Kirkman.developed act fixed base i) i
                (fun f h =>
                  Eq.ndrec (motive := fun i =>
                    key b ∈ Kirkman.ownerOrbits key fixed base i →
                      (∀ (y : F ⊕ A), (fun i => key b ∈ Kirkman.ownerOrbits key fixed base i) y → y = i) →
                        b ∈ ⋃ i, Kirkman.developed act fixed base i)
                    (fun hi right =>
                      Exists.casesOn hi fun c h =>
                        And.casesOn h fun hc hcb =>
                          Exists.casesOn (hfiber c b hcb) fun g hg =>
                            Set.mem_iUnion.mpr (Exists.intro (Sum.inl f) (hg ▸ hinvariant f g c hc)))
                    (Eq.symm h) hi right)
                (fun a h =>
                  Eq.ndrec (motive := fun i =>
                    key b ∈ Kirkman.ownerOrbits key fixed base i →
                      (∀ (y : F ⊕ A), (fun i => key b ∈ Kirkman.ownerOrbits key fixed base i) y → y = i) →
