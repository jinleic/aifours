theorem Kirkman.development_sound : ∀ {v : ℕ} {F A G Ω : Type} [inst : Fintype F] [inst_1 : Fintype A]
  [inst_2 : Fintype G] (act : G → Equiv.Perm (Fin v)) (key : Kirkman.Triple v → Ω) (fixed : F → Kirkman.Blocks v)
  (base : A → Kirkman.Blocks v),
  Fintype.card F + Fintype.card A * Fintype.card G = v - 2 →
    (∀ (f : F), Kirkman.IsKTS (fixed f)) →
      (∀ (a : A), Kirkman.IsKTS (base a)) →
