theorem Kirkman.mem_renameSized : ∀ {v k : ℕ} (e : Equiv.Perm (Fin v)) (b : Kirkman.Sized v k) (x : Fin v),
  x ∈ ↑((Kirkman.renameSized e k) b) ↔ (Equiv.symm e) x ∈ ↑b :=
fun {v k} e b x => Finset.mem_map_equiv
