                                                  (Eq.symm (hkey g' d))))
                                              (Eq.mpr
                                                (id
                                                  (congrArg
                                                    (fun _a => key _a = key ((Kirkman.renameSized (act g') 3) d)) hcb))
                                                (Eq.mpr (id (congrArg (fun _a => key b = key _a) hdb))
