                                              key c = key d → Sum.inr (a, g) = Sum.inr (a, g'))
                                          (fun hd hdb hk =>
                                            have hg := hfree c g g' (Eq.trans hcb (Eq.symm hdb));
                                            Eq.ndrec (motive := fun g' =>
                                              Sum.elim Sum.inl (fun ag => Sum.inr ag.1) (Sum.inr (a, g)) =
                                                  Sum.elim Sum.inl (fun ag => Sum.inr ag.1) (Sum.inr (a, g')) →
                                                c ∈ base (a, g').1 →
                                                  (Kirkman.renameSized (act (a, g').2) 3) c = b →
                                                    Sum.inr (a, g) = Sum.inr (a, g'))
