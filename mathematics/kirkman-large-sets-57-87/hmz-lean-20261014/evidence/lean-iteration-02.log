theorem Kirkman.pair_subset_rename_iff : ∀ {v : ℕ} (e : Equiv.Perm (Fin v)) (p : Kirkman.Pair v) (b : Kirkman.Triple v),
  ↑p ⊆ ↑((Kirkman.renameSized e 3) b) ↔ ↑((Kirkman.renameSized (Equiv.symm e) 2) p) ⊆ ↑b :=
fun {v} e p b => Iff.symm Finset.map_symm_subset
'Kirkman.pair_subset_rename_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem Kirkman.isSTS_image : ∀ {v : ℕ} (e : Equiv.Perm (Fin v)) (B : Kirkman.Blocks v),
  Kirkman.IsSTS B → Kirkman.IsSTS (Kirkman.imageBlocks e B) :=
fun {v} e B h p =>
  Exists.casesOn (h ((Kirkman.renameSized (Equiv.symm e) 2) p)) fun b h =>
    And.casesOn h fun hb hu =>
      Exists.intro ((Kirkman.renameSized e 3) b)
        ⟨⟨Exists.intro b ⟨hb.left, rfl⟩, (Kirkman.pair_subset_rename_iff e p b).mpr hb.right⟩, fun c hc =>
          Exists.casesOn hc.left fun d h =>
            And.casesOn h fun hd right =>
              Eq.ndrec (motive := fun c => c ∈ Kirkman.imageBlocks e B ∧ ↑p ⊆ ↑c → c = (Kirkman.renameSized e 3) b)
                (fun hc =>
                  congrArg (⇑(Kirkman.renameSized e 3)) (hu d ⟨hd, (Kirkman.pair_subset_rename_iff e p d).mp hc.right⟩))
                right hc⟩
'Kirkman.isSTS_image' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem Kirkman.parallel_image : ∀ {v : ℕ} (e : Equiv.Perm (Fin v)) (P : Kirkman.Blocks v),
  Kirkman.IsParallelClass P → Kirkman.IsParallelClass (Kirkman.imageBlocks e P) :=
fun {v} e P h x =>
  Exists.casesOn (h ((Equiv.symm e) x)) fun b h =>
    And.casesOn h fun hb hu =>
      Exists.intro ((Kirkman.renameSized e 3) b)
        ⟨⟨Exists.intro b ⟨hb.left, rfl⟩, (Kirkman.mem_renameSized e b x).mpr hb.right⟩, fun c hc =>
          Exists.casesOn hc.left fun d h =>
            And.casesOn h fun hd right =>
              Eq.ndrec (motive := fun c => c ∈ Kirkman.imageBlocks e P ∧ x ∈ ↑c → c = (Kirkman.renameSized e 3) b)
                (fun hc =>
                  congrArg (⇑(Kirkman.renameSized e 3)) (hu d ⟨hd, (Kirkman.mem_renameSized e d x).mp hc.right⟩))
                right hc⟩
'Kirkman.parallel_image' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem Kirkman.resolution_image : ∀ {v : ℕ} (e : Equiv.Perm (Fin v)) (B : Kirkman.Blocks v)
  (R : Fin ((v - 1) / 2) → Kirkman.Blocks v),
  Kirkman.IsResolution B R → Kirkman.IsResolution (Kirkman.imageBlocks e B) fun c => Kirkman.imageBlocks e (R c) :=
fun {v} e B R h =>
  ⟨fun c => Kirkman.parallel_image e (R c) (h.left c),
    ⟨fun ⦃c d⦄ hcd =>
      Set.disjoint_left.mpr fun ⦃b⦄ a =>
        Exists.casesOn a fun x h_1 =>
          And.casesOn h_1 fun hx hxb a =>
            Exists.casesOn a fun y h_2 =>
              And.casesOn h_2 fun hy hyb =>
                have heq := Equiv.injective (Kirkman.renameSized e 3) (Eq.trans hxb (Eq.symm hyb));
                Eq.ndrec (motive := fun y => y ∈ R d → (Kirkman.renameSized e 3) y = b → False)
                  (fun hy hyb => Set.disjoint_left.mp (h.right.left hcd) hx hy) heq hy hyb,
      Set.ext fun b =>
        Eq.mpr (id (congrFun' (congrArg Iff Kirkman.resolution_image._simp_1_1) (b ∈ Kirkman.imageBlocks e B)))
          {
            mp := fun a =>
              Exists.casesOn a fun c h_1 =>
                Exists.casesOn h_1 fun x h_2 =>
                  And.casesOn h_2 fun hx hxb =>
                    Exists.intro x
                      ⟨Eq.mpr (id (congrArg (fun _a => x ∈ _a) (Eq.symm h.right.right)))
                          (Set.mem_iUnion.mpr (Exists.intro c hx)),
                        hxb⟩,
            mpr := fun a =>
              Exists.casesOn a fun x h_1 =>
                And.casesOn h_1 fun hx hxb =>
                  Exists.casesOn (Set.mem_iUnion.mp (Eq.mp (congrArg (fun _a => x ∈ _a) (Eq.symm h.right.right)) hx))
                    fun c hc => Exists.intro c (Exists.intro x ⟨hc, hxb⟩) }⟩⟩
'Kirkman.resolution_image' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem Kirkman.isKTS_image : ∀ {v : ℕ} (e : Equiv.Perm (Fin v)) (B : Kirkman.Blocks v),
  Kirkman.IsKTS B → Kirkman.IsKTS (Kirkman.imageBlocks e B) :=
fun {v} e B h =>
  Exists.casesOn h.right fun R hR =>
    ⟨Kirkman.isSTS_image e B h.left,
      Exists.intro (fun c => Kirkman.imageBlocks e (R c)) (Kirkman.resolution_image e B R hR)⟩
