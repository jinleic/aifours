theorem Kirkman.sts_pair_unique : ∀ {v : ℕ} (B : Kirkman.Blocks v),
  Kirkman.IsSTS B → ∀ (p : Kirkman.Pair v) (b c : Kirkman.Triple v), b ∈ B → c ∈ B → ↑p ⊆ ↑b → ↑p ⊆ ↑c → b = c :=
fun {v} B h p b c hb hc hpb hpc =>
  Exists.casesOn (h p) fun d h => And.casesOn h fun left hu => Eq.trans (hu b ⟨hb, hpb⟩) (Eq.symm (hu c ⟨hc, hpc⟩))
