          (fun hb => Exists.intro b ⟨hb, rfl⟩) (Eq.symm h) hb)
      (fun ag h =>
        Eq.ndrec (motive := fun i =>
          b ∈ Kirkman.developed act fixed base i →
            key b ∈ Kirkman.ownerOrbits key fixed base (Sum.elim Sum.inl (fun ag => Sum.inr ag.1) i))
          (fun hb =>
            Exists.casesOn hb fun c h =>
              And.casesOn h fun hc right => right ▸ Exists.intro c ⟨hc, Eq.symm (hkey ag.2 c)⟩)
          (Eq.symm h) hb)
      (Eq.refl i);
  have index_unique := fun i j b hi hj =>
    have ho :=
      own_unique (key b) (Sum.elim Sum.inl (fun ag => Sum.inr ag.1) i) (Sum.elim Sum.inl (fun ag => Sum.inr ag.1) j)
        (owner_of i b hi) (owner_of j b hj);
    Sum.casesOn (motive := fun t => i = t → i = j) i
      (fun f h =>
        Eq.ndrec (motive := fun i =>
          b ∈ Kirkman.developed act fixed base i →
            Sum.elim Sum.inl (fun ag => Sum.inr ag.1) i = Sum.elim Sum.inl (fun ag => Sum.inr ag.1) j → i = j)
          (fun hi ho =>
            Sum.casesOn (motive := fun t => j = t → Sum.inl f = j) j
              (fun f' h =>
                Eq.ndrec (motive := fun j =>
                  b ∈ Kirkman.developed act fixed base j →
                    Sum.elim Sum.inl (fun ag => Sum.inr ag.1) (Sum.inl f) =
                        Sum.elim Sum.inl (fun ag => Sum.inr ag.1) j →
                      Sum.inl f = j)
                  (fun hj ho => congrArg Sum.inl (Sum.inl.inj ho)) (Eq.symm h) hj ho)
              (fun ag h =>
                Eq.ndrec (motive := fun j =>
                  b ∈ Kirkman.developed act fixed base j →
                    Sum.elim Sum.inl (fun ag => Sum.inr ag.1) (Sum.inl f) =
                        Sum.elim Sum.inl (fun ag => Sum.inr ag.1) j →
                      Sum.inl f = j)
