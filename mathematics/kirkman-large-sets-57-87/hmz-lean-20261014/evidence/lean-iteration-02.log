                      Exists.casesOn hi fun c h =>
                        And.casesOn h fun hc hcb =>
                          Exists.casesOn (hfiber c b hcb) fun g hg =>
                            Set.mem_iUnion.mpr (Exists.intro (Sum.inr (a, g)) (Exists.intro c ⟨hc, hg⟩)))
                    (Eq.symm h) hi right)
                (Eq.refl i)⟩⟩⟩
