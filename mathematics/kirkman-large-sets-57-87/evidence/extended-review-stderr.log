   260	def resolve(v,blocks,matchings,seconds,threads,seed):
   261	    n = v-2
   262	    classes = (v-1)//2
   263	    anchors = {0:(0,n,n+1)}
   264	    for x,y in matchings[0]:
   265	        anchors[min((y-x)%n,(x-y)%n)] = tuple(sorted((x,y,n)))
   266	    reverse_anchor = {b:c for c,b in anchors.items()}
   267	    model = cp_model.CpModel()
   268	    columns = defaultdict(list)
   269	    variables = []
   270	    order = list(enumerate(blocks))
   271	    random.Random(seed).shuffle(order)
   272	    for bi,b in order:
   273	        allowed = [reverse_anchor[b]] if b in reverse_anchor else range(classes)
   274	        for c in allowed:
   275	            if b not in reverse_anchor and set(b).intersection(anchors[c]):
   276	                continue
   277	            var = model.new_bool_var(f"b{bi}c{c}")
   278	            variables.append((var,bi,c))
   279	            columns[("block",bi)].append(var)
   280	            for x in b:
   281	                columns[("point",c,x)].append(var)
   282	    for bi in range(len(blocks)):
   283	        model.add_exactly_one(columns[("block",bi)])
   284	    for c in range(classes):
   285	        for x in range(v):
   286	            model.add_exactly_one(columns[("point",c,x)])
   287	    solver,status,info = cp_solve(model,seconds,threads,seed)
   288	    if status not in (cp_model.OPTIMAL,cp_model.FEASIBLE):
   289	        return None,info
   290	    base = [[] for _ in range(classes)]
   291	    for var,bi,c in variables:
   292	        if solver.value(var):
   293	            base[c].append(blocks[bi])
   294	    return base,info
