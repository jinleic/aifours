   253	def validate_base(v,blocks):
   254	    pairs = Counter(p for b in blocks for p in itertools.combinations(sorted(b),2))
   255	    assert len(blocks) == v*(v-1)//6
   256	    assert pairs == Counter(itertools.combinations(range(v),2))
   257	    assert len({orbit_key(b,v-2) for b in blocks}) == len(blocks)
