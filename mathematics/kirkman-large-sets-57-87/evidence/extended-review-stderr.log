    31	    image = {tuple(sorted(multiplier*x % n if x < n else
    32	                          (2*n+1-x if swap_infinities else x) for x in b)) for b in blocks}
    33	    expected = v*(v-1)//6
    34	    if len(blocks) != expected or len(set(blocks)) != expected:
    35	        raise ValueError("wrong base block count")
    36	    if set(pairs) != set(itertools.combinations(range(v), 2)) or set(pairs.values()) != {1}:
    37	        raise ValueError("base does not cover every pair exactly once")
    38	    if len(set(keys)) != expected:
    39	        raise ValueError("base is not a translation-orbit transversal")
    40	    if image != set(blocks):
