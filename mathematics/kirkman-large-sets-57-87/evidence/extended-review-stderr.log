    49	def digest(path):
    50	    h = hashlib.sha256()
    51	    with Path(path).open("rb") as stream:
    52	        for block in iter(lambda: stream.read(1 << 20), b""):
    53	            h.update(block)
    54	    return h.hexdigest()
