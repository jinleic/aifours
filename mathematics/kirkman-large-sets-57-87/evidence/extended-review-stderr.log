    82	def check_kts(classes):
    83	    assert len(classes) == CLASSES
    84	    pairs = set()
    85	    blocks = set()
    86	    for parallel in classes:
    87	        assert len(parallel) == 19
    88	        assert sorted(point for block in parallel for point in block) == list(range(V))
    89	        for block in parallel:
    90	            assert len(set(block)) == 3 and block not in blocks
    91	            blocks.add(block)
    92	            for pair in itertools.combinations(sorted(block), 2):
    93	                assert pair not in pairs
    94	                pairs.add(pair)
    95	    assert pairs == set(itertools.combinations(range(V), 2)) and len(blocks) == 532
    96	    return blocks
