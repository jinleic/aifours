   169	def extract_fixed(solver, rows, data):
   170	    starter, seeds, orbit_ids = [], [], []
   171	    for index, selected in enumerate(solver.response_proto.solution):
   172	        if not selected:
   173	            continue
   174	        oid, shift = rows[index]
   175	        orbit_ids.append(oid)
   176	        key = data["triple_orbits"][oid]["representative"]
   177	        (seeds if shift == -1 else starter).append(key if shift == -1 else translate(key, shift))
   178	    assert len(starter) == 19 and len(seeds) == 9 and len(set(orbit_ids)) == 28
   179	    return {"starter_class": sorted(starter), "fixed_class_seeds": sorted(seeds),
   180	            "orbit_ids": sorted(orbit_ids)}
