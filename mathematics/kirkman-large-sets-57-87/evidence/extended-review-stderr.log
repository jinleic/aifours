   117	def solve(model, seconds, threads, seed, log_path, cp_model):
   118	    solver = cp_model.CpSolver()
   119	    solver.parameters.max_time_in_seconds = max(0.001, seconds)
   120	    solver.parameters.num_search_workers = threads
   121	    solver.parameters.random_seed = seed
   122	    solver.parameters.log_search_progress = True
   123	    solver.parameters.log_to_stdout = False
   124	    config = str(solver.parameters)
   125	    with Path(log_path).open("w") as log:
   126	        solver.log_callback = lambda text: log.write(text + "\n")
   127	        status = solver.solve(model)
   128	    summary = {"status": solver.status_name(status), "solver_wall_seconds": solver.wall_time,
   129	               "wall_limit_seconds": seconds, "threads": threads, "seed": seed,
   130	               "parameters": config, "branches": solver.num_branches,
   131	               "conflicts": solver.num_conflicts, "log_path": str(log_path)}
   132	    return solver, status, summary
