   183	def completion_model(data, remaining, bases, cp_model):
   184	    model = cp_model.CpModel()
   185	    pair_ids = {pair: index for index, pair in enumerate(itertools.combinations(range(V), 2))}
   186	    pair_columns = [[[] for _ in pair_ids] for _ in range(bases)]
   187	    point_columns = [[[[] for _ in range(V)] for _ in range(CLASSES)] for _ in range(bases)]
   188	    class_minima = [[[] for _ in range(CLASSES)] for _ in range(bases)]
   189	    first_partners = [[] for _ in range(bases)]
   190	    rows = array("I")
   191	    blocks = []
   192	    for oid in sorted(remaining):
   193	        orbit_vars = []
   194	        for shift in range(N):
   195	            block = translate(data["triple_orbits"][oid]["representative"], shift)
   196	            bid = len(blocks)
   197	            blocks.append(block)
   198	            pair_indices = [pair_ids[pair] for pair in itertools.combinations(block, 2)]
   199	            if block[0] == 0:
   200	                # Classes sorted by the least nonzero point in their 0-block.
   201	                # Its c-th value lies in [c+1,2c+1], by the perfect matching.
   202	                least = block[1]
   203	                allowed_classes = range((least - 1 + 1) // 2, min(least - 1, CLASSES - 1) + 1)
   204	            else:
   205	                allowed_classes = range(CLASSES)
   206	            for base in range(bases):
   207	                for c in allowed_classes:
   208	                    var = model.new_bool_var("")
   209	                    rows.append((bid * bases + base) * CLASSES + c)
   210	                    orbit_vars.append(var)
   211	                    for point in block:
   212	                        point_columns[base][c][point].append(var)
   213	                    for pair in pair_indices:
   214	                        pair_columns[base][pair].append(var)
   215	                    if block[0] == 0:
   216	                        class_minima[base][c].append((block[1], var))
   217	                        if block[1] == 1:
   218	                            first_partners[base].append((block[2], var))
   219	        # Exactly one block from this orbit over all bases, not one per base.
   220	        model.add_exactly_one(orbit_vars)
   221	    for base in range(bases):
   222	        for column in pair_columns[base]:
   223	            model.add_exactly_one(column)
   224	        for parallel in point_columns[base]:
   225	            for column in parallel:
   226	                model.add_exactly_one(column)
   227	        minima = [sum(weight * var for weight, var in values) for values in class_minima[base]]
   228	        for c in range(CLASSES - 1):
   229	            model.add(minima[c] < minima[c + 1])
   230	    if bases == 2:
   231	        # The two base systems are interchangeable; their 0,1-completions differ.
   232	        model.add(sum(weight * var for weight, var in first_partners[0]) <
   233	                  sum(weight * var for weight, var in first_partners[1]))
   234	    return model, rows, blocks
   235	
   236	
   237	def extract_bases(solver, rows, blocks, bases):
   238	    result = [[[] for _ in range(CLASSES)] for _ in range(bases)]
   239	    for index, selected in enumerate(solver.response_proto.solution):
   240	        if selected:
   241	            quotient, c = divmod(rows[index], CLASSES)
   242	            bid, base = divmod(quotient, bases)
   243	            result[base][c].append(blocks[bid])
   244	    for classes in result:
   245	        check_kts(classes)
   246	    return result
