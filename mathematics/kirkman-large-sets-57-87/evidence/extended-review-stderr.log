   135	def fixed_model(data, forbidden, aaa_count, cp_model):
   136	    model = cp_model.CpModel()
   137	    points = [[] for _ in range(V)]
   138	    pairs = [[] for _ in range(84)]
   139	    aaa = []
   140	    rows = []
   141	    for oid, record in enumerate(data["triple_orbits"]):
   142	        if oid in forbidden or not record["fixed_admissible"]:
   143	            continue
   144	        if aaa_count == 4 and record["type"] == "ABC":
   145	            shifts = ()  # z=2u-8=0, so these can only seed fixed classes.
   146	        else:
   147	            shifts = range(N)
   148	        for shift in shifts:
   149	            block = translate(record["representative"], shift)
   150	            var = model.new_bool_var("")
   151	            rows.append((oid, shift))
   152	            for point in block:
   153	                points[point].append(var)
   154	            for pair in record["pair_orbits"]:
   155	                pairs[pair].append(var)
   156	            if record["type"] == "AAA":
   157	                aaa.append(var)
   158	        if record["type"] == "ABC":
   159	            var = model.new_bool_var("")
   160	            rows.append((oid, -1))
   161	            for pair in record["pair_orbits"]:
   162	                pairs[pair].append(var)
   163	    for column in points + pairs:
   164	        model.add_exactly_one(column)
   165	    model.add(sum(aaa) == aaa_count)
   166	    return model, rows
