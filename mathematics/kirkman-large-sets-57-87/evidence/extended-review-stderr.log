    44	def resolution_model(blocks, v, cp_model):
    45	    model = cp_model.CpModel()
    46	    count = (v-1)//2
    47	    colors = [model.new_int_var(0, count-1, f"c{i}") for i in range(len(blocks))]
    48	    incident = [[] for _ in range(v)]
    49	    for i, block in enumerate(blocks):
    50	        for x in block:
    51	            incident[x].append(colors[i])
    52	    for variables in incident:
    53	        model.add_all_different(variables)
    54	    # A point's incident blocks use all colors. Label them in sorted block order.
    55	    for c, variable in enumerate(incident[0]):
    56	        model.add(variable == c)
    57	    return model, colors
