     1	#!/usr/bin/env python3
     2	"""Independent, standard-library-only checker for an explicit LKTS certificate.
     3	
     4	Text format: LKTS <v>; KTS <id>; CLASS <id>; then one line per triple.
     5	Ids are zero-based, consecutive. Blank lines and # comments are ignored.
     6	Every point is an integer in range(v); no automorphism assumptions are used.
     7	"""
     8	import argparse
     9	import hashlib
    10	import itertools
    11	import json
    12	import math
    13	from pathlib import Path
    14	import sys
    15	
    16	
    17	def parse_certificate(path):
    18	    v = None
    19	    systems = []
    20	    for lineno, raw in enumerate(Path(path).read_text().splitlines(), 1):
    21	        line = raw.partition("#")[0].strip()
    22	        if not line:
    23	            continue
    24	        fields = line.split()
    25	        try:
    26	            if fields[0] == "LKTS":
    27	                if len(fields) != 2 or v is not None or systems:
    28	                    raise ValueError("invalid/duplicate LKTS header")
    29	                v = int(fields[1])
    30	            elif fields[0] == "KTS":
    31	                if v is None or len(fields) != 2 or int(fields[1]) != len(systems):
    32	                    raise ValueError("KTS ids must be consecutive starting at zero")
    33	                systems.append([])
    34	            elif fields[0] == "CLASS":
    35	                if not systems or len(fields) != 2 or int(fields[1]) != len(systems[-1]):
    36	                    raise ValueError("CLASS ids must be consecutive within each KTS")
    37	                systems[-1].append([])
    38	            else:
    39	                if not systems or not systems[-1] or len(fields) != 3:
    40	                    raise ValueError("a triple needs three points inside a CLASS")
    41	                systems[-1][-1].append(tuple(map(int, fields)))
    42	        except ValueError as error:
    43	            raise ValueError(f"line {lineno}: {error}") from error
    44	    if v is None:
    45	        raise ValueError("missing LKTS header")
    46	    return v, systems
    47	
    48	
    49	def check(v, systems):
    50	    if type(v) is not int or v < 3 or v % 6 != 3:
    51	        raise ValueError("v must be an integer >=3 congruent to 3 modulo 6")
    52	    if len(systems) != v - 2:
    53	        raise ValueError(f"expected {v - 2} systems, found {len(systems)}")
    54	    points = set(range(v))
    55	    all_pairs = set(itertools.combinations(range(v), 2))
    56	    all_triples = set(itertools.combinations(range(v), 3))
    57	    union = set()
    58	    for si, system in enumerate(systems):
    59	        if len(system) != (v - 1) // 2:
    60	            raise ValueError(f"KTS {si}: wrong number of parallel classes")
    61	        pairs = set()
    62	        blocks = set()
    63	        for ci, parallel in enumerate(system):
    64	            if len(parallel) != v // 3:
    65	                raise ValueError(f"KTS {si} CLASS {ci}: wrong number of blocks")
    66	            used = set()
    67	            for block in parallel:
    68	                if len(block) != 3 or any(type(x) is not int for x in block):
    69	                    raise ValueError(f"KTS {si} CLASS {ci}: malformed triple")
    70	                b = tuple(sorted(block))
    71	                if len(set(b)) != 3 or not set(b) <= points:
    72	                    raise ValueError(f"KTS {si} CLASS {ci}: not a 3-subset of the point set")
    73	                if used.intersection(b):
    74	                    raise ValueError(f"KTS {si} CLASS {ci}: repeated point")
    75	                used.update(b)
    76	                if b in blocks:
    77	                    raise ValueError(f"KTS {si}: repeated block")
    78	                blocks.add(b)
    79	                for pair in itertools.combinations(b, 2):
    80	                    if pair in pairs:
    81	                        raise ValueError(f"KTS {si}: repeated pair {pair}")
    82	                    pairs.add(pair)
    83	            if used != points:
    84	                raise ValueError(f"KTS {si} CLASS {ci}: class is not a partition")
    85	        if pairs != all_pairs or len(blocks) != v * (v - 1) // 6:
    86	            raise ValueError(f"KTS {si}: not a Steiner triple system")
    87	        if union.intersection(blocks):
    88	            raise ValueError(f"KTS {si}: shares a block with an earlier system")
    89	        union.update(blocks)
    90	    if union != all_triples:
    91	        raise ValueError("union is not all triples")
    92	    return {"verdict": "PASS", "v": v, "systems": len(systems),
    93	            "classes_per_system": (v - 1) // 2, "blocks_per_system": v * (v - 1) // 6,
    94	            "total_distinct_blocks": len(union), "expected_total": math.comb(v, 3)}
    95	
    96	
    97	def main():
    98	    parser = argparse.ArgumentParser(description=__doc__)
    99	    parser.add_argument("certificate", type=Path)
   100	    args = parser.parse_args()
   101	    try:
   102	        result = check(*parse_certificate(args.certificate))
   103	    except (ValueError, OSError) as error:
   104	        print(json.dumps({"verdict": "FAIL", "error": str(error)}))
   105	        return 1
   106	    result["certificate_sha256"] = hashlib.sha256(args.certificate.read_bytes()).hexdigest()
   107	    result["checker_sha256"] = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
   108	    print(json.dumps(result, indent=2))
   109	    return 0
   110	
   111	
   112	if __name__ == "__main__":
   113	    sys.exit(main())

