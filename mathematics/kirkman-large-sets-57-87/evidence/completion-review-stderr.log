   330	def load_blocked(manifest, encoding):
   331	    blocked = []
   332	    for item in manifest["blocked_candidates"]:
   333	        assert digest(item["path"]) == item["sha256"]
   334	        candidate = json.loads(Path(item["path"]).read_text())
   335	        selected = candidate["selected_primary_literals"]
   336	        validate_pair_cover(encoding, selected)
   337	        blocked.append(selected)
   338	    return blocked
