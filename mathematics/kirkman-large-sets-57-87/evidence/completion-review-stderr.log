    22	def orbit_key(block, n):
    23	    finite = [x for x in block if x < n]
    24	    fixed = tuple(x for x in block if x >= n)
    25	    return min(tuple(sorted((x - t) % n for x in finite)) + fixed for t in finite)
    26	
