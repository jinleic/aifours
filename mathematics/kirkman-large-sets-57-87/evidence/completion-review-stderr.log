   161	class CNF:
   162	    """Exactly-one: at-least-one plus Sinz sequential at-most-one clauses.
   163	
   164	    For k>3 use prefix auxiliaries s1..s(k-1):
   165	    (-x1,s1); (-xi,si),(-s(i-1),si),(-xi,-s(i-1)); (-xk,-s(k-1)).
   166	    Small k uses pairwise clauses. A fixed-width header permits incremental
   167	    blocking clauses without rewriting or retaining the whole CNF in RAM.
   168	    """
   169	    def __init__(self,path,primary,columns):
   170	        self.path = Path(path)
   171	        self.variables = primary
   172	        self.clauses = 0
   173	        with self.path.open("wb") as stream:
   174	            self.stream = stream
   175	            stream.write(self.header())
   176	            for literals in columns:
   177	                self.add(literals)
   178	                if len(literals) <= 3:
   179	                    for x,y in itertools.combinations(literals,2):
   180	                        self.add((-x,-y))
   181	                else:
   182	                    aux = list(range(self.variables+1,self.variables+len(literals)))
   183	                    self.variables += len(aux)
   184	                    self.add((-literals[0],aux[0]))
   185	                    for i in range(1,len(literals)-1):
   186	                        self.add((-literals[i],aux[i]))
   187	                        self.add((-aux[i-1],aux[i]))
   188	                        self.add((-literals[i],-aux[i-1]))
   189	                    self.add((-literals[-1],-aux[-1]))
   190	            stream.seek(0)
   191	            stream.write(self.header())
   192	        self.stream = None
   193	
   194	    def header(self):
   195	        return f"p cnf {self.variables:014d} {self.clauses:014d}\n".encode()
   196	
   197	    def add(self,literals):
   198	        self.stream.write((" ".join(map(str,literals))+" 0\n").encode())
   199	        self.clauses += 1
   200	
   201	    def block(self,selected):
   202	        with self.path.open("r+b") as stream:
   203	            self.stream = stream
   204	            stream.seek(0,2)
   205	            self.add([-x for x in selected])
   206	            stream.seek(0)
   207	            stream.write(self.header())
   208	        self.stream = None
