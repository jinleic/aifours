   538	def main():
   539	    parser = argparse.ArgumentParser(description=__doc__)
   540	    sub = parser.add_subparsers(dest="operation", required=True)
   541	    run = sub.add_parser("search")
   542	    run.add_argument("--packing", type=Path, required=True)
   543	    run.add_argument("--solver", choices=("kissat", "cadical", "cpsat"), required=True)
   544	    run.add_argument("--config", choices=("default", "sat", "unsat"), default="sat")
   545	    run.add_argument("--cp-encoding", choices=("boolean", "modular"), default="modular")
   546	    run.add_argument("--seconds", type=float, default=7200)
   547	    run.add_argument("--paircover-seconds", type=float, default=7200)
   548	    run.add_argument("--resolution-seconds", type=float, default=300)
   549	    run.add_argument("--threads", type=int, default=1)
   550	    run.add_argument("--seed", type=int, required=True)
   551	    run.add_argument("--stop-file", type=Path)
   552	    run.add_argument("--output", type=Path, required=True)
   553	    again = sub.add_parser("replay")
   554	    again.add_argument("manifest", type=Path)
   555	    again.add_argument("--output", type=Path, required=True)
   556	    args = parser.parse_args()
   557	    if args.operation == "search":
   558	        if not 1 <= args.threads <= 2 or (args.solver != "cpsat" and args.threads != 1):
   559	            parser.error("native runners use one worker; CP-SAT uses one or two")
   560	        if min(args.seconds, args.paircover_seconds, args.resolution_seconds) <= 0:
