   144	def finite_cover(n, matchings, seed):
   145	    forbidden = set(matchings[0]) | set(matchings[1])
   146	    triples = list(itertools.combinations(range(n),3))
   147	    orbit_names = sorted({orbit_key(b,n) for b in triples})
   148	    orbit_ids = {key:i for i,key in enumerate(orbit_names)}
   149	    allowed_pairs = [p for p in itertools.combinations(range(n),2) if p not in forbidden]
   150	    pair_ids = {p:i for i,p in enumerate(allowed_pairs)}
   151	    rows = [b for b in triples if all(p not in forbidden for p in itertools.combinations(b,2))]
   152	    random.Random(seed).shuffle(rows)
   153	    columns = [[] for _ in range(len(allowed_pairs)+len(orbit_names))]
   154	    for row_id,b in enumerate(rows,1):
   155	        for pair in itertools.combinations(b,2):
   156	            columns[pair_ids[pair]].append(row_id)
   157	        columns[len(allowed_pairs)+orbit_ids[orbit_key(b,n)]].append(row_id)
   158	    return rows,columns
