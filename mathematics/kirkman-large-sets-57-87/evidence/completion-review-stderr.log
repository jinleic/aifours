     1	#!/usr/bin/env python3
     2	"""Cyclic LKTS search: a resolved KTS transverse to Z_(v-2) triple orbits.
     3	
     4	Requires ortools. Example (from target dir):
     5	  UV_CACHE_DIR=/tmp/lkts-uv-cache uv run --with ortools python work/search_cyclic.py --v 9 --seconds 120 --threads 4 --output evidence/cyclic9
     6	Point action: translation on 0..v-3, fixing v-2 and v-1.
     7	Each resolution class is canonically labelled by the difference of its infinity-1
     8	block; class 0 contains {0, infinity-1, infinity-2}. This is WLOG.
     9	"""
    10	import argparse
    11	from collections import defaultdict
    12	import hashlib
    13	import itertools
    14	import json
    15	from pathlib import Path
    16	import platform
    17	import subprocess
