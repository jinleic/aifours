     8	from collections import Counter
     9	import hashlib
    10	import itertools
    11	import json
    12	import math
    13	from pathlib import Path
    14	
    15	ap = argparse.ArgumentParser(description=__doc__)
    16	ap.add_argument("certificate",type=Path)
    17	ap.add_argument("--expected-systems",type=int,required=True)
    18	ap.add_argument("--output",type=Path)
    19	args = ap.parse_args()
    20	lines = [line.partition("#")[0].split() for line in args.certificate.read_text().splitlines()]
    21	lines = [row for row in lines if row]
    22	assert len(lines[0]) == 3 and lines[0][0] == "PACKING"
    23	v,k = map(int,lines[0][1:])
    24	assert v>=3 and v%6==3 and 1<=k<=v-2 and k==args.expected_systems
    25	systems = []
    26	for row in lines[1:]:
    27	    if row[0] == "KTS":
    28	        assert len(row)==2 and int(row[1])==len(systems)
    29	        systems.append([])
    30	    elif row[0] == "CLASS":
    31	        assert systems and len(row)==2 and int(row[1])==len(systems[-1])
    32	        systems[-1].append([])
    33	    else:
    34	        assert systems and systems[-1] and len(row)==3
    35	        block = tuple(sorted(map(int,row)))
    36	        assert len(set(block))==3 and 0<=block[0]<block[-1]<v
    37	        systems[-1][-1].append(block)
    38	assert len(systems)==k
    39	all_blocks = Counter()
    40	expected_pairs = Counter(itertools.combinations(range(v),2))
    41	for system in systems:
    42	    assert len(system)==(v-1)//2
    43	    pairs = Counter()
    44	    for parallel in system:
    45	        assert len(parallel)==v//3
    46	        assert Counter(x for block in parallel for x in block)==Counter(range(v))
    47	        for block in parallel:
    48	            pairs.update(itertools.combinations(block,2))
    49	            all_blocks[block] += 1
