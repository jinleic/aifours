    28	def write_certificate(path, v, base):
    29	    n = v - 2
    30	    with Path(path).open("w") as stream:
    31	        stream.write(f"# Developed under Z_{n}; fixed points {n}, {n+1}\nLKTS {v}\n")
    32	        for t in range(n):
    33	            stream.write(f"\nKTS {t}\n")
    34	            for c, parallel in enumerate(base):
    35	                stream.write(f"CLASS {c}\n")
    36	                for block in sorted(parallel):
    37	                    stream.write(" ".join(str((x + t) % n if x < n else x) for x in block) + "\n")
    38	
