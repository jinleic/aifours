    54	          "required_for_full_large_set":v-2,"is_full_large_set":k==v-2,
    55	          "classes_per_system":(v-1)//2,"blocks_per_system":v*(v-1)//6,
    56	          "distinct_blocks":len(all_blocks),"total_possible_triples":math.comb(v,3),
    57	          "certificate_sha256":hashlib.sha256(args.certificate.read_bytes()).hexdigest(),
    58	          "checker_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}
    59	if args.output:
    60	    args.output.write_text(json.dumps(result,indent=2))
    61	print(json.dumps(result,indent=2))
