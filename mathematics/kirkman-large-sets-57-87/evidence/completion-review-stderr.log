   286	    assert len(anchors) == 28
   287	    anchor_class = {block: c for c, block in enumerate(anchors)}
   288	    anchor_points = [set(block) for block in anchors]
   289	    model = cp_model.CpModel()
   290	    rows = []
   291	    block_columns = [[] for _ in blocks]
   292	    point_columns = [[[] for _ in range(57)] for _ in range(28)]
   293	    for bi, block in enumerate(blocks):
   294	        if block in anchor_class:
   295	            allowed = (anchor_class[block],)
   296	        else:
   297	            allowed = [c for c in range(28) if not anchor_points[c].intersection(block)]
   298	        for c in allowed:
   299	            variable = model.new_bool_var(f"b{bi}c{c}")
   300	            rows.append((bi, c))
   301	            block_columns[bi].append(variable)
   302	            for point in block:
   303	                point_columns[c][point].append(variable)
   304	    for column in block_columns:
   305	        model.add_exactly_one(column)
   306	    for parallel in point_columns:
   307	        for column in parallel:
   308	            model.add_exactly_one(column)
   309	    text = str(model.proto).encode()
   310	    model_path = Path(str(prefix) + ".pbtxt")
   311	    model_path.write_bytes(text)
   312	    solver, info = cp_solve(model, seconds, threads, seed, str(prefix) + ".log")
   313	    info.update(instance_sha256=hashlib.sha256(text).hexdigest(), model_path=str(model_path),
   314	                rows=len(rows), symmetry="classes labeled by the 28 blocks through point0; otherwise unrestricted")
   315	    if info["status"] == "MODEL_INVALID":
   316	        raise RuntimeError("invalid unrestricted resolution model")
   317	    if solver is None:
   318	        return None, info
   319	    classes = [[] for _ in range(28)]
   320	    for index, selected in enumerate(solver.response_proto.solution):
   321	        if selected:
   322	            bi, c = rows[index]
   323	            classes[c].append(blocks[bi])
   324	    assert c19.check_kts(classes) == set(blocks)
   325	    save(str(prefix) + ".classes.json", classes)
   326	    info["expanded_KTS_check"] = "PASS"
   327	    return classes, info
