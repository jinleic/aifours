                  have this := Nat.Coprime.pow_right 2 (Nat.coprime_two_right.mpr hodd);
                  this;
                have hmc :=
                  have key := Decidable.byContradiction fun a => exists_unit_eight_mul_eq_four._proof_1_4 m h8 hm hu0 a;
                  have hd1 := Dvd.dvd.mul_left (Nat.gcd_dvd_left ((m + 1) / 2 + m) m) 2;
                  have hd2 := Dvd.dvd.mul_right (Nat.gcd_dvd_right ((m + 1) / 2 + m) m) 3;
