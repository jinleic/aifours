                (Decidable.byContradiction fun a => exists_unit_eight_mul_eq_four._proof_1_1 m h8 hm a));
        have hu0 := Decidable.byContradiction fun a => exists_unit_eight_mul_eq_four._proof_1_2 m h8 hm a;
