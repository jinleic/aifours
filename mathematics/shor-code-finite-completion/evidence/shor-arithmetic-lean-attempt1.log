          (fun he =>
            Exists.intro ((m + 1) / 2 + m)
              ⟨have hodd :=
                  Eq.mpr (id (congrArg (fun _a => _a) (propext Nat.odd_iff)))
                    (Decidable.byContradiction fun a => exists_unit_eight_mul_eq_four._proof_1_3 m h8 hm hu0 he a);
