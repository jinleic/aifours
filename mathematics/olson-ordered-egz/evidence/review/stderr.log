   107	        assert histogram[e] == 0, 'SAT model fails independent raw enumeration'
   108	        assert dp_products(table, e, word, selected) == {g for g, count in enumerate(histogram) if count}
   109	        record.update(sequence=word, raw_subset_count=sum(histogram), product_histogram=histogram)
   110	    return record
