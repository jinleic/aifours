    80	    for t in range(length):
    81	        for k in range(max(0, selected - (length - t)), min(t, selected) + 1):
    82	            for g in range(n):
    83	                previous = r(t, k, g)
    84	                if k >= max(0, selected - (length - t - 1)):
    85	                    solver.add(z3.Implies(previous, r(t + 1, k, g)))
    86	                if k < selected:
    87	                    for a in range(n):
    88	                        solver.add(z3.Implies(z3.And(previous, choice[t][a]),
    89	                                              r(t + 1, k + 1, table[g][a])))
    90	    solver.add(z3.Not(r(length, selected, e)))
    91	    if fixed_word is not None:
    92	        assert len(fixed_word) == length
    93	        for i, a in enumerate(fixed_word):
    94	            solver.add(choice[i][a])
    95	    started = time.monotonic()
