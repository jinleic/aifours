   112	
   113	def main():
   114	    parser = argparse.ArgumentParser()
   115	    parser.add_argument('group', choices=['C3rtC4', 'A4'])
   116	    parser.add_argument('--seconds', type=int, default=180)
   117	    parser.add_argument('--output', required=True, type=Path)
   118	    args = parser.parse_args()
   119	    elements, table, e = semidirect_c3_c4() if args.group == 'C3rtC4' else alternating4()
   120	    check_group(table, e)
   121	    n = len(table)
   122	    controls = []
   123	    if args.group == 'C3rtC4':
   124	        a, b = elements.index((1, 0)), elements.index((0, 1))
   125	        short_word = [a] * (n - 1) + [b] * (n - 1)
