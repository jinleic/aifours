    59	    obtain ⟨u, v, rfl, hu, hv⟩ := List.sublist_append_iff.mp hsub
    60	    obtain ⟨k, hk, rfl⟩ := List.sublist_replicate_iff.mp hu
    61	    obtain ⟨l, hl, rfl⟩ := List.sublist_replicate_iff.mp hv
    62	    simp only [List.length_append, List.length_replicate, DihedralGroup.card] at hlen
    63	    simpa only [List.prod_append, List.prod_replicate] using
    64	      two_block_product_ne_one m hm k l hk hl hlen
