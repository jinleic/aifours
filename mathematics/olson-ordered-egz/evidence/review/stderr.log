     1	#!/usr/bin/env python3
     2	"""Bounded existential ordered-word search, with a monotone Horn encoding.
     3	
     4	The solver carries (prefix, selected length, right-ordered product). It never
     5	permutes selected entries. UNKNOWN is not UNSAT. A model is independently
     6	checked by raw subset enumeration before reporting a counterexample candidate.
     7	"""
     8	import argparse
     9	import hashlib
    10	import itertools
    11	import json
    12	import math
    13	from pathlib import Path
    14	import time
    15	import z3
    16	
    17	
    18	def semidirect_c3_c4():
    19	    elements = list(itertools.product(range(3), range(4)))
    20	    index = {g: i for i, g in enumerate(elements)}
    21	    table = [[index[((a + (-1 if b % 2 else 1) * c) % 3, (b + d) % 4)]
    22	              for c, d in elements] for a, b in elements]
    23	    return elements, table, 0
    24	
    25	
    26	def alternating4():
    27	    def even(p):
    28	        return sum(p[i] > p[j] for i in range(4) for j in range(i + 1, 4)) % 2 == 0
    29	    elements = [p for p in itertools.permutations(range(4)) if even(p)]
    30	    index = {p: i for i, p in enumerate(elements)}
    31	    table = [[index[tuple(a[b[i]] for i in range(4))] for b in elements] for a in elements]
    32	    return elements, table, 0
    33	
    34	
    35	def check_group(table, e):
    36	    n = len(table)
    37	    assert all(len(row) == n and set(row) == set(range(n)) for row in table)
    38	    assert all(table[e][a] == a and table[a][e] == a for a in range(n))
    39	    assert all(any(table[a][b] == e and table[b][a] == e for b in range(n)) for a in range(n))
    40	    assert all(table[table[a][b]][c] == table[a][table[b][c]]
    41	               for a, b, c in itertools.product(range(n), repeat=3))
    42	
    43	
    44	def raw_histogram(table, e, word, selected):
    45	    counts = [0] * len(table)
    46	    for indices in itertools.combinations(range(len(word)), selected):
    47	        product = e
    48	        for i in indices:
    49	            product = table[product][word[i]]
    50	        counts[product] += 1
    51	    assert sum(counts) == math.comb(len(word), selected)
    52	    return counts
    53	
    54	
    55	def dp_products(table, e, word, selected):
    56	    layers = [{e}] + [set() for _ in range(selected)]
    57	    for a in word:
    58	        for k in range(selected, 0, -1):
    59	            layers[k].update(table[g][a] for g in layers[k - 1])
    60	    return layers[selected]
    61	
    62	
    63	def solve(table, e, length, selected, milliseconds, fixed_word=None):
    64	    n = len(table)
    65	    solver = z3.SolverFor('QF_FD')
    66	    solver.set(timeout=milliseconds, max_memory=3072)
    67	    choice = [[z3.Bool(f'x_{i}_{a}') for a in range(n)] for i in range(length)]
    68	    for row in choice:
    69	        solver.add(z3.PbEq([(b, 1) for b in row], 1))
    70	    reach = {}
    71	    def r(t, k, g):
    72	        # States unable to attain the final selected length are irrelevant.
    73	        if k < max(0, selected - (length - t)) or k > min(t, selected):
    74	            return z3.BoolVal(False)
    75	        key = t, k, g
    76	        if key not in reach:
    77	            reach[key] = z3.Bool(f'r_{t}_{k}_{g}')
    78	        return reach[key]
