    98	    record = {'answer': str(answer), 'solver_seconds': elapsed,
    99	              'timeout_ms': milliseconds, 'reachable_variables': len(reach),
   100	              'sequence_length': length, 'selected_length': selected,
   101	              'reason_unknown': solver.reason_unknown() if answer == z3.unknown else None}
