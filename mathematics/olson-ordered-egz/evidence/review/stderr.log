     1	#!/usr/bin/env python3
     2	"""Find obstruction to a sufficient disjoint-identity-interval proof route.
     3	
     4	A length-(2n-1) group word has 2n prefix products. Equal prefix products
     5	bound an identity-product interval. This assay asks whether n colors alone
     6	force disjoint such intervals whose total length is n. A coloring obstruction
     7	refutes only this proof route, not Olson's conjecture.
     8	"""
     9	import argparse
    10	import json
    11	from pathlib import Path
    12	
    13	
    14	def interval_lengths(colors):
    15	    reachable = [{0}] + [set() for _ in colors[1:]]
    16	    for end in range(1, len(colors)):
    17	        reachable[end].update(reachable[end - 1])
    18	        for start in range(end):
    19	            if colors[start] == colors[end]:
    20	                reachable[end].update(length + end - start for length in reachable[start])
    21	    return sorted(reachable[-1])
    22	
    23	
    24	def restricted_growth_words(length, alphabet):
    25	    word = [0] * length
    26	    def visit(index, largest):
    27	        if index == length:
    28	            yield tuple(word)
    29	            return
    30	        for value in range(min(largest + 1, alphabet - 1) + 1):
    31	            word[index] = value
    32	            yield from visit(index + 1, max(largest, value))
    33	    yield from visit(1, 0)
    34	
    35	
    36	def main():
    37	    parser = argparse.ArgumentParser()
    38	    parser.add_argument('--max-order', type=int, default=5)
    39	    parser.add_argument('--output', type=Path, required=True)
    40	    arguments = parser.parse_args()
    41	    records = []
    42	    for n in range(2, arguments.max_order + 1):
    43	        checked = 0
    44	        obstruction = None
    45	        for colors in restricted_growth_words(2 * n, n):
    46	            checked += 1
    47	            reachable = interval_lengths(colors)
    48	            if n not in reachable:
    49	                obstruction = {'prefix_colors': colors, 'attainable_total_interval_lengths': reachable}
    50	                break
    51	        records.append({'n': n, 'canonical_colorings_checked': checked, 'obstruction': obstruction})
    52	        if obstruction:
    53	            break
    54	    result = {'scope': 'Disjoint-contiguous-identity-interval sufficient route only; NOT an Olson counterexample',
    55	              'records': records}
    56	    arguments.output.write_text(json.dumps(result, indent=2) + '\n')
    57	    print(json.dumps(result, indent=2))
    58	
    59	
    60	if __name__ == '__main__':
    61	    main()

