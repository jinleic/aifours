     3	/- A reproduction of the known odd-dihedral lower bound, NOT a refutation
     4	   of Olson's 2|G|-1 conjecture. The word below has length 2|G|-2. -/
     5	namespace OlsonPartial
     6	
     7	open DihedralGroup
     8	
     9	def oddDihedralWord (m : ℕ) : List (DihedralGroup m) :=
    10	  List.replicate (2 * m - 1) (r 1) ++ List.replicate (2 * m - 1) (sr 0)
    11	
    12	private theorem two_block_product_ne_one (m : ℕ) [NeZero m] (hm : Odd m)
    13	    (k l : ℕ) (hk : k ≤ 2 * m - 1) (hl : l ≤ 2 * m - 1)
    14	    (hlen : k + l = 2 * m) :
    15	    (r 1 : DihedralGroup m) ^ k * (sr 0) ^ l ≠ 1 := by
    16	  intro hprod
    17	  have mpos : 0 < m := NeZero.pos m
    18	  have kpos : 0 < k := by omega
    19	  have klimit : k < 2 * m := by omega
    20	  have heven : l % 2 = 0 := by
    21	    by_contra h
    22	    have hmod : l % 2 = 1 := by omega
    23	    have hspow : (sr 0 : DihedralGroup m) ^ l = sr 0 := by
    24	      rw [← pow_mod_orderOf, orderOf_sr, hmod, pow_one]
    25	    simp only [r_one_pow, hspow, r_mul_sr, one_def] at hprod
    26	    cases hprod
    27	  have hspow : (sr 0 : DihedralGroup m) ^ l = 1 := by
    28	    rw [← pow_mod_orderOf, orderOf_sr, heven, pow_zero]
    29	  have hrpow : (r 1 : DihedralGroup m) ^ k = 1 := by
    30	    simpa only [hspow, mul_one] using hprod
    31	  have hdiv : m ∣ k := by
    32	    simpa only [orderOf_r_one] using orderOf_dvd_of_pow_eq_one hrpow
    33	  obtain ⟨d, hd⟩ := hdiv
    34	  have dpos : 0 < d := by
    35	    by_contra h
    36	    have dzero : d = 0 := by omega
    37	    simp only [dzero, mul_zero] at hd
    38	    omega
    39	  have dle : d ≤ 1 := by nlinarith
    40	  have deq : d = 1 := by omega
    41	  have keq : k = m := by simpa only [deq, mul_one] using hd
    42	  have hodd : m % 2 = 1 := Nat.odd_iff.mp hm
    43	  omega
    44	
    45	/-- For every odd m, the dihedral group of order 2m has a word of length
    46	    2|G|-2 with no |G|-term identity-product ordered sublist. This is a sharp
    47	    lower-bound witness, one term shorter than the conjecture's premise. -/
    48	theorem odd_dihedral_sharp_lower_bound (m : ℕ) [NeZero m] (hm : Odd m) :
    49	    Fintype.card (DihedralGroup m) = 2 * m ∧
    50	    (oddDihedralWord m).length = 2 * Fintype.card (DihedralGroup m) - 2 ∧
    51	    ∀ ys : List (DihedralGroup m), ys.Sublist (oddDihedralWord m) →
    52	      ys.length = Fintype.card (DihedralGroup m) → ys.prod ≠ 1 := by
    53	  refine ⟨DihedralGroup.card, ?_, ?_⟩
    54	  · simp only [oddDihedralWord, List.length_append, List.length_replicate,
    55	      DihedralGroup.card]
    56	    have mpos : 0 < m := NeZero.pos m
    57	    omega
