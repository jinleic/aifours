          "location",
          "problem",
          "correction"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "major",
              "minor"
            ]
          },
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          }
        }
      }
    }
  }
}
