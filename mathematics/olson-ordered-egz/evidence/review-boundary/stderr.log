work/ordered_smt.py:1:#!/usr/bin/env python3
work/ordered_smt.py:2:"""Bounded existential ordered-word search, with a monotone Horn encoding.
work/ordered_smt.py:3:
work/ordered_smt.py:4:The solver carries (prefix, selected length, right-ordered product). It never
work/ordered_smt.py:5:permutes selected entries. UNKNOWN is not UNSAT. A model is independently
work/ordered_smt.py:6:checked by raw subset enumeration before reporting a counterexample candidate.
work/ordered_smt.py:7:"""
work/ordered_smt.py:8:import argparse
work/ordered_smt.py:9:import hashlib
work/ordered_smt.py:10:import itertools
work/ordered_smt.py:11:import json
work/ordered_smt.py:12:import math
work/ordered_smt.py:13:from pathlib import Path
work/ordered_smt.py:14:import time
work/ordered_smt.py:15:import z3
work/ordered_smt.py:16:
work/ordered_smt.py:17:
work/ordered_smt.py:18:def semidirect_c3_c4():
work/ordered_smt.py:19:    elements = list(itertools.product(range(3), range(4)))
work/ordered_smt.py:20:    index = {g: i for i, g in enumerate(elements)}
work/ordered_smt.py:21:    table = [[index[((a + (-1 if b % 2 else 1) * c) % 3, (b + d) % 4)]
work/ordered_smt.py:22:              for c, d in elements] for a, b in elements]
work/ordered_smt.py:23:    return elements, table, 0
work/ordered_smt.py:24:
work/ordered_smt.py:25:
work/ordered_smt.py:26:def alternating4():
work/ordered_smt.py:27:    def even(p):
work/ordered_smt.py:28:        return sum(p[i] > p[j] for i in range(4) for j in range(i + 1, 4)) % 2 == 0
work/ordered_smt.py:29:    elements = [p for p in itertools.permutations(range(4)) if even(p)]
work/ordered_smt.py:30:    index = {p: i for i, p in enumerate(elements)}
work/ordered_smt.py:31:    table = [[index[tuple(a[b[i]] for i in range(4))] for b in elements] for a in elements]
work/ordered_smt.py:32:    return elements, table, 0
work/ordered_smt.py:33:
work/ordered_smt.py:34:
work/ordered_smt.py:35:def check_group(table, e):
work/ordered_smt.py:36:    n = len(table)
work/ordered_smt.py:37:    assert all(len(row) == n and set(row) == set(range(n)) for row in table)
work/ordered_smt.py:38:    assert all(table[e][a] == a and table[a][e] == a for a in range(n))
work/ordered_smt.py:39:    assert all(any(table[a][b] == e and table[b][a] == e for b in range(n)) for a in range(n))
work/ordered_smt.py:40:    assert all(table[table[a][b]][c] == table[a][table[b][c]]
work/ordered_smt.py:41:               for a, b, c in itertools.product(range(n), repeat=3))
work/ordered_smt.py:42:
work/ordered_smt.py:43:
work/ordered_smt.py:44:def raw_histogram(table, e, word, selected):
work/ordered_smt.py:45:    counts = [0] * len(table)
work/ordered_smt.py:46:    for indices in itertools.combinations(range(len(word)), selected):
work/ordered_smt.py:47:        product = e
work/ordered_smt.py:48:        for i in indices:
work/ordered_smt.py:49:            product = table[product][word[i]]
work/ordered_smt.py:50:        counts[product] += 1
work/ordered_smt.py:51:    assert sum(counts) == math.comb(len(word), selected)
work/ordered_smt.py:52:    return counts
work/ordered_smt.py:53:
work/ordered_smt.py:54:
work/ordered_smt.py:55:def dp_products(table, e, word, selected):
work/ordered_smt.py:56:    layers = [{e}] + [set() for _ in range(selected)]
work/ordered_smt.py:57:    for a in word:
work/ordered_smt.py:58:        for k in range(selected, 0, -1):
work/ordered_smt.py:59:            layers[k].update(table[g][a] for g in layers[k - 1])
work/ordered_smt.py:60:    return layers[selected]
work/ordered_smt.py:61:
work/ordered_smt.py:62:
work/ordered_smt.py:63:def solve(table, e, length, selected, milliseconds, fixed_word=None):
work/ordered_smt.py:64:    n = len(table)
work/ordered_smt.py:65:    solver = z3.SolverFor('QF_FD')
work/ordered_smt.py:66:    solver.set(timeout=milliseconds, max_memory=3072)
work/ordered_smt.py:67:    choice = [[z3.Bool(f'x_{i}_{a}') for a in range(n)] for i in range(length)]
work/ordered_smt.py:68:    for row in choice:
work/ordered_smt.py:69:        solver.add(z3.PbEq([(b, 1) for b in row], 1))
work/ordered_smt.py:70:    reach = {}
work/ordered_smt.py:71:    def r(t, k, g):
work/ordered_smt.py:72:        # States unable to attain the final selected length are irrelevant.
work/ordered_smt.py:73:        if k < max(0, selected - (length - t)) or k > min(t, selected):
work/ordered_smt.py:74:            return z3.BoolVal(False)
work/ordered_smt.py:75:        key = t, k, g
work/ordered_smt.py:76:        if key not in reach:
work/ordered_smt.py:77:            reach[key] = z3.Bool(f'r_{t}_{k}_{g}')
work/ordered_smt.py:78:        return reach[key]
work/ordered_smt.py:79:    solver.add(r(0, 0, e))
work/ordered_smt.py:80:    for t in range(length):
work/ordered_smt.py:81:        for k in range(max(0, selected - (length - t)), min(t, selected) + 1):
work/ordered_smt.py:82:            for g in range(n):
work/ordered_smt.py:83:                previous = r(t, k, g)
work/ordered_smt.py:84:                if k >= max(0, selected - (length - t - 1)):
work/ordered_smt.py:85:                    solver.add(z3.Implies(previous, r(t + 1, k, g)))
work/ordered_smt.py:86:                if k < selected:
work/ordered_smt.py:87:                    for a in range(n):
work/ordered_smt.py:88:                        solver.add(z3.Implies(z3.And(previous, choice[t][a]),
work/ordered_smt.py:89:                                              r(t + 1, k + 1, table[g][a])))
work/ordered_smt.py:90:    solver.add(z3.Not(r(length, selected, e)))
work/ordered_smt.py:91:    if fixed_word is not None:
work/ordered_smt.py:92:        assert len(fixed_word) == length
work/ordered_smt.py:93:        for i, a in enumerate(fixed_word):
work/ordered_smt.py:94:            solver.add(choice[i][a])
work/ordered_smt.py:95:    started = time.monotonic()
work/ordered_smt.py:96:    answer = solver.check()
work/ordered_smt.py:97:    elapsed = time.monotonic() - started
work/ordered_smt.py:98:    record = {'answer': str(answer), 'solver_seconds': elapsed,
work/ordered_smt.py:99:              'timeout_ms': milliseconds, 'reachable_variables': len(reach),
work/ordered_smt.py:100:              'sequence_length': length, 'selected_length': selected,
work/ordered_smt.py:101:              'reason_unknown': solver.reason_unknown() if answer == z3.unknown else None}
work/ordered_smt.py:102:    if answer == z3.sat:
work/ordered_smt.py:103:        model = solver.model()
work/ordered_smt.py:104:        word = [next(a for a in range(n) if z3.is_true(model.eval(choice[i][a])))
work/ordered_smt.py:105:                for i in range(length)]
work/ordered_smt.py:106:        histogram = raw_histogram(table, e, word, selected)
work/ordered_smt.py:107:        assert histogram[e] == 0, 'SAT model fails independent raw enumeration'
work/ordered_smt.py:108:        assert dp_products(table, e, word, selected) == {g for g, count in enumerate(histogram) if count}
work/ordered_smt.py:109:        record.update(sequence=word, raw_subset_count=sum(histogram), product_histogram=histogram)
work/ordered_smt.py:110:    return record
work/ordered_smt.py:111:
work/ordered_smt.py:112:
work/ordered_smt.py:113:def main():
work/ordered_smt.py:114:    parser = argparse.ArgumentParser()
work/ordered_smt.py:115:    parser.add_argument('group', choices=['C3rtC4', 'A4'])
work/ordered_smt.py:116:    parser.add_argument('--seconds', type=int, default=180)
work/ordered_smt.py:117:    parser.add_argument('--output', required=True, type=Path)
work/ordered_smt.py:118:    args = parser.parse_args()
work/ordered_smt.py:119:    elements, table, e = semidirect_c3_c4() if args.group == 'C3rtC4' else alternating4()
work/ordered_smt.py:120:    check_group(table, e)
work/ordered_smt.py:121:    n = len(table)
work/ordered_smt.py:122:    controls = []
work/ordered_smt.py:123:    if args.group == 'C3rtC4':
work/ordered_smt.py:124:        a, b = elements.index((1, 0)), elements.index((0, 1))
work/ordered_smt.py:125:        short_word = [a] * (n - 1) + [b] * (n - 1)
work/ordered_smt.py:126:        short = solve(table, e, len(short_word), n, 5000, short_word)
work/ordered_smt.py:127:        assert short['answer'] == 'sat'
work/ordered_smt.py:128:        controls.append({'kind': 'one-short-known-extremal', **short})
work/ordered_smt.py:129:        extended = solve(table, e, 2 * n - 1, n, 5000, short_word + [e])
work/ordered_smt.py:130:        assert extended['answer'] == 'unsat'
work/ordered_smt.py:131:        controls.append({'kind': 'identity-extension-positive-witness', **extended})
work/ordered_smt.py:132:    result = {'schema': 'ordered-olson-smt/1', 'group': args.group, 'elements': elements,
work/ordered_smt.py:133:              'table': table, 'identity': e, 'z3_version': z3.get_version_string(),
work/ordered_smt.py:134:              'script_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
work/ordered_smt.py:135:              'scope': 'One fixed finite group; only SAT plus independently verified witness refutes full conjecture',
work/ordered_smt.py:136:              'controls': controls, 'search': solve(table, e, 2 * n - 1, n, args.seconds * 1000)}
work/ordered_smt.py:137:    args.output.write_text(json.dumps(result, indent=2) + '\n')
work/ordered_smt.py:138:    print(json.dumps({'group': args.group, 'controls': [c['answer'] for c in controls],
work/ordered_smt.py:139:                      'search': result['search']}, indent=2), flush=True)
work/ordered_smt.py:140:
work/ordered_smt.py:141:
work/ordered_smt.py:142:if __name__ == '__main__':
work/ordered_smt.py:143:    main()

