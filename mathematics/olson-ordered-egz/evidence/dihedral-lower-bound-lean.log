theorem OlsonPartial.odd_dihedral_sharp_lower_bound : ∀ (m : ℕ) [inst : NeZero m],
  Odd m →
    Fintype.card (DihedralGroup m) = 2 * m ∧
      (oddDihedralWord m).length = 2 * Fintype.card (DihedralGroup m) - 2 ∧
        ∀ (ys : List (DihedralGroup m)),
          ys.Sublist (oddDihedralWord m) → ys.length = Fintype.card (DihedralGroup m) → ys.prod ≠ 1 :=
fun m [NeZero m] hm =>
  ⟨card,
    ⟨Eq.mpr
        (id
          (congr
            (congrArg Eq
              (Eq.trans List.length_append (congr (congrArg HAdd.hAdd List.length_replicate) List.length_replicate)))
            (congrFun' (congrArg HSub.hSub (congrArg (HMul.hMul 2) card)) 2)))
        (have mpos := NeZero.pos m;
        Decidable.byContradiction fun a => odd_dihedral_sharp_lower_bound._proof_1_2 m mpos a),
      fun ys hsub hlen =>
      Exists.casesOn (List.sublist_append_iff.mp hsub) fun u h =>
        Exists.casesOn h fun v h =>
          And.casesOn h fun left right =>
            Eq.ndrec (motive := fun ys =>
              ys.Sublist (oddDihedralWord m) → ys.length = Fintype.card (DihedralGroup m) → ys.prod ≠ 1)
              (fun hsub hlen =>
                And.casesOn right fun hu hv =>
                  Exists.casesOn (List.sublist_replicate_iff.mp hu) fun k h =>
                    And.casesOn h fun hk right =>
                      Eq.ndrec (motive := fun u =>
                        (u ++ v).Sublist (oddDihedralWord m) →
                          (u ++ v).length = Fintype.card (DihedralGroup m) →
                            u.Sublist (List.replicate (2 * m - 1) (r 1)) → (u ++ v).prod ≠ 1)
                        (fun hsub hlen hu =>
                          Exists.casesOn (List.sublist_replicate_iff.mp hv) fun l h =>
                            And.casesOn h fun hl right =>
                              Eq.ndrec (motive := fun v =>
                                v.Sublist (List.replicate (2 * m - 1) (sr 0)) →
                                  (List.replicate k (r 1) ++ v).Sublist (oddDihedralWord m) →
                                    (List.replicate k (r 1) ++ v).length = Fintype.card (DihedralGroup m) →
                                      (List.replicate k (r 1) ++ v).prod ≠ 1)
                                (fun hv hsub hlen =>
                                  Eq.mpr
                                    (id
                                      (congrFun'
                                        (congrArg Ne
                                          (Eq.trans List.prod_append
                                            (congr (congrArg HMul.hMul (List.prod_replicate k (r 1)))
                                              (List.prod_replicate l (sr 0)))))
                                        1))
                                    (two_block_product_ne_one m hm k l hk hl
                                      (Eq.mp
                                        (congr
                                          (congrArg Eq
                                            (Eq.trans List.length_append
                                              (congr (congrArg HAdd.hAdd List.length_replicate) List.length_replicate)))
                                          card)
                                        hlen)))
                                (Eq.symm right) hv hsub hlen)
                        (Eq.symm right) hsub hlen hu)
              (Eq.symm left) hsub hlen⟩⟩
'OlsonPartial.odd_dihedral_sharp_lower_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
