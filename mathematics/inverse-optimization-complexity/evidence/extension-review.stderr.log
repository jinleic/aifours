    36	class Verification:
    37	    """Independent exhaustive YES/NO oracle; does not expose witnesses."""
    38	    def __init__(self, feasible):
    39	        self.feasible = frozenset(feasible)
    40	        self.calls = 0
    41	
    42	    def __call__(self, cost, target):
    43	        assert target in self.feasible, "reduction queried an invalid target"
    44	        self.calls += 1
    45	        assert self.calls < 100_000, "nontermination guard"
    46	        value = dot(cost, target)
    47	        return all(value <= dot(cost, y) for y in self.feasible)
