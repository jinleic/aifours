     1	"""Algorithms corresponding to proof.md; no external packages.
     2	
     3	The forward reduction takes only a yes/no optimality oracle and a valid feasible
     4	start. Enumerating a feasible set is used only in the separately named inverse
     5	reference, never disguised as a polynomial forward algorithm.
     6	"""
     7	from fractions import Fraction
     8	from math import lcm
     9	
    10	
    11	def augment(verify, cost, target):
    12	    """Schulz's verification -> augmentation reduction (proof Lemma A).
    13	
    14	    Return a strictly better feasible tuple, or None if target is optimal.
    15	    verify(cost, target) must be exact, allow arbitrary signed rational costs,
    16	    and accept every feasible target for one fixed binary feasible set.
    17	    """
    18	    target = tuple(target)
    19	    if verify(cost, target):
    20	        return None
    21	    penalty = 1 + sum(map(abs, cost))
    22	    query = list(cost)
    23	    matches = [False] * len(target)
    24	    for i, bit in enumerate(target):
    25	        shift = penalty * (2 * bit - 1)
    26	        query[i] -= shift
    27	        if verify(query, target):
    28	            query[i] += shift
    29	        else:
    30	            matches[i] = True
    31	    return tuple(bit if keep else 1 - bit for bit, keep in zip(target, matches))
    32	
    33	
    34	def optimize_from_verification(verify, cost, feasible_start):
    35	    """Exact bit-polynomial oracle reduction, including signed/rational costs.
    36	
    37	    verify returns only a Boolean, never a better point or objective value.
    38	    Existence of feasible_start is a necessary input promise, not solved here.
    39	    """
    40	    rational = tuple(map(Fraction, cost))
    41	    denominator = lcm(*(value.denominator for value in rational))
    42	    integer = tuple(int(value * denominator) for value in rational)
    43	    flipped = tuple(value < 0 for value in integer)
    44	    absolute = tuple(abs(value) for value in integer)
    45	    bits = max((value.bit_length() for value in absolute), default=0)
    46	    z = tuple(1 - bit if flip else bit for bit, flip in zip(feasible_start, flipped))
    47	
    48	    def virtual_verify(virtual_cost, virtual_target):
    49	        original_cost = tuple(-value if flip else value for value, flip in zip(virtual_cost, flipped))
    50	        original_target = tuple(1 - bit if flip else bit for bit, flip in zip(virtual_target, flipped))
    51	        return verify(original_cost, original_target)
    52	
    53	    prefix = [0] * len(integer)
    54	    for position in reversed(range(bits)):
    55	        prefix = [2 * old + ((value >> position) & 1) for old, value in zip(prefix, absolute)]
    56	        while True:
    57	            better = augment(virtual_verify, prefix, z)
    58	            if better is None:
    59	                break
    60	            z = better
    61	    return tuple(1 - bit if flip else bit for bit, flip in zip(z, flipped))
    62	
    63	
    64	def optimize_bottleneck(verify, cost, feasible_start):
    65	    """Theorem B: global min-max optimization using only YES/NO verification.
    66	
    67	    Every feasible set must be nonempty. All queries use 0/1 costs and the
    68	    original feasible_start, not a hypothetical feasible restricted target.
    69	    """
    70	    n = len(cost)
    71	    support = {i for i, bit in enumerate(feasible_start) if bit}
    72	
    73	    def contains_feasible(allowed):
    74	        if support <= allowed:
    75	            return True
    76	        query = tuple(0 if i in allowed else 1 for i in range(n))
    77	        return not verify(query, feasible_start)
    78	
    79	    levels = sorted(set(cost))
    80	    low, high = 0, len(levels) - 1
    81	    while low < high:
    82	        middle = (low + high) // 2
    83	        allowed = {i for i, value in enumerate(cost) if value <= levels[middle]}
    84	        if contains_feasible(allowed):
    85	            high = middle
    86	        else:
    87	            low = middle + 1
    88	    allowed = {i for i, value in enumerate(cost) if value <= levels[low]}
    89	    for i in range(n):
    90	        if i in allowed and contains_feasible(allowed - {i}):
    91	            allowed.remove(i)
    92	    return tuple(int(i in allowed) for i in range(n))
    93	
    94	
    95	def clip_free_costs(cost, free_target):
    96	    """Exact inverse for SAT x cube with witness costs fixed at zero (Prop. C)."""
    97	    return tuple(min(value, 0) if bit else max(value, 0)
    98	                 for value, bit in zip(cost, free_target))
    99	
   100	
