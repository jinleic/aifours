    50	def solve_square(rows, rhs):
    51	    """Exact Gaussian elimination, independent of production algorithms."""
    52	    n = len(rhs)
    53	    a = [[Q(t) for t in row] + [Q(b)] for row, b in zip(rows, rhs)]
    54	    for col in range(n):
    55	        pivot = next((j for j in range(col, n) if a[j][col]), None)
    56	        if pivot is None:
    57	            return None
    58	        a[col], a[pivot] = a[pivot], a[col]
    59	        divisor = a[col][col]
    60	        a[col] = [x / divisor for x in a[col]]
    61	        for j in range(n):
    62	            if j != col:
    63	                factor = a[j][col]
    64	                a[j] = [x - factor * y for x, y in zip(a[j], a[col])]
    65	    return tuple(row[-1] for row in a)
