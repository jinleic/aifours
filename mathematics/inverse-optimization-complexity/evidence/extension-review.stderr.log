    68	def independent_linf_lp(feasible, target, c, weights):
    69	    """Enumerate vertices of the original LP in variables (d_1,...,d_n,t).
    70	
    71	    Constraints use a·(d,t)<=b. This does not use the ratio formula.
    72	    The epigraph is pointed and an optimum vertex exists for these finite tests.
    73	    """
    74	    n = len(c)
    75	    constraints = []
    76	    for y in feasible:
    77	        if y != target:
    78	            constraints.append((tuple(a - b for a, b in zip(target, y)) + (0,), Q(0)))
    79	    for i in range(n):
    80	        row = [Q(0)] * (n + 1)
    81	        row[i], row[-1] = weights[i], Q(-1)
    82	        constraints.append((tuple(row), weights[i] * c[i]))
    83	        row = [Q(0)] * (n + 1)
    84	        row[i], row[-1] = -weights[i], Q(-1)
    85	        constraints.append((tuple(row), -weights[i] * c[i]))
    86	    constraints.append(((Q(0),) * n + (Q(-1),), Q(0)))
    87	    optimum = None
    88	    vertices = 0
    89	    for selected in itertools.combinations(constraints, n + 1):
    90	        point = solve_square([a for a, _ in selected], [b for _, b in selected])
    91	        if point is None or not all(dot(a, point) <= b for a, b in constraints):
    92	            continue
    93	        vertices += 1
    94	        if optimum is None or point[-1] < optimum:
    95	            optimum = point[-1]
    96	    assert optimum is not None
    97	    return optimum, vertices
