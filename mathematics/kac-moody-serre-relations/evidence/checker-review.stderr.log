   238	                        coords = radicals[previous].reduce(coords)
   239	                    elif coords:
   240	                        raise ArithmeticError('nonzero descent into absent free-Lie space')
   241	                    for j, value in coords.items():
   242	                        image[(i, j)] = value
   243	                images.append(image)
   244	            radical, image_rank = kernel_of_images(images, field)
   245	        assert all(not radical.reduce(row) for row in ideal.basis()), ('Serre not in radical', alpha)
   246	        ideals[alpha], radicals[alpha] = ideal, radical
   247	        records.append({'alpha': list(alpha), 'free_dim': len(words), 'serre_ideal_rank': len(ideal),
   248	                        'maximal_ideal_rank': len(radical), 'serre_dim': len(words) - len(ideal),
   249	                        'contragredient_dim': len(words) - len(radical), 'descent_rank': image_rank,
   250	                        'extra_relations': len(radical) - len(ideal),
   251	                        'words': [''.join(map(str, w)) for w in words],
   252	                        'ideal_basis': [[[j, str(v)] for j, v in sorted(row.items())] for row in ideal.basis()],
   253	                        'radical_basis': [[[j, str(v)] for j, v in sorted(row.items())] for row in radical.basis()]})
   254	    return records

