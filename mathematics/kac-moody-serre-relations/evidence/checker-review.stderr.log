   215	    alphas = sorted(free.words, key=lambda a: (sum(a), a))
   216	    for alpha in alphas:
   217	        words = free.words[alpha]
   218	        ideal = RowSpace(field, original.get(alpha, ()))
   219	        for i in range(rank):
   220	            if not alpha[i]:
   221	                continue
   222	            previous = tuple(a - int(k == i) for k, a in enumerate(alpha))
   223	            if previous in ideals:
