   228	                require(all(not projected_descent(row) for row in producer_radical), 'non-kernel radical row')
   229	                counts['descent_columns'] += m
   230	                counts['kernel_vectors_checked'] += len(producer_radical)
   231	            require(all(not k_span.remainder(row) for row in producer_ideal), 'Serre ideal not contained in radical')
   232	            expected_fields = {'free_dim': m, 'serre_ideal_rank': i_span.rank(),
   233	                               'maximal_ideal_rank': k_span.rank(), 'serre_dim': m - i_span.rank(),
   234	                               'contragredient_dim': m - k_span.rank(), 'descent_rank': descent_rank,
   235	                               'extra_relations': k_span.rank() - i_span.rank()}
   236	            require(all(record[key] == value for key, value in expected_fields.items()), 'reported dimension mismatch')
   237	            ideal_rows[alpha], radical_rows[alpha], radical_spaces[alpha] = producer_ideal, producer_radical, k_span
   238	            degree = str(sum(alpha))
   239	            row = totals.setdefault(degree, {'serre': 0, 'contragredient': 0})
   240	            row['serre'] += m - i_span.rank()
   241	            row['contragredient'] += m - k_span.rank()
   242	            counts['root_degrees'] += 1
   243	        outputs[name] = totals
   244	        counts['matrices'] += 1
   245	    return {'counts': counts, 'graded_dimensions': outputs}
   246	
   247	
   248	def main():
   249	    parser = argparse.ArgumentParser()
   250	    parser.add_argument('certificate', type=Path)
   251	    parser.add_argument('--output', type=Path, required=True)
   252	    parser.add_argument('--negative-controls', action='store_true')
   253	    args = parser.parse_args()
   254	    started = time.monotonic()
   255	    compressed = args.certificate.read_bytes()
   256	    data = json.loads(gzip.decompress(compressed))
   257	    checked = validate(data)
   258	    rejected = []
   259	    if args.negative_controls:
   260	        for mutation in ('field', 'missing_root', 'dimension'):
   261	            modified = copy.deepcopy(data)
   262	            first = next(iter(modified['matrices'].values()))
   263	            if mutation == 'field':
   264	                modified['field'] = 'F_2'
   265	            elif mutation == 'missing_root':
   266	                first['records'].pop()
   267	            else:
   268	                first['records'][0]['contragredient_dim'] += 1
   269	            try:
   270	                validate(modified)
   271	            except ValueError as error:
   272	                rejected.append({'mutation': mutation, 'rejected': True, 'reason': str(error)})
   273	            else:
   274	                raise AssertionError(f'negative control accepted: {mutation}')
   275	    result = {'status': 'PASS', 'certificate': str(args.certificate),
   276	              'certificate_sha256': hashlib.sha256(compressed).hexdigest(),
   277	              'checker_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
   278	              'height': data['height'], 'field': 'Q', 'independence': 'No producer imports; associative-word lowering rather than recursive bracket lowering',
   279	              'elapsed_seconds': round(time.monotonic() - started, 3), 'processes': 1,
   280	              'negative_controls': rejected, **checked}
   281	    args.output.write_text(json.dumps(result, indent=2) + '\n')
   282	    print(json.dumps(result, indent=2))
   283	
   284	
   285	if __name__ == '__main__':
   286	    main()

