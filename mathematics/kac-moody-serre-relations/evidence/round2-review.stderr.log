   113	def affine_matrix(alpha, cell, ideals, free, raw):
   114	    columns = [j for j in range(len(free.words[alpha])) if j not in ideals[alpha].rows]
   115	    targets = []
   116	    variables = [k for k, (i, j) in enumerate(EDGES) if cell[k] == alpha[i]]
   117	    for i in range(3):
   118	        previous = tuple(a - int(i == k) for k, a in enumerate(alpha))
   119	        targets.extend((i, j) for j in range(len(free.words[previous])) if j not in ideals[previous].rows)
   120	    target_index = {item: k for k, item in enumerate(targets)}
   121	    entries = [[[Q(0)] * (1 + len(variables)) for _ in columns] for _ in targets]
   122	    for c, column in enumerate(columns):
   123	        for i in range(3):
   124	            previous = tuple(a - int(i == k) for k, a in enumerate(alpha))
   125	            baseline = dict(raw[i, -1][column])
   126	            for edge, (u, v) in enumerate(EDGES):
   127	                if u == i:
   128	                    for j, coefficient in raw[i, edge][column].items():
   129	                        baseline[j] = baseline.get(j, 0) + cell[edge] * coefficient
   130	            for j, coefficient in ideals[previous].reduce(baseline).items():
   131	                entries[target_index[i, j]][c][0] = coefficient
