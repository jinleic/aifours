   100	def content_determinant(matrix, ring, arity):
   101	    """Recompute a hard determinant by exact Schur steps and row division.
   102	
   103	    For current size m, det(B)=det(p*D-c*r)/p**(m-2).
   104	    This rational-function identity, followed by checked exact row divisions
   105	    and checked polynomial factorizations, yields an exact polynomial identity.
   106	    No producer state, scalar factors, or elimination transcript is trusted.
   107	    """
   108	    current = [row[:] for row in matrix]
   109	    scalar = Q(1)
   110	    raw_factors = []
   111	    divisions = 0
   112	    while len(current) > 1:
   113	        size = len(current)
   114	        choice = next((r for r in range(size) if current[r][0].to_dict().get((0,)*arity)), None)
   115	        require(choice is not None, 'no nonzero constant Schur pivot')
   116	        if choice != 0:
   117	            current[0], current[choice] = current[choice], current[0]
   118	            scalar = -scalar
   119	        pivot = current[0][0]
   120	        raw_factors.append((pivot, 2-size))
   121	        following = []
   122	        for row in current[1:]:
   123	            numerators = [pivot*entry-row[0]*top for entry, top in zip(row[1:], current[0][1:])]
   124	            divisor = ring.constant(0)
   125	            for entry in numerators:
   126	                divisor = divisor.gcd(entry)
   127	            require(divisor != 0, 'zero Schur row')
   128	            raw_factors.append((divisor, 1))
   129	            reduced = []
   130	            for numerator in numerators:
   131	                quotient, remainder = divmod(numerator, divisor)
   132	                require(remainder == 0, 'Schur row division not exact')
   133	                reduced.append(quotient)
   134	                divisions += 1
   135	            following.append(reduced)
   136	        current = following
   137	    raw_factors.append((current[0][0], 1))
   138	    collection = {}
   139	    for polynomial, weight in raw_factors:
   140	        if weight == 0:
   141	            continue
   142	        unit, factorization = polynomial.factor()
   143	        checked = ring.constant(int(unit))
   144	        scalar *= Q(int(unit))**weight
   145	        for factor, multiplicity in factorization:
   146	            checked *= factor**multiplicity
   147	            identity = tuple(sorted((tuple(map(int, powers)), int(value))
   148	                                    for powers, value in factor.to_dict().items()))
   149	            if identity not in collection:
   150	                collection[identity] = [factor, 0]
   151	            collection[identity][1] += weight*int(multiplicity)
   152	        require(checked == polynomial, 'local factorization identity failed')
   153	    require(all(exponent >= 0 for factor, exponent in collection.values()), 'uncancelled determinant denominator')
   154	    answer = ring.constant(scalar.numerator)
   155	    for factor, exponent in collection.values():
   156	        answer *= factor**exponent
   157	    answer, remainder = divmod(answer, ring.constant(scalar.denominator))
   158	    require(remainder == 0, 'final determinant not integral after denominator clearing')
