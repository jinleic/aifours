    42	def cover(alpha):
    43	    cells = list(itertools.product(*(range(1, alpha[i] + 1) for i, j in EDGES)))
    44	    permutations = [p for p in itertools.permutations(range(3))
    45	                    if all(alpha[p[i]] == alpha[i] for i in range(3))]
    46	    edge_index = {edge: k for k, edge in enumerate(EDGES)}
    47	    rows = []
    48	    for cell in cells:
    49	        orbit = []
    50	        for p in permutations:
    51	            renamed = [0] * 6
    52	            for k, (i, j) in enumerate(EDGES):
    53	                renamed[edge_index[p[i], p[j]]] = cell[k]
    54	            orbit.append((tuple(renamed), p))
    55	        representative, permutation = min(orbit)
    56	        rows.append({'cell': list(cell), 'representative': list(representative),
    57	                     'permutation': list(permutation)})
    58	    return {'degree': list(alpha), 'edge_order': EDGES,
    59	            'cell_count': len(cells), 'cover': rows,
    60	            'representatives': sorted({key(row['representative']) for row in rows})}
