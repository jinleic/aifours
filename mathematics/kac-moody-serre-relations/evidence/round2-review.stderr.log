   120	            orientation = 1 if constant > 0 else -1
   121	            normalized = sorted((tuple(map(int, powers)), orientation*int(coefficient)) for powers, coefficient in terms.items())
   122	            negative = sum(coefficient < 0 for powers, coefficient in normalized)
   123	            data.update(status='POSITIVE_MINOR_CANDIDATE' if not negative else 'SIGN_TEST_INCONCLUSIVE',
   124	                        orientation=orientation, constant=str(abs(constant)), monomials=len(normalized),
   125	                        negative_coefficients=negative,
   126	                        polynomial_terms=[[list(powers) if variables else [], str(coefficient)] for powers, coefficient in normalized],
   127	                        determinant_algorithm='row-content elimination and checked factorization identities')
   128	        except (TimeoutError, OverflowError, ArithmeticError) as error:
   129	            data.update(status=type(error).__name__.upper(), error=str(error))
   130	        finally:
   131	            signal.setitimer(signal.ITIMER_REAL, 0)
