   134	class FreeLie:
   135	    def __init__(self, rank, height):
   136	        self.rank, self.height = rank, height
   137	        self.words = {}
   138	        self.index = {}
   139	        for degree in range(1, height + 1):
   140	            for word in product(range(rank), repeat=degree):
   141	                if lyndon(word):
   142	                    alpha = tuple(word.count(i) for i in range(rank))
