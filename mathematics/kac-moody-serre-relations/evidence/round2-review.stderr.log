    92	    for i in range(3):
    93	        previous = tuple(a - int(i == k) for k, a in enumerate(alpha))
    94	        raw[i, -1] = [free.coordinates(lower(i, word), previous) for word in free.words[alpha]]
    95	        for edge, (u, v) in enumerate(EDGES):
    96	            if u != i:
    97	                continue
    98	            shifted = [list(row) for row in diagonal]
    99	            shifted[u][v] = -1
   100	            slope = descend_factory(tuple(map(tuple, shifted)))
   101	            values = []
   102	            for column, word in enumerate(free.words[alpha]):
   103	                value = free.coordinates(slope(i, word), previous)
   104	                for j, coefficient in raw[i, -1][column].items():
   105	                    value[j] = value.get(j, 0) - coefficient
   106	                    if not value[j]:
   107	                        del value[j]
   108	                values.append(value)
   109	            raw[i, edge] = values
   110	    return raw
