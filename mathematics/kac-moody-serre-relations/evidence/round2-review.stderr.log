    63	def serre_spaces(matrix, alpha, free):
    64	    original = {}
    65	    for i, j in EDGES:
    66	        exponent = 1 - matrix[i][j]
    67	        degree = tuple(exponent if k == i else 1 if k == j else 0 for k in range(3))
    68	        if all(a <= b for a, b in zip(degree, alpha)):
    69	            polynomial = {(j,): 1}
    70	            for _ in range(exponent):
    71	                polynomial = bracket({(i,): 1}, polynomial)
    72	            original.setdefault(degree, []).append(free.coordinates(polynomial, degree))
    73	    ideals = {}
    74	    for degree in sorted(free.words, key=lambda a: (sum(a), a)):
    75	        if not all(a <= b for a, b in zip(degree, alpha)):
    76	            continue
    77	        space = RowSpace(Field(), original.get(degree, ()))
    78	        for i in range(3):
    79	            previous = tuple(a - int(i == k) for k, a in enumerate(degree))
    80	            if previous in ideals:
    81	                for row in ideals[previous].basis():
    82	                    space.add(free.ad_generator(i, previous, row))
    83	        ideals[degree] = space
    84	    return ideals
