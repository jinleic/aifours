   157	            answer[index[word]] = value
   158	            add_scaled(row, expansion(word), -value)
   159	        return answer
   160	
   161	    def ad_generator(self, i, alpha, row):
   162	        target = list(alpha)
   163	        target[i] += 1
   164	        target = tuple(target)
   165	        out = {}
   166	        for j, value in row.items():
   167	            key = (i, self.words[alpha][j])
   168	            if key not in self._ad_cache:
   169	                self._ad_cache[key] = self.coordinates(bracket({(i,): 1}, expansion(key[1])), target)
