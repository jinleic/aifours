   133	                if EDGES[edge][0] == i:
   134	                    for j, coefficient in ideals[previous].reduce(raw[i, edge][column]).items():
   135	                        entries[target_index[i, j]][c][v] = coefficient
   136	    return columns, targets, variables, entries
