   130	def witt_dimension(alpha):
   131	    height, divisor_gcd = sum(alpha), math.gcd(*alpha)
   132	    total = 0
   133	    for divisor in range(1, divisor_gcd+1):
   134	        if divisor_gcd % divisor == 0:
   135	            denominator = math.prod(math.factorial(a//divisor) for a in alpha)
   136	            total += mobius(divisor) * (math.factorial(height//divisor)//denominator)
   137	    require(total % height == 0, 'nonintegral Witt dimension')
   138	    return total//height
