   116	def mobius(number):
   117	    factors, divisor = 0, 2
   118	    while divisor * divisor <= number:
   119	        if number % divisor == 0:
   120	            number //= divisor
   121	            factors += 1
   122	            if number % divisor == 0:
   123	                return 0
   124	        divisor += 1
   125	    if number > 1:
   126	        factors += 1
   127	    return -1 if factors % 2 else 1
