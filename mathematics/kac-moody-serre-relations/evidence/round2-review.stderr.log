    27	def save(path, data):
    28	    if path.exists():
    29	        raise FileExistsError(path)
    30	    path.parent.mkdir(parents=True, exist_ok=True)
    31	    if path.suffix == '.gz':
    32	        with gzip.open(path, 'wt') as stream:
    33	            json.dump(data, stream, sort_keys=True)
