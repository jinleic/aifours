   174	def descend_factory(matrix):
   175	    """Recursive derivation; independent checker uses word deletion instead."""
   176	    rank = len(matrix)
   177	
   178	    @lru_cache(None)
   179	    def lower(i, word):
   180	        if len(word) == 1:
   181	            raise ValueError('height one descends to Cartan, not positive free Lie')
   182	        u, v = factor(word)
   183	        out = {}
   184	        if len(u) == 1:
   185	            if u[0] == i:
   186	                add_scaled(out, expansion(v), -sum(matrix[i][j] for j in v))
   187	        else:
   188	            add_scaled(out, bracket(lower(i, u), expansion(v)))
   189	        if len(v) == 1:
   190	            if v[0] == i:
   191	                add_scaled(out, expansion(u), sum(matrix[i][j] for j in u))
   192	        else:
   193	            add_scaled(out, bracket(expansion(u), lower(i, v)))
   194	        return out
   195	
   196	    return lower
   197	
   198	
   199	def compute_matrix(matrix, free, field):
   200	    rank = len(matrix)
   201	    ideals, radicals, records = {}, {}, []
   202	    lower = descend_factory(tuple(map(tuple, matrix)))
   203	    original = {}
   204	    for i in range(rank):
   205	        for j in range(rank):
   206	            if i == j:
   207	                continue
   208	            exponent = 1 - matrix[i][j]
   209	            alpha = tuple((exponent if k == i else 1 if k == j else 0) for k in range(rank))
   210	            if sum(alpha) <= free.height:
   211	                poly = {(j,): 1}
   212	                for _ in range(exponent):
   213	                    poly = bracket({(i,): 1}, poly)
   214	                original.setdefault(alpha, []).append(free.coordinates(poly, alpha))
   215	    alphas = sorted(free.words, key=lambda a: (sum(a), a))
   216	    for alpha in alphas:
   217	        words = free.words[alpha]
   218	        ideal = RowSpace(field, original.get(alpha, ()))
   219	        for i in range(rank):
   220	            if not alpha[i]:
   221	                continue
   222	            previous = tuple(a - int(k == i) for k, a in enumerate(alpha))
   223	            if previous in ideals:
   224	                for row in ideals[previous].basis():
   225	                    ideal.add(free.ad_generator(i, previous, row))
   226	        if sum(alpha) == 1:
   227	            radical, image_rank = RowSpace(field), len(words)
   228	        else:
   229	            images = []
   230	            for word in words:
   231	                image = {}
   232	                for i in range(rank):
   233	                    if not alpha[i]:
   234	                        continue
   235	                    previous = tuple(a - int(k == i) for k, a in enumerate(alpha))
   236	                    coords = free.coordinates(lower(i, word), previous)
   237	                    if previous in radicals:
   238	                        coords = radicals[previous].reduce(coords)
   239	                    elif coords:
   240	                        raise ArithmeticError('nonzero descent into absent free-Lie space')
   241	                    for j, value in coords.items():
   242	                        image[(i, j)] = value
   243	                images.append(image)
   244	            radical, image_rank = kernel_of_images(images, field)
   245	        assert all(not radical.reduce(row) for row in ideal.basis()), ('Serre not in radical', alpha)
   246	        ideals[alpha], radicals[alpha] = ideal, radical
   247	        records.append({'alpha': list(alpha), 'free_dim': len(words), 'serre_ideal_rank': len(ideal),
   248	                        'maximal_ideal_rank': len(radical), 'serre_dim': len(words) - len(ideal),
   249	                        'contragredient_dim': len(words) - len(radical), 'descent_rank': image_rank,
   250	                        'extra_relations': len(radical) - len(ideal),
   251	                        'words': [''.join(map(str, w)) for w in words],
   252	                        'ideal_basis': [[[j, str(v)] for j, v in sorted(row.items())] for row in ideal.basis()],
   253	                        'radical_basis': [[[j, str(v)] for j, v in sorted(row.items())] for row in radical.basis()]})
   254	    return records

