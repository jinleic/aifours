   148	def determinant(matrix, ring, term_limit, event):
   149	    """Producer Bareiss implementation, with explicit exact-division checks."""
   150	    values = [row[:] for row in matrix]
   151	    previous, sign = ring.constant(1), 1
   152	    for k in range(len(values) - 1):
   153	        pivot_row = next((i for i in range(k, len(values)) if values[i][k]), None)
   154	        if pivot_row is None:
   155	            return ring.constant(0)
   156	        if pivot_row != k:
   157	            values[k], values[pivot_row] = values[pivot_row], values[k]
   158	            sign = -sign
   159	        pivot = values[k][k]
   160	        largest = 0
   161	        for i in range(k + 1, len(values)):
   162	            for j in range(k + 1, len(values)):
   163	                numerator = values[i][j] * pivot - values[i][k] * values[k][j]
   164	                quotient, remainder = divmod(numerator, previous)
   165	                if remainder:
   166	                    raise ArithmeticError('nonexact producer Bareiss division')
   167	                values[i][j] = quotient
   168	                largest = max(largest, len(quotient))
   169	                if largest > term_limit:
   170	                    raise OverflowError(f'intermediate entry exceeds {term_limit} monomials at pivot {k}')
   171	            values[i][k] = ring.constant(0)
   172	        previous = pivot
   173	        event({'pivot': k, 'largest_entry_terms': largest})
   174	    return sign * values[-1][-1]
