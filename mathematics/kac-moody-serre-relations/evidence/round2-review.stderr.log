    87	def raw_lowerings(alpha, free):
    88	    """Cache affine coefficient arrays once, before any ideal projection."""
    89	    diagonal = tuple(tuple(2 if i == j else 0 for j in range(3)) for i in range(3))
    90	    lower = descend_factory(diagonal)
