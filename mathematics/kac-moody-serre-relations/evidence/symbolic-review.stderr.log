    52	def bareiss(matrix, ring):
    53	    entries = [row[:] for row in matrix]
    54	    n = len(entries)
    55	    previous, sign = ring.constant(1), 1
    56	    divisions = 0
    57	    for k in range(n-1):
    58	        pivot_row = next((i for i in range(k, n) if entries[i][k] != 0), None)
    59	        require(pivot_row is not None, 'symbolic rank defect')
    60	        if pivot_row != k:
    61	            entries[k], entries[pivot_row] = entries[pivot_row], entries[k]
    62	            sign = -sign
    63	        pivot = entries[k][k]
    64	        for i in range(k+1, n):
    65	            for j in range(k+1, n):
    66	                numerator = entries[i][j]*pivot - entries[i][k]*entries[k][j]
    67	                quotient, remainder = divmod(numerator, previous)
    68	                require(remainder == 0, 'Bareiss division was not exact')
    69	                entries[i][j] = quotient
    70	                divisions += 1
    71	            entries[i][k] = ring.constant(0)
    72	        previous = pivot
    73	    return sign*entries[-1][-1], divisions
