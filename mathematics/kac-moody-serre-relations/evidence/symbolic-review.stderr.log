   178	        require(sorted(permutation)==[0,1,2],'invalid index permutation')
   179	        renamed=sum(1<<edge_index[(permutation[i],permutation[j])]
   180	                    for bit,(i,j) in enumerate(EDGES) if row['mask']>>bit&1)
   181	        require(renamed==row['representative'],'permutation does not map cell to claimed representative')
   182	    representatives=sorted({row['representative'] for row in rows})
   183	    require(representatives==coverage['representatives'] and not coverage['uncovered'],'incomplete representative ledger')
   184	    return representatives
