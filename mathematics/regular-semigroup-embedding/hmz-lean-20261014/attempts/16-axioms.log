def P1.Idem.{u} : {S : Type u} → [Mul.{u} S] → S → Prop :=
fun {S} [Mul.{u} S] x => Eq.{u + 1} (HMul.hMul.{u, u, u} x x) x
def P1.Band.{u} : (B : Type u) → [Mul.{u} B] → Prop :=
fun B [Mul.{u} B] => ∀ (x : B), P1.Idem.{u} x
def P1.Regular.{u} : (S : Type u) → [Mul.{u} S] → Prop :=
fun S [Mul.{u} S] =>
  ∀ (x : S),
    Exists.{u + 1} fun y =>
      Eq.{u + 1} (HMul.hMul.{u, u, u} (HMul.hMul.{u, u, u} x y) x) x ∧
        Eq.{u + 1} (HMul.hMul.{u, u, u} (HMul.hMul.{u, u, u} y x) y) y
def P1.NaturalLE.{u} : {S : Type u} → [Mul.{u} S] → S → S → Prop :=
fun {S} [Mul.{u} S] x y =>
  Exists.{u + 1} fun e =>
    Exists.{u + 1} fun f =>
      P1.Idem.{u} e ∧ P1.Idem.{u} f ∧ Eq.{u + 1} x (HMul.hMul.{u, u, u} e y) ∧ Eq.{u + 1} x (HMul.hMul.{u, u, u} y f)
