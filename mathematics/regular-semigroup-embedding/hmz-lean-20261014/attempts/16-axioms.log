fun S [Mul.{u} S] => ∀ (e a : S), P1.Idem.{u} e → P1.NaturalLE.{u} e a → P1.Idem.{u} a
def P1.EUnitary.{u} : (S : Type u) → [Mul.{u} S] → Prop :=
fun S [Mul.{u} S] =>
  (∀ (e a : S), P1.Idem.{u} e → P1.Idem.{u} (HMul.hMul.{u, u, u} e a) → P1.Idem.{u} a) ∧
    ∀ (e a : S), P1.Idem.{u} e → P1.Idem.{u} (HMul.hMul.{u, u, u} a e) → P1.Idem.{u} a
