theorem SemifilterElimination.residual_elimination.{u, v} : ∀ {Alphabet : Type u} {State : Type v}
  (T : List Alphabet → Bool) (representative : State → List Alphabet) (step : State → Alphabet → State) (q₀ : State),
  representative q₀ = [] →
    ∀ (w : List Alphabet),
      T w =
        (T (representative (runState step q₀ w)) ^^
          pathError (fun q suffix => T (representative q ++ suffix)) step q₀ w) :=
fun {Alphabet} {State} T representative step q₀ initial_empty w =>
  Eq.mp
    (congr (congrArg Eq (congrArg T (congrFun' (congrArg HAppend.hAppend initial_empty) w)))
      (congrFun' (congrArg xor (congrArg T (List.append_nil (representative (runState step q₀ w)))))
        (pathError (fun q suffix => T (representative q ++ suffix)) step q₀ w)))
    (eliminate (fun q suffix => T (representative q ++ suffix)) step q₀ w)
'SemifilterElimination.residual_elimination' depends on axioms: [propext]
