theorem Semifilter.series_regular_criterion.{w} : ∀ {X : Type w} [Finite X]
  (V : Submodule (ZMod 2) (Semifilter.Series X)) (hV : Semifilter.Invariant Semifilter.letter V),
  (∀ (T : Language X), Semifilter.characteristic T ∈ Semifilter.saturate Semifilter.letter V hV ↔ T.IsRegular) ↔
    ∀ f ∈ V, (Semifilter.support f).IsRegular :=
fun {X} [Finite X] V hV =>
  have hclass :=
    {
      mp := fun h =>
        Submodule.ext fun f =>
          id
            (have hh := h (Semifilter.support f);
            Iff.trans
              (Eq.mp
                (congrArg (fun _a => _a ∈ Semifilter.saturate Semifilter.letter V hV ↔ (Semifilter.support f).IsRegular)
                  (Semifilter.characteristic_support f))
                hh)
              (Iff.symm (Semifilter.finiteOrbit_iff_support_regular f))),
      mpr := fun h T =>
        Eq.mpr (id (congrArg (fun _a => Semifilter.characteristic T ∈ _a ↔ T.IsRegular) h))
          (Semifilter.finiteOrbit_characteristic_iff_regular T) };
  Eq.mpr (id (congrArg (fun _a => _a ↔ ∀ f ∈ V, (Semifilter.support f).IsRegular) (propext hclass)))
    (Eq.mpr
      (id (congrArg (fun _a => _a ↔ ∀ f ∈ V, (Semifilter.support f).IsRegular) (propext (Semifilter.series_q2 V hV))))
      { mp := fun h f hf => (Semifilter.finiteOrbit_iff_support_regular f).mp (h hf),
        mpr := fun h ⦃f⦄ hf => (Semifilter.finiteOrbit_iff_support_regular f).mpr (h f hf) })
'Semifilter.series_regular_criterion' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem Semifilter.series_saturation.{w} : ∀ {X : Type w} [Finite X] (V : Submodule (ZMod 2) (Semifilter.Series X))
  (hV : Semifilter.Invariant Semifilter.letter V),
  Semifilter.saturate Semifilter.letter (Semifilter.saturate Semifilter.letter V hV) ⋯ =
    Semifilter.saturate Semifilter.letter V hV :=
fun {X} [Finite X] V hV => Semifilter.saturate_idempotent Semifilter.letter V hV
'Semifilter.series_saturation' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem Semifilter.series_q3.{w} : ∀ {X : Type w} [Finite X] (V W : Submodule (ZMod 2) (Semifilter.Series X))
  (hV : Semifilter.Invariant Semifilter.letter V) (hW : Semifilter.Invariant Semifilter.letter W),
  Semifilter.saturate Semifilter.letter V hV = Semifilter.saturate Semifilter.letter W hW ↔
    V ≤ Semifilter.saturate Semifilter.letter W hW ∧ W ≤ Semifilter.saturate Semifilter.letter V hV :=
fun {X} [Finite X] V W hV hW => Semifilter.saturate_eq_iff_mutual Semifilter.letter V W hV hW
'Semifilter.series_q3' depends on axioms: [propext, Classical.choice, Quot.sound]
