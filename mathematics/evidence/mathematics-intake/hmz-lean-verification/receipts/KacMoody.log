info: AI4SSolutions/KacMoody.lean:270:0: theorem SerrePartial.graded_kernel_raising_stable.{u_1, u_2, u_3, u_4} : ∀ {K : Type u_1} {L : Type u_2} {I : Type u_3}
  {P : Type u_4} [inst : CommRing K] [inst_1 : LieRing L] [inst_2 : LieAlgebra K L] [inst_3 : DecidableEq I]
  (E F : I → L) (H : P → L) (coroot : I → P) (W R : ℕ → Submodule K L),
  R 0 = ⊥ →
    R 1 = ⊥ →
      (∀ (n : ℕ) (x : L), x ∈ R (n + 2) ↔ x ∈ W (n + 2) ∧ ∀ (i : I), ⁅F i, x⁆ ∈ R (n + 1)) →
        (∀ (i : I) (n : ℕ), ∀ x ∈ W n, ⁅E i, x⁆ ∈ W (n + 1)) →
          (∀ (n : ℕ) (p : P), ∀ x ∈ R n, ⁅H p, x⁆ ∈ R n) →
            (∀ (i j : I), ⁅F i, E j⁆ = if i = j then -H (coroot i) else 0) →
              ∀ (n : ℕ) (j : I), ∀ x ∈ R n, ⁅E j, x⁆ ∈ R (n + 1) :=
fun {K} {L} {I} {P} [CommRing K] [LieRing L] [LieAlgebra K L] [DecidableEq I] E F H coroot W R r0 r1 recurrence raising
    cartan_stable fe n =>
  Nat.strong_induction_on n fun n ih j x hx =>
    Nat.casesAuxOn (motive := fun a => n = a → ⁅E j, x⁆ ∈ R (n + 1)) n
      (fun h =>
        Eq.ndrec (motive := fun n =>
          (∀ m < n, ∀ (j : I), ∀ x ∈ R m, ⁅E j, x⁆ ∈ R (m + 1)) → x ∈ R n → ⁅E j, x⁆ ∈ R (n + 1))
          (fun ih hx =>
            have hx0 := Eq.mp (Eq.trans (congrFun' (congrArg Membership.mem r0) x) (Submodule.mem_bot._simp_1 K)) hx;
            of_eq_true
              (Eq.trans
                (congr (congrArg Membership.mem (congrArg R (zero_add 1)))
                  (Eq.trans (congrArg (Bracket.bracket (E j)) hx0) (lie_zero (E j))))
                (ZeroMemClass.zero_mem._simp_1 (R 1))))
          (Eq.symm h) ih hx)
      (fun n_1 h =>
        Eq.ndrec (motive := fun n =>
          (∀ m < n, ∀ (j : I), ∀ x ∈ R m, ⁅E j, x⁆ ∈ R (m + 1)) → x ∈ R n → ⁅E j, x⁆ ∈ R (n + 1))
          (fun ih hx =>
            Nat.casesAuxOn (motive := fun a => n_1 = a → ⁅E j, x⁆ ∈ R (n_1 + 1 + 1)) n_1
              (fun h =>
                Eq.ndrec (motive := fun n =>
                  (∀ m < n + 1, ∀ (j : I), ∀ x ∈ R m, ⁅E j, x⁆ ∈ R (m + 1)) → x ∈ R (n + 1) → ⁅E j, x⁆ ∈ R (n + 1 + 1))
                  (fun ih hx =>
                    have hx0 :=
                      Eq.mp
                        (Eq.trans (congrFun' (congrArg Membership.mem (Eq.trans (congrArg R (zero_add 1)) r1)) x)
                          (Submodule.mem_bot._simp_1 K))
                        hx;
                    of_eq_true
                      (Eq.trans
                        (congr (congrArg Membership.mem (congrArg R (congrFun' (congrArg HAdd.hAdd (zero_add 1)) 1)))
                          (Eq.trans (congrArg (Bracket.bracket (E j)) hx0) (lie_zero (E j))))
                        (ZeroMemClass.zero_mem._simp_1 (R 2))))
                  (Eq.symm h) ih hx)
              (fun n h =>
                Eq.ndrec (motive := fun n =>
                  (∀ m < n + 1, ∀ (j : I), ∀ x ∈ R m, ⁅E j, x⁆ ∈ R (m + 1)) → x ∈ R (n + 1) → ⁅E j, x⁆ ∈ R (n + 1 + 1))
                  (fun ih hx =>
                    have hparts := (recurrence n x).mp hx;
                    (recurrence (n + 1) ⁅E j, x⁆).mpr
                      ⟨raising j (n + 2) x hparts.left, fun i =>
                        have hr :=
                          ih (n + 1)
                            (Decidable.byContradiction fun a => SerrePartial.graded_kernel_cartan_stable._proof_1 n a) j
                            ⁅F i, x⁆ (hparts.right i);
                        Eq.mpr (id (congrArg (fun _a => _a ∈ R (n + 1 + 1)) (leibniz_lie (F i) (E j) x)))
                          (Eq.mpr (id (congrArg (fun _a => ⁅_a, x⁆ + ⁅E j, ⁅F i, x⁆⁆ ∈ R (n + 1 + 1)) (fe i j)))
                            (if hij : i = j then
                              Eq.mpr
                                (id
                                  (congrArg (Membership.mem (R (n + 1 + 1)))
                                    (congrFun'
                                      (congrArg HAdd.hAdd (congrFun' (congrArg Bracket.bracket (ite_eq_left hij)) x))
                                      ⁅E j, ⁅F i, x⁆⁆)))
                                (Eq.mpr
                                  (id
                                    (congrArg (fun _a => _a + ⁅E j, ⁅F i, x⁆⁆ ∈ R (n + 1 + 1))
                                      (neg_lie (H (coroot i)) x)))
                                  (Submodule.add_mem (R (n + 2))
                                    (Submodule.neg_mem (R (n + 2)) (cartan_stable (n + 2) (coroot i) x hx)) hr))
                            else
                              Eq.mpr
                                (id
                                  (congrArg (Membership.mem (R (n + 1 + 1)))
                                    (congrFun'
                                      (congrArg HAdd.hAdd (congrFun' (congrArg Bracket.bracket (ite_eq_right hij)) x))
                                      ⁅E j, ⁅F i, x⁆⁆)))
                                (Eq.mpr
                                  (id
                                    (congrArg (Membership.mem (R (n + 1 + 1)))
                                      (Eq.trans (congrFun' (congrArg HAdd.hAdd (zero_lie x)) ⁅E j, ⁅F i, x⁆⁆)
                                        (zero_add ⁅E j, ⁅F i, x⁆⁆))))
                                  hr)))⟩)
                  (Eq.symm h) ih hx)
              (Eq.refl n_1))
          (Eq.symm h) ih hx)
