info: AI4SSolutions/KacMoody.lean:274:0: theorem SerrePartial.generatorClosure_eq_lieIdeal.{u_1, u_2} : ∀ {K : Type u_1} {L : Type u_2} [inst : CommRing K]
  [inst_1 : LieRing L] [inst_2 : LieAlgebra K L] (s t : Set L),
  LieSubalgebra.lieSpan K L s = ⊤ →
    SerrePartial.generatorClosure s t = (LieIdeal.toLieSubalgebra K L (LieSubmodule.lieSpan K L t)).toSubmodule :=
fun {K} {L} [CommRing K] [LieRing L] [LieAlgebra K L] s t hgen =>
  le_antisymm
    (fun ⦃x⦄ hx =>
      id
        (fun hx =>
          SerrePartial.GeneratorClosure.rec (LieSubmodule.zero_mem (LieSubmodule.lieSpan K L t))
            (fun {x} ht => LieSubmodule.subset_lieSpan ht)
            (fun {x y} a a_1 hx hy => Submodule.add_mem (↑(LieSubmodule.lieSpan K L t)) hx hy)
            (fun r {x} a hx => Submodule.smul_mem (↑(LieSubmodule.lieSpan K L t)) r hx)
            (fun {x y} a a_1 hy => (LieSubmodule.lieSpan K L t).lie_mem hy) hx)
        hx)
    (let I :=
      SerrePartial.idealOfGeneratorStable s hgen (SerrePartial.generatorClosure s t) fun x hx y hy =>
        SerrePartial.GeneratorClosure.bracket hx hy;
    have hI :=
      Eq.mpr (id (congrArg (fun _a => _a) (propext LieSubmodule.lieSpan_le))) fun ⦃x⦄ hx =>
        SerrePartial.GeneratorClosure.seed hx;
    hI)
