info: AI4SSolutions/KacMoody.lean:272:0: theorem SerrePartial.lieSpan_stability.{u_1, u_2} : ∀ {K : Type u_1} {L : Type u_2} [inst : CommRing K]
  [inst_1 : LieRing L] [inst_2 : LieAlgebra K L] (s : Set L) (W : Submodule K L),
  (∀ x ∈ s, ∀ y ∈ W, ⁅x, y⁆ ∈ W) → ∀ x ∈ LieSubalgebra.lieSpan K L s, ∀ y ∈ W, ⁅x, y⁆ ∈ W :=
fun {K} {L} [CommRing K] [inst_1 : LieRing L] [inst_2 : LieAlgebra K L] s W hs x hx =>
  (fun x_0 x_1 x_2 x_3 x_4 => LieSubalgebra.lieSpan_induction K) L inst_1 inst_2 s (fun x hx => ∀ y ∈ W, ⁅x, y⁆ ∈ W)
    (fun x hx => hs x hx)
    (fun y hy => of_eq_true (Eq.trans (congrArg (Membership.mem W) (zero_lie y)) (ZeroMemClass.zero_mem._simp_1 W)))
    (fun x y hx hy hx_1 hy_1 z hz =>
      Eq.mpr (id (congrArg (fun _a => _a ∈ W) (add_lie x y z))) (Submodule.add_mem W (hx_1 z hz) (hy_1 z hz)))
    (fun r x hx hx_1 z hz =>
      Eq.mpr (id (congrArg (fun _a => _a ∈ W) (smul_lie r x z))) (Submodule.smul_mem W r (hx_1 z hz)))
    (fun x y hx hy hx_1 hy_1 z hz =>
      Eq.mpr (id (congrArg (fun _a => _a ∈ W) (lie_lie x y z)))
        (Submodule.sub_mem W (hx_1 ⁅y, z⁆ (hy_1 z hz)) (hy_1 ⁅x, z⁆ (hx_1 z hz))))
    hx
