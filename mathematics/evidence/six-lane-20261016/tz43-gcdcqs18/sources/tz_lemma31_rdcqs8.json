      [634, "%\\end{align*}"],
      [635, "Our $\\mathrm{CQS}(8^{4}:2)$ $(X,S,\\mathcal{G},\\mathcal{B})$ admits the automorphism group $\\mathcal{H}$ and the base blocks are listed as follows:"],
