{
  "scope": "all real common rates, two positive real outer rates, positive long cycle; z>4/5",
  "definitions": {
    "t": "v1+v2",
    "r": "v1*v2",
    "delta": "t^2-4r",
    "C": "negative e2-coefficient of F",
    "B": "F at e2=0",
    "M": "(r-t+1-z)^2+z*(t-2)^2"
  },
  "identity": "L=(s-4)*M^2/C after F=0",
  "C_delta_SOS": "delta**2 + 2*delta*(5*t**2 - 16*t + 4*z + 12) + (t**2 - 4*t + 4*z + 4)*(5*t**2 - 12*t + 4*z + 4)",
  "conclusion": "C>0 and M>0, hence positive long cycle forces s>4"
}
