   123	        reverse = {i: [] for i in range(len(labels))}
   124	        for s, t, _a, _b in edges:
   125	            reverse[t].append(s)
   126	        good, todo = {1}, [1]
   127	        while todo:
   128	            for s in reverse[todo.pop()]:
   129	                if s not in good:
   130	                    good.add(s)
   131	                    todo.append(s)
   132	        ids = {old: new for new, old in enumerate(sorted(good))}
   133	        return {"states": [labels[i] for i in sorted(good)], "start": ids[0], "accept": ids[1],
   134	                "edges": sorted(set((ids[s], ids[t], a, b) for s, t, a, b in edges
   135	                                    if s in good and t in good)), "filtered_minimal_leading": filtered}
