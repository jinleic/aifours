   238	def build_table(typ, n=0, m=0, order=None) -> WTable:
   239	    M = coxeter_matrix(typ, n, m)
   240	    if order is not None:
     1	"""Finite Coxeter groups as permutation groups on their root systems, and the
     2	Garside structure of the associated Artin monoid / Artin group.
     3	
     4	Independent of any rewriting system: elements of W are permutations of the
     5	root system (computed numerically from the Tits bilinear form and identified
     6	by rounding), and positive Artin-monoid elements are kept in left-greedy
     7	(Garside) normal form, i.e. a list of simple elements (= elements of W).
     8	
     9	Letters: generator i (0-based, i < n) is written chr(ord('a') + i); the
    10	Garside element Delta is '1' and Delta^{-1} is '0'.  Python string order
    11	'0' < '1' < 'a' < 'b' < ... is the letter order Delta^{-1} < Delta < s_1 < s_2 < ...
    12	used by Bokut (arXiv:0806.1125); deg-lex = compare (len, string).
    13	"""
    14	from __future__ import annotations
    15	
    16	import math
    17	from functools import lru_cache
    18	
    19	DINV, DELTA = "0", "1"
    20	
    21	
    22	def letter(i: int) -> str:
    23	    return chr(ord("a") + i)
    24	
    25	
    26	def index(c: str) -> int:
    27	    return ord(c) - ord("a")
