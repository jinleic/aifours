    73	def permute_matrix(M: list[list[int]], order: list[int]) -> list[list[int]]:
    74	    """Relabel: new generator k is old generator order[k]."""
    75	    return [[M[order[i]][order[j]] for j in range(len(M))] for i in range(len(M))]
