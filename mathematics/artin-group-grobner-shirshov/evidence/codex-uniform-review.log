    78	    def graph(self, filtered=True):
    79	        """All accepting paths are explicit rule pairs. Vertices 0=start,1=accept.
    80	        Edges (i,j,input,output); there is no edge out of the accept vertex.
    81	        State labels are serializable and deterministic."""
    82	        A = NFAutomaton(self.T) if filtered else None
    83	        labels = ["start", "accept"]
    84	        idx = {}
    85	        queue = deque()
    86	        edges = []
    87	
    88	        def add_state(key):
    89	            if key not in idx:
    90	                idx[key] = len(labels)
    91	                e, full, suffix = key
    92	                labels.append([e, sorted(full) if full is not None else None,
    93	                               sorted(suffix) if suffix is not None else None])
    94	                queue.append(key)
    95	            return idx[key]
    96	
    97	        for x, q, e, output in self.seeds():
    98	            full = A.step(frozenset(), x) if filtered else None
    99	            key = (e, full, frozenset() if filtered else None)
   100	            edges.append((0, add_state(key), chr(97 + x), output))
   101	        while queue:
   102	            key = queue.popleft()
   103	            e, full, suffix = key
   104	            for y in range(self.T.n):
   105	                if filtered:
   106	                    suffix2 = A.step(suffix, y)
   107	                    if suffix2 is None:
   108	                        continue
   109	                    full2 = A.step(full, y)
   110	                else:
   111	                    full2 = suffix2 = None
   112	                e2, output = self.step(e, y)
   113	                if e2 == self.T.e:
   114	                    if filtered:
   115	                        assert full2 is None
   116	                    dest = 1
   117	                elif filtered and full2 is None:
   118	                    continue  # a different witness killed the full prefix sooner
   119	                else:
   120	                    dest = add_state((e2, full2, suffix2))
   121	                edges.append((idx[key], dest, chr(97 + y), output))
