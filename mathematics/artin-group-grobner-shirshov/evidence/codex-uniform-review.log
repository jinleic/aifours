    31	class WTable:
    32	    """Integer-indexed finite Coxeter group with multiplication by generators."""
    33	
    34	    def __init__(self, W: Coxeter, limit: int = 200000):
    35	        self.W = W
    36	        n = self.n = W.n
    37	        elems = [W.e]
    38	        idx = {W.e: 0}
    39	        frontier = [W.e]
    40	        while frontier:
    41	            new = []
    42	            for w in frontier:
    43	                for i in range(n):
    44	                    v = W.rmul(w, i)
    45	                    if v not in idx:
    46	                        idx[v] = len(elems)
    47	                        elems.append(v)
    48	                        new.append(v)
    49	                        if len(elems) > limit:
    50	                            raise ValueError("group too large for tables")
    51	            frontier = new
    52	        self.size = len(elems)
    53	        self.rmul = [[idx[W.rmul(w, i)] for i in range(n)] for w in elems]
    54	        self.lmul = [[idx[W.lmul(i, w)] for w in elems] for i in range(n)]
    55	        pos = W.positive
    56	        posidx = [k for k in range(W.nroots) if pos[k]]
    57	        self.length = []
    58	        self.ld = []
    59	        self.rd = []
    60	        self.inv = []  # left inversion set bitmask: {alpha>0 : w^{-1} alpha < 0}
    61	        for w in elems:
    62	            wi = W.inv(w)
    63	            self.length.append(sum(1 for k in posidx if not pos[w[k]]))
    64	            self.rd.append(sum(1 << i for i in range(n) if not pos[w[W.sidx[i]]]))
    65	            self.ld.append(sum(1 << i for i in range(n) if not pos[wi[W.sidx[i]]]))
    66	            bits = 0
    67	            for b, k in enumerate(posidx):
    68	                if not pos[wi[k]]:
    69	                    bits |= 1 << b
    70	            self.inv.append(bits)
    71	        self.e = 0
    72	        self.w0 = idx[W.w0]
    73	        self.gen = [idx[W.gen[i]] for i in range(n)]
    74	        self.phi = W.phi
    75	        self.M = W.M
    76	        self._join = {}
    77	
    78	    def leq(self, a: int, b: int) -> bool:
    79	        """a <= b in the prefix (right weak) order = left divisibility of simples."""
    80	        ia = self.inv[a]
    81	        return ia & self.inv[b] == ia
    82	
    83	    def word_elem(self, letters: list[int]) -> int:
    84	        w = self.e
    85	        for i in letters:
    86	            w = self.rmul[w][i]
    87	        return w
    88	
    89	    def alt(self, s: int, t: int, k: int) -> int:
    90	        return self.word_elem([s if j % 2 == 0 else t for j in range(k)])
    91	
    92	    def join(self, a: int, b: int) -> int:
    93	        if self.leq(a, b):
    94	            return b
    95	        if self.leq(b, a):
    96	            return a
    97	        key = (a, b)
    98	        r = self._join.get(key)
    99	        if r is not None:
   100	            return r
   101	        lda, ldb = self.ld[a], self.ld[b]
   102	        common = lda & ldb
   103	        if common:
   104	            s = (common & -common).bit_length() - 1
   105	            r = self.lmul[s][self.join(self.lmul[s][a], self.lmul[s][b])]
   106	        else:
   107	            s = (lda & -lda).bit_length() - 1
   108	            t = (ldb & -ldb).bit_length() - 1
   109	            # s v t: Delta_{st} = t * Pi_{m-1}(s,t); s v b = t * (Pi_{m-1}(s,t) v t^{-1}b)
   110	            m = self.M[s][t]
   111	            pst = self.alt(s, t, m - 1)
   112	            sb = self.lmul[t][self.join(pst, self.lmul[t][b])]
   113	            r = self.join(a, sb)
   114	        self._join[key] = r
   115	        return r
   116	
   117	    def complement(self, y: int, c: int) -> int:
   118	        """y\\c = y^{-1} (y v c) for an atom y and a simple element c."""
   119	        if (self.ld[c] >> y) & 1:
   120	            return self.lmul[y][c]
   121	        return self.lmul[y][self.join(self.gen[y], c)]
