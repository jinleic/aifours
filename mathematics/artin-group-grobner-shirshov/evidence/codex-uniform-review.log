    25	def series_mul(a, b, L):
    26	    c = [0] * (L + 1)
    27	    for i, x in enumerate(a[: L + 1]):
    28	        if x:
    29	            for j, y in enumerate(b[: L + 1 - i]):
    30	                c[i + j] += x * y
    31	    return c
    32	
    33	
    34	def series_inv(a, L):
    35	    assert a[0] == 1
    36	    b = [0] * (L + 1)
    37	    b[0] = 1
    38	    for k in range(1, L + 1):
    39	        b[k] = -sum(a[j] * b[k - j] for j in range(1, min(k, len(a) - 1) + 1))
    40	    return b
    41	
    42	
    43	def growth_counts(W, L, mode="group"):
    44	    """Coefficients of growth series, from M(t) = 1 / sum_{T subset S} (-1)^{|T|} t^{N_T}
    45	    (Deligne/Saito formula for the Artin monoid; N_T = number of positive roots of W_T):
    46	      mode="monoid":   M(t)                         (all positive elements)
    47	      mode="positive": (1 - t^N) M(t)               (Delta-free positive elements)
    48	      mode="group":    (1 - t^N) M(t) (1+t)/(1-t)   (group, generators {s_i, Delta^{+-1}})."""
    49	    from itertools import combinations
    50	
    51	    from coxeter import Coxeter
    52	
    53	    n = W.n
    54	    den = [0] * (max(L, W.N) + 1)
    55	    for r in range(n + 1):
    56	        for T in combinations(range(n), r):
    57	            if T:
    58	                MT = [[W.M[i][j] for j in T] for i in T]
    59	                NT = Coxeter(MT).N
    60	            else:
    61	                NT = 0
    62	            if NT <= L:
    63	                den[NT] += (-1) ** r
    64	    Mser = series_inv(den, L)
    65	    one_minus = [0] * (L + 1)
    66	    one_minus[0] = 1
    67	    if W.N <= L:
    68	        one_minus[W.N] = -1
    69	    if mode == "monoid":
    70	        return Mser
    71	    F = series_mul(Mser, one_minus, L)
    72	    if mode == "positive":
    73	        return F
    74	    geo = [1] + [2] * L  # (1+t)/(1-t)
    75	    return series_mul(F, geo, L)
