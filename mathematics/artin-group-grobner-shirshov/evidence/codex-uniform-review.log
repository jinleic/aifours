   172	# ---------------------------------------------------------------- Garside normal form
   173	class Garside:
   174	    """Positive elements of the Artin monoid as left-greedy normal forms
   175	    (lists of non-trivial simple elements), and the Artin group as pairs
   176	    (k, F) meaning Delta^k * F with F not divisible by Delta."""
   177	
   178	    def __init__(self, W: Coxeter):
   179	        self.W = W
   180	        self._ldesc = {}
   181	        self._rdesc = {}
   182	
   183	    def ld(self, w):
   184	        r = self._ldesc.get(w)
   185	        if r is None:
   186	            r = self._ldesc[w] = self.W.ldesc(w)
   187	        return r
   188	
   189	    def rd(self, w):
   190	        r = self._rdesc.get(w)
   191	        if r is None:
   192	            r = self._rdesc[w] = self.W.rdesc(w)
   193	        return r
   194	
   195	    def normalize(self, F: list) -> list:
   196	        """Left-greedy normal form of a product of simple elements."""
   197	        W = self.W
   198	        F = [f for f in F if f != W.e]
   199	        changed = True
   200	        while changed:
   201	            changed = False
   202	            for j in range(len(F) - 1):
   203	                a, b = F[j], F[j + 1]
   204	                while True:
   205	                    move = self.ld(b) - self.rd(a)
   206	                    if not move:
   207	                        break
   208	                    s = min(move)
   209	                    a = W.rmul(a, s)
   210	                    b = W.lmul(s, b)
   211	                    changed = True
   212	                F[j], F[j + 1] = a, b
   213	            if changed:
   214	                F = [f for f in F if f != W.e]
   215	        return F
   216	
   217	    def times_atom(self, F: list, i: int) -> list:
   218	        return self.normalize(F + [self.W.gen[i]])
   219	
   220	    # ---- group elements: (k, F)
   221	    def group_mul_letter(self, state, c: str):
   222	        """Right multiplication by a letter: 'a'.. = s_i, '1' = Delta, '0' = Delta^{-1},
   223	        'A'.. = s_i^{-1} (= Delta^{-1} * simple(w0 s_i))."""
   224	        k, F = state
   225	        W = self.W
   226	        if c == DELTA:
   227	            return (k + 1, [W.conj_w0(f) for f in F])
   228	        if c == DINV:
   229	            return (k - 1, [W.conj_w0(f) for f in F])
   230	        if c.isupper():
   231	            i = ord(c) - ord("A")
   232	            F = self.normalize([W.conj_w0(f) for f in F] + [W.rmul(W.w0, i)])
   233	            k -= 1
   234	        else:
   235	            F = self.times_atom(F, index(c))
   236	        while F and F[0] == W.w0:
   237	            F = F[1:]
   238	            k += 1
   239	        return (k, F)
   240	
   241	    def group_state(self, word: str):
   242	        st = (0, [])
   243	        for c in word:
   244	            st = self.group_mul_letter(st, c)
   245	        return st
   246	
   247	    def lexmin(self, F: list) -> str:
   248	        """deg-lex smallest positive word for the positive element F."""
   249	        W = self.W
   250	        F = list(F)
   251	        out = []
   252	        while F:
   253	            s = min(self.ld(F[0]))
   254	            out.append(letter(s))
   255	            F[0] = W.lmul(s, F[0])
   256	            F = self.normalize(F)
   257	        return "".join(out)
   258	
   259	    def nf_state(self, state) -> str:
   260	        k, F = state
   261	        return (DELTA * k if k >= 0 else DINV * (-k)) + self.lexmin(F)
   262	
   263	    def nf(self, word: str) -> str:
   264	        return self.nf_state(self.group_state(word))
   265	
   266	    def delta_word(self) -> str:
   267	        return self.lexmin([self.W.w0])
   268	
   269	
   270	def build(typ: str, n: int = 0, m: int = 0, order: list[int] | None = None) -> Garside:
   271	    M = coxeter_matrix(typ, n, m)
   272	    if order is not None:
   273	        M = permute_matrix(M, order)
   274	    return Garside(Coxeter(M))

