    30	# ---------------------------------------------------------------- Coxeter data
    31	def coxeter_matrix(typ: str, n: int = 0, m: int = 0) -> list[list[int]]:
    32	    """Coxeter matrix with Bourbaki numbering (node k -> row k-1)."""
    33	    def chain(k: int) -> list[list[int]]:
    34	        M = [[2] * k for _ in range(k)]
    35	        for i in range(k):
    36	            M[i][i] = 1
    37	        for i in range(k - 1):
    38	            M[i][i + 1] = M[i + 1][i] = 3
    39	        return M
    40	
    41	    if typ == "A":
    42	        return chain(n)
    43	    if typ == "B":  # s1 - s2 - ... - s_{n-1} =4= s_n
    44	        M = chain(n)
    45	        M[n - 2][n - 1] = M[n - 1][n - 2] = 4
    46	        return M
    47	    if typ == "D":  # chain s1..s_{n-1}, and s_n joined to s_{n-2}
    48	        M = chain(n)
    49	        M[n - 2][n - 1] = M[n - 1][n - 2] = 2
    50	        M[n - 3][n - 1] = M[n - 1][n - 3] = 3
    51	        return M
    52	    if typ == "E":  # 1-3-4-5-6(-7-8), 2-4
    53	        M = [[2] * n for _ in range(n)]
    54	        for i in range(n):
    55	            M[i][i] = 1
    56	        edges = [(1, 3), (3, 4), (4, 5), (5, 6), (2, 4)] + [(k, k + 1) for k in range(6, n)]
    57	        for i, j in edges:
    58	            M[i - 1][j - 1] = M[j - 1][i - 1] = 3
    59	        return M
    60	    if typ == "F":  # 1 - 2 =4= 3 - 4
    61	        M = chain(4)
    62	        M[1][2] = M[2][1] = 4
    63	        return M
    64	    if typ == "H":  # 1 =5= 2 - 3 (- 4)
    65	        M = chain(n)
    66	        M[0][1] = M[1][0] = 5
    67	        return M
    68	    if typ == "I":
    69	        return [[1, m], [m, 1]]
    70	    raise ValueError(typ)
