     1	"""Reduced deg-lex Groebner-Shirshov basis of a finite-type Artin group in the
     2	Artin-Garside generators, computed from the Garside normal-form oracle.
     3	
     4	For a deg-lex order the irreducible words of the (unique) reduced GS basis
     5	are the deg-lex-smallest words of their group elements, and the reduced GS
     6	basis is {u -> NF(u) : u reducible, every proper factor of u irreducible}.
     7	This script enumerates that set for leading words of length <= L by a
     8	breadth-first search over irreducible words (independent of any rewriting
     9	or completion procedure).
    10	
    11	Usage: python3 work/gs_oracle.py TYPE n [m] L [--positive] [--order 0,1,2]
    12	Output: JSON lines to stdout: {"lhs":..., "rhs":...}, then a summary line
    13	with the irreducible-word counts by length.
    14	"""
    15	from __future__ import annotations
    16	
    17	import argparse
    18	import json
    19	import sys
    20	
    21	sys.path.insert(0, __file__.rsplit("/", 1)[0])
    22	from coxeter import DELTA, DINV, build, letter  # noqa: E402
