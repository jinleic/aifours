   124	class NFAutomaton:
   125	    def __init__(self, T: WTable, monoid: bool = False):
   126	        if T.W.N < 2:
   127	            raise ValueError("Theorem B automaton needs N >= 2 (type A1 is treated by hand)")
   128	        self.T = T
   129	        self.monoid = monoid
   130	        n = T.n
   131	        # obligations created when reading letter y
   132	        self.created = []
   133	        for y in range(n):
   134	            obs = set()
   135	            for t in range(y):
   136	                m = T.M[t][y]
   137	                obs.add(T.alt(t, y, m - 1))
   138	            if not monoid:
   139	                obs.add(T.lmul[y][T.w0])
   140	            self.created.append(frozenset(obs))
   141	        self._trans = {}
   142	
   143	    def minimal(self, S) -> frozenset:
   144	        T = self.T
   145	        S = list(S)
   146	        out = [c for c in S if not any(d != c and T.leq(d, c) for d in S)]
   147	        return frozenset(out)
   148	
   149	    def step(self, O: frozenset, y: int):
   150	        """Return the next state, or None if the word dies."""
   151	        key = (O, y)
   152	        r = self._trans.get(key, 0)
   153	        if r != 0:
   154	            return r
   155	        T = self.T
   156	        new = set(self.created[y])
   157	        dead = False
   158	        for c in O:
   159	            d = T.complement(y, c)
   160	            if d == T.e:
   161	                dead = True
   162	                break
   163	            new.add(d)
   164	        r = None if dead else self.minimal(new)
   165	        self._trans[key] = r
   166	        return r
   167	
   168	    def count_nf(self, L: int) -> list[int]:
   169	        cur = {frozenset(): 1}
   170	        counts = [1]
   171	        for _ in range(L):
   172	            nxt = {}
   173	            for O, k in cur.items():
   174	                for y in range(self.T.n):
   175	                    O2 = self.step(O, y)
   176	                    if O2 is not None:
   177	                        nxt[O2] = nxt.get(O2, 0) + k
   178	            cur = nxt
   179	            counts.append(sum(cur.values()))
   180	        return counts, len(self._states_seen(cur))
   181	
   182	    def _states_seen(self, cur):
   183	        return {O for (O, _y), v in self._trans.items()} | set(cur)
   184	
   185	    def count_minred(self, L: int) -> list[int]:
   186	        """Number of minimal reducible positive words of each length <= L."""
   187	        n = self.T.n
   188	        counts = [0, 0]
   189	        cur = {}
   190	        for y in range(n):
   191	            O1 = self.step(frozenset(), y)
   192	            if O1 is not None:
   193	                key = (O1, frozenset())
   194	                cur[key] = cur.get(key, 0) + 1
   195	        for _ in range(2, L + 1):
   196	            nxt = {}
   197	            c = 0
   198	            for (Of, Os), k in cur.items():
   199	                for y in range(n):
   200	                    Os2 = self.step(Os, y)
   201	                    if Os2 is None:
   202	                        continue
   203	                    Of2 = self.step(Of, y)
   204	                    if Of2 is None:
   205	                        c += k
   206	                    else:
   207	                        key = (Of2, Os2)
   208	                        nxt[key] = nxt.get(key, 0) + k
   209	            counts.append(c)
   210	            cur = nxt
   211	        return counts, len(cur)
   212	
   213	    def minred_words(self, L: int):
   214	        """Enumerate minimal reducible positive words of length <= L."""
   215	        n = self.T.n
   216	        out = []
   217	        stack = []
   218	        for y in range(n):
   219	            O1 = self.step(frozenset(), y)
   220	            if O1 is not None:
   221	                stack.append((letter(y), O1, frozenset()))
   222	        while stack:
   223	            w, Of, Os = stack.pop()
   224	            if len(w) >= L:
   225	                continue
   226	            for y in range(n):
   227	                Os2 = self.step(Os, y)
   228	                if Os2 is None:
   229	                    continue
   230	                Of2 = self.step(Of, y)
   231	                if Of2 is None:
   232	                    out.append(w + letter(y))
   233	                else:
   234	                    stack.append((w + letter(y), Of2, Os2))
   235	        return sorted(out, key=lambda u: (len(u), u))
