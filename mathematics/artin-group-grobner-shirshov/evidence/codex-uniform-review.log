   198	def scc_report(table):
   199	    A = NFAutomaton(table)
   200	    starts, edges = pair_graph(A)
   201	    graph = trim(starts, edges)
   202	    components = sccs(graph)
   203	    multi = []
   204	    for comp in components:
   205	        vertices = set(comp)
   206	        internal = [(s, y, t) for s in comp for y, t in graph[s] if t != ACC and t in vertices]
   207	        if len(internal) > len(comp):
   208	            # Stable state names use explicit obligation sets, not arbitrary object IDs.
   209	            vertices = sorted(comp, key=lambda p: (sorted(p[0]), sorted(p[1])))
   210	            index = {s: i for i, s in enumerate(vertices)}
   211	            multi.append({"states": [[sorted(s[0]), sorted(s[1])] for s in vertices],
   212	                          "edges": sorted((index[s], index[t], chr(97 + y)) for s, y, t in internal)})
   213	    return multi
