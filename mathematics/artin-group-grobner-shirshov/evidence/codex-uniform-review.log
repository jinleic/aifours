   138	class PairRegex:
   139	    """Hash-consed expression DAG. Nodes always reference lower-indexed nodes."""
   140	    def __init__(self):
   141	        self.nodes = [["empty"], ["epsilon"]]
   142	        self.cache = {("empty",): 0, ("epsilon",): 1}
   143	
   144	    def node(self, op, *args):
   145	        key = (op,) + args
   146	        if key not in self.cache:
   147	            self.cache[key] = len(self.nodes)
   148	            self.nodes.append(list(key))
   149	        return self.cache[key]
   150	
   151	    def add(self, a, b):
   152	        if a == 0 or a == b:
   153	            return b
   154	        if b == 0:
   155	            return a
   156	        return self.node("union", *sorted((a, b)))
   157	
   158	    def cat(self, a, b):
   159	        if 0 in (a, b):
   160	            return 0
   161	        if a == 1:
   162	            return b
   163	        if b == 1:
   164	            return a
   165	        return self.node("concat", a, b)
   166	
   167	    def star(self, a):
   168	        return 1 if a in (0, 1) else self.node("star", a)
   169	
   170	    def eliminate(self, graph):
   171	        edges = {}
   172	        for i, j, a, b in graph["edges"]:
   173	            edges[i, j] = self.add(edges.get((i, j), 0), self.node("pair", a, b))
   174	        remaining = set(range(len(graph["states"]))) - {graph["start"], graph["accept"]}
   175	        order = []
   176	        while remaining:
   177	            incoming, outgoing = {}, {}
   178	            for (i, j), label in edges.items():
   179	                if label and i != j:
   180	                    outgoing.setdefault(i, set()).add(j)
   181	                    incoming.setdefault(j, set()).add(i)
   182	            k = min(remaining, key=lambda v: (len(incoming.get(v, ())) * len(outgoing.get(v, ())), v))
   183	            left, right = sorted(incoming.get(k, ())), sorted(outgoing.get(k, ()))
   184	            loop = self.star(edges.get((k, k), 0))
   185	            for i in left:
   186	                prefix = self.cat(edges[i, k], loop)
   187	                for j in right:
   188	                    edges[i, j] = self.add(edges.get((i, j), 0), self.cat(prefix, edges[k, j]))
   189	            for key in [key for key in edges if k in key]:
   190	                del edges[key]
   191	            remaining.remove(k)
   192	            order.append(k)
   193	        root = edges.get((graph["start"], graph["accept"]), 0)
   194	        return {"nodes": self.nodes, "root": root, "elimination_order": order,
   195	                "semantics": "paired words; union, coordinatewise concat, coupled Kleene star"}
   196	
