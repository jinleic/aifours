   189	    # length as affine function: const + sum coef*p
   190	    cL = sum(len(a) for a in A)
   191	    cR = sum(len(b) for b in B)
   192	    coefL = [len(x) for x in X]
   193	    coefR = [len(y) for y in Y]
   194	    if any(a < b for a, b in zip(coefL, coefR)) or cL < cR:
