     1	"""Independent check of Theorem 2.3 of Iqbal-Munir-Ayub-Nizami, 'Complete
     2	presentation and Hilbert series of the mixed braid monoid MB_{1,3}',
     3	Rev. Un. Mat. Argentina 67(2) (2024) 503-516 (sources/iqbal-et-al-2024-type-b3-monoid.*).
     4	
     5	MB_{1,3} = <z1,z2,z3 | z3z1=z1z3, z3z2z3=z2z3z2, z2z1z2z1=z1z2z1z2> is the Artin
     6	monoid of type B3 (4 between z1,z2).  Order z1<z2<z3, length-lex.  In our
     7	coxeter.py labelling (Bourbaki s1-s2=4=s3): z1=s3, z2=s2, z3=s1, i.e. order
     8	[2,1,0]; letters a=z1, b=z2, c=z3.
     9	
    10	Interpretation of the families (stated in the paper with n,n1,... in N): we test
    11	exponents >= 1, and for R9-R11 the bracket '(z2^n z1^n1 z2^n2 ...)' as an
    12	alternating product of positive powers whose tail after the first two powers
    13	is any (possibly empty) word over {z1,z2} beginning with z2.  We check
    14	 (1) validity of every instance up to length L (Garside normal form), and
    15	 (2) coverage: every minimal non-lexmin word of the monoid (the leading words
    16	     of the reduced GS basis, computed independently) of length <= L is a
    17	     leading word of the paper's list -- necessary for a GS basis (Lemma 1).
    18	Usage: python3 work/check_iqbal2024.py [L] [--corrected]
    19	  --corrected: R3, R6, R9 with z2^(n+1) instead of z2^n on the left (as printed
    20	  they are length-inconsistent: |LHS| = |RHS| - 1 for every n).
    21	"""
    22	import itertools
    23	import json
    24	import sys
    25	
    26	sys.path.insert(0, __file__.rsplit("/", 1)[0])
    27	from coxeter import build  # noqa: E402
    28	from gs_oracle import enumerate_basis  # noqa: E402
    29	
    30	L = int(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].isdigit() else 12
    31	CORR = "--corrected" in sys.argv
    32	K = 1 if CORR else 0  # extra z2 on the left of R3, R6, R9
    33	G = build("B", 3, 0, [2, 1, 0])
    34	a, b, c = "a", "b", "c"
    35	
    36	
    37	def tails(maxlen):
    38	    """words over {a,b} that are empty or begin with b, length <= maxlen"""
    39	    out = [""]
    40	    for n in range(1, maxlen + 1):
    41	        for w in itertools.product("ab", repeat=n):
    42	            if w[0] == "b":
    43	                out.append("".join(w))
    44	    return out
    45	
    46	
    47	def fams(L):
    48	    R = []
    49	    E = range(1, L + 1)
    50	    R.append(("R0", "ca", "ac"))
    51	    R.append(("Rbr1", "cbc", "bcb"))
    52	    R.append(("Rbr2", "baba", "abab"))
    53	    for n in range(0, L):
    54	        R.append(("R1", "b" + "a" * (n + 1) + "bab", "ababb" + "a" * n))
    55	    for n in E:
    56	        R.append(("R2", "cb" + "a" * n + "c", "bcb" + "a" * n))
    57	        R.append(("R3", "c" + "b" * (n + K) + "cb", "bcbb" + "c" * n))
    58	        R.append(("R5", "cbab" + "b" * (n - 1) + "cb", "bcbab" + "c" * n))
    59	        for n1 in E:
    60	            R.append(("R4", "cb" + "a" * n + "b" * n1 + "cb", "bcb" + "a" * n + "b" + "c" * n1))
    61	            R.append(("R6", "c" + "b" * (n + K) + "a" * n1 + "cbab", "bcbba" + "c" * n + "ba" + "a" * (n1 - 1)))
    62	            R.append(("R8", "cba" + "b" * n + "a" * n1 + "cbab", "bacbab" + "c" * n + "b" + "a" * n1))
    63	            for n2 in E:
    64	                R.append(("R7", "cb" + "a" * n + "b" * n1 + "a" * n2 + "cbab",
    65	                          "bcb" + "a" * n + "ba" + "c" * n1 + "b" + "a" * n2))
    66	    for n in E:
    67	        for n1 in E:
    68	            for t in tails(L):
