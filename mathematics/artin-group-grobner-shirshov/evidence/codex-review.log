    21	
    22	
    23	def gt(x: str, y: str) -> bool:
    24	    return (len(x), x) > (len(y), y)
    25	
    26	
    27	class KB:
    28	    def __init__(self):
    29	        self.rules: dict[str, str] = {}
    30	        self.lens: list[int] = []
    31	        self.pre: dict[str, set[str]] = defaultdict(set)  # proper prefix -> lhs
    32	        self.suf: dict[str, set[str]] = defaultdict(set)  # proper suffix -> lhs
    33	        self.truncated = 0  # equations whose reduced left side exceeded maxlen
    34	        self.skipped_overlaps = 0  # critical pairs longer than maxlen (not computed)
    35	
    36	    # ------------------------------------------------------------ reduction
    37	    def reduce(self, w: str) -> str:
    38	        rules, lens = self.rules, self.lens
    39	        out: list[str] = []
    40	        inp = list(reversed(w))
    41	        while inp:
    42	            out.append(inp.pop())
    43	            n = len(out)
    44	            for L in lens:
    45	                if L > n:
    46	                    break
    47	                r = rules.get("".join(out[n - L:]))
    48	                if r is not None:
    49	                    del out[n - L:]
    50	                    inp.extend(reversed(r))
    51	                    break
    52	        return "".join(out)
    53	
    54	    # ------------------------------------------------------------ rule set
    55	    def _index(self, l: str) -> None:
    56	        for k in range(1, len(l)):
    57	            self.pre[l[:k]].add(l)
    58	            self.suf[l[-k:]].add(l)
    59	
    60	    def _unindex(self, l: str) -> None:
    61	        for k in range(1, len(l)):
    62	            self.pre[l[:k]].discard(l)
    63	            self.suf[l[-k:]].discard(l)
    64	
    65	    def _set_lens(self) -> None:
    66	        self.lens = sorted({len(l) for l in self.rules})
    67	
    68	    def _add(self, l: str, r: str, queue) -> None:
    69	        # inter-reduce: rules whose lhs contains l are removed and re-queued
    70	        doomed = [l2 for l2 in self.rules if l in l2]
    71	        for l2 in doomed:
    72	            r2 = self.rules.pop(l2)
    73	            self._unindex(l2)
    74	            heapq.heappush(queue, (len(l2), l2, r2))
    75	        self.rules[l] = r
    76	        self._index(l)
    77	        self._set_lens()
    78	        # right sides are kept reduced
    79	        for l2, r2 in list(self.rules.items()):
    80	            if l in r2:
    81	                self.rules[l2] = self.reduce(r2)
    82	
    83	    # ------------------------------------------------------------ completion
    84	    def complete(self, equations, maxlen: int, verbose: bool = False) -> None:
    85	        queue: list = []
    86	        for s, t in equations:
    87	            heapq.heappush(queue, (max(len(s), len(t)), s, t))
    88	        added = 0
    89	        while queue:
    90	            _, s, t = heapq.heappop(queue)
    91	            s, t = self.reduce(s), self.reduce(t)
    92	            if s == t:
    93	                continue
    94	            if gt(t, s):
    95	                s, t = t, s
    96	            if len(s) > maxlen:
    97	                self.truncated += 1
    98	                continue
    99	            self._add(s, t, queue)
   100	            added += 1
   101	            if verbose and added % 500 == 0:
   102	                print("rules", len(self.rules), "queue", len(queue), flush=True)
   103	            # critical pairs of s->t with every rule (including itself)
   104	            l1, r1 = s, t
   105	            for k in range(1, len(l1)):
   106	                # suffix of l1 == proper prefix of l2
   107	                for l2 in list(self.pre.get(l1[-k:], ())):
   108	                    if len(l1) + len(l2) - k > maxlen:
   109	                        self.skipped_overlaps += 1
   110	                        continue
   111	                    if l2 not in self.rules:
   112	                        continue
   113	                    r2 = self.rules[l2]
   114	                    w1 = r1 + l2[k:]
   115	                    w2 = l1[:-k] + r2
   116	                    heapq.heappush(queue, (len(l1) + len(l2) - k, w1, w2))
   117	                # suffix of l2 == proper prefix of l1
   118	                for l2 in list(self.suf.get(l1[:k], ())):
   119	                    if len(l1) + len(l2) - k > maxlen:
   120	                        self.skipped_overlaps += 1
   121	                        continue
   122	                    if l2 not in self.rules:
   123	                        continue
   124	                    r2 = self.rules[l2]
   125	                    w1 = r2 + l1[k:]
   126	                    w2 = l2[:-k] + r1
   127	                    heapq.heappush(queue, (len(l1) + len(l2) - k, w1, w2))
   128	        # final normalisation of right sides
   129	        for l2, r2 in list(self.rules.items()):
   130	            self.rules[l2] = self.reduce(r2)
     1	"""Run the (independent) Knuth-Bendix completion on the Artin-Garside
     2	presentation of A(W) and compare its rules with leading words of length <= L
     3	against the Garside-oracle reduced GS basis (and, optionally, an explicit
     4	family spec).
     5	
     6	Presentation fed to KB (letters '0' = Delta^-1 < '1' = Delta < 'a' < 'b' < ...):
     7	  braid relations;  Delta = (a positive word for Delta);  Delta Delta^-1 = 1 = Delta^-1 Delta;
     8	  s Delta = Delta phi(s), s Delta^-1 = Delta^-1 phi(s)  (standard consequences, added
     9	  so that the truncated completion does not need overlaps longer than maxlen).
    10	
    11	Usage: python3 work/kb_compare.py TYPE n --order 0,2,1 --maxlen 14 --L 12 [--m M] [--spec B3]
    12	"""
    13	from __future__ import annotations
    14	
    15	import argparse
    16	import json
    17	import sys
    18	import time
    19	
    20	sys.path.insert(0, __file__.rsplit("/", 1)[0])
    21	from coxeter import build  # noqa: E402
    22	from gs_oracle import enumerate_basis  # noqa: E402
    23	from kb import KB  # noqa: E402
    24	from specs import SPECS, alt  # noqa: E402
    25	
    26	
    27	def main():
    28	    ap = argparse.ArgumentParser()
    29	    ap.add_argument("typ")
    30	    ap.add_argument("n", type=int)
    31	    ap.add_argument("--m", type=int, default=0)
    32	    ap.add_argument("--order", default=None)
    33	    ap.add_argument("--maxlen", type=int, default=14)
    34	    ap.add_argument("--L", type=int, default=12)
    35	    ap.add_argument("--spec", default=None)
    36	    ap.add_argument("--monoid", action="store_true", help="Artin monoid only (no Delta letters)")
    37	    a = ap.parse_args()
    38	    order = [int(x) for x in a.order.split(",")] if a.order else None
    39	    G = build(a.typ, a.n, a.m, order)
    40	    W = G.W
    41	    gens = [chr(97 + i) for i in range(W.n)]
    42	    eqs = []
    43	    for i in range(W.n):
    44	        for j in range(i + 1, W.n):
    45	            eqs.append((alt(gens[i], gens[j], W.M[i][j]), alt(gens[j], gens[i], W.M[i][j])))
    46	    if not a.monoid:
    47	        # any positive word for Delta: a reduced word of w0 built greedily in W (not the lexmin one)
    48	        w, word = W.e, []
    49	        while True:
    50	            asc = [i for i in range(W.n) if i not in W.rdesc(w)]
    51	            if not asc:
    52	                break
    53	            i = asc[-1]
    54	            w = W.rmul(w, i)
    55	            word.append(gens[i])
    56	        eqs.append(("".join(word), "1"))
    57	        eqs += [("10", ""), ("01", "")]
    58	        for i in range(W.n):
    59	            eqs.append((gens[i] + "1", "1" + gens[W.phi[i]]))
    60	            eqs.append((gens[i] + "0", "0" + gens[W.phi[i]]))
    61	    t0 = time.time()
    62	    rws = KB()
    63	    rws.complete(eqs, a.maxlen)
    64	    t1 = time.time()
    65	    kb_rules = {l: r for l, r in rws.rules.items() if len(l) <= a.L}
    66	    rules, _ = enumerate_basis(G, a.L, monoid=a.monoid)
    67	    oracle = dict(rules)
    68	    rep = {"type": a.typ, "n": a.n, "m": a.m, "order": order, "monoid": a.monoid,
    69	           "maxlen": a.maxlen, "L": a.L, "kb_seconds": round(t1 - t0, 1),
    70	           "kb_rules_total": len(rws.rules), "kb_discarded_long_equations": rws.truncated,
    71	           "kb_skipped_long_overlaps": rws.skipped_overlaps,
    72	           "kb_rules_le_L": len(kb_rules), "oracle_rules_le_L": len(oracle),
    73	           "kb_equals_oracle": kb_rules == oracle}
    74	    if kb_rules != oracle:
    75	        rep["only_kb"] = sorted(set(kb_rules) - set(oracle))[:20]
    76	        rep["only_oracle"] = sorted(set(oracle) - set(kb_rules))[:20]
    77	    if a.spec:
    78	        from certify import expand, instances_upto
    79	        spec = SPECS[a.spec]()
    80	        inst = instances_upto([expand(f) for f in spec["families"]], a.L)
    81	        rep["kb_equals_spec"] = kb_rules == inst
    82	    print(json.dumps(rep))
    83	
    84	
    85	if __name__ == "__main__":
    86	    main()
     1	"""Group oracle rules into run-length 'skeleton' families for inspection.
     2	
     3	Usage: python3 work/families.py evidence/oracle/FILE.jsonl
     4	Prints, for each LHS skeleton (sequence of run letters), the list of
     5	(LHS exponents -> RHS run-length word).
     6	"""
     7	import itertools
     8	import json
     9	import sys
    10	from collections import defaultdict
    11	
    12	
    13	def runs(w):
    14	    return [(c, len(list(g))) for c, g in itertools.groupby(w)]
    15	
    16	
    17	def rl(w):
    18	    return " ".join(c if k == 1 else f"{c}^{k}" for c, k in runs(w))
    19	
    20	
    21	def main():
    22	    fams = defaultdict(list)
    23	    for line in open(sys.argv[1]):
    24	        d = json.loads(line)
    25	        if "lhs" not in d:
    26	            print("#", {k: d[k] for k in ("irreducible_counts", "match", "delta", "nrules") if k in d})
    27	            continue
    28	        sk = "".join(c for c, _ in runs(d["lhs"]))
    29	        fams[sk].append((tuple(k for _, k in runs(d["lhs"])), d["rhs"]))
    30	    for sk in sorted(fams, key=lambda s: (min(sum(e) for e, _ in fams[sk]), s)):
    31	        items = fams[sk]
    32	        print(f"[{sk}] {len(items)} rules")
    33	        for e, rhs in items[:8]:
    34	            print("    ", e, "->", rl(rhs))
    35	        if len(items) > 8:
    36	            print("     ...")
    37	
    38	
    39	if __name__ == "__main__":
    40	    main()

