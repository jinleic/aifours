    70	                    continue
    71	                R.append(("R9", "c" + "b" * (n + K) + "a" * n1 + t + "cbabc",
    72	                          "bcbba" + "c" * n + "b" + "a" * n1 + "c" + t))
    73	            for t in tails(L):
