   209	        self.final = set()
   210	
   211	    def new(self):
   212	        self.trans.append(dict())
   213	        return len(self.trans) - 1
   214	
   215	    def add(self, s, c, t):
   216	        self.trans[s].setdefault(c, set()).add(t)
