    19	def check(typ, n=0, m=0, trials=300, seed=1):
    20	    G = build(typ, n, m)
    21	    W = G.W
    22	    key = (typ, n) if typ != "I" else ("I", m)
    23	    if typ == "I":
    24	        assert W.N == m
    25	    else:
    26	        assert W.N == EXPECTED_N[key], (key, W.N)
    27	    rng = random.Random(seed)
    28	    gens = [letter(i) for i in range(W.n)]
    29	    rels = []
    30	    for i in range(W.n):
    31	        for j in range(i + 1, W.n):
    32	            mij = W.M[i][j]
    33	            rels.append((alt(gens[i], gens[j], mij), alt(gens[j], gens[i], mij)))
    34	    dw = G.delta_word()
    35	    assert len(dw) == W.N
    36	    assert G.nf(dw) == DELTA
    37	    alphabet = gens + [DELTA, DINV]
    38	    for _ in range(trials):
    39	        u = "".join(rng.choice(alphabet) for _ in range(rng.randint(0, 12)))
    40	        v = "".join(rng.choice(alphabet) for _ in range(rng.randint(0, 12)))
    41	        a, b = rng.choice(rels)
    42	        nf = G.nf(u + a + v)
    43	        assert nf == G.nf(u + b + v)
    44	        assert G.nf(u + DELTA + DINV + v) == G.nf(u + v) == G.nf(u + DINV + DELTA + v)
    45	        assert G.nf(u + dw + v) == G.nf(u + DELTA + v)
