   218	    def add_family(self, parts, start=0):
   219	        assert parts[0][1] is None and parts[0][0], "family must start with a fixed word"
   220	        s = start
   221	        for w, p in parts:
   222	            if p is None:
   223	                for c in w:
   224	                    t = self.new()
   225	                    self.add(s, c, t)
   226	                    s = t
   227	            else:
