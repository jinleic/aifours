   296	def irreducible_dfa_counts(N: NFA, alphabet, Lmax):
   297	    """Count words with no factor in L(N); returns counts and #DFA states."""
   298	    start = frozenset([0])
   299	    states = {start: 0}
   300	    trans = {}
   301	    todo = [start]
   302	    while todo:
   303	        S = todo.pop()
   304	        for c in alphabet:
   305	            T = N.step(S, c) | {0}
   306	            if T & N.final:
   307	                trans[(S, c)] = None
   308	                continue
   309	            T = frozenset(T)
   310	            trans[(S, c)] = T
   311	            if T not in states:
   312	                states[T] = len(states)
   313	                todo.append(T)
   314	    K = len(states)
   315	    L = max(Lmax, 0)
   316	    cur = {start: 1}
   317	    counts = [1]
   318	    for _ in range(L):
   319	        nxt = {}
   320	        for S, k in cur.items():
   321	            for c in alphabet:
   322	                T = trans[(S, c)]
   323	                if T is not None:
   324	                    nxt[T] = nxt.get(T, 0) + k
   325	        cur = nxt
   326	        counts.append(sum(cur.values()))
   327	    return counts, K, trans, states
