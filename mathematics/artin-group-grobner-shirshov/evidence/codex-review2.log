   234	# ------------------------------------------------------------------ NFA of a family language
   235	class NFA:
   236	    """NFA with epsilon moves into fresh loop states, so that consecutive powers
   237	    x^p y^q are recognised exactly (not as (x|y)*)."""
   238	
   239	    def __init__(self):
   240	        self.trans = [dict()]  # state -> letter -> set(states)
   241	        self.eps = [set()]
   242	        self.final = set()
   243	
   244	    def new(self):
   245	        self.trans.append(dict())
   246	        self.eps.append(set())
   247	        return len(self.trans) - 1
   248	
   249	    def add(self, s, c, t):
   250	        self.trans[s].setdefault(c, set()).add(t)
   251	
   252	    def add_family(self, parts, start=0):
   253	        assert parts[0][1] is None and parts[0][0], "family must start with a fixed word"
   254	        s = start
   255	        for w, p in parts:
   256	            if p is None:
   257	                for c in w:
   258	                    t = self.new()
   259	                    self.add(s, c, t)
   260	                    s = t
   261	            else:
   262	                loop = self.new()
   263	                self.eps[s].add(loop)
   264	                cur = loop
   265	                for j, c in enumerate(w):
   266	                    t = loop if j == len(w) - 1 else self.new()
   267	                    self.add(cur, c, t)
   268	                    cur = t
   269	                s = loop
   270	        self.final.add(s)
   271	
   272	    def closure(self, S):
   273	        out, todo = set(S), list(S)
   274	        while todo:
   275	            for t in self.eps[todo.pop()]:
   276	                if t not in out:
   277	                    out.add(t)
   278	                    todo.append(t)
   279	        return out
   280	
   281	    def step(self, S, c):
   282	        out = set()
   283	        for s in S:
   284	            out |= self.trans[s].get(c, set())
   285	        return frozenset(self.closure(out))
   286	
   287	
   288	def leading_nfa(families):
   289	    N = NFA()
   290	    for _name, lhs, _rhs in families:
   291	        N.add_family(lhs)
   292	    return N
