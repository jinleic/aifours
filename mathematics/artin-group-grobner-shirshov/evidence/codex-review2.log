   430	              "delta_word": G.delta_word(), "N": W.N, "families": len(fams)}
   431	    # (V1) group identities via Garside normal form; (V2) positive transport identities via
   432	    # braid-relation class exploration (independent of Garside theory); (O) order
   433	    report["validity"] = {f[0]: check_validity(G, f[:3]) for f in fams_h}
   434	    rels = braid_relations(W.M)
   435	    tr = {f[0]: check_transport(f[:3], rels, G.delta_word(), W.phi) for f in fams_h}
   436	    report["validity_transport"] = {k: v[0] for k, v in tr.items()}
   437	    report["transport_proofs"] = {k: v[1] for k, v in tr.items()}
   438	    report["order_ok"] = {f[0]: check_order(f) for f in fams}
   439	    # (G)
   440	    Nlead = leading_nfa(fams)
   441	    counts0, K, _, _ = irreducible_dfa_counts(Nlead, alphabet, 0)
   442	    Lg = K + W.N + 2
   443	    counts, K, _, _ = irreducible_dfa_counts(Nlead, alphabet, Lg)
   444	    growth = growth_counts(W, Lg, "group")
   445	    report["growth_certificate"] = {"dfa_states": K, "checked_up_to": Lg,
   446	                                    "equal": counts == growth,
   447	                                    "first_counts": counts[:12]}
   448	    # (L)
   449	    pos = [f for f in fams if all(c not in "01" for c in f[1][0][0])]
   450	    Npos = leading_nfa(pos)
   451	    T = build_table(typ, n, m, spec["order"])
   452	    A = NFAutomaton(T)
   453	    eq, info = language_equal(Npos, A, gens)
   454	    report["language_equal_minred_automaton"] = {"equal": eq, "product_states": info if eq else str(info)}
   455	    # (R)
   456	    report["rhs_irreducible"] = rhs_irreducible(fams, Nlead, alphabet)
   457	    # (E)
   458	    rules, _ = enumerate_basis(G, a.Lmax)
   459	    oracle = dict(rules)
   460	    inst = instances_upto(fams, a.Lmax)
   461	    report["oracle_crosscheck"] = {"Lmax": a.Lmax, "oracle_rules": len(oracle),
   462	                                   "family_instances": len(inst), "equal": oracle == inst}
   463	    if oracle != inst:
   464	        report["oracle_crosscheck"]["missing"] = sorted(set(oracle) - set(inst), key=lambda u: (len(u), u))[:20]
   465	        report["oracle_crosscheck"]["extra"] = sorted(set(inst) - set(oracle), key=lambda u: (len(u), u))[:20]
   466	        report["oracle_crosscheck"]["rhs_diff"] = [(u, oracle[u], inst[u]) for u in oracle
   467	                                                   if u in inst and oracle[u] != inst[u]][:20]
   468	    allok = (all(v[0] is True for v in report["validity"].values()) and all(report["order_ok"].values())
   469	             and all(v is not False for v in report["validity_transport"].values())
   470	             and report["growth_certificate"]["equal"] and eq and report["rhs_irreducible"]
   471	             and report["oracle_crosscheck"]["equal"])
   472	    report["ALL_OK"] = allok
