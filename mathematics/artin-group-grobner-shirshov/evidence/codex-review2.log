   114	            C = "".join(F[k:])
   115	            out[P[k - 1]] = inv_word(C) + Lp[k - 1] + C
   116	    conds = ["".join(A) + inv_word("".join(B))]
   117	    conds += [g[p] + inv_word(h[p]) for p in pl]
   118	    pos = {p: i for i, p in enumerate(pr)}
   119	    for i in range(len(pl)):
   120	        for j in range(i + 1, len(pl)):
   121	            if pos[pl[i]] > pos[pl[j]]:
   122	                gi, gj = g[pl[i]], g[pl[j]]
   123	                conds.append(gi + gj + inv_word(gi) + inv_word(gj))
   124	    ok = all(is_id(c) for c in conds)
   125	    return ok, len(conds)
