   347	                P2 = ("dead",)
   348	            else:
   349	                Of, Os = P
   350	                Os2 = A.step(Os, y)
   351	                if Os2 is None:
   352	                    P2 = ("dead",)
   353	                else:
   354	                    Of2 = A.step(Of, y)
   355	                    P2 = ("acc",) if Of2 is None else (Of2, Os2)
   356	            if not S2 and P2 == ("dead",):
   357	                continue
   358	            st = (S2, P2)
   359	            if st not in seen:
   360	                seen.add(st)
   361	                todo.append(st)
   362	    return True, len(seen)
   363	
   364	
   365	# ------------------------------------------------------------------ (R)
   366	def rhs_irreducible(families, Nlead: NFA, alphabet):
   367	    R = NFA()
   368	    for _name, _lhs, rhs in families:
   369	        if not rhs or not rhs[0][0]:
   370	            continue
   371	        R.add_family(rhs)
   372	    start = (frozenset([0]), frozenset([0]))
   373	    seen = {start}
   374	    todo = [start]
   375	    while todo:
   376	        S, T = todo.pop()
   377	        for c in alphabet:
   378	            S2 = R.step(S, c)
   379	            if not S2:
   380	                continue
   381	            T2 = Nlead.step(T, c) | {0}
   382	            if T2 & Nlead.final:
   383	                return False
   384	            st = (S2, frozenset(T2))
   385	            if st not in seen:
   386	                seen.add(st)
   387	                todo.append(st)
   388	    return True
   389	
   390	
   391	# ------------------------------------------------------------------ (E)
   392	def instances_upto(families, Lmax):
   393	    out = {}
   394	    for name, lhs, rhs in families:
   395	        _, X, names = split(lhs)
   396	        base = len(instantiate(lhs, {p: 0 for p in names}))
   397	
   398	        def rec(i, vals):
   399	            if i == len(names):
   400	                u = instantiate(lhs, vals)
   401	                if len(u) <= Lmax:
   402	                    assert u not in out, f"duplicate leading word {u}"
   403	                    out[u] = instantiate(rhs, vals)
   404	                return
   405	            for v in range(0, Lmax + 1):
   406	                vals2 = dict(vals, **{names[i]: v})
   407	                if base + sum(len(X[j]) * vals2[names[j]] for j in range(i + 1)) > Lmax:
   408	                    break
   409	                rec(i + 1, vals2)
   410	
   411	        rec(0, {})
   412	    return out
   413	
