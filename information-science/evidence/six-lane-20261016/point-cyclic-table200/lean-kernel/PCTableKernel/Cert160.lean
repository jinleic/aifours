import PCTableKernel.Data160

/-!
# A point-cyclic resolution of a 2-(160,4,1) design: kernel-checked existence

`cert160` comes from `PCTableKernel.Data160`, generated by `lean-kernel/gen_lean.py` from the pinned raw certificate (its
SHA-256 is recorded there and in `cert160RawSha256`). Every `decide +kernel` below is evaluated by the Lean kernel (no
`native_decide`, no `Lean.ofReduceBool`). The semantic conclusions come from the data-independent theorem
`sound_of_check` (`PC100Kernel.Check`, byte copy of the accepted v = 100 module) and the cycle lemmas
`isFullCycle_shift`, `cycleType_shift`; the target notions are defined in `PC100Kernel.Target` (byte copy).
Generated by `lean-kernel/gen_cert.py` from one template for all orders.
-/

namespace PC100.Kernel

/-- Shape of the raw data: 53 classes of 40 blocks each, 2120 blocks in all. -/
theorem cert160_shape :
    cert160.length = 53 ∧ (∀ c ∈ cert160, c.length = 40) ∧ cert160.flatten.length = 2120 := by
  decide +kernel

/-- Every listed block is `a < b < c < d < 160`: no reduction modulo 160 happens. -/
theorem cert160_range :
    ∀ e ∈ cert160.flatten, e.1 < e.2.1 ∧ e.2.1 < e.2.2.1 ∧ e.2.2.1 < e.2.2.2 ∧ e.2.2.2 < 160 := by
  decide +kernel

/-! The checker `certCheck v d` is the conjunction (`&&`) of four Boolean parts. Each part is evaluated by the kernel
in its own declaration (this bounds the memory of each kernel evaluation), and `cert160_check` assembles them. -/

theorem cert160_rangeOK : cert160.flatten.all (rangeOK 160) = true := by
  decide +kernel

theorem cert160_pairsOK :
    (insertAll (cert160.flatten.flatMap (pairCodes 160)) 0 == some (pairMask 160)) = true := by
  decide +kernel

theorem cert160_classesOK :
    cert160.all (fun c => insertAll (c.flatMap pts) 0 == some (pointMask 160)) = true := by
  decide +kernel

theorem cert160_shiftOK : shiftOK 160 cert160 = true := by
  decide +kernel

/-- The certificate checker evaluates to `true` (assembled from the four kernel evaluations). -/
theorem cert160_check : certCheck 160 cert160 = true := by
  simp only [certCheck, Bool.and_eq_true]
  exact ⟨⟨⟨cert160_rangeOK, cert160_pairsOK⟩, cert160_classesOK⟩, cert160_shiftOK⟩

/-- The explicit block set: the 2120 blocks listed in the raw certificate. -/
def pc160Blocks : Finset (Finset (Fin 160)) := blocks 160 cert160

/-- The explicit resolution: the 53 classes listed in the raw certificate. -/
def pc160Classes : Finset (Finset (Finset (Fin 160))) := classes 160 cert160

theorem pc160Blocks_spec (X : Finset (Fin 160)) :
    X ∈ pc160Blocks ↔ ∃ e ∈ cert160.flatten, blk 160 e = X :=
  mem_blocks

theorem pc160Classes_spec (P : Finset (Finset (Fin 160))) :
    P ∈ pc160Classes ↔ ∃ c ∈ cert160, classOf 160 c = P :=
  mem_classes

theorem isDesign241_pc160 : IsDesign241 pc160Blocks :=
  (sound_of_check cert160_check).1

theorem isResolution_pc160 : IsResolution pc160Blocks pc160Classes :=
  (sound_of_check cert160_check).2.1

theorem shift_pc160 : IsResolutionAutomorphism pc160Blocks pc160Classes (shift 160) :=
  (sound_of_check cert160_check).2.2.1

/-- `x ↦ x + 1` permutes the 160 points in one cycle. -/
theorem isFullCycle_shift160 : IsFullCycle (shift 160) :=
  isFullCycle_shift 158

theorem cycleType_shift160 : (shift 160).cycleType = {160} :=
  cycleType_shift 158

theorem counts_pc160 : pc160Blocks.card = 2120 ∧ pc160Classes.card = 53 ∧
    ∀ P ∈ pc160Classes, P.card = 40 := by
  obtain ⟨-, -, -, hb, hr, hp⟩ := sound_of_check cert160_check
  obtain ⟨hlen, hcl, hflat⟩ := cert160_shape
  refine ⟨?_, ?_, ?_⟩
  · rw [pc160Blocks, hb, hflat]
  · rw [pc160Classes, hr, hlen]
  · intro P hP
    obtain ⟨c, hc, rfl⟩ := mem_classes.mp hP
    rw [hp c hc, hcl c hc]

/-- **A point-cyclic resolution of a 2-(160,4,1) design exists** (on the point set `Fin 160`). -/
theorem exists_pc160 : Target 160 :=
  ⟨pc160Blocks, isDesign241_pc160, pc160Classes, isResolution_pc160, shift 160,
    isFullCycle_shift160, shift_pc160⟩

theorem exists_pc160_shift : TargetShift 160 :=
  ⟨isFullCycle_shift160, pc160Blocks, pc160Classes, isDesign241_pc160, isResolution_pc160,
    shift_pc160⟩

theorem counts_pc160_target : TargetCounts 160 := by
  obtain ⟨hb, hr, hp⟩ := counts_pc160
  refine ⟨pc160Blocks, pc160Classes, isDesign241_pc160, isResolution_pc160, shift_pc160, ?_, ?_, ?_⟩
  · rw [hb]
  · rw [hr]
  · intro P hP
    rw [hp P hP]

end PC100.Kernel
