import PCTableKernel.Data136

/-!
# A point-cyclic resolution of a 2-(136,4,1) design: kernel-checked existence

`cert136` comes from `PCTableKernel.Data136`, generated by `lean-kernel/gen_lean.py` from the pinned raw certificate (its
SHA-256 is recorded there and in `cert136RawSha256`). Every `decide +kernel` below is evaluated by the Lean kernel (no
`native_decide`, no `Lean.ofReduceBool`). The semantic conclusions come from the data-independent theorem
`sound_of_check` (`PC100Kernel.Check`, byte copy of the accepted v = 100 module) and the cycle lemmas
`isFullCycle_shift`, `cycleType_shift`; the target notions are defined in `PC100Kernel.Target` (byte copy).
Generated by `lean-kernel/gen_cert.py` from one template for all orders.
-/

namespace PC100.Kernel

/-- Shape of the raw data: 45 classes of 34 blocks each, 1530 blocks in all. -/
theorem cert136_shape :
    cert136.length = 45 ∧ (∀ c ∈ cert136, c.length = 34) ∧ cert136.flatten.length = 1530 := by
  decide +kernel

/-- Every listed block is `a < b < c < d < 136`: no reduction modulo 136 happens. -/
theorem cert136_range :
    ∀ e ∈ cert136.flatten, e.1 < e.2.1 ∧ e.2.1 < e.2.2.1 ∧ e.2.2.1 < e.2.2.2 ∧ e.2.2.2 < 136 := by
  decide +kernel

/-! The checker `certCheck v d` is the conjunction (`&&`) of four Boolean parts. Each part is evaluated by the kernel
in its own declaration (this bounds the memory of each kernel evaluation), and `cert136_check` assembles them. -/

theorem cert136_rangeOK : cert136.flatten.all (rangeOK 136) = true := by
  decide +kernel

theorem cert136_pairsOK :
    (insertAll (cert136.flatten.flatMap (pairCodes 136)) 0 == some (pairMask 136)) = true := by
  decide +kernel

theorem cert136_classesOK :
    cert136.all (fun c => insertAll (c.flatMap pts) 0 == some (pointMask 136)) = true := by
  decide +kernel

theorem cert136_shiftOK : shiftOK 136 cert136 = true := by
  decide +kernel

/-- The certificate checker evaluates to `true` (assembled from the four kernel evaluations). -/
theorem cert136_check : certCheck 136 cert136 = true := by
  simp only [certCheck, Bool.and_eq_true]
  exact ⟨⟨⟨cert136_rangeOK, cert136_pairsOK⟩, cert136_classesOK⟩, cert136_shiftOK⟩

/-- The explicit block set: the 1530 blocks listed in the raw certificate. -/
def pc136Blocks : Finset (Finset (Fin 136)) := blocks 136 cert136

/-- The explicit resolution: the 45 classes listed in the raw certificate. -/
def pc136Classes : Finset (Finset (Finset (Fin 136))) := classes 136 cert136

theorem pc136Blocks_spec (X : Finset (Fin 136)) :
    X ∈ pc136Blocks ↔ ∃ e ∈ cert136.flatten, blk 136 e = X :=
  mem_blocks

theorem pc136Classes_spec (P : Finset (Finset (Fin 136))) :
    P ∈ pc136Classes ↔ ∃ c ∈ cert136, classOf 136 c = P :=
  mem_classes

theorem isDesign241_pc136 : IsDesign241 pc136Blocks :=
  (sound_of_check cert136_check).1

theorem isResolution_pc136 : IsResolution pc136Blocks pc136Classes :=
  (sound_of_check cert136_check).2.1

theorem shift_pc136 : IsResolutionAutomorphism pc136Blocks pc136Classes (shift 136) :=
  (sound_of_check cert136_check).2.2.1

/-- `x ↦ x + 1` permutes the 136 points in one cycle. -/
theorem isFullCycle_shift136 : IsFullCycle (shift 136) :=
  isFullCycle_shift 134

theorem cycleType_shift136 : (shift 136).cycleType = {136} :=
  cycleType_shift 134

theorem counts_pc136 : pc136Blocks.card = 1530 ∧ pc136Classes.card = 45 ∧
    ∀ P ∈ pc136Classes, P.card = 34 := by
  obtain ⟨-, -, -, hb, hr, hp⟩ := sound_of_check cert136_check
  obtain ⟨hlen, hcl, hflat⟩ := cert136_shape
  refine ⟨?_, ?_, ?_⟩
  · rw [pc136Blocks, hb, hflat]
  · rw [pc136Classes, hr, hlen]
  · intro P hP
    obtain ⟨c, hc, rfl⟩ := mem_classes.mp hP
    rw [hp c hc, hcl c hc]

/-- **A point-cyclic resolution of a 2-(136,4,1) design exists** (on the point set `Fin 136`). -/
theorem exists_pc136 : Target 136 :=
  ⟨pc136Blocks, isDesign241_pc136, pc136Classes, isResolution_pc136, shift 136,
    isFullCycle_shift136, shift_pc136⟩

theorem exists_pc136_shift : TargetShift 136 :=
  ⟨isFullCycle_shift136, pc136Blocks, pc136Classes, isDesign241_pc136, isResolution_pc136,
    shift_pc136⟩

theorem counts_pc136_target : TargetCounts 136 := by
  obtain ⟨hb, hr, hp⟩ := counts_pc136
  refine ⟨pc136Blocks, pc136Classes, isDesign241_pc136, isResolution_pc136, shift_pc136, ?_, ?_, ?_⟩
  · rw [hb]
  · rw [hr]
  · intro P hP
    rw [hp P hP]

end PC100.Kernel
