import PCTableKernelR2.Data196

/-!
# A point-cyclic resolution of a 2-(196,4,1) design: kernel-checked existence

`cert196` comes from `PCTableKernelR2.Data196`, generated by `lean-kernel/gen_lean.py` from the pinned raw certificate (its
SHA-256 is recorded there and in `cert196RawSha256`). Every `decide +kernel` below is evaluated by the Lean kernel (no
`native_decide`, no `Lean.ofReduceBool`). The semantic conclusions come from the data-independent theorem
`sound_of_check` (`PC100Kernel.Check`, byte copy of the accepted v = 100 module) and the cycle lemmas
`isFullCycle_shift`, `cycleType_shift`; the target notions are defined in `PC100Kernel.Target` (byte copy).
Generated by `lean-kernel/gen_cert.py` from one template for all orders.
-/

namespace PC100.Kernel

/-- Shape of the raw data: 65 classes of 49 blocks each, 3185 blocks in all. -/
theorem cert196_shape :
    cert196.length = 65 ∧ (∀ c ∈ cert196, c.length = 49) ∧ cert196.flatten.length = 3185 := by
  decide +kernel

/-- Every listed block is `a < b < c < d < 196`: no reduction modulo 196 happens. -/
theorem cert196_range :
    ∀ e ∈ cert196.flatten, e.1 < e.2.1 ∧ e.2.1 < e.2.2.1 ∧ e.2.2.1 < e.2.2.2 ∧ e.2.2.2 < 196 := by
  decide +kernel

/-! The checker `certCheck v d` is the conjunction (`&&`) of four Boolean parts. Each part is evaluated by the kernel
in its own declaration (this bounds the memory of each kernel evaluation), and `cert196_check` assembles them. -/

theorem cert196_rangeOK : cert196.flatten.all (rangeOK 196) = true := by
  decide +kernel

theorem cert196_pairsOK :
    (insertAll (cert196.flatten.flatMap (pairCodes 196)) 0 == some (pairMask 196)) = true := by
  decide +kernel

theorem cert196_classesOK :
    cert196.all (fun c => insertAll (c.flatMap pts) 0 == some (pointMask 196)) = true := by
  decide +kernel

theorem cert196_shiftOK : shiftOK 196 cert196 = true := by
  decide +kernel

/-- The certificate checker evaluates to `true` (assembled from the four kernel evaluations). -/
theorem cert196_check : certCheck 196 cert196 = true := by
  simp only [certCheck, Bool.and_eq_true]
  exact ⟨⟨⟨cert196_rangeOK, cert196_pairsOK⟩, cert196_classesOK⟩, cert196_shiftOK⟩

/-- The explicit block set: the 3185 blocks listed in the raw certificate. -/
def pc196Blocks : Finset (Finset (Fin 196)) := blocks 196 cert196

/-- The explicit resolution: the 65 classes listed in the raw certificate. -/
def pc196Classes : Finset (Finset (Finset (Fin 196))) := classes 196 cert196

theorem pc196Blocks_spec (X : Finset (Fin 196)) :
    X ∈ pc196Blocks ↔ ∃ e ∈ cert196.flatten, blk 196 e = X :=
  mem_blocks

theorem pc196Classes_spec (P : Finset (Finset (Fin 196))) :
    P ∈ pc196Classes ↔ ∃ c ∈ cert196, classOf 196 c = P :=
  mem_classes

theorem isDesign241_pc196 : IsDesign241 pc196Blocks :=
  (sound_of_check cert196_check).1

theorem isResolution_pc196 : IsResolution pc196Blocks pc196Classes :=
  (sound_of_check cert196_check).2.1

theorem shift_pc196 : IsResolutionAutomorphism pc196Blocks pc196Classes (shift 196) :=
  (sound_of_check cert196_check).2.2.1

/-- `x ↦ x + 1` permutes the 196 points in one cycle. -/
theorem isFullCycle_shift196 : IsFullCycle (shift 196) :=
  isFullCycle_shift 194

theorem cycleType_shift196 : (shift 196).cycleType = {196} :=
  cycleType_shift 194

theorem counts_pc196 : pc196Blocks.card = 3185 ∧ pc196Classes.card = 65 ∧
    ∀ P ∈ pc196Classes, P.card = 49 := by
  obtain ⟨-, -, -, hb, hr, hp⟩ := sound_of_check cert196_check
  obtain ⟨hlen, hcl, hflat⟩ := cert196_shape
  refine ⟨?_, ?_, ?_⟩
  · rw [pc196Blocks, hb, hflat]
  · rw [pc196Classes, hr, hlen]
  · intro P hP
    obtain ⟨c, hc, rfl⟩ := mem_classes.mp hP
    rw [hp c hc, hcl c hc]

/-- **A point-cyclic resolution of a 2-(196,4,1) design exists** (on the point set `Fin 196`). -/
theorem exists_pc196 : Target 196 :=
  ⟨pc196Blocks, isDesign241_pc196, pc196Classes, isResolution_pc196, shift 196,
    isFullCycle_shift196, shift_pc196⟩

theorem exists_pc196_shift : TargetShift 196 :=
  ⟨isFullCycle_shift196, pc196Blocks, pc196Classes, isDesign241_pc196, isResolution_pc196,
    shift_pc196⟩

theorem counts_pc196_target : TargetCounts 196 := by
  obtain ⟨hb, hr, hp⟩ := counts_pc196
  refine ⟨pc196Blocks, pc196Classes, isDesign241_pc196, isResolution_pc196, shift_pc196, ?_, ?_, ?_⟩
  · rw [hb]
  · rw [hr]
  · intro P hP
    rw [hp P hP]

end PC100.Kernel
