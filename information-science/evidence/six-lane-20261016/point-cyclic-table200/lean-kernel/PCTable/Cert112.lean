import PCTable.Data112

/-!
# A point-cyclic resolution of a 2-(112,4,1) design: kernel-checked existence

`cert112` comes from `PCTable.Data112`, generated by `lean-kernel/gen_lean.py` from the pinned raw certificate (its
SHA-256 is recorded there and in `cert112RawSha256`). Every `decide +kernel` below is evaluated by the Lean kernel (no
`native_decide`, no `Lean.ofReduceBool`). The semantic conclusions come from the data-independent theorem
`sound_of_check` (`PC100Kernel.Check`, byte copy of the accepted v = 100 module) and the cycle lemmas
`isFullCycle_shift`, `cycleType_shift`; the target notions are defined in `PC100Kernel.Target` (byte copy).
Generated by `lean-kernel/gen_cert.py` from one template for all orders.
-/

namespace PC100.Kernel

/-- Shape of the raw data: 37 classes of 28 blocks each, 1036 blocks in all. -/
theorem cert112_shape :
    cert112.length = 37 ∧ (∀ c ∈ cert112, c.length = 28) ∧ cert112.flatten.length = 1036 := by
  decide +kernel

/-- Every listed block is `a < b < c < d < 112`: no reduction modulo 112 happens. -/
theorem cert112_range :
    ∀ e ∈ cert112.flatten, e.1 < e.2.1 ∧ e.2.1 < e.2.2.1 ∧ e.2.2.1 < e.2.2.2 ∧ e.2.2.2 < 112 := by
  decide +kernel

/-- One kernel evaluation of the certificate checker. -/
theorem cert112_check : certCheck 112 cert112 = true := by
  decide +kernel

/-- The explicit block set: the 1036 blocks listed in the raw certificate. -/
def pc112Blocks : Finset (Finset (Fin 112)) := blocks 112 cert112

/-- The explicit resolution: the 37 classes listed in the raw certificate. -/
def pc112Classes : Finset (Finset (Finset (Fin 112))) := classes 112 cert112

theorem pc112Blocks_spec (X : Finset (Fin 112)) :
    X ∈ pc112Blocks ↔ ∃ e ∈ cert112.flatten, blk 112 e = X :=
  mem_blocks

theorem pc112Classes_spec (P : Finset (Finset (Fin 112))) :
    P ∈ pc112Classes ↔ ∃ c ∈ cert112, classOf 112 c = P :=
  mem_classes

theorem isDesign241_pc112 : IsDesign241 pc112Blocks :=
  (sound_of_check cert112_check).1

theorem isResolution_pc112 : IsResolution pc112Blocks pc112Classes :=
  (sound_of_check cert112_check).2.1

theorem shift_pc112 : IsResolutionAutomorphism pc112Blocks pc112Classes (shift 112) :=
  (sound_of_check cert112_check).2.2.1

/-- `x ↦ x + 1` permutes the 112 points in one cycle. -/
theorem isFullCycle_shift112 : IsFullCycle (shift 112) :=
  isFullCycle_shift 110

theorem cycleType_shift112 : (shift 112).cycleType = {112} :=
  cycleType_shift 110

theorem counts_pc112 : pc112Blocks.card = 1036 ∧ pc112Classes.card = 37 ∧
    ∀ P ∈ pc112Classes, P.card = 28 := by
  obtain ⟨-, -, -, hb, hr, hp⟩ := sound_of_check cert112_check
  obtain ⟨hlen, hcl, hflat⟩ := cert112_shape
  refine ⟨?_, ?_, ?_⟩
  · rw [pc112Blocks, hb, hflat]
  · rw [pc112Classes, hr, hlen]
  · intro P hP
    obtain ⟨c, hc, rfl⟩ := mem_classes.mp hP
    rw [hp c hc, hcl c hc]

/-- **A point-cyclic resolution of a 2-(112,4,1) design exists** (on the point set `Fin 112`). -/
theorem exists_pc112 : Target 112 :=
  ⟨pc112Blocks, isDesign241_pc112, pc112Classes, isResolution_pc112, shift 112,
    isFullCycle_shift112, shift_pc112⟩

theorem exists_pc112_shift : TargetShift 112 :=
  ⟨isFullCycle_shift112, pc112Blocks, pc112Classes, isDesign241_pc112, isResolution_pc112,
    shift_pc112⟩

theorem counts_pc112_target : TargetCounts 112 := by
  obtain ⟨hb, hr, hp⟩ := counts_pc112
  refine ⟨pc112Blocks, pc112Classes, isDesign241_pc112, isResolution_pc112, shift_pc112, ?_, ?_, ?_⟩
  · rw [hb]
  · rw [hr]
  · intro P hP
    rw [hp P hP]

end PC100.Kernel
