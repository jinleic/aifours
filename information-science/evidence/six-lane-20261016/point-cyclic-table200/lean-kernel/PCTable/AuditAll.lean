/-!
# Audit: the table roots prove the data-independent targets

`PC100.Target`, `PC100.TargetShift`, `PC100.TargetCounts` and their vocabulary are defined in `PC100Kernel.Target`
(byte copy of the accepted v = 100 module), which imports no proof and no data. The theorems below restate the roots
with exactly the target types, one block per order. Generated by `lean-kernel/gen_cert.py`.
-/

namespace PCTable.Audit

/-- Root: a 2-(112,4,1) design on `Fin 112` with a point-cyclic resolution. -/
theorem root112 : PC100.Target 112 := PC100.Kernel.exists_pc112

/-- Root: `x ↦ x + 1` is one 112-cycle on `Fin 112` and preserves a 2-(112,4,1) design and a resolution of it. -/
theorem root112_shift : PC100.TargetShift 112 := PC100.Kernel.exists_pc112_shift

/-- Root with the counts written out: 1036 blocks, 37 classes of 28 blocks. -/
theorem root112_counts : PC100.TargetCounts 112 := PC100.Kernel.counts_pc112_target

theorem root112_cycleType : (PC100.shift 112).cycleType = {112} := PC100.Kernel.cycleType_shift112

theorem shift112_apply (x : Fin 112) : PC100.shift 112 x = x + 1 := rfl

