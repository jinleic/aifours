+def allocation_refusals(go, go_sha, out_dir, full_reserve, root=PILOT_ROOT):
+    """N3: the parent's explicit allocation inside the GO is the ONLY admission authority (no second scheduler).
+    Required: schema ALLOCATION_SCHEMA; out_dir == OUT_DIR (with exclusive creation: one-use); reservation_bytes
+    >= this run's reservation; lane_ceiling_bytes == LANE_CEILING; busy_slots == BUSY_SLOTS; released_attempts
+    covering EVERY existing entry of the pilot root with a verified release (release_refusals), so no other
+    attempt holds a busy slot or an unreleased reservation; measured lane usage + reservation <= ceiling.
+    Returns (refusals, ledger)."""
