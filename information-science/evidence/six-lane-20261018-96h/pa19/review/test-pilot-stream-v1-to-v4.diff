+            sm = _write_json(os.path.join(d, "summary.json"), summary)
+        if quarantine:
+            _write_json(os.path.join(d, "children", "01-x.QUARANTINE.json"), {"pid": 1})
+        return {"dir": d, "launch_record_sha256": lr, "summary_sha256": sm}
+
+    def scenario(name, build, res=1000, **kw):
+        check()
+        root = os.path.join(W, "alloc-" + name)
+        os.mkdir(root)
+        rel = build(root)
+        out_dir = os.path.join(root, "run-new")
+        a = {"schema": R.ALLOCATION_SCHEMA, "allocation_id": name, "out_dir": out_dir, "reservation_bytes": res,
+             "lane_ceiling_bytes": R.LANE_CEILING, "busy_slots": R.BUSY_SLOTS, "released_attempts": rel}
+        a.update(kw)
+        return R.allocation_refusals({"allocation": a}, go_sha, out_dir, 1000, root=root)[0]
