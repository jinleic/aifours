+def t_helper_refusals_and_clock(R, W):
+    """N2: the helper starts no process while the latch is held, a cancel is stamped, an owned process is unsettled
+    (this one latches) or its allowance does not fit the frozen cutoffs; the normal path returns one /bin/date line
+    from a SETTLED helper (verified identity, empty group, rc 0, exact output, within its bounds)."""
+    n_helpers, n_latch = len(R.HELPERS), len(R.LATCH)
+    outcomes = {}
+
+    def attempt(tag):
+        try:
+            R.Helper(R.DATE_ARGV).run()
+            outcomes[tag] = "ran"
+        except R.HelperRefused:
+            outcomes[tag] = "refused"
+
+    fake = types.SimpleNamespace(proc=types.SimpleNamespace(returncode=None), settled_rec=None)
+    R.OWNED.append(fake)
+    try:
+        attempt("unsettled_owner")
+    finally:
+        R.OWNED.remove(fake)
+    unsettled_latched = R.LATCH[n_latch:]
+    del R.LATCH[n_latch:]
+    R.LATCH.append("test latch")
+    try:
+        attempt("latch")
+    finally:
+        R.LATCH.remove("test latch")
+    saved_co = R.STATE["cancel_order"]
+    R.STATE["cancel_order"] = next(R.ORDER)
+    try:
+        attempt("cancel")
+    finally:
+        restore_cancel(R, saved_co)
+    saved = (R.STATE["mono_end"], R.STATE["abs_end"])
+    R.STATE["mono_end"], R.STATE["abs_end"] = time.monotonic() + 1, time.time() + 1
+    try:
+        attempt("cutoff")
+    finally:
+        R.STATE["mono_end"], R.STATE["abs_end"] = saved
+    assert outcomes == {"unsettled_owner": "refused", "latch": "refused", "cancel": "refused", "cutoff": "refused"}, outcomes
+    assert len(R.HELPERS) == n_helpers and unsettled_latched and len(R.LATCH) == n_latch, (unsettled_latched, R.LATCH)
+    need(R.HELPER_ALLOW + 1, "helper")
+    stamp = R.clock()
+    assert isinstance(stamp, str) and R.DATE_RE.fullmatch((stamp + "\n").encode()), stamp
+    last = R.HELPERS[-1]
+    assert last.settled and last.record["unsettled"] == [] and last.record["invalid"] == []
+    assert last.identity_at_start is not None
+    assert last.proc.returncode == 0 and not last.quarantined and last.term_delivery is None
+    return {"clock": stamp, "helper_record": last.record}
