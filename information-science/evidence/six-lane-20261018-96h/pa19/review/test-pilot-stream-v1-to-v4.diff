+def t_allocation_release(R, W):
+    """N3: only the parent's allocation admits.  Every existing attempt must be listed and verifiably released:
+    '{}', UNSETTLED, symlinked, digest-mismatched, unlisted, GO-reusing, quarantined and missing attempts release
+    nothing; reservation, out_dir and busy-slot mismatches refuse; an existing OUT_DIR refuses (one use); a fully
+    released root (v14 and v3 summaries) admits.  Each scenario uses its own fixture pilot root."""
+    go_sha = "f" * 64
+    v14 = {"schema": "PA19-96H-PILOT-SUMMARY-v14", "exit_code": 0, "all_children_settled": True,
+           "children": [{"seq": 1, "settled": True}]}
+    v3 = dict(v14, schema="PA19-96H-PSTREAM-SUMMARY-v3", all_helpers_settled=True, quarantine_receipts=[],
+              proof_ram_outstanding_bytes=0)
+
+    def attempt(root, name, summary, go="e" * 64, quarantine=False, link_summary=False):
+        d = os.path.join(root, name)
+        os.makedirs(os.path.join(d, "children"))
+        lr = _write_json(os.path.join(d, "launch-record.json"), {"go": {"sha256": go}})
+        if link_summary:
