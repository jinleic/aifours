+def pipe_writer(w, raw, step, res):
+    """Plays the checker's stdout: writes `raw` in `step` slices (partial writes completed), then closes."""
+    try:
+        for i in range(0, len(raw), step):
+            mv = memoryview(raw)[i:i + step]
+            while mv:
+                k = os.write(w, mv)
+                mv = mv[k:]
+        res["ok"] = True
+    except Exception as exc:
+        res["error"] = repr(exc)
+    finally:
+        os.close(w)
