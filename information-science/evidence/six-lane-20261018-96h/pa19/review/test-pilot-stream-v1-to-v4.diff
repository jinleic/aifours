+        "no_allocation": R.allocation_refusals({}, go_sha, os.path.join(W, "x", "run-new"), 1000,
+                                               root=os.path.join(W, "x"))[0],
+        "small_reservation": scenario("small", good, res=999),
+        "wrong_out_dir": scenario("outdir", good, out_dir="/elsewhere/run-new"),
+        "busy_slots": scenario("busy", good, busy_slots=3),
+        "empty_summary": scenario("empty", lambda root: [attempt(root, "run-a", {})]),
+        "unsettled": scenario("unsettled", lambda root: [attempt(root, "run-a", dict(v14, all_children_settled=False))]),
+        "unsettled_child": scenario("child", lambda root: [attempt(root, "run-a", dict(v14, children=[{"settled": False}]))]),
+        "v3_helper_unsettled": scenario("helper", lambda root: [attempt(root, "run-a", dict(v3, all_helpers_settled=False))]),
+        "symlinked_summary": scenario("symlink", lambda root: [attempt(root, "run-a", v14, link_summary=True)]),
+        "digest_mismatch": scenario("mismatch", mismatched),
+        "unlisted": scenario("unlisted", lambda root: (attempt(root, "run-a", v14), [])[1]),
+        "go_reuse": scenario("reuse", lambda root: [attempt(root, "run-a", v14, go=go_sha)]),
+        "quarantine": scenario("quarantine", lambda root: [attempt(root, "run-a", v14, quarantine=True)]),
+        "missing": scenario("missing", missing),
+        "out_dir_exists": scenario("exists", out_exists),
+    }
+    assert res["admitted"] == [], res["admitted"]
+    refused = {k: v for k, v in res.items() if k != "admitted"}
+    assert all(refused.values()), {k: v for k, v in refused.items() if not v}
+    return {k: len(v) for k, v in res.items()}
 
 
