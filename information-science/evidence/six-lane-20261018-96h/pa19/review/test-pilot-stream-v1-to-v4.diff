+                        "exit_observed_s": exit_obs, "settle_done_s": exit_obs + 50.0}}
+        r.update(kw)
+        return r
+    ok = R.c6_timer_refusals(rec(10.0, 11.95, 12.02), ["s UNKNOWN"])
+    bad = {"immediate_exit_slow_cleanup": R.c6_timer_refusals(rec(10.0, 10.0, 10.05), ["s UNKNOWN"]),
