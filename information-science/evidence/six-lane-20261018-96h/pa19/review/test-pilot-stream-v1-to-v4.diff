+def t_stop_identity(R, W):
+    """N1: the stop primitive sends at most one group SIGTERM, only to an identity-verified owner, never to a reaped
+    or unverifiable one (KILLPG, bsd_identity and list_pids are patched; no process is signalled)."""
+    calls = []
+    saved = (R.KILLPG, R.bsd_identity, R.list_pids)
+    n_latch = len(R.LATCH)
+    me = os.getpid()
+    good = {"pid": 424242, "ppid": me, "pgid": 424242, "status": 2, "start": [7, 8], "comm": "x"}
+
+    def owner(identity, rc=None):
+        o = R.Owned()
+        o._owned_init()
+        o.argv, o.proc, o.pid, o.pgid, o.identity_at_start = ["fake"], FakeProc(rc), 424242, 424242, identity
+        return o
+
+    try:
+        R.KILLPG = lambda pgid, sig: calls.append((pgid, sig))
+        R.list_pids = lambda kind, value: []
+        R.bsd_identity = lambda pid: (dict(good), None)
+        a = owner(None)                            # no verified start identity: refused, no signal
+        a.term("t")
+        a.term("t")
+        R.bsd_identity = lambda pid: (dict(good, start=[9, 9]), None)
+        b = owner(dict(good))                      # a different process start: refused
+        b.term("t")
+        R.bsd_identity = lambda pid: (dict(good), None)
+        c = owner(dict(good))                      # verified: exactly one group SIGTERM, never a second
+        c.term("t")
+        c.term("t")
+        d = owner(dict(good), rc=0)                # reaped: never signalled
+        d.term("t")
+        R.bsd_identity = lambda pid: (None, {"bsd_bytes": 0, "errno": errno.ESRCH})
+        R.list_pids = lambda kind, value: [424242]
+        e = owner(dict(good))                      # exited, unreaped, still listed in its own group: verified
+        e.term("t")
+    finally:
+        R.KILLPG, R.bsd_identity, R.list_pids = saved
+    latched = R.LATCH[n_latch:]
+    del R.LATCH[n_latch:]
+    assert calls == [(424242, signal.SIGTERM), (424242, signal.SIGTERM)], calls
+    assert a.term_refused_mono is not None and a.term_sent_mono is None and b.term_refused_mono is not None
+    assert c.term_sent_mono is not None and c.term_delivery["delivered"] is True and d.term_delivery is None
+    assert e.term_sent_mono is not None and len(latched) == 2, latched
+    return {"signals_recorded": len(calls), "refusals_latched": len(latched)}
