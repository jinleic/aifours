+def canonical_snapshot(obj):
+    """T2P-1: canonical JSON-safe text of disposition evidence; evidence that is not JSON-safe refuses disposal."""
+    return json.dumps(obj, sort_keys=True, allow_nan=False, separators=(",", ":"))
