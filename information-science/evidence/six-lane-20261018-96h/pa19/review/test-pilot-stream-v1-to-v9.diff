+    assert why == [] and [path for path, end in calls] == [X.PILOT_ROOT], (why, calls)
+    calls[:] = []
+    X.bounded_names = lambda path, deadline=None, cap=None: calls.append((path, deadline)) or ["run-new"]
+    X.walk_bounded = lambda *args, **kwargs: {}
