+    return {"rebound_functions": rebound, "rebound_methods": methods, "production_unchanged": True,
+            "pre_existing_sentinels_disjoint_and_unchanged": True,
+            "default_refusals": probes, "exercised_synthetic_test": sorted(exercised)}
