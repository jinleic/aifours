+def commit_record(path, rec_unknown, rec_unsat):
+    """r2#1: explicit commit boundary.  Both serializations and the O_EXCL fd exist before the boundary;
+    the boundary is one atomic next(ORDER); a cancel stamped before it forces UNKNOWN."""
+    unknown_bytes = json.dumps(rec_unknown, indent=1, sort_keys=True).encode()
+    unsat_bytes = None if rec_unsat is None else json.dumps(rec_unsat, indent=1, sort_keys=True).encode()
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
+    try:
+        boundary = next(ORDER)
+        co = STATE["cancel_order"]
+        chosen = unsat_bytes if (unsat_bytes is not None and not LATCH and (co is None or co > boundary)) else unknown_bytes
+        view = memoryview(chosen)
+        while view:
+            k = os.write(fd, view)
+            view = view[k:]
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    return {"boundary": boundary, "cancel_order": STATE["cancel_order"], "committed_unsat": chosen is unsat_bytes,
+            "sha256": hashlib.sha256(chosen).hexdigest()}
