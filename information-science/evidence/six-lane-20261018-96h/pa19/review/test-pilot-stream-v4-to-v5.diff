+def t_settle_all_bounded(R, W):
+    """B1: settle_all makes one bounded pass: a child whose settle() always raises is recorded UNSETTLED (not
+    synthesized as settled) after SETTLE_ALL_ATTEMPTS attempts with the latch held, and the pass returns."""
+    n_latch = len(R.LATCH)
+
+    class StuckChild:
+        def __init__(self):
+            self.proc, self.settled_rec, self.stop, self.unsettled = FakeProc(None), None, None, None
+            self.seq, self.label, self.pid, self.attempts = 99, "stuck", 454545, 0
+
+        def settle(self):
+            self.attempts += 1
+            raise RuntimeError("injected settlement failure")
+
+    c = StuckChild()
+    R.OWNED.append(c)
+    t0 = time.monotonic()
+    try:
+        R.settle_all()
+    finally:
+        R.OWNED.remove(c)
+    took = time.monotonic() - t0
+    latched = R.LATCH[n_latch:]
+    del R.LATCH[n_latch:]
+    assert c.attempts == R.SETTLE_ALL_ATTEMPTS and c.settled_rec and c.settled_rec["settled"] is False, c.settled_rec
+    assert c.stop == "runner_escape_cleanup" and latched and took < 5.0, (latched, took)
+    return {"attempts": c.attempts, "seconds": round(took, 3)}
