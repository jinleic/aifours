+def t_reap_bounded_survivor(R, W):
+    """B1: a survivor of the bounded stop grace is recorded UNSETTLED irreversibly and reap_owned returns None within
+    the grace (plus one slice): exactly one group SIGTERM for a verified identity, none for an unverifiable one; the
+    record carries exact identities, a live census and the late obligations; a second reap returns at once without
+    waiting or signalling again.  (A never-started FakeProc stands in for the survivor; KILLPG, bsd_identity and
+    list_pids are patched; no process is signalled.)"""
+    calls = []
+    saved = (R.KILLPG, R.bsd_identity, R.list_pids)
+    n_latch = len(R.LATCH)
+    me = os.getpid()
+    good = {"pid": 434343, "ppid": me, "pgid": 434343, "status": 2, "start": [3, 4], "comm": "x"}
+
+    def survivor(identity):
+        o = R.Owned()
+        o._owned_init()
+        o.argv, o.proc, o.pid, o.pgid, o.identity_at_start = ["fake"], FakeProc(None), 434343, 434343, identity
+        return o
+
+    grace = 0.3
+    try:
+        R.KILLPG = lambda pgid, sig: calls.append((pgid, sig))
+        R.bsd_identity = lambda pid: (dict(good), None)
+        R.list_pids = lambda kind, value: [434343]
+        a = survivor(dict(good))
+        t0 = time.monotonic()
+        rc_a = a.reap_owned(grace)
+        took_a = time.monotonic() - t0
+        t1 = time.monotonic()
+        rc_a2 = a.reap_owned(grace)                # recorded UNSETTLED: no second wait, no second signal
+        took_a2 = time.monotonic() - t1
+        b = survivor(None)                         # unverifiable identity: no signal at all, still bounded
+        t2 = time.monotonic()
+        rc_b = b.reap_owned(grace)
+        took_b = time.monotonic() - t2
+    finally:
+        R.KILLPG, R.bsd_identity, R.list_pids = saved
+    latched = R.LATCH[n_latch:]
+    del R.LATCH[n_latch:]
+    assert rc_a is None and rc_a2 is None and rc_b is None, (rc_a, rc_a2, rc_b)
+    assert calls == [(434343, signal.SIGTERM)], calls
+    assert took_a < grace + 1.0 and took_a2 < 0.2 and took_b < grace + 1.0, (took_a, took_a2, took_b)
+    assert a.quarantined and b.quarantined and a.unsettled and b.unsettled
+    assert a.unsettled["pid"] == 434343 and a.unsettled["live_census"]["leader_pid"] == 434343
+    assert a.unsettled["late_obligations"] and a.quarantine_receipt_state.startswith("unpublishable")
+    assert b.term_delivery and b.term_delivery["delivered"] is False and any("UNSETTLED" in x for x in latched), latched
+    return {"reap_seconds": [round(took_a, 3), round(took_a2, 3), round(took_b, 3)], "signals": len(calls)}
+
