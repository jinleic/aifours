+def list_pids(kind, value):
+    """V1: proc_listpids in-process (no /bin/ps); fail-closed: raises on an error or a possibly truncated listing.
+    The kernel lists exited-but-unreaped processes too."""
+    buf = (ctypes.c_int * LIST_SLOTS)()
+    ctypes.set_errno(0)
+    n = LIBPROC.proc_listpids(kind, value, buf, ctypes.sizeof(buf))
+    err = ctypes.get_errno()
+    if n < 0 or (n == 0 and err != 0) or n >= ctypes.sizeof(buf):
+        raise OSError(err, "proc_listpids(%d, %d) returned %d" % (kind, value, n))
+    return sorted({p for p in buf[:n // ctypes.sizeof(ctypes.c_int)] if p > 0})
