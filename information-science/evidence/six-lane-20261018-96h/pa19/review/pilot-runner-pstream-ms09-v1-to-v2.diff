+class Helper:
+    """V1: one OWNED, BOUNDED metadata helper process (only the pinned /bin/date).
+    Ownership: pre-registered in HELPERS before Popen; own session; never overlaps a native child or another helper
+    (refused, and latched, if any owned process is unreaped), so at most one process besides the runner exists at
+    any time.  Launch/cancel boundary as V7: after an owner cancel no helper starts.  Bounds: communicate() waits at
+    most HELPER_WALL s, then ONE SIGTERM and at most HELPER_TERM_WAIT s; a survivor is latched and quarantined (no
+    further signal, waited for without bound, UNSETTLED, parent disposition).  Output must be exactly one /bin/date
+    line (<= HELPER_OUT_CAP bytes) with rc 0 and empty stderr, else the read fails closed (latched by clock())."""
+
+    def __init__(self, argv):
+        self.argv = argv
+        self.proc = None
+        self.quarantined = False
+
+    def run(self):
+        if any(c.proc is not None and c.proc.returncode is None for c in OWNED) or \
+                any(h.proc is not None and h.proc.returncode is None for h in HELPERS):
+            latch("metadata helper refused: an owned process is unreaped")
+            raise HelperRefused("an owned native child or helper is unreaped")
+        if sha_file(self.argv[0])[0] != DATE[1]:
+            raise RuntimeError("helper binary pin mismatch")
+        rec = {"argv": self.argv}
+        HELPERS.append(self)                        # ownership exists before the process does
+        self.launch_order = next(ORDER)             # V7 boundary
+        if STATE["cancel_order"] is not None:
+            HELPERS.remove(self)
+            raise HelperRefused("cancel stamped (order %s) before helper launch boundary %d"
+                                % (STATE["cancel_order"], self.launch_order))
+        t0 = time.monotonic()
+        self.proc = subprocess.Popen(self.argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                                     stderr=subprocess.PIPE, start_new_session=True, close_fds=True)
+        rec.update(pid=self.proc.pid, launch_order=self.launch_order)
+        out = err = b""
+        term_sent = False
+        try:
+            out, err = self.proc.communicate(timeout=HELPER_WALL)
+        except subprocess.TimeoutExpired:
+            if self.proc.returncode is None:
+                self.proc.send_signal(signal.SIGTERM)   # the single SIGTERM (Popen never signals a reaped pid)
+                term_sent = True
