+class FakeProc:
+    """A never-started stand-in for a retained Popen: no process exists behind it."""
+
+    def __init__(self, rc=None):
+        self.returncode = rc
+
+    def poll(self):
+        return self.returncode
+
+    def wait(self):
+        return self.returncode
