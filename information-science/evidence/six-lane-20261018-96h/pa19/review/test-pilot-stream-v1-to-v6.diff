+def consume_expected_latches(R, before, expected):
+    """Consume only an exact full-match multiset of deliberate fixture faults; leave ALL faults on any mismatch."""
+    before = tuple(before)
+    current = tuple(R.LATCH)
+    assert current[:len(before)] == before, ("fixture changed an existing latch", before, current)
+    patterns = []
+    for pattern, count in expected:
+        assert isinstance(pattern, str) and type(count) is int and count > 0, expected
+        patterns.append((re.compile(pattern), count))
+    suffix, counts = current[len(before):], [0] * len(patterns)
+    matched_indices = []
+    for offset, fault in enumerate(suffix):
+        matches = [i for i, (pattern, _count) in enumerate(patterns)
+                   if isinstance(fault, str) and pattern.fullmatch(fault) is not None]
+        assert len(matches) == 1, ("unexpected or ambiguous fixture latch", fault, expected, suffix)
+        counts[matches[0]] += 1
+        matched_indices.append(len(before) + offset)
+    assert counts == [count for _pattern, count in patterns], ("fixture latch counts differ", expected, suffix)
+    assert tuple(R.LATCH) == current, "latch changed while checking fixture faults"
+    for index in reversed(matched_indices):
+        del R.LATCH[index]
+    return list(suffix)
+
+def dispose_fixture_fault(R, obj, kind, expected_faults, both_original_descriptors_observed_closed=False):
+    """TEST ONLY: retain an exact fault receipt; never clear a resource flag, delete an owner, or exempt lifecycle."""
+    disposition = {"resource": obj, "kind": kind, "expected_faults": list(expected_faults),
+                   "both_original_descriptors_observed_closed": both_original_descriptors_observed_closed}
+    state = fixture_disposition_state(R, disposition)
+    assert state["lifecycle_refusals"] == [], state
+    assert not any(d["resource"] is obj for d in STATE.setdefault("fixture_dispositions", [])), "duplicate disposition"
+    obj.fixture_disposed = True
+    STATE["fixture_dispositions"].append(disposition)
+    return dict(state, expected_faults=list(expected_faults))
+
+def filter_fixture_inventory(R, inventory):
+    """Only exact acknowledged TEST integrity faults may be distinguished from unresolved physical ownership."""
+    filtered, observed = [], []
+    dispositions = STATE.get("fixture_dispositions", [])
+    for entry in inventory:
+        matches = []
+        for disposition in dispositions:
+            if not isinstance(entry, dict):
+                continue
+            kind, obj = disposition["kind"], disposition["resource"]
+            if entry.get("kind") == "partial publication" and kind == "file sink":
+                state = fixture_disposition_state(R, disposition)
+                if state["lifecycle_refusals"]:
+                    continue
+                for covered in state.get("covered_partial_publications", []):
+                    current = R.CREATED.get(covered.get("path"))
+                    if entry.get("path") == covered.get("path") and isinstance(current, dict) \
+                            and entry.get("state") == current and current.get("state") == covered.get("state") == "open" \
+                            and current.get("identity") == covered.get("identity"):
+                        matches.append(dict(state, expected_faults=list(disposition["expected_faults"]),
+                                            exact_partial_publication=dict(covered)))
+                continue
+            if entry.get("kind") != kind:
+                continue
+            if kind == "RAM collector":
+                same = (entry.get("state") or {}).get("fifo") == getattr(obj, "fifo_path", None)
+            elif kind == "file sink":
+                same = (entry.get("state") or {}).get("file") == getattr(obj, "file_path", None)
+            elif kind == "stdin feeder":
+                same = entry.get("label") == getattr(obj, "label", None)
+            else:
+                same = False
+            if same:
+                state = fixture_disposition_state(R, disposition)
+                if state["lifecycle_refusals"] == []:
+                    matches.append(dict(state, expected_faults=list(disposition["expected_faults"])))
+        if len(matches) == 1:
+            observed.extend(matches)
+        else:
+            filtered.append(entry)
+    return filtered, observed
