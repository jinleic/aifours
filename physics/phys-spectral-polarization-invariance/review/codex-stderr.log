        Z=[[Y[j][i] if transpose else Y[i][j] for j in range(2)] for i in range(2)]
        return [[p*Z[i][j]+((1-p)*tr(Y)/2 if i==j else 0) for j in range(2)] for i in range(2)]
    blocks=[]
    for a in range(3):
        row=[]
        for b in range(3):
            E=[[int(i==a and j==b) for j in range(3)] for i in range(3)]
            row.append(phi(E))
        blocks.append(row)
    assert [[tr(blocks[b][a]) for b in range(3)] for a in range(3)] == T
    for f in ([1,2j,3],[2+1j,-1j,1-2j],null):
        J=phi(outer(f,f))
        from_blocks=[[sum(f[a]*f[b].conjugate()*blocks[a][b][i][j] for a in range(3) for b in range(3)) for j in range(2)] for i in range(2)]
        assert J==from_blocks
        intensity=sum(f[a].conjugate()*T[a][b]*f[b] for a in range(3) for b in range(3))
        assert tr(J)==intensity
        det=J[0][0]*J[1][1]-J[0][1]*J[1][0]
        assert tr(J)**2-4*det==p*p*tr(J)**2
    assert phi(outer(null,[1,2j,3]))==[[0,0],[0,0]]
