    38	def choi(p: float, transpose: bool = False) -> np.ndarray:
    39	    if transpose:
    40	        part = np.zeros((4, 4), complex)
    41	        for a in range(2):
    42	            for b in range(2):
    43	                part[2 * a + b, 2 * b + a] = 1
    44	    else:
    45	        omega = np.array([1, 0, 0, 1], complex)
    46	        part = np.outer(omega, omega.conj())
    47	    return (1 - p) * np.eye(4) / 2 + p * part
