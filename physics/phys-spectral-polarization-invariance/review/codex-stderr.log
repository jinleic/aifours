    26	def degree(j: np.ndarray) -> np.ndarray:
    27	    """Bloch norm avoids artificial clipping of a determinant cancellation."""
    28	    tr = np.trace(j, axis1=-2, axis2=-1).real
    29	    if np.any(tr <= 0):
    30	        raise ValueError("Polarization is undefined at nonpositive intensity")
    31	    s = np.stack(
    32	        (2 * j[..., 0, 1].real, -2 * j[..., 0, 1].imag,
    33	         (j[..., 0, 0] - j[..., 1, 1]).real), axis=-1,
    34	    )
    35	    return np.linalg.norm(s, axis=-1) / tr
