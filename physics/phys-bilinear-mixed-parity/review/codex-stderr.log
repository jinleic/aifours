   103	def symbolic_pair_and_gauge():
   104	    k1,k2,l1,l2,c1,c2,c3,d,r,w=sp.symbols('k1 k2 l1 l2 c1 c2 c3 d r w')
   105	    alpha=3*c3/(2*c2)
   106	    F,G=mixed_coefficients([k1,k2],[l1,l2],'FG',[sp.S(1),sp.S(1)],alpha)
   107	    expected_F=k1*l1*(2*c2+3*c3*k1-3*c3*k2)/((2*c2+3*c3*k1)*(k1+k2)*(l1+l2))
   108	    expected_G=k2*l2*(2*c2+3*c3*k1-3*c3*k2)/((2*c2-3*c3*k2)*(k1+k2)*(l1+l2))
   109	    assert sp.cancel(F[3]-expected_F)==0
   110	    assert sp.cancel(G[3]-expected_G)==0
   111	    p0=lambda q:c3*q**3+(c1-3*c3*d*d)*q
   112	    gauge=sp.expand(w-p0(d)+p0(r+d)-(w+c1*r+3*c3*d*r*r+c3*r**3))
   113	    assert gauge==0
   114	    # Exact algebraic cancellation of powers of alpha, for every cardinality nF,nG.
   115	    m,n=sp.symbols('m n',integer=True)
   116	    exponent=m*(m-1)/2+n*(n-1)/2-m*n+n
   117	    assert sp.expand(exponent.subs(m,n))==0
   118	    assert sp.expand(exponent.subs(m,n+1))==0
   119	    assert mixed_coefficients([],[],[],[],Q(0))==([Q(1)],[Q(1)])
   120	    return {'pair_coefficients_symbolically_checked':2,'gauge_polynomial_identity':True,
   121	            'alpha_power_cancellation_for_all_balanced_and_F_surplus_cardinalities':True,
   122	            'zero_soliton_vacuum':True}
   123	
   124	
   125	def negative_controls():
   126	    ks=list(map(Q,[2,5]));ls=list(map(Q,[3,7]));types='FG'
   127	    c1,c2,c3=Q(1),Q(3),Q(2)
   128	    waves=[(k,l,-(c1*k+c2*k*k+c3*k**3) if t=='F' else -c1*k+c2*k*k-c3*k**3)
   129	           for k,l,t in zip(ks,ls,types)]
   130	    Bs=system(c1,c2,c3,'y')
   131	    F,G=mixed_coefficients(ks,ls,types,[Q(1),Q(1)],3*c3/(2*c2))
   132	    changed=F.copy();changed[3]+=1
   133	    assert H.residuals(Bs,waves,changed,G)
   134	    badwaves=waves.copy();badwaves[1]=(ks[1],ls[1],-(c1*ks[1]+c2*ks[1]**2+c3*ks[1]**3))
   135	    assert H.residuals(Bs,badwaves,F,G)
   136	    return {'perturbed_pair_coefficient_rejected':True,'wrong_G_seed_dispersion_rejected':True}
   137	
   138	
   139	def main():
   140	    symbolic=symbolic_pair_and_gauge()
   141	    direct=direct_checks()
   142	    cases=rational_cases()
   143	    negative=negative_controls()
   144	    report={'evidence_boundary':'Finite controls support the written all-N proof; they do not prove all N.',
   145	            'shared_verifier':str(SHARED),'shared_verifier_sha256':hashlib.sha256(SHARED.read_bytes()).hexdigest(),
   146	            'sympy_version':sp.__version__,'symbolic':symbolic,'direct_checks':direct,
   147	            'exact_cases':cases,'negative_controls':negative}
   148	    (ROOT/'results/verification.json').write_text(json.dumps(report,indent=2)+'\n')
   149	    print('PASS: symbolic mixed pair, gauge identity, and arbitrary-cardinality alpha cancellation.')
   150	    print(f'PASS: {len(direct)} independent polynomial-differentiation cases, cubic and quadratic.')
   151	    print(f'PASS: {len(cases)} exact cases through N=7; all type patterns through N=5; formula equals shared recursion and every residual is zero.')
   152	    print('PASS: 2 negative controls rejected. All-N claim rests on the written Pfaffian proof, not these samples.')
   153	
   154	
   155	if __name__=='__main__':
   156	    main()
