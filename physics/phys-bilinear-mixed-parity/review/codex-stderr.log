def pf(H):
    if not H: return Q(1)
    out=H[0][0]*0
    for j in range(1,len(H)):
        ix=[i for i in range(1,len(H)) if i"'!=j]
        out+=(-1)**(j+1)*H[0][j]*pf([[H[i][k] for k in ix] for i in ix])
    return out

def border(H,*cols):
    n=len(H); m=len(cols)
    out=[[Q(0) for _ in range(n+m)] for _ in range(n+m)]
    for i in range(n):
        for j in range(n): out[i][j]=H[i][j]
        for j in range(m): out[i][n+j]=cols[j][i]; out[n+j][i]=-cols[j][i]
    return pf(out)

def wedge(u,v):
    return [[u[i]*v[j]-v[i]*u[j] for j in range(len(u))] for i in range(len(u))]
def madd(H,J):
    return [[a+b for a,b in zip(x,y)] for x,y in zip(H,J)]
def mat(n):
    return [[Q((i+1)*(j+3)+1) if i<j else -Q((j+1)*(i+3)+1) if i>j else Q(0)
             for j in range(n)] for i in range(n)]

