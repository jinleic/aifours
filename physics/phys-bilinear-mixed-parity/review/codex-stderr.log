    66	            for it in range(c+1):
    67	                left=euler_derivative(euler_derivative(euler_derivative(F,z,ks,a-ix),z,ls,b-iy),z,ws,c-it)
    68	                right=euler_derivative(euler_derivative(euler_derivative(G,z,ks,ix),z,ls,iy),z,ws,it)
    69	                result+=(-1)**(ix+iy+it)*comb(a,ix)*comb(b,iy)*comb(c,it)*left*right
    70	    return sp.expand(result)
    71	
