    73	def direct_checks():
    74	    records=[]
    75	    for n,types in [(2,'FF'),(2,'FG'),(2,'GF'),(2,'GG'),(3,'FFG'),(3,'FGG')]:
    76	        for c1,c2,c3 in [(Q(1),Q(3),Q(2)),(Q(4),Q(7),Q(0))]:
    77	            ks=list(map(Q,[2,5,11][:n]));ls=list(map(Q,[3,7,13][:n]))
    78	            ws=[-(c1*k+c2*k*k+c3*k**3) if typ=='F' else -c1*k+c2*k*k-c3*k**3 for k,typ in zip(ks,types)]
    79	            Fc,Gc=mixed_coefficients(ks,ls,types,[Q(1)]*n,3*c3/(2*c2))
    80	            z=sp.symbols(f'z0:{n}')
    81	            monomials=[sp.prod(z[i] for i in range(n) if mask>>i&1) for mask in range(1<<n)]
    82	            F=sum(a*m for a,m in zip(Fc,monomials));G=sum(a*m for a,m in zip(Gc,monomials))
    83	            for multiplier in [None,'x','y']:
    84	                # DxP is checked only after l=k, not on unrestricted transverse waves.
    85	                left,right,transverse=F,G,ls
    86	                if multiplier=='x':
    87	                    Fx,Gx=mixed_coefficients(ks,ks,types,[Q(1)]*n,3*c3/(2*c2))
    88	                    left=sum(a*m for a,m in zip(Fx,monomials))
    89	                    right=sum(a*m for a,m in zip(Gx,monomials))
    90	                    transverse=ks
    91	                residual=0
    92	                for orders,coefficient in system(c1,c2,c3,'y')[0].items():
    93	                    dx,dy,dt=orders
    94	                    if multiplier=='x': dx+=1
    95	                    if multiplier=='y': dy+=1
    96	                    residual+=coefficient*direct_bilinear(left,right,z,ks,transverse,ws,(dx,dy,dt))
    97	                assert sp.Poly(sp.expand(residual),*z).is_zero
    98	            records.append({'N':n,'types':types,'coefficients':list(map(str,(c1,c2,c3))),
    99	                            'P_DyP_and_reduced_DxP_zero':True})
   100	    return records
