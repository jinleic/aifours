    22	def mixed_coefficients(ks, ls, types, amplitudes, alpha):
    23	    """Return F_S,G_S, bitmask S using the sibling Hirota coefficient convention.
    24	
    25	    types is a sequence of 'F'/'G'; each amplitude is the sole active seed
    26	    amplitude. Denominators in the explicit formula must be nonzero. The
    27	    auxiliary index 0 is F-type with k_0=l_0=0; active index i+1 is bit i.
    28	    """
