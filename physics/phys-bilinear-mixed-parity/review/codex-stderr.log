    35	    zero = one * 0
    36	    k = [zero] + list(ks)
    37	    l = [zero] + list(ls)
    38	    eps = [1] + [1 if t == 'F' else -1 for t in types]
    39	    a = [one if e == 1 else zero for e in eps]
    40	    b = [one if e == -1 else zero for e in eps]
