# A tiny truncated Taylor ring, for direct differentiation of Pfaffians.
class Jet:
    D=3
    def __init__(self,x):
        self.c=tuple(Q(v) for v in x)+tuple(Q(0) for _ in range(self.D+1-len(x))) if isinstance(x,(list,tuple)) else (Q(x),)+tuple(Q(0) for _ in range(self.D))
    def __add__(self,o):
        o=o if isinstance(o,Jet) else Jet(o)
        return Jet([a+b for a,b in zip(self.c,o.c)])
    __radd__=__add__
    def __neg__(self): return Jet([-a for a in self.c])
    def __sub__(self,o): return self+-o
    def __mul__(self,o):
        o=o if isinstance(o,Jet) else Jet(o)
        return Jet([sum(self.c[j]*o.c[i-j] for j in range(i+1)) for i in range(self.D+1)])
    __rmul__=__mul__
    def d(self,i): return self.c[i]*factorial(i)

lemma_count=0
