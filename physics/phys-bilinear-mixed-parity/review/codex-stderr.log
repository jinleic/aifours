    ws=[-c1*k-c2*k*k-c3*k**3 if t=='\\''F'\\'' else -c1*k+c2*k*k-c3*k**3 for k,t in zip(ks,types)]
    waves=[(sum(ks[i] for i in range(n) if mask>>i&1),sum(ls[i] for i in range(n) if mask>>i&1),sum(ws[i] for i in range(n) if mask>>i&1)) for mask in range(1<<n)]
    out={}
    for s,fc in enumerate(F):
        for t,gc in enumerate(G):
            dk,dl,dw=(a-b for a,b in zip(waves[s],waves[t]))
            p=dw+c1*dk+c2*dk**2+c3*dk**3
            if mult=='\\''y'\\'': p*=dl
            if mult=='\\''x'\\'': p*=dk
            exponent=tuple(((s>>i)&1)+((t>>i)&1) for i in range(n))
            out[exponent]=out.get(exponent,Q(0))+fc*gc*p
    assert all(v==0 for v in out.values()),(types,c,mult,out)
    return any(2 in e for e in out),F,G

