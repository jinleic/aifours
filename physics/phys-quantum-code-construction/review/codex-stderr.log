    98	def as_masks(word):
    99	    return (sum(1<<j for j,p in enumerate(word) if p in 'XY'),
   100	            sum(1<<j for j,p in enumerate(word) if p in 'ZY'))
   101	
   102	
   103	def symplectic_distance(code):
   104	    generators=[as_masks(word) for word in code['stabilizer_generators']]
   105	    assert all(((x&v).bit_count()+(z&u).bit_count())%2==0
   106	               for x,z in generators for u,v in generators)
   107	    span={(0,0)}
   108	    for x,z in generators:
   109	        span |= {(u^x,v^z) for u,v in list(span)}
   110	    assert len(span)==64
   111	    assert code['K']==2**N//len(span)
   112	    minimum=N+1
   113	    distribution=[0]*(N+1)
   114	    for x in range(2**N):
   115	        for z in range(2**N):
   116	            if (x,z) not in span and all(((x&v).bit_count()+(z&u).bit_count())%2==0 for u,v in generators):
   117	                w=(x|z).bit_count()
   118	                distribution[w]+=1
   119	                minimum=min(minimum,w)
   120	    assert minimum==code['distance']==3
   121	    return {'paulis_enumerated':4**N,'stabilizer_size':len(span),
   122	            'normalizer_minus_stabilizer_weight_counts':distribution,'distance':minimum}
   123	
   124	
   125	def act(word, state):
   126	    """Integer signed permutation, Y represented by XZ (global phase omitted)."""
   127	    out=[0]*(2**N)
   128	    for basis,amplitude in enumerate(state):
   129	        if not amplitude:
   130	            continue
   131	        target=basis
   132	        sign=1
   133	        for j,pauli in enumerate(word):
   134	            bit=(basis>>j)&1
   135	            if pauli in ('Z','Y') and bit:
   136	                sign=-sign
   137	            if pauli in ('X','Y'):
   138	                target ^= 1<<j
   139	        out[target]+=sign*amplitude
   140	    return out
   141	
   142	
   143	def compression(word, states):
   144	    return [[sum(a*b for a,b in zip(left,act(word,right)))
   145	             for right in states] for left in states]
   146	
   147	
   148	def scalar_matrix(matrix):
   149	    return all(matrix[i][j]==(matrix[0][0] if i==j else 0)
   150	               for i in range(len(matrix)) for j in range(len(matrix)))
   151	
   152	
   153	def words_of_weight(w):
   154	    for support in combinations(range(N),w):
   155	        for labels in product('XYZ',repeat=w):
   156	            word=['I']*N
   157	            for j,label in zip(support,labels):
   158	                word[j]=label
   159	            yield ''.join(word)
   160	
   161	
   162	def vector_distance(code):
   163	    states=[[int(i in supp) for i in range(2**N)] for supp in code['basis_supports']]
   164	    assert len(states)==2
   165	    gram=[[sum(x*y for x,y in zip(a,b)) for b in states] for a in states]
   166	    assert gram==[[8,0],[0,8]]
   167	    for generator,eigenvalue in zip(code['stabilizer_generators'],code['generator_eigenvalues']):
   168	        for state in states:
   169	            assert act(generator,state)==[eigenvalue*x for x in state]
   170	    tested=0
   171	    for w in range(3):
   172	        for word in words_of_weight(w):
   173	            assert scalar_matrix(compression(word,states)), word
   174	            tested+=1
   175	    witness=code['weight_three_logical_witness']
   176	    assert sum(c!='I' for c in witness)==3
   177	    m=compression(witness,states)
   178	    assert not scalar_matrix(m)
   179	    # Negative control: orthogonal computational basis vectors fail at weight one.
   180	    bad=[[int(i==0) for i in range(128)],[int(i==1) for i in range(128)]]
   181	    assert not scalar_matrix(compression('ZIIIIII',bad))
   182	    return {'integer_gram':gram,'low_weight_paulis_checked':tested,
   183	            'weight_three_witness':witness,'unnormalized_witness_compression':m,
   184	            'distance':3,'negative_controls_rejected':1}
   185	
   186	
   187	def graph_assay():
   188	    errors=[]
   189	    for w in (1,2):
   190	        for word in words_of_weight(w):
   191	            errors.append(as_masks(word))
   192	    graphs=[g for g in nx.graph_atlas_g() if len(g)==N]
   193	    assert len(graphs)==1044
   194	    histogram={}
   195	    degenerate_graphs=0
   196	    graph_digest=hashlib.sha256()
   197	    for g in graphs:
   198	        neighbors=[sum(1<<j for j in g.neighbors(i)) for i in range(N)]
   199	        graph_digest.update(bytes(neighbors))
   200	        forbidden=set()
   201	        zero_x=[]
   202	        for x,z in errors:
   203	            induced=z
   204	            for j in range(N):
   205	                if x>>j&1:
   206	                    induced ^= neighbors[j]
   207	            if induced:
   208	                forbidden.add(induced)
   209	            else:
   210	                zero_x.append(x)
   211	        if zero_x:
   212	            degenerate_graphs+=1
   213	        allowed={c for c in range(1,128) if c not in forbidden and
   214	                 all((c&x).bit_count()%2==0 for x in zero_x)}
   215	        histogram[len(allowed)]=histogram.get(len(allowed),0)+1
   216	        # With 0 translated into the code, a third word needs a,b,a XOR b allowed.
   217	        assert all(a^b not in allowed for a,b in combinations(sorted(allowed),2))
   218	    return {'graphs':len(graphs),'graphs_with_weight_below_three_graph_stabilizers':degenerate_graphs,
   219	            'allowed_nonzero_word_histogram':histogram,'graphs_admitting_three_words':0,
   220	            'atlas_adjacency_sha256':graph_digest.hexdigest(),
   221	            'scope':'CWS graph-basis codes only; atlas completeness is not needed by the analytic proof'}
   222	
