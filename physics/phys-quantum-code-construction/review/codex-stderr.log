    52	    cols=[transform_column(i) for i in range(N+1)]
    53	    rows={}
    54	    for j in range(N+1):
    55	        rows[f'a_{j}']=[F(int(i==j)) for i in range(N+1)]
    56	        rows[f'KB_{j}-A_{j}']=[F(4*cols[i][j]-128*int(i==j)) for i in range(N+1)]
    57	        rows[f'shadow_{j}']=[F((-1)**i*cols[i][j]) for i in range(N+1)]
    58	    total=[F(0)]*(N+1)
    59	    for label,value in cert['nonnegative_multipliers'].items():
