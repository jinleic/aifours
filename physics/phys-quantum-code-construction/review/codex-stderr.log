    15	def error_pairs():
    16	    out=[]
    17	    for weight in range(1,4):
    18	        for support in combinations(range(N),weight):
    19	            for symbols in product((1,2,3),repeat=weight):
    20	                x=sum(1<<i for i,p in zip(support,symbols) if p&1)
    21	                z=sum(1<<i for i,p in zip(support,symbols) if p&2)
    22	                out.append((x,z))
