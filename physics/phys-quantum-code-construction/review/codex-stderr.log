    49	def build():
    50	    G,H,h,_,_ = constraints(3)
    51	    p = linprog(np.zeros(N+1), A_ub=-np.array(G), b_ub=np.zeros(len(G)),
    52	                A_eq=H, b_eq=h, bounds=[(None,None)]*(N+1), method='highs')
    53	    assert p.success, p.message
    54	    a = rational(p.x)
    55	    assert all(dot(row,a) >= 0 for row in G)
