    26	def graph_rows(mask):
    27	    offsets=[j+1 for j in range(5) if mask>>j&1]
    28	    return [sum(1<<((i+d)%N) for d in offsets)+sum(1<<((i-d)%N) for d in offsets)
    29	            for i in range(N)]
    30	
    31	
    32	def allowed_words(rows,errors):
    33	    forbidden=set()
    34	    zero_x=[]
    35	    for x,z in errors:
    36	        syndrome=z
    37	        while x:
    38	            bit=x&-x
    39	            syndrome ^= rows[bit.bit_length()-1]
    40	            x^=bit
    41	        if syndrome:
    42	            forbidden.add(syndrome)
    43	    # Separate loop retains the original x for every zero syndrome.
    44	    for x,z in errors:
    45	        syndrome=z
    46	        for i,row in enumerate(rows):
    47	            if x>>i&1:
    48	                syndrome ^= row
    49	        if not syndrome:
    50	            zero_x.append(x)
    51	    return [c for c in range(1,1<<N) if c not in forbidden and
    52	            all((c&x).bit_count()%2==0 for x in zero_x)]
