    55	def find_clique(vertices,need):
    56	    allowed=set(vertices)
    57	    adjacency=[]
    58	    for i,a in enumerate(vertices):
    59	        adjacency.append(sum(1<<j for j in range(i+1,len(vertices)) if a^vertices[j] in allowed))
    60	    calls=0
    61	    def recurse(candidates,left):
    62	        nonlocal calls
    63	        calls+=1
    64	        if left==0:
    65	            return []
    66	        while candidates.bit_count()>=left:
    67	            bit=candidates&-candidates
    68	            candidates^=bit
    69	            i=bit.bit_length()-1
    70	            result=recurse(candidates&adjacency[i],left-1)
    71	            if result is not None:
    72	                return [vertices[i]]+result
    73	        return None
    74	    result=recurse((1<<len(vertices))-1,need)
    75	    return result,calls
