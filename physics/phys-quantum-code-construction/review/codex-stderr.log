    24	def transform_column(i):
    25	    """Coefficients of (x+3y)^(7-i)(x-y)^i by polynomial multiplication."""
    26	    coeff = [1]
    27	    for slope in [3]*(N-i)+[-1]*i:
    28	        nxt = [0]*(len(coeff)+1)
    29	        for j, value in enumerate(coeff):
    30	            nxt[j] += value
    31	            nxt[j+1] += slope*value
    32	        coeff = nxt
    33	    return coeff
    34	
    35	
    36	def transforms(a, K):
    37	    coeffs = [transform_column(i) for i in range(N+1)]
    38	    b = [F(K,2**N)*sum(coeffs[i][j]*a[i] for i in range(N+1)) for j in range(N+1)]
    39	    s = [F(1,2**N)*sum((-1)**i*coeffs[i][j]*a[i] for i in range(N+1)) for j in range(N+1)]
    40	    return b,s
    41	
    42	
    43	def primal_ok(a, K=3):
    44	    b,s=transforms(a,K)
    45	    return (a[0]==1 and min(a)>=0 and min(s)>=0 and
    46	            all(b[j]==a[j] for j in range(3)) and
    47	            all(b[j]>=a[j] for j in range(3,N+1)))
    48	
    49	
    50	def farkas_ok(cert):
    51	    assert (cert['n'],cert['K'],cert['d']) == (7,4,3)
    52	    cols=[transform_column(i) for i in range(N+1)]
    53	    rows={}
    54	    for j in range(N+1):
    55	        rows[f'a_{j}']=[F(int(i==j)) for i in range(N+1)]
    56	        rows[f'KB_{j}-A_{j}']=[F(4*cols[i][j]-128*int(i==j)) for i in range(N+1)]
    57	        rows[f'shadow_{j}']=[F((-1)**i*cols[i][j]) for i in range(N+1)]
    58	    total=[F(0)]*(N+1)
    59	    for label,value in cert['nonnegative_multipliers'].items():
    60	        value=F(value)
    61	        if value<0 or (label.startswith('KB_') and int(label.split('_')[1].split('-')[0])<3):
    62	            return False
    63	        for i in range(N+1):
    64	            total[i]+=value*rows[label][i]
    65	    constant=F(0)
    66	    for label,value in cert['equality_multipliers'].items():
    67	        value=F(value)
    68	        if label=='a_0=1':
    69	            constant+=value
    70	            total[0]+=value
    71	        else:
    72	            label=label.removesuffix('=0')
    73	            if label not in [f'KB_{j}-A_{j}' for j in range(3)]:
    74	                return False
    75	            for i in range(N+1):
    76	                total[i]+=value*rows[label][i]
    77	    return not any(total) and constant==1
    78	
    79	
    80	def verify_lp():
    81	    cert=load('lp-feasible-7-3-3.json')
    82	    assert (cert['n'],cert['K'],cert['d']) == (7,3,3)
    83	    a=list(map(F,cert['a']))
    84	    assert len(a)==8 and primal_ok(a)
    85	    b,s=transforms(a,3)
    86	    dual=load('lp-infeasible-7-4-3.json')
    87	    assert farkas_ok(dual)
    88	    broken=a.copy()
    89	    broken[4]+=1
    90	    assert not primal_ok(broken)
    91	    broken_dual=copy.deepcopy(dual)
    92	    broken_dual['nonnegative_multipliers']['a_1']='5'
    93	    assert not farkas_ok(broken_dual)
    94	    return {'K3_a':list(map(str,a)), 'K3_b':list(map(str,b)), 'K3_shadow':list(map(str,s)),
    95	            'K4_farkas_identity':'0 >= 1', 'negative_controls_rejected':2}
