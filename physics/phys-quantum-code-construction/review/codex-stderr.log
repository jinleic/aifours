    27	def constraints(K):
    28	    identity = [[int(i == j) for i in range(N+1)] for j in range(N+1)]
    29	    mac = [[K*kraw(j, i) - 2**N*int(i == j) for i in range(N+1)]
    30	           for j in range(N+1)]
    31	    shadow = [[(-1)**i*kraw(j, i) for i in range(N+1)] for j in range(N+1)]
    32	    # G*a >= 0, H*a = h. All matrix entries are integers.
    33	    G = identity + mac[D:] + shadow
    34	    H = [identity[0]] + mac[:D]
    35	    h = [1] + [0]*D
    36	    glabels = [f'a_{i}' for i in range(N+1)] + [f'KB_{i}-A_{i}' for i in range(D,N+1)] + [f'shadow_{i}' for i in range(N+1)]
    37	    hlabels = ['a_0=1'] + [f'KB_{i}-A_{i}=0' for i in range(D)]
    38	    return G, H, h, glabels, hlabels
