+        if len(z) == 4:
+            procs[int(z[0])] = (int(z[1]), int(z[2]) * 1024, z[3])
+    own = {os.getpid()}
+    selected = own | {p for p, (_, _, cmd) in procs.items() if any(m in cmd for m in markers)}
+    for group in (own, selected):
