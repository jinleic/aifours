+    done2, stop2, surv2, cres, fres, lres, cs, warn = {}, None, {}, {}, {}, {}, [], []
+    if stop1 is None and not surv1 and (done1.get('kissat') or {}).get('rc') == 20 and pres.get('ok'):
+        cr, cw = os.pipe(); pr, pw = os.pipe(); lr, lw = os.pipe(); t2s = time.monotonic()
+        dp = subprocess.Popen([DRAT, '/dev/fd/%d' % cr, '-i', '-t', str(dsec)], stdin=pr, stdout=lw,
+                              stderr=subprocess.STDOUT, pass_fds=(cr,), cwd=str(OUTDIR/'tmp'))
+        for fd in (cr, pr, lw):
