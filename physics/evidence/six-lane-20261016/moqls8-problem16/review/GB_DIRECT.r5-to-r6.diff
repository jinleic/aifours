+def supervise(live, rec, t0, stopflag, peak, on_exit=None):
+    done = {}; stop_reason = None; termed = None; last_free = 0.0
+    lane_t = time.monotonic(); lane_counted = ga_usage()['ga_counted_bytes']
+
+    def reap(name, pid):
+        got, st, ru = os.wait4(pid, os.WNOHANG)
+        if got != pid:
+            return False
+        done[name] = {'rc': os.waitstatus_to_exitcode(st), 'wall_s': round(time.monotonic() - t0, 3),
+                      'ru_maxrss_bytes': ru.ru_maxrss, 'user_s': ru.ru_utime, 'sys_s': ru.ru_stime}
+        del live[name]
+        if on_exit:
+            on_exit(name)
+        return True
+    while live:
+        for name, pid in list(live.items()):
+            reap(name, pid)
+        agg = resident(os.getpid())[0] or resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+        unknown = []
+        for name, pid in list(live.items()):
+            r, err = resident(pid)
+            if r is None:
+                if not reap(name, pid):
+                    unknown.append((name, err))
+            else:
+                peak[name] = max(peak.get(name, 0), r); agg += r
+        peak['aggregate'] = max(peak.get('aggregate', 0), agg)
+        tn = time.monotonic()
+        if tn - lane_t >= 10.0:
+            lane_t = tn; lane_counted = ga_usage()['ga_counted_bytes']
+            peak['lane_counted_ga_max'] = max(peak.get('lane_counted_ga_max', 0), lane_counted)
+        if stop_reason is None and live:
+            if unknown:
+                stop_reason = 'unknown resident reading %r' % unknown
+            elif agg > AGG_CAP:
+                stop_reason = 'aggregate resident %d > cap %d' % (agg, AGG_CAP)
+            elif agg + lane_counted > LANE_CAP_RSS:
+                stop_reason = 'M8 lane resident (GA counted %d + this pipeline %d) > %d; GA has priority' % (lane_counted, agg, LANE_CAP_RSS)
+            elif time.time() >= DEADLINE:
+                stop_reason = 'in-flight deadline 17:55 PDT'
+            elif stopflag.get('sigterm'):
+                stop_reason = 'driver SIGTERM'
+            elif tn - last_free >= 2.0:
+                last_free = tn; fb = shutil.disk_usage(ROOT).free
+                if fb < FLOOR:
+                    stop_reason = 'free bytes %d < in-flight floor %d' % (fb, FLOOR)
+            if stop_reason:
+                termed = tn
+                rec['events'].append({'at': now(), 'event': 'SIGTERM', 'reason': stop_reason, 'targets': list(live)})
+                for pid in live.values():
+                    try:
+                        os.kill(pid, signal.SIGTERM)
+                    except ProcessLookupError:
+                        pass
+        if termed is not None and tn - termed > 120 and live:
+            rec['events'].append({'at': now(), 'event': 'bounded wait exceeded; survivors recorded, no SIGKILL',
+                                  'survivors': dict(live)})
+            break
+        if live:
+            time.sleep(0.5)
+    return done, stop_reason, dict(live)
