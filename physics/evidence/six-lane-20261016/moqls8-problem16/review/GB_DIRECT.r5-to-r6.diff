+           'kissat_argv': [KISSAT, '--time=%d' % ksec, '/dev/fd/<cnf>', str(fifo)],
+           'drat_argv': [DRAT, '/dev/fd/<cnf>', '-i', '-t', str(dsec)], 'expected_feed_bytes': expected_bytes,
+           'expected_feed_sha256': expected_sha, 'events': []}
