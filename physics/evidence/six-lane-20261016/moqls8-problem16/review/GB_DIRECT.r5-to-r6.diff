+def collector(rfd, chunks, res):
+    h, total = hashlib.sha256(), 0
+    try:
+        while True:
+            b = os.read(rfd, 1 << 20)
+            if not b:
+                break
+            chunks.append(b); h.update(b); total += len(b)
+        res.update(ok=True, error=None)
+    except OSError as e:
+        res.update(ok=False, error=repr(e))
+    finally:
+        os.close(rfd)
+    res.update(proof_bytes_read=total, proof_sha256=h.hexdigest())
+
+
+def proof_feeder(fd, chunks, res):
+    h, total = hashlib.sha256(), 0
+    try:
+        for i in range(len(chunks)):
+            c = chunks[i]; mv = memoryview(c); n = 0
+            while n < len(mv):
+                n += os.write(fd, mv[n:])
+            h.update(c); total += len(c); chunks[i] = None
+        res.update(ok=True, error=None)
+    except OSError as e:
+        res.update(ok=False, error=repr(e))
+    finally:
+        os.close(fd)
+    res.update(proof_bytes_fed=total, proof_fed_sha256=h.hexdigest())
+
