+def pipeline_staged(label, parts, expected_bytes, expected_sha, ksec, dsec, stopflag):
+    """Stage 1: kissat alone; its DRAT goes FIFO -> collector (sha/bytes) -> driver RAM chunks.
+    Stage 2 (only after kissat rc20 and no stop): drat-trim alone, fed the CNF and the in-memory proof."""
