    47	        a root beta of g has degree d and Q(beta) contains Q(alpha) = F (F has no proper
    48	        subfield other than Q), so Q(beta) = F and alpha = beta^2 IS a square.
    49	    """
    50	    P = sp.Poly(pi, v)
    51	    num, den = sp.fraction(sp.together(expr))
    52	    alpha = sp.rem(sp.Poly(num, v) * sp.invert(sp.Poly(den, v), P), P)   # alpha in Q[v]/(pi)
    53	    d = P.degree()
    54	    t = sp.Symbol('t')
