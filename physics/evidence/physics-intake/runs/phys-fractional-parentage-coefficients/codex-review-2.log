     1	"""Can a Q(v)-rational orthonormal basis of a two-dimensional spin-2 multiplicity family
     2	L = 2v - k (k = 6, 8, ...) have Bao-Li-type CFPs?
     3	
     4	K = Q(v).  For x in V (Q(v)-span of the family states), cfp(x/|x|; d)^2 = b_d(x)^2 C_d / q(x)
     5	with C_d a product of linear factors (multiplicity_obstruction.py).  So some (equivalently
     6	every) nonzero CFP of x/|x| into a multiplicity-free daughter is of Bao-Li type
     7	(square * constant * product of linear polynomials) iff q(x) lies in L * K*^2, where L is
     8	generated by Q* and the linear polynomials.  With q = <q11, q11*Delta> (q11 = q(phi1),
     9	Delta = det G), q represents c iff the quaternion algebra A_c = (c*q11, -Delta) splits over K;
    10	necessary: every residue (tame symbol) of A_c vanishes.
    11	
    12	Steps (all exact):
    13	 1. non-linear irreducible pi with odd valuation in q11 (or in Delta): A_c has residue
    14	    (-Delta mod pi) (resp. depending on c) -- checked with multiplicity_obstruction.is_square_mod;
    15	 2. P = rational places (roots of linear factors, and infinity) where -Delta has odd
    16	    valuation; for c = c0 * prod_{s in S}(v - s), S a subset of P, the residues at P are
    17	    c0 * R_S(r); a suitable c0 exists iff all R_S(r) coincide (bimultiplicativity);
    18	 3. a linear factor (v - s), s not in P, may occur in c only if -Delta(s) is a nonzero
    19	    rational square (else the residue at s is nontrivial): search s of small height and
    20	    s = n/4, |n| <= 10^6.
    21	Run: $PY code/brauer_residues.py [k] [height]     (k in {6, 8, 9, 10, 11}; default 6, 60)
    22	"""
    23	import itertools
    24	import sys
    25	from math import gcd, isqrt
    26	
    27	import sympy as sp
    28	
    29	from multiplicity_obstruction import family_gram, is_square_mod, square_free_part
    30	from top_family_symbolic import v
    31	
    32	
    33	def sqclass(r):
    34	    r = sp.Rational(r)
    35	    n = r.p * r.q
    36	    out = -1 if n < 0 else 1
    37	    for p, e in sp.factorint(abs(n)).items():
    38	        if e % 2:
    39	            out *= p
    40	    return out
    41	
    42	
    43	def val_unit(expr, r):
    44	    num, den = sp.fraction(sp.together(expr))
    45	    pn, pd = sp.Poly(num, v), sp.Poly(den, v)
    46	    if r == 'inf':
    47	        return -(pn.degree() - pd.degree()), sp.Rational(pn.LC()) / sp.Rational(pd.LC())
    48	    a = 0
    49	    lin = sp.Poly(v - r, v)
    50	    while pn.eval(r) == 0:
    51	        pn = sp.div(pn, lin)[0]
    52	        a += 1
    53	    while pd.eval(r) == 0:
    54	        pd = sp.div(pd, lin)[0]
    55	        a -= 1
    56	    return a, sp.Rational(pn.eval(r)) / sp.Rational(pd.eval(r))
    57	
    58	
    59	def tame(x, y, r):
    60	    a, u = val_unit(x, r)
    61	    b, w = val_unit(y, r)
    62	    return sqclass((-1) ** (a * b) * u ** b * w ** (-a))
    63	
    64	
    65	def odd_linear_places(expr):
    66	    """Rational roots of linear factors with odd multiplicity, plus 'inf' if the degree is odd."""
    67	    _, facs = square_free_part(expr)
    68	    places = []
    69	    for fac in facs:
    70	        P = sp.Poly(fac, v)
    71	        if P.degree() == 1:
    72	            a, b = P.all_coeffs()
    73	            places.append(sp.Rational(-b, a))
    74	    num, den = sp.fraction(sp.together(expr))
    75	    if (sp.Poly(num, v).degree() - sp.Poly(den, v).degree()) % 2:
    76	        places.append('inf')
    77	    return places
    78	
    79	
    80	def residue_hits(x0, y, places):
    81	    """Subsets S of the finite places and c0 with all residues of (c0 prod_S (v-s) x0, y) trivial.
    82	
    83	    places: every rational place where x0 or y has odd valuation (plus 'inf' if relevant).
    84	    c0 contributes c0^(v_r(y)): at places with v_r(y) odd the residues must all equal c0,
    85	    at places with v_r(y) even they must be trivial."""
    86	    finite = [r for r in places if r != 'inf']
    87	    yodd = {r: val_unit(y, r)[0] % 2 == 1 for r in places}
    88	    base = {r: tame(x0, y, r) for r in places}
    89	    gens = {s: {r: tame(v - s, y, r) for r in places} for s in finite}
    90	    hits = []
    91	    for eps in itertools.product((0, 1), repeat=len(finite)):
    92	        res = dict(base)
    93	        for s, e in zip(finite, eps):
    94	            if e:
    95	                res = {r: sqclass(res[r] * gens[s][r]) for r in places}
    96	        odd_vals = {res[r] for r in places if yodd[r]}
    97	        if len(odd_vals) <= 1 and all(res[r] == 1 for r in places if not yodd[r]):
    98	            hits.append(([s for s, e in zip(finite, eps) if e], odd_vals.pop() if odd_vals else 1))
    99	    return base, hits
   100	
   101	
   102	def extra_places(y, places, height, quarter_bound):
   103	    num, den = sp.fraction(sp.together(y))
   104	    a = [int(c) for c in sp.Poly(num, v).all_coeffs()]
   105	    b = [int(c) for c in sp.Poly(den, v).all_coeffs()]
   106	    assert all(sp.Rational(c).q == 1 for c in sp.Poly(num, v).all_coeffs() + sp.Poly(den, v).all_coeffs())
   107	
   108	    def hom(coeffs, p, q):
   109	        d = len(coeffs) - 1
   110	        return sum(c * p ** (d - i) * q ** i for i, c in enumerate(coeffs))
   111	
   112	    def is_sq(p, q):
   113	        val = hom(a, p, q) * hom(b, p, q) * q ** ((len(a) - 1 + len(b) - 1) % 2)
   114	        return val > 0 and isqrt(val) ** 2 == val
   115	
   116	    skip = set(r for r in places if r != 'inf')
   117	    small = [sp.Rational(p, q) for q in range(1, height + 1) for p in range(-height * q, height * q + 1)
   118	             if gcd(p, q) == 1 and sp.Rational(p, q) not in skip and hom(b, p, q) != 0 and is_sq(p, q)]
   119	    quarter = [n for n in range(-quarter_bound, quarter_bound + 1)
   120	               if sp.Rational(n, 4) not in skip and hom(b, n, 4) != 0 and is_sq(n, 4)]
   121	    return small, quarter
   122	
