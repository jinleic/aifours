   203	def large_sign(expr):
   204	    """Sign of a rational function of (v, f) for large v and f (asymptotic sign; callers
   205	    check separately that no factor changes sign on the integer domain used)."""
   206	    val = sp.sympify(expr).subs({v: 10 ** 9, fs: 10 ** 6})
