    46	def numeric_Q00(f, n):
    47	    """sum over an orthonormal basis of the (n, L = f n - 4) block of cfp^2 into the stretched
    48	    daughter, from the polynomial engine."""
    49	    B = SpinBosons(f)
    50	    basis = B.hw_harmonic_basis(n, f * n - 4)
    51	    assert len(basis) == 2
    52	    ortho = []
    53	    for w in basis:
    54	        w = dict(w)
    55	        for u in ortho:
    56	            c = B.inner(u, w) / B.norm2(u)
    57	            for a, x in u.items():
    58	                w[a] = w.get(a, fmpq(0)) - c * x
    59	            w = {a: x for a, x in w.items() if x != 0}
    60	        ortho.append(w)
    61	    daughter = {tuple([0] * (2 * f) + [n - 1]): fmpq(1)}
    62	    return sum((B.cfp_sq_sign(psi, n, f * n - 4, daughter, f * (n - 1))[0] for psi in ortho), fmpq(0))
    63	
    64	
    65	def main(fs_):
    66	    for f in fs_:
    67	        D, q00, q01, q11, disc, rows, Cds = family(f)
    68	        print(f"=== spin f = {f}, family L = {f}v - 4 ===")
    69	        print("q(phi0) =", sp.factor(q00))
    70	        print("q(phi1) =", sp.factor(q11))
    71	        print("disc =", disc)
    72	        for kp, Cd in zip((0, 2, 3), Cds):
    73	            nonlin = [p for p in square_free_part(Cd)[1] if sp.Poly(p, v).degree() > 1]
    74	            assert not nonlin, (f, kp, Cd)
    75	        M = sp.Matrix(rows)
    76	        print("C_d linear-type for k' = 0, 2, 3; pairing rank:", M.rank(simplify=True))
    77	        G = sp.Matrix([[q00, q01], [q01, q11]])
    78	        b = sp.Matrix(rows[0])
    79	        Q00 = sp.factor(sp.cancel(Cds[0] * (b.T * G.inv() * b)[0, 0]))
    80	        print("basis-independent weight into the stretched daughter Q_00 =", Q00)
    81	        for n in range(5, 10):
    82	            num = numeric_Q00(f, n)
    83	            assert sp.Rational(Q00.subs(v, n)) == sp.Rational(int(num.p), int(num.q)), (f, n)
    84	        print("Q_00 agrees with the polynomial engine at v = 5..9")
    85	        analyze(q11, disc, height=30)
    86	
    87	
    88	if __name__ == "__main__":
    89	    main([int(a) for a in sys.argv[1:]] or [3, 4, 5])

