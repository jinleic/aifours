   107	def numeric_crosscheck(k, q00, q01, q11, nvals=10):
   108	    """Scale-invariant check against the independent polynomial engine (spin2_basis):
   109	    cos^2 = q01^2/(q00 q11) of the two projected covariants at L = 2v - k."""
   110	    from spin2_basis import Spin2
   111	    S2 = Spin2()
   112	    B = S2.B
   113	    for vv in range(k + 1, k + 1 + nvals):
   114	        (e0, a), (e1, b) = S2.raw_basis(vv, 2 * vv - k)
   115	        assert (e0, e1) == (0, 1)
   116	        num = B.inner(a, b) ** 2 / (B.norm2(a) * B.norm2(b))
   117	        sym = sp.Rational((q01 ** 2 / (q00 * q11)).subs(v, vv))
   118	        assert sym == sp.Rational(int(num.p), int(num.q)), vv
   119	    return nvals
