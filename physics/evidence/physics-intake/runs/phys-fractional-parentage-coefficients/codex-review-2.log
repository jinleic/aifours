   262	    # ----- CFP -------------------------------------------------------------------------
   263	    def cfp_sq_sign(self, parent, N, L, daughter, Lp):
   264	        """Squared one-body CFP (fmpq) and sign for unnormalised highest-weight states.
   265	
   266	        parent: degree-N polynomial with S_z = L, S+ parent = 0 (total spin L)
   267	        daughter: degree-(N-1) polynomial with S_z = Lp, S+ daughter = 0.
   268	        Returns (0, 0) when (f, Lp, L) violates the triangle rule.
   269	        """
   270	        mu = L - Lp
   271	        if not (abs(mu) <= self.f <= L + Lp):
   272	            return fmpq(0), 0
   273	        x = self.inner(parent, self.mul_var(daughter, mu))
   274	        cgs, cg2 = cg_stretched(self.f, mu, Lp, Lp, L)
   275	        val = x * x / (self.w[mu + self.f] * self.norm2(parent) * self.norm2(daughter) * N * cg2)
   276	        sgn = 0 if x == 0 else (1 if x > 0 else -1) * cgs
   277	        return val, sgn
