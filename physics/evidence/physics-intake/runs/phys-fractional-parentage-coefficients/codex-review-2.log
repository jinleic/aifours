   104	        self._cache[key] = out
   105	        return out
     1	"""Exact tables of SO(5)>SO(3) reduced one-body CFPs r(v e L ; v-1 e' L') for spin-2 bosons.
     2	
     3	r is the one-body CFP at N = v (harmonic states); by Theorem A every spin-2 one-body CFP
     4	equals an explicit N-factor times r.  Basis: Gram-Schmidt of harmonic projections of
     5	covariant monomials f^a H^b T^c j^e (see spin2_basis.py), in order of e ascending ("asc",
     6	default) or descending ("desc").
     7	
     8	Output: results/spin2_r_table_<tag>.json  with entries
     9	  {"v","L","e","Lp","ep","r2" (exact p/q), "sign"}  plus per-(v,L) multiplicity checks.
    10	Run: $PY code/spin2_tables.py VMAX [LMAX|-] [asc|desc]
    11	"""
    12	import json
    13	import os
    14	import sys
    15	import time
    16	
    17	from flint import fmpq
    18	
    19	from fpc_core import frac_str
    20	from spin2_basis import Spin2, labels
    21	
    22	
    23	def main(vmax, lmax=None, order="asc"):
    24	    """All parents with v <= vmax (and L <= lmax if given: the low-spin 'bottom' sector)."""
    25	    S = Spin2()
    26	    B = S.B
    27	    rows = []
    28	    mult_checks = []
    29	    t0 = time.time()
    30	    for v in range(1, vmax + 1):
    31	        for L in range(0, (2 * v if lmax is None else min(2 * v, lmax)) + 1):
    32	            labs = labels(v, L)
    33	            nul = B.hw_harmonic_basis(v, L) if v <= 14 else None
    34	            if nul is not None:
    35	                assert len(nul) == len(labs), (v, L, len(nul), labs)
    36	                mult_checks.append((v, L, len(labs)))
    37	            if not labs:
    38	                continue
    39	            parents = S.orthogonal_basis(v, L, order)
    40	            for e, psi in parents:
    41	                tot = fmpq(0)
    42	                for Lp in range(max(0, L - 2), L + 3):
    43	                    if not labels(v - 1, Lp):
    44	                        continue
    45	                    for ep, phi in S.orthogonal_basis(v - 1, Lp, order):
    46	                        sq, sg = B.cfp_sq_sign(psi, v, L, phi, Lp)
    47	                        tot += sq
    48	                        rows.append({"v": v, "L": L, "e": e, "Lp": Lp, "ep": ep,
    49	                                     "r2": frac_str(sq), "sign": sg})
    50	                assert tot == 1, (v, L, e, tot)
    51	        print(f"v={v} done  ({time.time() - t0:.1f}s)", flush=True)
    52	    here = os.path.dirname(os.path.abspath(__file__))
    53	    tag = (f"v{vmax}" if lmax is None else f"v{vmax}_L{lmax}") + ("" if order == "asc" else "_desc")
    54	    out = os.path.join(here, "..", "results", f"spin2_r_table_{tag}.json")
    55	    with open(out, "w") as fh:
    56	        json.dump({"description": "spin-2 SO(5)>SO(3) reduced one-body CFPs r(v e L; v-1 e' L'), "
    57	                                  f"GS basis (e {order}) of projected covariants f^a H^b T^c j^e; "
    58	                                  "sign convention: see spin2_basis.py / fpc_core.py",
    59	                   "vmax": vmax, "multiplicity_checks_vs_nullspace": mult_checks,
    60	                   "rows": rows}, fh, indent=0)
    61	    print(f"wrote {len(rows)} rows; completeness exact for every parent; "
    62	          f"label count == null-space dimension for {len(mult_checks)} (v,L) pairs")
    63	
    64	
    65	if __name__ == "__main__":
