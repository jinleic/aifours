   130	
   131	    def mul(self, p, q):
   132	        out = {}
   133	        for d, c in p.items():
   134	            for e, b in q.items():
   135	                nd = tuple(x + y for x, y in zip(d, e))
   136	                out[nd] = out.get(nd, 0) + c * b
   137	        return {d: sp.expand(c) for d, c in out.items() if sp.expand(c) != 0}
   138	
   139	    def mul_z(self, p, j):
   140	        """Multiply by z_(f-j)."""
   141	        if j == 0:
   142	            return dict(p)
   143	        out = {}
   144	        for d, c in p.items():
   145	            nd = list(d)
   146	            nd[j - 1] += 1
