   122	def main(k=6):
   123	    S, phi0, phi1, q00, q01, q11, disc = family_gram(k)
   124	    D = S.D
   125	    print(f"family k = {k} (L = 2v - {k})")
   126	    print("q(phi0) =", sp.factor(q00))
   127	    print("q(phi1) =", sp.factor(q11))
   128	    print("<phi0,phi1> =", sp.factor(q01))
   129	    print("disc = det G =", disc)
   130	    print("square-free part of disc:", square_free_part(disc))
   131	    n = numeric_crosscheck(k, q00, q01, q11)
   132	    print(f"independent numeric engine agrees on q01^2/(q00 q11) for {n} values v = {k + 1}..{k + n}")
   133	    free = [kp for kp in range(max(0, k - 4), k + 1) if len(f2_labels(kp)) == 1]
   134	    rows = []
   135	    Cd_list = []
   136	    for kp in free:
   137	        (e0, y), = S.basis(kp, v - 1)
   138	        j = k - kp
   139	        nd = D.inner(y, y, v - 1, kp)
   140	        shift = kp + 1 - k
   141	        fac = sp.ff(v - k, shift) if shift >= 0 else 1 / sp.ff(v - 1 - kp, -shift)
   142	        Cd = sp.factor(fac / (D.w(j) * nd * v * cg2(2, 2 * v - k, 2 * (v - 1) - kp, j)))
   143	        b0 = D.inner(phi0, D.mul_z(y, j), v, k)
   144	        b1 = D.inner(phi1, D.mul_z(y, j), v, k)
   145	        rows.append((b0, b1))
   146	        Cd_list.append(Cd)
   147	        print(f"daughter k'={kp}: C_d = {Cd};  square-free part {square_free_part(Cd)}")
   148	        print(f"   b_d(phi0) = {sp.factor(b0)},  b_d(phi1) = {sp.factor(b1)}")
   149	    M = sp.Matrix(rows)
   150	    print(f"rank of the {len(rows)}x2 pairing matrix over Q(v):", M.rank(simplify=True))
   151	    G = sp.Matrix([[q00, q01], [q01, q11]])
   152	    Ginv = G.inv()
   153	    # basis-invariant total parentage weight Q_dd = C_d * b_d^T G^{-1} b_d (sum over any
   154	    # orthonormal parent basis of cfp^2 into daughter d); principal parent of d has
   155	    # q(x_d) = b_d^T G^{-1} b_d.
   156	    for kp, (b0, b1), Cd in zip(free, rows, Cd_list):
