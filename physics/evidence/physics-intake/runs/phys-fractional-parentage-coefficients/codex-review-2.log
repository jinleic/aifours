   210	def leading_sign_fix(p):
   211	    """Phase rule: coefficient of the partition with lexicographically largest
   212	    (d_J, ..., d_1) is positive (for large v)."""
   213	    key = max(p, key=lambda d: tuple(reversed(d)))
   214	    return {d: -x for d, x in p.items()} if large_sign(p[key]) < 0 else p
