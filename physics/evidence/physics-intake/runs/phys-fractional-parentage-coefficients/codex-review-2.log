   150	    def inner(self, p, q, n, k):
   151	        """<p, q> / (n-k)! for degree-n, deficit-k polynomials (exact rational function)."""
   152	        s = 0
   153	        for d, c in p.items():
   154	            b = q.get(d)
   155	            if b is None:
