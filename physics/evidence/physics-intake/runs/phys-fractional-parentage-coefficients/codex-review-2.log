   324	        self.H, self.T, self.J = (leading_sign_fix(p) for p in (H, T, J))
   325	        self._basis = {}
   326	
   327	    def harm_proj(self, p, n, k):
   328	        D = self.D
   329	        out = dict(p)
   330	        q = p
   331	        coef = sp.Integer(1)
   332	        i = 0
   333	        while 4 * (i + 1) <= k:
   334	            i += 1
   335	            q = D.pair_ann(q, n - 2 * (i - 1))
   336	            if not q:
   337	                break
   338	            coef = coef * sp.Integer(-1) / (2 * i * (5 + 2 * n - 2 - 2 * i))
   339	            t = q
   340	            for _ in range(i):
   341	                t = D.pair_cre(t)
   342	            for d, c in t.items():
   343	                out[d] = out.get(d, 0) + coef * c
   344	        return {d: sp.factor(sp.cancel(c)) for d, c in out.items() if sp.cancel(c) != 0}
   345	
   346	    def covariant(self, k, e):
   347	        """Deficit polynomial of H^b T^c J^e for the family k (the f^a factor is implicit)."""
   348	        c = (k - 6 * e) % 2
   349	        b = (k - 6 * e - 3 * c) // 2
   350	        p = {(0, 0, 0, 0): sp.Integer(1)}
   351	        for _ in range(b):
   352	            p = self.D.mul(p, self.H)
   353	        if c:
   354	            p = self.D.mul(p, self.T)
   355	        for _ in range(e):
   356	            p = self.D.mul(p, self.J)
   357	        return p
