    93	def family_gram(k=6):
    94	    """Symbolic Gram data of family k: (S, phi0, phi1, q00, q01, q11, disc)."""
    95	    assert f2_labels(k) == [0, 1], k
    96	    S = Spin2Families()
    97	    D = S.D
    98	    phi0 = S.harm_proj(S.covariant(k, 0), v, k)
    99	    phi1 = S.harm_proj(S.covariant(k, 1), v, k)
   100	    q00 = D.inner(phi0, phi0, v, k)
   101	    q01 = D.inner(phi0, phi1, v, k)
   102	    q11 = D.inner(phi1, phi1, v, k)
   103	    disc = sp.factor(q00 * q11 - q01 ** 2)
   104	    return S, phi0, phi1, q00, q01, q11, disc
