    80	        return [(e, self.B.harm_proj(self.covariant_monomial(v, e, L), v)) for e in labels(v, L)]
    81	
    82	    def orthogonal_basis(self, v, L, order="asc"):
    83	        """[(e, psi)] Gram-Schmidt of the projected covariants, in order of e ascending
    84	        ("asc", default) or descending ("desc": most trios first)."""
    85	        key = (v, L, order)
    86	        if key in self._cache:
    87	            return self._cache[key]
    88	        B = self.B
    89	        out = []
    90	        raw = self.raw_basis(v, L)
    91	        for e, phi in (raw if order == "asc" else raw[::-1]):
    92	            w = dict(phi)
    93	            for _, u in out:
    94	                cf = B.inner(u, w) / B.norm2(u)
    95	                for a, x in u.items():
