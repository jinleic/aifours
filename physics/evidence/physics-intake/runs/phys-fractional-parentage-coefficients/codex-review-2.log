   217	def reduced_cfp2(D, psi, k, phi, kp, f):
   218	    """r^2 for parent psi (degree v, deficit k) and daughter phi (degree v-1, deficit kp)."""
   219	    j = k - kp
   220	    if not (0 <= j <= 2 * f if not D.symbolic else 0 <= j):
   221	        return sp.Integer(0), 0
   222	    L = f * v - k
   223	    Lp = f * (v - 1) - kp
   224	    X = D.inner(psi, D.mul_z(phi, j), v, k)
   225	    Np = D.inner(psi, psi, v, k)
   226	    Nd = D.inner(phi, phi, v - 1, kp)
   227	    shift = kp + 1 - k   # (v-k)!/(v-1-kp)!
   228	    fac = sp.ff(v - k, shift) if shift >= 0 else 1 / sp.ff(v - 1 - kp, -shift)
   229	    val = sp.factor(sp.cancel(X ** 2 * fac / (D.w(j) * Np * Nd * v * cg2(f, L, Lp, j))))
   230	    sgn_cg = -1 if (j % 2) else 1   # (-1)^(f - mu) = (-1)^j
   231	    return val, large_sign(X) * sgn_cg, sp.factor(X)
