   234	def run_general(kmax):
   235	    """Symbolic f: families k < 2f (no harmonic constraint), multiplicity-free ones."""
   236	    D = Deficit(fs, kmax)
   237	    states = {}
   238	    for k in range(0, kmax + 1):
   239	        ker = D.hw_kernel(v, k, harmonic=False)
   240	        states[k] = [leading_sign_fix(p) for p in ker]
   241	    res = {}
   242	    for k in range(1, kmax + 1):
   243	        if len(states[k]) != 1:
   244	            continue
   245	        for kp in range(max(0, k - 2 * kmax), k + 1):
   246	            if kp not in states or len(states[kp]) != 1:
   247	                continue
   248	            j = k - kp
   249	            val, sg, X = reduced_cfp2(D, states[k][0], k, states[kp][0], kp, fs)
   250	            res[(k, kp)] = (val, sg)
   251	    return states, res
