     1	"""The first multiplicity family for spin f >= 3: L = f v - 4 (two states of seniority v).
     2	
     3	For f >= 3 the deficit-4 highest-weight space is two-dimensional and automatically harmonic
     4	(P lowers the deficit by 2f > 4).  This script (exact, symbolic in v, for f = 3, 4, 5):
     5	  * builds a Q(v)-rational basis (sympy null space of S+ in deficit coordinates) and the Gram
     6	    matrix of the Fock form / (v-4)!;
     7	  * checks that the factors C_d of the multiplicity-free daughters (k' = 0, 2, 3) are products of
     8	    linear polynomials and that the pairing matrix has rank 2;
     9	  * cross-checks the basis-independent weight Q_dd into the stretched daughter (k' = 0) against
    10	    the independent polynomial engine fpc_core at v = 5..9;
    11	  * runs the residue (Brauer) analysis of brauer_residues.analyze on <q11, q11*disc>.
    12	Run: $PY general_f_k4.py [f ...]   (default 3 4 5)
    13	"""
    14	import sys
    15	
    16	import sympy as sp
    17	from flint import fmpq
    18	
    19	from brauer_residues import analyze
    20	from fpc_core import SpinBosons
    21	from multiplicity_obstruction import square_free_part
    22	from top_family_symbolic import Deficit, cg2, v
    23	
    24	
    25	def family(f):
    26	    D = Deficit(f, 2 * f)
    27	    k = 4
    28	    phi0, phi1 = D.hw_kernel(v, k, harmonic=False)
    29	    q00 = D.inner(phi0, phi0, v, k)
    30	    q01 = D.inner(phi0, phi1, v, k)
    31	    q11 = D.inner(phi1, phi1, v, k)
    32	    disc = sp.factor(q00 * q11 - q01 ** 2)
    33	    rows, Cds = [], []
    34	    for kp in (0, 2, 3):
    35	        (y,) = D.hw_kernel(v - 1, kp, harmonic=False)
    36	        j = k - kp
    37	        nd = D.inner(y, y, v - 1, kp)
    38	        shift = kp + 1 - k
    39	        fac = sp.ff(v - k, shift) if shift >= 0 else 1 / sp.ff(v - 1 - kp, -shift)
    40	        Cd = sp.factor(fac / (D.w(j) * nd * v * cg2(f, f * v - k, f * (v - 1) - kp, j)))
    41	        rows.append((D.inner(phi0, D.mul_z(y, j), v, k), D.inner(phi1, D.mul_z(y, j), v, k)))
    42	        Cds.append(Cd)
    43	    return D, q00, q01, q11, disc, rows, Cds
    44	
