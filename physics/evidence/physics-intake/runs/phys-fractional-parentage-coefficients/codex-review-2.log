   285	def integer_roots(expr, v0):
   286	    """Integer roots >= v0 of numerator or denominator of a rational function of v."""
   287	    bad = set()
   288	    num, den = sp.fraction(sp.factor(sp.together(expr)))
   289	    for poly in (num, den):
   290	        for fac, _ in sp.factor_list(sp.Poly(poly, v))[1]:
   291	            if fac.degree() == 1:
   292	                a, b = fac.all_coeffs()
   293	                root = sp.Rational(-b, a)
   294	                if root.q == 1 and root >= v0:
   295	                    bad.add(int(root))
   296	    return bad
