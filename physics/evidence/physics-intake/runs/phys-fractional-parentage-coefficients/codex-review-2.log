   269	def run_general_k4():
   270	    """Symbolic (v, f), f >= 3: all reduced CFPs of the k = 4 family (multiplicity 2) in the
   271	    pair-first basis, into the daughters k' = 0, 2, 3 and the k' = 4 pair-first states."""
   272	    D = Deficit(fs, 4)
   273	    states = {k: [leading_sign_fix(p) for p in D.hw_kernel(v, k, harmonic=False)] for k in (0, 2, 3)}
   274	    parents = pair_first_k4(D, v)
   275	    daughters = {0: states[0], 2: states[2], 3: states[3], 4: pair_first_k4(D, v - 1)}
   276	    res = {}
   277	    for i, psi in enumerate(parents, start=1):
   278	        for kp, ds in daughters.items():
   279	            for jd, phi in enumerate(ds, start=1):
   280	                val, sg, X = reduced_cfp2(D, psi, 4, phi, kp, fs)
   281	                res[(i, kp, jd if kp == 4 else 0)] = (val, sg)
   282	    return res
