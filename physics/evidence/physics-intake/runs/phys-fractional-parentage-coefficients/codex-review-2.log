    18	def unique_state(B, n, L):
    19	    basis = B.hw_harmonic_basis(n, L)
    20	    assert len(basis) == 1, (B.f, n, L, len(basis))
    21	    p = basis[0]
    22	    lead = max(p)
    23	    return p if p[lead] > 0 else {a: -c for a, c in p.items()}
