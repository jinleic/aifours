   158	        beta = sp.factor(sp.cancel((bvec.T * Ginv * bvec)[0, 0]))
   159	        Qdd = sp.factor(sp.cancel(beta * Cd))
   160	        print(f"daughter k'={kp}: Q_dd = {Qdd}")
   161	        print(f"   square-free part of Q_dd: {square_free_part(Qdd)}")
   162	    for name, a in (("q(phi1)", q11), ("q(phi0)", q00)):
   163	        _, facs = square_free_part(a)
   164	        for pi in facs:
   165	            if sp.Poly(pi, v).degree() >= 2:
   166	                sq, cert = is_square_mod(-disc, pi)
   167	                print(f"residue test at pi = {pi} (odd in {name}): -disc is "
   168	                      f"{'a square' if sq else ('NOT a square' if sq is False else 'undecided')}"
   169	                      f" in Q[v]/(pi)   [{cert}]")
