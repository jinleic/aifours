    41	class Spin2:
    42	    def __init__(self):
    43	        self.B = SpinBosons(2)
    44	        B = self.B
    45	        (self.H,) = B.hw_harmonic_basis(2, 2)
    46	        (self.T,) = B.hw_harmonic_basis(3, 3)
    47	        (self.J,) = B.hw_harmonic_basis(3, 0)
    48	        self.F = {(0, 0, 0, 0, 1): fmpq(1)}
    49	        # fix phases: leading (lexicographically largest) monomial coefficient positive
    50	        for name in ("H", "T", "J"):
    51	            p = getattr(self, name)
    52	            lead = max(p)
    53	            if p[lead] < 0:
    54	                setattr(self, name, {a: -c for a, c in p.items()})
    55	        self._pow = {}
    56	        self._cache = {}
    57	
    58	    def power(self, name, k):
    59	        key = (name, k)
    60	        if key not in self._pow:
    61	            base = {"F": self.F, "H": self.H, "T": self.T, "J": self.J}[name]
    62	            if k == 0:
    63	                self._pow[key] = {(0, 0, 0, 0, 0): fmpq(1)}
    64	            else:
    65	                self._pow[key] = self.B.mul(self.power(name, k - 1), base)
    66	        return self._pow[key]
