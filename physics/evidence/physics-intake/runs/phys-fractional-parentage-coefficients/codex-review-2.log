    98	                    if d[j - 1] == 0 or d[jj - 1] == 0:
    99	                        continue
   100	                    coef = 2 * (-1) ** m * self.w(j) * d[j - 1] * d[jj - 1]
   101	                    nd = list(d)
   102	                    nd[j - 1] -= 1
   103	                    nd[jj - 1] -= 1
   104	                nd = tuple(nd)
