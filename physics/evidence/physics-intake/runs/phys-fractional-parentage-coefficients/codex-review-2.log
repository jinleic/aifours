   299	def max_real_root(expr):
   300	    """Largest real root (exact) of numerator or denominator of a rational function of v,
   301	    or None.  The sign of expr is constant on (max_real_root, oo)."""
   302	    roots = []
   303	    num, den = sp.fraction(sp.factor(sp.together(expr)))
   304	    for poly in (num, den):
   305	        P = sp.Poly(poly, v)
   306	        if P.degree() > 0:
   307	            roots += P.real_roots()
   308	    return max(roots) if roots else None
