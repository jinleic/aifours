   254	def pair_first_k4(D, n):
   255	    """Spin f >= 3, deficit 4 (two states, both seniority n): Gram-Schmidt at degree n of
   256	    phi_A = z_f^(n-2) Q4 then phi_B = z_f^(n-4) H2^2, where Q4 (H2) is the degree-2 highest-weight
   257	    pair of spin 2f-4 (2f-2); phases fixed by leading_sign_fix.  Returns [psi_1, psi_2]."""
   258	    (Q4,) = D.hw_kernel(2, 4, harmonic=False, max_parts=2)
   259	    (H2,) = D.hw_kernel(2, 2, harmonic=False, max_parts=2)
   260	    A = leading_sign_fix(Q4)
   261	    H2 = leading_sign_fix(H2)
   262	    Bv = D.mul(H2, H2)
   263	    cf = sp.cancel(D.inner(A, Bv, n, 4) / D.inner(A, A, n, 4))
   264	    B2 = {d: sp.factor(sp.cancel(Bv.get(d, 0) - cf * A.get(d, 0))) for d in set(A) | set(Bv)}
   265	    B2 = {d: c for d, c in B2.items() if c != 0}
   266	    return [A, B2]
