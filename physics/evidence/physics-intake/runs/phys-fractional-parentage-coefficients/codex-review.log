    85	    for key in sorted(exceptions, key=str):
    86	        print(f"{key}: NO agreement at v = {exceptions[key]}")
    87	    print(f"total exact agreements: {n}; formulas with disagreements: {len(exceptions)}")
    88	    print("block weight (5,4)->(6-block) implied by completeness:", BLOCK[(5, 4, 6)])
    89	
    90	
    91	if __name__ == "__main__":
    92	    main(sys.argv[1])

