    12	from math import factorial
    13	
    14	import sympy as sp
    15	from sympy.physics.wigner import clebsch_gordan
    16	
    17	from check_seniority_factorization import harmonic_states
    18	from fpc_core import SpinBosons
    19	
    20	
    21	def to_tensor(B, poly, N):
    22	    """Polynomial in z_m (unnormalised orbitals eps_m) -> normalised symmetric tensor dict."""
    23	    f = B.f
    24	    out = {}
    25	    for a, c in poly.items():
    26	        # z^a |0> = prod_m (sqrt(w_m) a+_m)^(a_m) |0> = prod_m w_m^(a_m/2) sqrt(a_m!) |a>
    27	        amp = sp.Rational(int(c.p), int(c.q))
    28	        for am, wm in zip(a, B.w):
    29	            amp *= sp.sqrt(sp.Rational(int(wm.p), int(wm.q))) ** am * sp.sqrt(factorial(am))
    30	        # |a> = sqrt(prod a_m! / N!) * sum over distinct arrangements
    31	        pref = sp.sqrt(sp.Rational(sp.prod([factorial(x) for x in a]), factorial(N)))
    32	        seq = [m - f for m, am in enumerate(a) for _ in range(am)]
    33	        for arr in set(itertools.permutations(seq)):
    34	            out[arr] = out.get(arr, 0) + amp * pref
    35	    nrm = sp.sqrt(sum(sp.nsimplify(x) ** 2 for x in out.values()))
    36	    return {k: sp.nsimplify(x / nrm) for k, x in out.items()}
    37	
    38	
    39	def lowered(B, poly, L):
    40	    """[(M, polynomial)] for M = L, L-1, ..., -L via S-."""
    41	    out = [(L, poly)]
    42	    p = poly
    43	    for M in range(L - 1, -L - 1, -1):
    44	        p = B.sminus(p)
    45	        out.append((M, p))
    46	    return out
    47	
    48	
    49	def cfp_first_quantized(B, parent, N, L, daughter, Lp):
    50	    f = B.f
    51	    Psi = to_tensor(B, parent, N)
    52	    acc = 0
    53	    for Mp, dpoly in lowered(B, daughter, Lp):
    54	        m = L - Mp
    55	        if abs(m) > f:
    56	            continue
    57	        cg = clebsch_gordan(f, Lp, L, m, Mp, L)
    58	        if cg == 0:
    59	            continue
    60	        Dt = to_tensor(B, dpoly, N - 1)
    61	        for key, x in Dt.items():
    62	            y = Psi.get(key + (m,))
    63	            if y is not None:
    64	                acc += cg * x * y
    65	    return sp.nsimplify(sp.radsimp(acc))
    66	
