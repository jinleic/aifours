    21	
    22	def square_free_part(expr):
    23	    """(constant, [(irreducible poly, exponent mod 2)]) of a rational function of v."""
    24	    num, den = sp.fraction(sp.factor(sp.together(expr)))
    25	    out = []
    26	    c = sp.Integer(1)
    27	    for poly, sgn in ((num, 1), (den, -1)):
    28	        cf, facs = sp.factor_list(sp.Poly(poly, v))
    29	        c *= sp.Rational(cf) ** sgn
    30	        for fac, m in facs:
    31	            if m % 2:
    32	                out.append(fac.as_expr())
    33	    return c, out
    34	
    35	
    36	def is_square_mod(expr, pi):
    37	    """Is the rational function expr (a unit at pi) a square in the field F = Q[v]/(pi)?
    38	
    39	    Returns (answer, certificate); answer None if undecided.  With d = deg pi and
    40	    alpha = expr(theta), the norm polynomial R(t) = Res_v(t^2 - alpha(v), pi(v)) has degree 2d
    41	    and roots +-sqrt(alpha(theta_i)).
    42	      * R irreducible over Q: sqrt(alpha) has degree 2d > d = [F:Q], so NOT a square;
    43	      * d = 2: decided exactly by factoring t^2 - alpha over F = Q(sqrt(Delta));
    44	      * d an odd prime, alpha not in Q, R = g(t) g(-t) with g irreducible of degree d:
    45	        a root beta of g has degree d and Q(beta) contains Q(alpha) = F (F has no proper
    46	        subfield other than Q), so Q(beta) = F and alpha = beta^2 IS a square.
    47	    """
    48	    P = sp.Poly(pi, v)
    49	    num, den = sp.fraction(sp.together(expr))
    50	    alpha = sp.rem(sp.Poly(num, v) * sp.invert(sp.Poly(den, v), P), P)   # alpha in Q[v]/(pi)
    51	    d = P.degree()
    52	    t = sp.Symbol('t')
    53	    R = sp.Poly(sp.resultant(t ** 2 - alpha.as_expr(), P.as_expr(), v), t)
    54	    facs = sp.factor_list(R)[1]
    55	    if len(facs) == 1 and facs[0][1] == 1 and sp.Poly(facs[0][0], t).degree() == 2 * d:
    56	        return False, f"Res_v(t^2 - alpha, pi) irreducible over Q of degree {2 * d}"
    57	    if d == 2:
    58	        a2, a1, a0 = P.all_coeffs()
    59	        Delta = a1 ** 2 - 4 * a2 * a0
    60	        theta = (-a1 + sp.sqrt(Delta)) / (2 * a2)
    61	        val = sp.nsimplify(sp.expand(alpha.as_expr().subs(v, theta)))
    62	        fl = sp.factor_list(t ** 2 - val, extension=sp.sqrt(Delta))[1]
    63	        return len(fl) > 1, f"factorisation of t^2 - alpha over Q(sqrt({Delta})): {fl}"
    64	    if sp.isprime(d) and d > 2 and alpha.degree() >= 1 and len(facs) == 2 and all(
    65	            m == 1 and sp.Poly(g, t).degree() == d for g, m in facs):
    66	        g = sp.Poly(facs[0][0], t)
    67	        h = sp.Poly(facs[1][0], t)
    68	        if sp.Poly(g.as_expr().subs(t, -t), t).monic() == h.monic():
    69	            return True, f"R = g(t) g(-t), g irreducible of prime degree {d}: {g.as_expr()}"
    70	    return None, f"inconclusive: Res factors as {facs}"
