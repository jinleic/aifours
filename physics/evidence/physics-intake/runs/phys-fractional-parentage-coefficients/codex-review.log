    18	def unique_state(B, n, L):
    19	    basis = B.hw_harmonic_basis(n, L)
    20	    assert len(basis) == 1, (B.f, n, L, len(basis))
    21	    p = basis[0]
    22	    lead = max(p)
    23	    return p if p[lead] > 0 else {a: -c for a, c in p.items()}
    24	
    25	
    26	
    27	def pair_first_numeric(B, n):
    28	    """Numeric pair-first basis of the deficit-4 space at degree n (same rule as
    29	    top_family_symbolic.pair_first_k4): GS of z_f^(n-2) Q4, z_f^(n-4) H2^2."""
    30	    f = B.f
    31	    Q4 = unique_state(B, 2, 2 * f - 4)
    32	    H2 = unique_state(B, 2, 2 * f - 2)
    33	    zf = lambda m: {tuple([0] * (2 * f) + [m]): fmpq(1)}  # noqa: E731
    34	    A = B.mul(zf(n - 2), Q4)
    35	    Bv = B.mul(zf(n - 4), B.mul(H2, H2))
    36	    c = B.inner(A, Bv) / B.norm2(A)
    37	    B2 = dict(Bv)
    38	    for a, x in A.items():
    39	        B2[a] = B2.get(a, fmpq(0)) - c * x
    40	    return [A, {a: x for a, x in B2.items() if x != 0}]
