    73	def family_gram(k=6):
    74	    """Symbolic Gram data of family k: (S, phi0, phi1, q00, q01, q11, disc)."""
    75	    assert f2_labels(k) == [0, 1], k
    76	    S = Spin2Families()
    77	    D = S.D
    78	    phi0 = S.harm_proj(S.covariant(k, 0), v, k)
    79	    phi1 = S.harm_proj(S.covariant(k, 1), v, k)
    80	    q00 = D.inner(phi0, phi0, v, k)
    81	    q01 = D.inner(phi0, phi1, v, k)
    82	    q11 = D.inner(phi1, phi1, v, k)
    83	    disc = sp.factor(q00 * q11 - q01 ** 2)
    84	    return S, phi0, phi1, q00, q01, q11, disc
