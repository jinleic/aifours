sys.path.insert(0,\"code\")
import sympy as sp
import brauer_residues as b
from multiplicity_obstruction import family_gram
from top_family_symbolic import v

def tame_exact(x,y,r):
    a,u = b.val_unit(x,r)
    e,w = b.val_unit(y,r)
    return b.sqclass(sp.Integer(-1)**(a*e)*u**e*w**(-a))

def add_sq(x,y):
    from math import gcd
    z=x*y
    g=gcd(abs(x),abs(y))
    return z//(g*g)

for k in (6,8,9,10,11):
    _,_,_,q00,q01,q11,disc=family_gram(k)
    y=-disc
    places=[]
    for expr in (y,q11):
        num,den=sp.fraction(sp.together(expr))
        for poly in (num,den):
            for fac,_ in sp.factor_list(sp.Poly(poly,v))[1]:
                if fac.degree()==1:
                    a,c=fac.all_coeffs()
                    r=sp.Rational(-c,a)
                    if r not in places: places.append(r)
    if k==11: places.append(sp.Integer(2))
    places.append(\"inf\")
    finite=places[:-1]
    odd=[r for r in places if b.val_unit(y,r)[0]%2]
    anchor=odd[0]
    bas={r:tame_exact(q11,y,r) for r in places}
    gens=[{r:tame_exact(v-s,y,r) for r in places} for s in finite]
    parity={r:b.val_unit(y,r)[0]%2 for r in places}
    def eliminate_constant(vals):
        return [add_sq(vals[r],vals[anchor]) if parity[r] else vals[r] for r in places]
    rhs=eliminate_constant(bas)
    columns=[eliminate_constant(g) for g in gens]
    primes=sorted(set(p for row in [rhs]+columns for z in row for p in sp.factorint(abs(z))))
    chars=[-1]+primes
    def encode(row):
        out=0
        for i,z in enumerate(row):
            if z<0: out "'^= 1<<(i*len(chars))
            for j,p in enumerate(primes,1):
                if abs(z)%p==0: out ''^= 1<<(i*len(chars)+j)
        return out
    pivots={}
    for col in columns:
        x=encode(col)
        while x:
            bit=x.bit_length()-1
            if bit not in pivots:
                pivots[bit]=x
                break
            x ''^= pivots[bit]
    x=encode(rhs)
    while x:
        bit=x.bit_length()-1
        if bit not in pivots: break
        x ''^= pivots[bit]
    mismatches=[]
    for s,g in zip(finite,gens):
        for r in places:
            old=b.tame(v-s,y,r)
            if old!=g[r]: mismatches.append((s,r,old,g[r]))
    print("k",k,"finite",len(finite),"exact residue system consistent",x==0,"rank",len(pivots),
          "generator class mismatches",len(mismatches),"first",mismatches[:2],flush=True)
