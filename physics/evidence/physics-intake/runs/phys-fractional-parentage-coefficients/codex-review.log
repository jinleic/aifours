   130	def analyze(q11, disc, height=60):
   131	    """Residue analysis for the binary form <q11, q11*disc> over Q(v); returns the hit list."""
   132	    y = -disc
   133	    # step 1: non-linear places (status: True = residue trivial, False = obstruction there,
   134	    # None = undecided / not handled)
   135	    nonlin_ok = True
   136	    for name, a in (("q(phi1)", q11), ("disc", disc)):
   137	        for pi in square_free_part(a)[1]:
   138	            if sp.Poly(pi, v).degree() >= 2:
   139	                if name == "disc":
   140	                    print(f"  disc has odd non-linear factor {pi}: residue depends on c (not handled)")
   141	                    nonlin_ok = None
   142	                    continue
   143	                sq, cert = is_square_mod(y, pi)
   144	                word = {True: "is a square", False: "is NOT a square", None: "is UNDECIDED"}[sq]
   145	                print(f"  residue at {pi}: -disc {word} mod pi [{cert}]")
   146	                if sq is False and nonlin_ok is not None:
   147	                    nonlin_ok = False
   148	                elif sq is None:
   149	                    nonlin_ok = None
   150	    if nonlin_ok is False:
   151	        print("  => obstruction already at a non-linear place: q represents no c in L (unconditional)")
   152	    elif nonlin_ok is None:
   153	        print("  => non-linear places not fully decided; conclusions below are about linear places only")
   154	    py = odd_linear_places(y)
   155	    px = odd_linear_places(q11)
   156	    # every rational root (any multiplicity) of q11 or -disc, plus infinity: a factor (v - s)
   157	    # of c at such s is handled by the tame symbols below; any other s needs -disc(s) square.
   158	    places = []
   159	    for expr in (y, q11):
   160	        num, den = sp.fraction(sp.together(expr))
   161	        for poly in (num, den):
   162	            for fac, _ in sp.factor_list(sp.Poly(poly, v))[1]:
   163	                if fac.degree() == 1:
   164	                    a, b = fac.all_coeffs()
   165	                    r = sp.Rational(-b, a)
   166	                    if r not in places:
   167	                        places.append(r)
   168	    places.append('inf')
   169	    print(f"  rational places with odd valuation: -disc {py}; q11 {px}; all rational places used: "
   170	          f"{len(places) - 1} finite + inf")
   171	    small, quarter = extra_places(y, places, height, 10 ** 6)
   172	    extras = sorted(set(small) | {sp.Rational(n, 4) for n in quarter})
   173	    print(f"  extra places s (not above) with -disc(s) a nonzero square: height <= {height}: {small};"
   174	          f" s = n/4, |n| <= 10^6: {quarter}")
   175	    places = places[:-1] + extras + ['inf']
   176	    base, hits = residue_hits(q11, y, places)
   177	    print(f"  residues of (q11, -disc): {base}")
   178	    assert sqclass(sp.prod([x for x in base.values()])) == 1 or nonlin_ok is not True, "reciprocity"
   179	    lin_ctrl = sp.prod([v - s for s in py[:2] if s != 'inf']) * 3
   180	    _, ctrl = residue_hits(lin_ctrl, y, places)
   181	    assert ctrl, "positive control failed"
   182	    print(f"  controls OK (reciprocity product square; linear-type control {lin_ctrl} hit)")
   183	    print(f"  subsets S of the {len(places) - 1} finite places (incl. extras {extras}) with all residues"
   184	          f" trivial for some c0: {len(hits)} {hits[:5]}")
   185	    return hits
