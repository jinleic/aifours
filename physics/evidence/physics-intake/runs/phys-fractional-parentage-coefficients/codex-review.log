     1	"""The first multiplicity family for spin f >= 3: L = f v - 4 (two states of seniority v).
     2	
     3	For f >= 3 the deficit-4 highest-weight space is two-dimensional and automatically harmonic
     4	(P lowers the deficit by 2f > 4).  This script (exact, symbolic in v, for f = 3, 4, 5):
     5	  * builds a Q(v)-rational basis (sympy null space of S+ in deficit coordinates) and the Gram
     6	    matrix of the Fock form / (v-4)!;
     7	  * checks that the factors C_d of the multiplicity-free daughters (k' = 0, 2, 3) are products of
     8	    linear polynomials and that the pairing matrix has rank 2;
     9	  * cross-checks the basis-independent weight Q_dd into the stretched daughter (k' = 0) against
    10	    the independent polynomial engine fpc_core at v = 5..9;
    11	  * runs the residue (Brauer) analysis of brauer_residues.analyze on <q11, q11*disc>.
    12	Run: $PY general_f_k4.py [f ...]   (default 3 4 5)
    13	"""
    14	import sys
    15	
    16	import sympy as sp
    17	from flint import fmpq
    18	
    19	from brauer_residues import analyze
    20	from fpc_core import SpinBosons
    21	from multiplicity_obstruction import square_free_part
    22	from top_family_symbolic import Deficit, cg2, v
    23	
    24	
    25	def family(f):
    26	    D = Deficit(f, 2 * f)
    27	    k = 4
    28	    phi0, phi1 = D.hw_kernel(v, k, harmonic=False)
    29	    q00 = D.inner(phi0, phi0, v, k)
    30	    q01 = D.inner(phi0, phi1, v, k)
    31	    q11 = D.inner(phi1, phi1, v, k)
    32	    disc = sp.factor(q00 * q11 - q01 ** 2)
    33	    rows, Cds = [], []
    34	    for kp in (0, 2, 3):
    35	        (y,) = D.hw_kernel(v - 1, kp, harmonic=False)
    36	        j = k - kp
    37	        nd = D.inner(y, y, v - 1, kp)
    38	        shift = kp + 1 - k
    39	        fac = sp.ff(v - k, shift) if shift >= 0 else 1 / sp.ff(v - 1 - kp, -shift)
    40	        Cd = sp.factor(fac / (D.w(j) * nd * v * cg2(f, f * v - k, f * (v - 1) - kp, j)))
    41	        rows.append((D.inner(phi0, D.mul_z(y, j), v, k), D.inner(phi1, D.mul_z(y, j), v, k)))
    42	        Cds.append(Cd)
    43	    return D, q00, q01, q11, disc, rows, Cds
    44	
    45	
    46	def numeric_Q00(f, n):
    47	    """sum over an orthonormal basis of the (n, L = f n - 4) block of cfp^2 into the stretched
    48	    daughter, from the polynomial engine."""
    49	    B = SpinBosons(f)
    50	    basis = B.hw_harmonic_basis(n, f * n - 4)
    51	    assert len(basis) == 2
    52	    ortho = []
    53	    for w in basis:
    54	        w = dict(w)
    55	        for u in ortho:
    56	            c = B.inner(u, w) / B.norm2(u)
    57	            for a, x in u.items():
    58	                w[a] = w.get(a, fmpq(0)) - c * x
    59	            w = {a: x for a, x in w.items() if x != 0}
    60	        ortho.append(w)
    61	    daughter = {tuple([0] * (2 * f) + [n - 1]): fmpq(1)}
    62	    return sum((B.cfp_sq_sign(psi, n, f * n - 4, daughter, f * (n - 1))[0] for psi in ortho), fmpq(0))
    63	
    64	
    65	def main(fs_):
    66	    for f in fs_:
    67	        D, q00, q01, q11, disc, rows, Cds = family(f)
    68	        print(f"=== spin f = {f}, family L = {f}v - 4 ===")
    69	        print("q(phi0) =", sp.factor(q00))
    70	        print("q(phi1) =", sp.factor(q11))
    71	        print("disc =", disc)
    72	        for kp, Cd in zip((0, 2, 3), Cds):
    73	            nonlin = [p for p in square_free_part(Cd)[1] if sp.Poly(p, v).degree() > 1]
    74	            assert not nonlin, (f, kp, Cd)
    75	        M = sp.Matrix(rows)
    76	        print("C_d linear-type for k' = 0, 2, 3; pairing rank:", M.rank(simplify=True))
    77	        G = sp.Matrix([[q00, q01], [q01, q11]])
    78	        b = sp.Matrix(rows[0])
    79	        Q00 = sp.factor(sp.cancel(Cds[0] * (b.T * G.inv() * b)[0, 0]))
    80	        print("basis-independent weight into the stretched daughter Q_00 =", Q00)
    81	        for n in range(5, 10):
    82	            num = numeric_Q00(f, n)
    83	            assert sp.Rational(Q00.subs(v, n)) == sp.Rational(int(num.p), int(num.q)), (f, n)
    84	        print("Q_00 agrees with the polynomial engine at v = 5..9")
    85	        analyze(q11, disc, height=30)
    86	
    87	
    88	if __name__ == "__main__":
    89	    main([int(a) for a in sys.argv[1:]] or [3, 4, 5])
     1	"""Two-body CFPs from one-body CFPs: exact check of the standard chain (recoupling) formula
     2	
     3	  C2(N Gamma L; pair s, N-2 Gamma'' L'') = sum_{Gamma' L'} c(N Gamma L; N-1 Gamma' L') c(N-1 Gamma' L'; N-2 Gamma'' L'')
     4	        * (-1)^(L+L'') sqrt((2s+1)(2L'+1)) {f f s; L'' L L'}          (s even; 0 for s odd)
     5	
     6	where C2 is defined by  |N; Gamma L M> = sum C2 [phi_s(N-1,N) (x) |N-2; Gamma'' L''>]_{LM}
     7	with phi_s(N-1,N)_mu = sum <f m1 f m2|s mu> e_m1(N-1) e_m2(N).  The left side is computed in
     8	first quantization from explicit symmetric tensors (verify_first_quantized.to_tensor); the
     9	right side uses the engine's one-body CFPs with signs.  With Theorem A and the closed forms of
    10	RESULTS.md this gives two-body CFPs in closed form wherever the one-body ones are known.
    11	Run: $PY code/verify_two_body.py
    12	"""
    13	import sympy as sp
    14	from sympy.physics.wigner import clebsch_gordan, wigner_6j
    15	
    16	from check_seniority_factorization import harmonic_states
    17	from fpc_core import SpinBosons
    18	from verify_first_quantized import lowered, to_tensor
    19	
    20	
    21	def c1(B, parent, N, L, daughter, Lp):
    22	    sq, sg = B.cfp_sq_sign(parent, N, L, daughter, Lp)
    23	    return sg * sp.sqrt(sp.Rational(int(sq.p), int(sq.q)))
    24	
    25	
    26	def c2_first_quantized(B, parent, N, L, gdaughter, Lpp, s):
    27	    f = B.f
    28	    Psi = to_tensor(B, parent, N)
    29	    acc = 0
    30	    for Mpp, gpoly in lowered(B, gdaughter, Lpp):
    31	        mu = L - Mpp
    32	        if abs(mu) > s:
    33	            continue
    34	        cg_outer = clebsch_gordan(s, Lpp, L, mu, Mpp, L)
    35	        if cg_outer == 0:
    36	            continue
    37	        G = to_tensor(B, gpoly, N - 2)
    38	        for m1 in range(-f, f + 1):
    39	            m2 = mu - m1
    40	            if abs(m2) > f:
    41	                continue
    42	            cg_pair = clebsch_gordan(f, f, s, m1, m2, mu)
    43	            if cg_pair == 0:
    44	                continue
    45	            for key, x in G.items():
    46	                y = Psi.get(key + (m1, m2))
    47	                if y is not None:
    48	                    acc += cg_outer * cg_pair * x * y
    49	    return sp.nsimplify(sp.radsimp(acc))
    50	
    51	
    52	def main():
    53	    checks = 0
    54	    for f, Nmax in ((1, 5), (2, 4)):
    55	        B = SpinBosons(f)
    56	        H = harmonic_states(B, Nmax)
    57	        states = {}
    58	        for (v, L), hs in H.items():
    59	            for al, h in enumerate(hs):
    60	                p, N = h, v
    61	                while N <= Nmax:
    62	                    states[(N, v, L, al)] = p
    63	                    p = B.pair_cre(p)
    64	                    N += 2
    65	        for (N, v, L, al), p in states.items():
    66	            if N < 3:
    67	                continue
    68	            for (N2, v2, L2, al2), g in states.items():
    69	                if N2 != N - 2:
    70	                    continue
    71	                for s in range(0, 2 * f + 1):
    72	                    if not (abs(L - L2) <= s <= L + L2):
    73	                        continue
    74	                    lhs = c2_first_quantized(B, p, N, L, g, L2, s)
    75	                    rhs = 0
    76	                    if s % 2 == 0:
    77	                        for (N1, v1, L1, al1), q in states.items():
    78	                            if N1 != N - 1:
    79	                                continue
    80	                            a = c1(B, p, N, L, q, L1)
    81	                            b = c1(B, q, N - 1, L1, g, L2)
    82	                            if a == 0 or b == 0:
    83	                                continue
    84	                            rhs += a * b * (-1) ** (L + L2) * sp.sqrt((2 * s + 1) * (2 * L1 + 1)) * \
    85	                                wigner_6j(f, f, s, L2, L, L1)
    86	                    assert sp.simplify(lhs - rhs) == 0, (f, N, v, L, al, v2, L2, al2, s, lhs, rhs)
    87	                    checks += 1
    88	    print(f"two-body chain formula verified exactly: {checks} two-body CFPs (f=1 N<=5, f=2 N<=4), "
    89	          f"including signs and the vanishing of odd-s pairs")
    90	
    91	
    92	if __name__ == "__main__":
    93	    main()

