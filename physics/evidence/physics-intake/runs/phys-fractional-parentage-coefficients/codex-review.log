    87	def numeric_crosscheck(k, q00, q01, q11, nvals=10):
    88	    """Scale-invariant check against the independent polynomial engine (spin2_basis):
    89	    cos^2 = q01^2/(q00 q11) of the two projected covariants at L = 2v - k."""
    90	    from spin2_basis import Spin2
    91	    S2 = Spin2()
