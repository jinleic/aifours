     7	  * Theorem E1 (weight of the scalar parent), f = 1..4, v <= 9.
     8	Run: $PY code/check_general_f.py
     9	"""
    10	import sympy as sp
    11	from flint import fmpq
    12	
    13	from fpc_core import SpinBosons
    14	from top_family_symbolic import fs, run_general, v
    15	
    16	
    17	def unique_state(B, n, L):
    18	    basis = B.hw_harmonic_basis(n, L)
    19	    assert len(basis) == 1, (B.f, n, L, len(basis))
    20	    p = basis[0]
    21	    lead = max(p)
    22	    return p if p[lead] > 0 else {a: -c for a, c in p.items()}
    23	
    24	
    25	def scalar_parent_weight(fmax=4, nmax=9):
    26	    """Theorem E1: for every normalised seniority-(v-1) state phi with L' = 0, the total weight
    27	    sum_alpha cfp(v alpha L=f; phi)^2 = (2v+D-2)(v+D-3) / (D v (2v+D-4)),  D = 2f+1."""
    28	    from check_seniority_factorization import harmonic_states
    29	    checks = 0
    30	    for f in range(1, fmax + 1):
    31	        B = SpinBosons(f)
    32	        D = B.D
    33	        H = harmonic_states(B, nmax)
    34	        for (vm1, Lp), daughters in H.items():
    35	            v_ = vm1 + 1
    36	            if Lp != 0 or v_ > nmax or (v_, f) not in H:
    37	                continue
    38	            for phi in daughters:
    39	                W = sum((B.cfp_sq_sign(psi, v_, f, phi, 0)[0] for psi in H[(v_, f)]), fmpq(0))
    40	                assert W == fmpq((2 * v_ + D - 2) * (v_ + D - 3), D * v_ * (2 * v_ + D - 4)), (f, v_)
    41	                checks += 1
    42	    return checks
    43	
    44	
    45	def main():
    46	    _, res = run_general(3)
    47	    checks = 0
    48	    for f in range(2, 7):
    49	        B = SpinBosons(f)
    50	        for (k, kp), (val, sg) in res.items():
    51	            if not (k < 2 * f):
    52	                continue
    53	            for n in range(max(k, kp + 1, 2), 11):
    54	                L, Lp = f * n - k, f * (n - 1) - kp
    55	                psi = unique_state(B, n, L)
    56	                phi = unique_state(B, n - 1, Lp)
    57	                sq, s = B.cfp_sq_sign(psi, n, L, phi, Lp)
    58	                ref = sp.Rational(val.subs({fs: f, v: n}))
    59	                assert sp.Rational(int(sq.p), int(sq.q)) == ref, (f, n, k, kp, sq, ref)
    60	                if ref != 0:
    61	                    assert s == sg, (f, n, k, kp, s, sg)
    62	                checks += 1
    63	    print(f"Theorem B formulas agree exactly (with signs) with the polynomial engine: {checks} checks,"
    64	          f" f = 2..6, v <= 10")
    65	    print(f"Theorem E1 (scalar-parent weight) agrees exactly: {scalar_parent_weight()} daughters,"
    66	          f" f = 1..4, v <= 9")
    67	
    68	
    69	if __name__ == "__main__":
    70	    main()

