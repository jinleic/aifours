   124	def main(k=6, height=60):
   125	    _, _, _, q00, q01, q11, disc = family_gram(k)
   126	    print(f"family k = {k}: q11 = {sp.factor(q11)};  disc = {sp.factor(disc)}")
   127	    return analyze(q11, disc, height)
