   210	def part_D(report):
   211	    Dx, Dy, Dt = H.DX, H.DY, H.DT
   212	    out = {}
   213	    for label, pc in (("k^5+k^2", {5: 1, 2: 1}), ("k^4+k^3", {4: 1, 3: 1}), ("k^6-3k^2+k", {6: 1, 2: -3, 1: 1}),
   214	                      ("2k^5-k^3+k", {5: 2, 3: -1, 1: 1}), ("k^7+k^5+k^3", {7: 1, 5: 1, 3: 1})):
   215	        Pexpr = Dt + sum(c * Dx**j for j, c in pc.items())
   216	        for mult, M in (("(1)", Dx), ("(2)", Dy)):
   217	            Bs = [H.bpoly(Pexpr), H.bpoly(M * Pexpr)]
   218	            vals = []
   219	            for s in (1, 2, 5, 20):
   220	                ks = [Fr(s), Fr(2 * s), Fr(-4 * s)]
