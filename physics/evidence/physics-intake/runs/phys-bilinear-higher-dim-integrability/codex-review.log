     1	"""Claim C8. Exploratory scan outside the proved class (Empirical evidence only; finite samples, fixed seeds).
     2	
     3	Part 1  P(D_x, D_t) of several shapes (D_t^2, D_x^j D_t terms, even/odd/mixed parity) and multipliers
     4	        Q in {D_x, D_x^3, D_x + D_x^3} with R = Q(D_y).  For each (P, Q) we run the generic three-soliton test
     5	        of (1) and of (2) at 3 random points per soliton-type pattern, in 60-digit mpmath arithmetic (the
     6	        dispersion relation is solved numerically, so this part is floating point).  Outcome labels:
     7	        PASS (max relative residual < 1e-30), FAIL, degenerate (singular recursion).
     8	Part 2  discrete extra dimension: R(S) = sinh(D_n), i.e. the multiplier sinh(nu_A - nu_C) on exp(nu n),
     9	        for P = D_t + D_x^3 (two amplitudes) and P = D_t + D_x^2 (F/G patterns); exact rational arithmetic
    10	        with z_i = exp(nu_i) rational.
    11	Run: python exploratory_scan.py
    12	"""
    13	from __future__ import annotations
    14	
    15	import itertools
    16	import json
    17	import random
    18	import sys
    19	from fractions import Fraction as Fr
    20	from pathlib import Path
    21	
    22	import mpmath as mp
    23	import sympy as sp
    24	
    25	sys.path.insert(0, str(Path(__file__).resolve().parent))
    26	import hirota_ns as H  # noqa: E402
    27	
    28	mp.mp.dps = 60
    29	OUT = Path(__file__).resolve().parent.parent / "results"
    30	Dx, Dy, Dt = H.DX, H.DY, H.DT
    31	W = sp.Symbol("w")
    32	
    33	
    34	def _mp(B):
    35	    return {k: mp.mpf(v.numerator) / v.denominator for k, v in B.items()}
    36	
    37	
    38	def _root(Pexpr, kq, rng, sign):
    39	    poly = sp.Poly(sp.expand(Pexpr.subs({Dx: sign * kq, Dt: sign * W})), W)
    40	    coeffs = [mp.mpf(sp.Rational(c).p) / sp.Rational(c).q for c in poly.all_coeffs()]
    41	    if len(coeffs) <= 1:
    42	        return None
    43	    roots = mp.polyroots(coeffs, maxsteps=200, extraprec=200)
    44	    real = [mp.re(r) for r in roots if abs(mp.im(r)) < mp.mpf(10) ** -40]
    45	    return rng.choice(real if real else list(roots))
    46	
    47	
    48	def float_test(Pexpr, Mexpr, seed, types):
    49	    rng = random.Random(seed)
    50	    Bs = [_mp(H.bpoly(Pexpr)), _mp(H.bpoly(sp.expand(Mexpr * Pexpr)))]
    51	    with_y = Mexpr.has(Dy)
    52	    waves, a, b = [], [], []
    53	    for typ in types:
    54	        kq = sp.Rational(rng.randint(1, 29), rng.randint(3, 11)) * rng.choice((1, -1))
    55	        l = mp.mpf(rng.randint(1, 29)) / rng.randint(3, 11) * rng.choice((1, -1)) if with_y else mp.mpf(0)
    56	        w = _root(Pexpr, kq, rng, -1 if typ == "G" else 1)
    57	        if w is None:
    58	            return "no-dispersion"
    59	        waves.append((mp.mpf(kq.p) / kq.q, l, w))
    60	        ai = mp.mpf(rng.randint(1, 19)) / rng.randint(1, 7) * rng.choice((1, -1))
    61	        bi = mp.mpf(rng.randint(1, 19)) / rng.randint(1, 7) * rng.choice((1, -1))
    62	        a.append(mp.mpf(0) if typ == "G" else ai)
    63	        b.append(mp.mpf(0) if typ == "F" else bi)
    64	    try:
    65	        F, G = H.two_function_solution(Bs, waves, a, b)
    66	    except Exception:  # singular recursion (exact zero det) or division by zero
    67	        return "degenerate"
    68	    kap = H._kappa_table(waves)
    69	    worst, scale = mp.mpf(0), mp.mpf(0)
    70	    for n in itertools.product((0, 1, 2), repeat=3):
    71	        S2 = sum(1 << i for i, v in enumerate(n) if v == 2)
    72	        S1 = sum(1 << i for i, v in enumerate(n) if v == 1)
    73	        for B in Bs:
    74	            babs = {m: abs(c) for m, c in B.items()}
    75	            tot = mp.mpf(0)
    76	            for A in H._submasks(S1):
    77	                mu, nu = S2 | A, S2 | (S1 ^ A)
    78	                v = H._vec_sub(kap[A], kap[S1 ^ A])
    79	                tot += F[mu] * G[nu] * H.beval(B, v)
    80	                scale = max(scale, abs(F[mu] * G[nu]) * H.beval(babs, tuple(abs(x) for x in v)))
    81	            if 2 in n:
    82	                worst = max(worst, abs(tot))
    83	    rel = worst / scale if scale > 0 else mp.mpf(0)
    84	    return "PASS" if rel < mp.mpf(10) ** -30 else "FAIL"
    85	
    86	
    87	def part1():
    88	    Ps = {
    89	        "Dt^2-Dx^2-Dx^4": Dt**2 - Dx**2 - Dx**4, "Dt^2+Dx^4": Dt**2 + Dx**4, "Dt^2+DxDt+Dx^4": Dt**2 + Dx * Dt + Dx**4,
    90	        "Dt^2+Dx^3": Dt**2 + Dx**3, "DxDt+Dx^4": Dx * Dt + Dx**4, "DxDt+Dx^6": Dx * Dt + Dx**6,
    91	        "Dx^3Dt+Dx^2": Dx**3 * Dt + Dx**2, "Dt+DxDt+Dx^3": Dt + Dx * Dt + Dx**3,
    92	        "Dt+Dx^2Dt+Dx^3": Dt + Dx**2 * Dt + Dx**3, "Dt+Dx^2Dt+Dx^5": Dt + Dx**2 * Dt + Dx**5,
    93	        "Dt+Dt^3+Dx^3": Dt + Dt**3 + Dx**3, "Dt+Dx^3+Dt^2": Dt + Dx**3 + Dt**2,
    94	        "Dt+Dx^3": Dt + Dx**3, "Dt+Dx^2": Dt + Dx**2, "Dt+Dx^5": Dt + Dx**5,
    95	    }
    96	    Ms = {"Dx|Dy": (Dx, Dy), "Dx^3|Dy^3": (Dx**3, Dy**3), "Dx+Dx^3|Dy+Dy^3": (Dx + Dx**3, Dy + Dy**3)}
    97	    rows, mismatches = {}, []
    98	    for pname, P in Ps.items():
    99	        par = H.parity(H.bpoly(P))
   100	        pats = [("FG",) * 3] if par in ("odd", "even") else list(itertools.product("FG", repeat=3))
   101	        for mname, (M1, M2) in Ms.items():
   102	            per = {}
   103	            for pat in pats:
   104	                r1 = sorted({float_test(P, M1, s, pat) for s in (1, 2, 3)})
   105	                r2 = sorted({float_test(P, M2, s, pat) for s in (1, 2, 3)})
   106	                per["".join(x[0] for x in pat)] = (r1, r2)
   107	                if r1 == ["PASS"] and r2 != ["PASS"]:
   108	                    mismatches.append((pname, mname, "".join(x[0] for x in pat), r1, r2))
   109	            rows[f"{pname} | {mname}"] = {"parity": par, "patterns": per}
   110	            summ1 = sorted({x for v in per.values() for x in v[0]})
   111	            summ2 = sorted({x for v in per.values() for x in v[1]})
   112	            print(f"{pname:18s} {mname:16s} {par:5s} (1): {summ1}  (2): {summ2}", flush=True)
   113	    print("patterns where (1) passes but (2) does not:", mismatches if mismatches else "none")
   114	    return rows, mismatches
   115	
   116	
   117	def part2():
   118	    """R(S) = sinh(D_n): multiplier sinh(nu_A - nu_C) = (Z_A/Z_C - Z_C/Z_A)/2 with Z_A = prod_{i in A} z_i."""
   119	    out = {}
   120	    for label, Pexpr, pc in (("Dt+Dx^3", Dt + Dx**3, {3: 1}), ("Dt+Dx^2", Dt + Dx**2, {2: 1})):
   121	        Pd = H.bpoly(Pexpr)
   122	        odd = all(j % 2 for j in pc)
   123	        pats = [("FG",) * 3] if odd else list(itertools.product("FG", repeat=3))
   124	        for pat in pats:
   125	            res_counts = []
   126	            for seed in (11, 12, 13):
   127	                rng = random.Random(seed)
   128	                waves, a, b, z = [], [], [], []
   129	                for typ in pat:
   130	                    k = Fr(rng.randint(1, 25), rng.randint(1, 7)) * rng.choice((1, -1))
   131	                    pk = sum(Fr(c) * k**j for j, c in pc.items())
   132	                    pmk = sum(Fr(c) * (-k) ** j for j, c in pc.items())
   133	                    waves.append((k, Fr(0), -pk if typ in ("FG", "F") else pmk))
   134	                    z.append(Fr(rng.randint(2, 30), rng.randint(1, 9)))
   135	                    a.append(Fr(rng.randint(1, 9)) if typ in ("FG", "F") else Fr(0))
   136	                    b.append(Fr(rng.randint(1, 9)) * rng.choice((1, -1)) if typ in ("FG", "G") else Fr(0))
   137	                kap = H._kappa_table(waves)
   138	                Z = [Fr(1)] * 8
   139	                for S in range(1, 8):
   140	                    Z[S] = Fr(1)
   141	                    for i in range(3):
   142	                        if S >> i & 1:
   143	                            Z[S] *= z[i]
   144	
   145	                def B1(A, C, kap=kap):
   146	                    return H.beval(Pd, H._vec_sub(kap[A], kap[C]))
   147	
   148	                def B2(A, C, kap=kap, Z=Z):
   149	                    return B1(A, C) * (Z[A] / Z[C] - Z[C] / Z[A]) / 2
   150	
   151	                F, G = H.two_function_solution([B1, B2], waves, a, b)
   152	                res_counts.append(len(H.residuals([B1, B2], waves, F, G)))
   153	            out[f"{label} pattern {'two-amplitude' if odd else ''.join(pat)}"] = res_counts
   154	    print("Part 2 (R(S) = sinh(D_n)), nonzero residual counts per seed:", out)
   155	    return out
   156	
