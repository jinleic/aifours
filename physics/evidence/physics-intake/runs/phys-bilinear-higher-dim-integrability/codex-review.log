     2	
     3	The three-soliton candidate f = sum_S prod_{i in S} c_i e^{eta_i} prod_{i<j in S} A_ij is built with the
     4	phase factors printed in the literature:
     5	  2DSK  D_y(D_t + D_x^5) f.f = 0  : A_ij = (ki-kj)(li-lj)(ki^2-ki kj+kj^2) / ((ki+kj)(li+lj)(ki^2+ki kj+kj^2))
     6	        [Wang-Yang-Tang-Chen, Nonlinear Dyn. 2024, eq. (15)]
     7	  SK    D_x(D_t + D_x^5) f.f = 0  : A_ij = (ki-kj)^2(ki^2-ki kj+kj^2) / ((ki+kj)^2(ki^2+ki kj+kj^2))
     8	The Hirota derivative is evaluated from its definition B(d_x - d_x', d_y - d_y', d_t - d_t') f(x,y,t) f(x',y',t')
     9	by sympy differentiation, then restricted to x = x', ... and to the origin, with the phase constants c_i kept
    10	symbolic.  The result is the polynomial sum_n C(n) c^n whose coefficients are the exponential coefficients
    11	C(n) of the residual; all arithmetic is exact.
    12	Run: python direct_substitution_check.py
    13	"""
    14	from __future__ import annotations
    15	
    16	import itertools
    17	import json
    18	from pathlib import Path
    19	
    20	import sympy as sp
    21	
    22	x, y, t, xp, yp, tp = sp.symbols("x y t xp yp tp")
    23	c = sp.symbols("c1:4")
    24	OUT = Path(__file__).resolve().parent.parent / "results"
    25	
    26	
    27	def three_soliton(ks, ls, ws, Aij, X, Y, T):
    28	    f = 0
    29	    for S in itertools.product((0, 1), repeat=3):
    30	        term = 1
    31	        for i in range(3):
    32	            if S[i]:
    33	                term *= c[i] * sp.exp(ks[i] * X + ls[i] * Y + ws[i] * T)
    34	        for i in range(3):
    35	            for j in range(i + 1, 3):
    36	                if S[i] and S[j]:
    37	                    term *= Aij[(i, j)]
    38	        f += term
    39	    return f
    40	
    41	
    42	def hirota(op_terms, f1, f2):
    43	    """op_terms: list of (coeff, (a, b, cc)) meaning coeff * Dx^a Dy^b Dt^cc."""
    44	    total = 0
    45	    for co, (a, b, cc) in op_terms:
    46	        # (d_x - d_x')^a (d_y - d_y')^b (d_t - d_t')^cc applied to f1(x,y,t) f2(x',y',t')
    47	        for i in range(a + 1):
    48	            for j in range(b + 1):
    49	                for m in range(cc + 1):
    50	                    sgn = (-1) ** ((a - i) + (b - j) + (cc - m))
    51	                    coef = sp.binomial(a, i) * sp.binomial(b, j) * sp.binomial(cc, m) * sgn
    52	                    d1 = f1
    53	                    if i:
    54	                        d1 = sp.diff(d1, x, i)
    55	                    if j:
    56	                        d1 = sp.diff(d1, y, j)
    57	                    if m:
    58	                        d1 = sp.diff(d1, t, m)
    59	                    d2 = f2
    60	                    if a - i:
    61	                        d2 = sp.diff(d2, xp, a - i)
    62	                    if b - j:
    63	                        d2 = sp.diff(d2, yp, b - j)
    64	                    if cc - m:
    65	                        d2 = sp.diff(d2, tp, cc - m)
    66	                    total += co * coef * d1 * d2
    67	    return total
    68	
    69	
    70	def residual_polynomial(op_terms, ks, ls, ws, Aij):
    71	    f1 = three_soliton(ks, ls, ws, Aij, x, y, t)
    72	    f2 = three_soliton(ks, ls, ws, Aij, xp, yp, tp)
    73	    expr = hirota(op_terms, f1, f2)
    74	    expr = expr.subs({xp: 0, yp: 0, tp: 0, x: 0, y: 0, t: 0})
    75	    return sp.Poly(sp.expand(expr), *c)
    76	
    77	
    78	def main():
    79	    OUT.mkdir(exist_ok=True)
    80	    ks = [sp.Integer(1), sp.Integer(2), sp.Integer(3)]
    81	    ls = [sp.Integer(1), sp.Integer(3), sp.Integer(7)]
    82	    ws = [-k**5 for k in ks]
    83	    A2 = {}
    84	    A1 = {}
    85	    for i in range(3):
    86	        for j in range(i + 1, 3):
    87	            ki, kj, li, lj = ks[i], ks[j], ls[i], ls[j]
    88	            A2[(i, j)] = ((ki - kj) * (li - lj) * (ki**2 - ki * kj + kj**2)
    89	                          / ((ki + kj) * (li + lj) * (ki**2 + ki * kj + kj**2)))
    90	            A1[(i, j)] = ((ki - kj) ** 2 * (ki**2 - ki * kj + kj**2)
    91	                          / ((ki + kj) ** 2 * (ki**2 + ki * kj + kj**2)))
    92	    # D_y (D_t + D_x^5) = Dy Dt + Dx^5 Dy ;  D_x (D_t + D_x^5) = Dx Dt + Dx^6
    93	    op_2dsk = [(1, (0, 1, 1)), (1, (5, 1, 0))]
    94	    op_sk = [(1, (1, 0, 1)), (1, (6, 0, 0))]
    95	    p2 = residual_polynomial(op_2dsk, ks, ls, ws, A2)
