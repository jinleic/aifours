    97	    nz2 = {str(m): str(v) for m, v in zip(p2.monoms(), p2.coeffs()) if v != 0}
    98	    nz1 = {str(m): str(v) for m, v in zip(p1.monoms(), p1.coeffs()) if v != 0}
    99	    print("2DSK D_y(D_t+D_x^5) f.f, k=(1,2,3), l=(1,3,7): nonzero exponential coefficients:", nz2)
   100	    print("SK   D_x(D_t+D_x^5) f.f, k=(1,2,3)          : nonzero exponential coefficients:", nz1)
   101	    (OUT / "direct_substitution_check.json").write_text(json.dumps(
   102	        {"2DSK_nonzero_coefficients": nz2, "SK_nonzero_coefficients": nz1}, indent=2))
