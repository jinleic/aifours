   161	    disc = part2()
   162	    (OUT / "exploratory_scan.json").write_text(json.dumps(
   163	        {"part1": rows, "part1_mismatches_1pass_2fail": mism, "part2_discrete_sinh": disc}, indent=2, default=str))
   164	    print("wrote", OUT / "exploratory_scan.json")
