    43	# ------------------------------------------------------------------------------------------- Part A
    44	def part_A(report):
    45	    names = []
    46	    for i in (1, 2, 3):
    47	        names += [f"k{i}", f"l{i}", f"a{i}", f"b{i}"]
    48	    names += ["c1", "c2", "c3"]
    49	    K, *gens = field(",".join(names), QQ)
    50	    g = dict(zip(names, gens))
    51	    c1, c2, c3 = g["c1"], g["c2"], g["c3"]
    52	    out = {}
    53	
    54	    def run(pcoef, mult, types):
    55	        P = {(0, 0, 1): K.one}
    56	        for j, cj in pcoef.items():
    57	            P[(j, 0, 0)] = cj
    58	        M = {(0, 1, 0): K.one} if mult == "Dy" else {(1, 0, 0): K.one}
    59	        Bs = [P, H.bmul(M, P)]
    60	        waves, a, b = [], [], []
    61	        for i, typ in zip((1, 2, 3), types):
    62	            k = g[f"k{i}"]
    63	            l = g[f"l{i}"] if mult == "Dy" else K.zero
    64	            pk = sum((cj * k**j for j, cj in pcoef.items()), K.zero)
    65	            pmk = sum((cj * (-k) ** j for j, cj in pcoef.items()), K.zero)
    66	            w = -pk if typ in ("FG", "F") else pmk
    67	            waves.append((k, l, w))
    68	            a.append(g[f"a{i}"] if typ in ("FG", "F") else K.zero)
    69	            b.append(g[f"b{i}"] if typ in ("FG", "G") else K.zero)
    70	        F, G = H.two_function_solution(Bs, waves, a, b)
    71	        res = H.residuals(Bs, waves, F, G)
    72	        return len(res)
    73	
    74	    t0 = time.time()
    75	    for mult in ("Dx", "Dy"):
    76	        n = run({1: c1, 3: c3}, mult, ("FG", "FG", "FG"))
    77	        out[f"A1 odd cubic, two amplitudes, {mult}"] = n
    78	        for pat in itertools.product("FG", repeat=3):
    79	            n1 = run({1: c1, 2: c2, 3: c3}, mult, pat)
    80	            n2 = run({1: c1, 2: c2}, mult, pat)
    81	            out[f"A2 c1k+c2k^2+c3k^3 pattern {''.join(pat)}, {mult}"] = n1
    82	            out[f"A2 c1k+c2k^2 pattern {''.join(pat)}, {mult}"] = n2
    83	        # explicit specialisations (guards against hidden denominators vanishing at special c's)
    84	        for lab, pc in (("k^3", {3: 1}), ("k^3-2k", {3: 1, 1: -2}), ("k^2", {2: 1}), ("k^3+k^2", {3: 1, 2: 1}),
    85	                        ("3k^2+k", {2: 3, 1: 1})):
    86	            pcK = {j: K.one * c for j, c in pc.items()}
    87	            pats = [("FG",) * 3] if all(j % 2 for j in pc) else list(itertools.product("FG", repeat=3))
    88	            for pat in pats:
    89	                out[f"A3 p={lab} pattern {''.join(x[0] for x in pat) if len(pats) > 1 else 'two-amp'},"
    90	                    f" {mult}"] = run(pcK, mult, pat)
    91	    bad = {k: v for k, v in out.items() if v != 0}
    92	    print(f"Part A: {len(out)} symbolic three-soliton identities, nonzero residual sets: {bad if bad else 'none'}"
    93	          f"  [{time.time() - t0:.1f}s]")
    94	    report["partA_nonzero_residual_counts"] = out
    95	    return not bad
    96	
    97	
    98	# ------------------------------------------------------------------------------------------- Part B
    99	def part_B(report):
   100	    """Abstract FFG lemma: every value P(eps.kappa) is an independent symbol."""
   101	    eps_all = [e for e in itertools.product((-1, 0, 1), repeat=3) if any(e)]
   102	    zero_P = {(1, 0, 0), (0, 1, 0), (0, 0, -1)}  # dispersion: P(k1) = P(k2) = 0 (F type), P(-k3) = 0 (G type)
   103	    sym_names = {e: "P_" + "".join({-1: "m", 0: "0", 1: "p"}[x] for x in e) for e in eps_all if e not in zero_P}
   104	    names = list(sym_names.values()) + ["m1", "m2", "m3", "a1", "a2", "b3"]
   105	    K, *gens = field(",".join(names), QQ)
   106	    g = dict(zip(names, gens))
   107	    m = [g["m1"], g["m2"], g["m3"]]
   108	
   109	    def eps_of(A, C):
   110	        return tuple((1 if A >> i & 1 else 0) - (1 if C >> i & 1 else 0) for i in range(3))
   111	
   112	    def Pval(e):
   113	        if not any(e) or e in zero_P:
   114	            return K.zero
   115	        return g[sym_names[e]]
   116	
   117	    def B1(A, C):
   118	        return Pval(eps_of(A, C))
   119	
   120	    def B2(A, C):
   121	        e = eps_of(A, C)
   122	        return sum((ei * mi for ei, mi in zip(e, m)), K.zero) * Pval(e)
   123	
   124	    dummy = [(K.one, K.one, K.one)] * 3  # kappa table is not used by callable symbols
   125	    a = [g["a1"], g["a2"], K.zero]
   126	    b = [K.zero, K.zero, g["b3"]]
   127	    F, G = H.two_function_solution([B1, B2], dummy, a, b)
   128	    kap = H._kappa_table(dummy)
   129	    r211 = H.coefficient(B1, kap, F, G, (2, 1, 1))
   130	    P = lambda *e: Pval(tuple(e))  # noqa: E731
   131	    Phi = (P(0, 1, -1) * P(1, -1, -1) * P(-1, 0, -1) + P(1, 0, -1) * P(-1, 1, -1) * P(0, -1, -1))
   132	    closed = g["a1"] ** 2 * g["a2"] * g["b3"] * m[2] * Phi / ((m[0] + m[1] + m[2]) * P(-1, -1, -1) * P(-1, 0, -1))
   133	    ok = (r211 - closed) == 0
   134	    # all other residual coefficients with a 2-entry, for the record (they involve M non-trivially)
   135	    res = H.residuals([B1, B2], dummy, F, G)
   136	    print(f"Part B: abstract FFG lemma (n=(2,1,1) residual == closed form): {ok};"
   137	          f" residual coefficient sets present at n = {sorted(res)}")
   138	    report["partB_closed_form_matches"] = ok
   139	    report["partB_nonzero_n"] = [list(n) for n in sorted(res)]
   140	    return ok
   141	
   142	
   143	# ------------------------------------------------------------------------------------------- Part C
   144	def monomial_values(d, ks=(1, 2, -4), types="FFG"):
   145	    w = []
   146	    for k, typ in zip(ks, types):
   147	        w.append(-(k**d) if typ == "F" else (-k) ** d)
   148	
   149	    def P(*e):
   150	        return sum(ei * wi for ei, wi in zip(e, w)) + sum(ei * ki for ei, ki in zip(e, ks)) ** d
   151	    return P
   152	
   153	
   154	def Phi_d(d):
   155	    P = monomial_values(d)
   156	    return P(0, 1, -1) * P(1, -1, -1) * P(-1, 0, -1) + P(1, 0, -1) * P(-1, 1, -1) * P(0, -1, -1)
   157	
   158	
   159	def part_C(report):
   160	    rows = {}
   161	    all_ok = True
   162	    for d in range(2, 61):
   163	        P = monomial_values(d)
   164	        phi = Phi_d(d)
   165	        nondeg = all(v != 0 for v in (P(1, 1, 0), P(-1, -1, 0), P(1, 0, 1), P(-1, 0, -1), P(0, 1, 1),
   166	                                         P(0, -1, -1), P(1, 1, 1), P(-1, -1, -1)))
   167	        expected_zero = d in (2, 3)
   168	        ok = nondeg and ((phi == 0) if expected_zero else (phi < 0))
   169	        all_ok &= ok
   170	        if d <= 12:
   171	            rows[d] = str(phi)
   172	    # inequality used for d >= 30 (see RESULTS.md): (1 - 2*0.8^d)^2 >= 2*0.96^d, checked exactly at d = 30
   173	    d0 = 30
   174	    lhs = (1 - 2 * Fr(4, 5) ** d0) ** 2
   175	    rhs = 2 * Fr(24, 25) ** d0
   176	    ineq_ok = lhs >= rhs
   177	    print(f"Part C: Phi_d (d=2..60) zero exactly for d=2,3, negative for 4<=d<=60, nondegenerate: {all_ok};"
   178	          f" tail inequality at d=30: {ineq_ok}")
   179	    print("        Phi_d for d=2..12:", rows)
   180	    report["partC_Phi_d_small"] = rows
   181	    report["partC_all_checks_d_le_60"] = all_ok
   182	    report["partC_tail_inequality_d30"] = ineq_ok
   183	
   184	    # engine cross-check of the closed form for (1) and (2)
   185	    Dx, Dy, Dt = H.DX, H.DY, H.DT
   186	    cross = {}
   187	    for d in range(4, 10):
   188	        Pexpr = Dt + Dx**d
   189	        ks = [Fr(1), Fr(2), Fr(-4)]
   190	        ls = [Fr(1), Fr(3), Fr(7)]
   191	        w = [-(ks[0] ** d), -(ks[1] ** d), (-ks[2]) ** d]
   192	        for mult, M in (("(1)", Dx), ("(2)", Dy)):
   193	            Bs = [H.bpoly(Pexpr), H.bpoly(M * Pexpr)]
   194	            lv = ls if mult == "(2)" else [Fr(0)] * 3
   195	            waves = [(ks[i], lv[i], w[i]) for i in range(3)]
   196	            F, G = H.two_function_solution(Bs, waves, [Fr(1), Fr(1), Fr(0)], [Fr(0), Fr(0), Fr(1)])
   197	            kap = H._kappa_table(waves)
   198	            r = H.coefficient(Bs[0], kap, F, G, (2, 1, 1))
   199	            m3 = ks[2] if mult == "(1)" else ls[2]
   200	            m123 = sum(ks) if mult == "(1)" else sum(ls)
   201	            P = monomial_values(d)
   202	            closed = Fr(m3) * Phi_d(d) / (m123 * P(-1, -1, -1) * P(-1, 0, -1))
   203	            cross[f"d={d} {mult}"] = (r == closed and r != 0)
   204	    print("        engine cross-check (closed form == engine residual != 0):", all(cross.values()))
   205	    report["partC_engine_crosscheck"] = cross
   206	    return all_ok and ineq_ok and all(cross.values())
   207	
