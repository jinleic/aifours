   138	    N = len(waves)
   139	    kap = _kappa_table(waves)
   140	    one = waves[0][0] ** 0
   141	    F = [None] * (1 << N)
   142	    G = [None] * (1 << N)
   143	    F[0] = one
   144	    G[0] = one
   145	    for i in range(N):
   146	        F[1 << i] = a[i]
   147	        G[1 << i] = b[i]
   148	    order = sorted(range(1, 1 << N), key=lambda m: bin(m).count("1"))
   149	    for S in order:
   150	        if bin(S).count("1") < 2:
   151	            continue
