    61	        b.append(Fr(rng.randint(1, 30), rng.randint(1, 9)) * rng.choice((1, -1)) if typ in ("FG", "G") else Fr(0))
    62	    F, G = H.two_function_solution(Bs, waves, a, b)
    63	    return len(H.residuals(Bs, waves, F, G))
