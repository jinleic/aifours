     1	"""Claim C7: a discrete extra dimension, R(S) = sinh(D_n), in the class P = D_t + p(D_x).
     2	
     3	System (2d):  P(D_x, D_t) F.G = 0,   sinh(D_n) P(D_x, D_t) F.G = 0,   F, G functions of (x, n, t), n in Z.
     4	On exp(eta) with eta = k x + nu n + w t the multiplier is sinh(nu_A - nu_C) = (Z_A/Z_C - Z_C/Z_A)/2,
     5	Z_A = prod_{i in A} z_i, z_i = exp(nu_i).  Checked:
     6	  symbolic N = 3 : p = c1 k + c3 k^3 (two amplitudes) and p = c1 k + c2 k^2 + c3 k^3 (all F/G patterns),
     7	                   identity in Q(k_i, z_i, amplitudes, c_j);
     8	  exact points   : p = k^4, k^5, k^5 + k^2 fail (fixed rational configurations).
     9	Run: python discrete_variant.py
    10	"""
    11	from __future__ import annotations
    12	
    13	import itertools
    14	import json
    15	import sys
    16	import time
    17	from fractions import Fraction as Fr
    18	from pathlib import Path
    19	
    20	from sympy import QQ
    21	from sympy.polys.fields import field
    22	
    23	sys.path.insert(0, str(Path(__file__).resolve().parent))
    24	import hirota_ns as H  # noqa: E402
    25	
    26	OUT = Path(__file__).resolve().parent.parent / "results"
    27	
    28	
    29	def system(waves, P, z, one):
    30	    kap = H._kappa_table(waves)
    31	    N = len(waves)
    32	    Z = [one] * (1 << N)
    33	    for S in range(1, 1 << N):
    34	        v = one
    35	        for i in range(N):
    36	            if S >> i & 1:
    37	                v = v * z[i]
    38	        Z[S] = v
    39	
    40	    def B1(A, C):
    41	        return H.beval(P, H._vec_sub(kap[A], kap[C]))
    42	
    43	    def B2(A, C):
    44	        return B1(A, C) * (Z[A] / Z[C] - Z[C] / Z[A]) / 2
    45	
    46	    return [B1, B2]
    47	
    48	
    49	def symbolic():
    50	    names = []
    51	    for i in (1, 2, 3):
    52	        names += [f"k{i}", f"z{i}", f"a{i}", f"b{i}"]
    53	    names += ["c1", "c2", "c3"]
    54	    K, *gens = field(",".join(names), QQ)
    55	    g = dict(zip(names, gens))
    56	    out = {}
    57	    for label, pcoef, pats in (("c1k+c3k^3 two-amplitude", {1: g["c1"], 3: g["c3"]}, [("FG",) * 3]),
    58	                               ("c1k+c2k^2+c3k^3", {1: g["c1"], 2: g["c2"], 3: g["c3"]},
    59	                                list(itertools.product("FG", repeat=3)))):
    60	        P = {(0, 0, 1): K.one}
    61	        for j, cj in pcoef.items():
    62	            P[(j, 0, 0)] = cj
    63	        for pat in pats:
    64	            waves, a, b = [], [], []
    65	            for i, typ in zip((1, 2, 3), pat):
    66	                k = g[f"k{i}"]
    67	                pk = sum((cj * k**j for j, cj in pcoef.items()), K.zero)
    68	                pmk = sum((cj * (-k) ** j for j, cj in pcoef.items()), K.zero)
    69	                waves.append((k, K.zero, -pk if typ in ("FG", "F") else pmk))
    70	                a.append(g[f"a{i}"] if typ in ("FG", "F") else K.zero)
    71	                b.append(g[f"b{i}"] if typ in ("FG", "G") else K.zero)
    72	            Bs = system(waves, P, [g["z1"], g["z2"], g["z3"]], K.one)
    73	            F, G = H.two_function_solution(Bs, waves, a, b)
    74	            out[f"{label} {''.join(t[0] for t in pat) if len(pats) > 1 else ''}".strip()] = \
    75	                len(H.residuals(Bs, waves, F, G))
    76	    return out
    77	
    78	
    79	def failures():
    80	    out = {}
    81	    cfg = {"k": [Fr(1), Fr(2), Fr(-4)], "z": [Fr(2), Fr(3), Fr(5)]}
    82	    for label, pc in (("k^4", {4: 1}), ("k^5", {5: 1}), ("k^5+k^2", {5: 1, 2: 1})):
    83	        P = {(0, 0, 1): Fr(1)}
    84	        for j, c in pc.items():
    85	            P[(j, 0, 0)] = Fr(c)
    86	        pats = {"FFG": "FFG", "two-amplitude": ("FG", "FG", "FG")} if all(j % 2 for j in pc) else {"FFG": "FFG"}
    87	        for pname, pat in pats.items():
    88	            waves, a, b = [], [], []
    89	            for k, typ in zip(cfg["k"], pat):
    90	                pk = sum(Fr(c) * k**j for j, c in pc.items())
    91	                pmk = sum(Fr(c) * (-k) ** j for j, c in pc.items())
    92	                waves.append((k, Fr(0), -pk if typ in ("FG", "F") else pmk))
    93	                a.append(Fr(1) if typ in ("FG", "F") else Fr(0))
    94	                b.append(Fr(3) if typ in ("FG", "G") else Fr(0))
    95	            Bs = system(waves, P, cfg["z"], Fr(1))
    96	            F, G = H.two_function_solution(Bs, waves, a, b)
    97	            out[f"{label} {pname}"] = len(H.residuals(Bs, waves, F, G))
    98	    return out
    99	
