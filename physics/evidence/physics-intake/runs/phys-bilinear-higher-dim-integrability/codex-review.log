    16	            Phi = P(k2-k3) P(k1-k2-k3) P(-k1-k3) + P(k1-k3) P(k2-k1-k3) P(-k2-k3),
    17	        checked with every value P(e.k) an independent symbol (only the dispersion relations imposed).
    18	Part C  monomials p = k^d at (k1, k2, k3) = (1, 2, -4) (types F, F, G): Phi_d = 0 for d = 2, 3 and Phi_d < 0 for
    19	        4 <= d <= 60 (exact integers); all nondegeneracy conditions hold; engine cross-check of the closed
    20	        form for d = 4..9 for (1) and for (2) with l = (1, 3, 7).  (d > 60: inequality in RESULTS.md.)
    21	Part D  lower-order terms do not help (illustration of the scaling lemma; the proof is in RESULTS.md).
    22	Run: python two_function_3ss.py     (deterministic; a few minutes)
    23	"""
    24	from __future__ import annotations
    25	
    26	import itertools
    27	import json
    28	import sys
    29	import time
    30	from fractions import Fraction as Fr
    31	from pathlib import Path
    32	
    33	import sympy as sp
    34	from sympy import QQ
    35	from sympy.polys.fields import field
    36	
    37	sys.path.insert(0, str(Path(__file__).resolve().parent))
