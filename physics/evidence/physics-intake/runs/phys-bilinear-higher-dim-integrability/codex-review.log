   222	                w.append(sum(Fr(c) * (-ks[2]) ** j for j, c in pc.items()))
   223	                lv = [Fr(1), Fr(3), Fr(7)] if mult == "(2)" else [Fr(0)] * 3
   224	                waves = [(ks[i], lv[i], w[i]) for i in range(3)]
   225	                try:
   226	                    F, G = H.two_function_solution(Bs, waves, [Fr(1), Fr(1), Fr(0)], [Fr(0), Fr(0), Fr(1)])
