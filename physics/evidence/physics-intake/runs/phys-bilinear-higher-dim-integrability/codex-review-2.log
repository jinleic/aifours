    33	    for S in range(1, 1 << N):
    34	        v = one
    35	        for i in range(N):
    36	            if S >> i & 1:
    37	                v = v * z[i]
    38	        Z[S] = v
    39	
    40	    def B1(A, C):
    41	        return H.beval(P, H._vec_sub(kap[A], kap[C]))
    42	
    43	    def B2(A, C):
    44	        return B1(A, C) * (Z[A] / Z[C] - Z[C] / Z[A]) / 2
    45	
    46	    return [B1, B2]
