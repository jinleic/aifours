     1	"""Exact Hirota multi-soliton tests for bilinear equations and two-function bilinear systems.
     2	
     3	Conventions
     4	-----------
     5	Coordinates z = (x, y, t).  A bilinear polynomial B(D_x, D_y, D_t) is stored as a dict
     6	{(a, b, c): coeff} meaning sum coeff * D_x^a D_y^b D_t^c.  The only analytic fact used is
     7	
     8	    B(D) exp(p.z) . exp(q.z) = B(p - q) exp((p + q).z),
     9	
    10	so for F = sum_S F_S exp(eta_S), G = sum_S G_S exp(eta_S) with eta_S = sum_{i in S} eta_i,
    11	eta_i = kappa_i . z + const, the coefficient of exp(sum_i n_i eta_i), n in {0,1,2}^N, in B(D)F.G is
    12	
    13	    C_B(n) = sum_{mu + nu = n} F_mu G_nu B(kappa_mu - kappa_nu).
    14	
    15	All arithmetic is generic: it works for fractions.Fraction (exact rational witnesses) and for
    16	elements of a sympy rational-function field (symbolic identities).  No floating point is used.
    17	
    18	Two constructions are provided.
    19	
    20	* two_function_solution: the N-soliton ansatz of a two-function system B_1 F.G = B_2 F.G = 0
    21	  with free one-soliton amplitudes (a_i, b_i).  For every subset S with |S| >= 2 the two
    22	  equations C_{B_1}(1_S) = C_{B_2}(1_S) = 0 are linear in the unknowns (F_S, G_S) with matrix
    23	  [[B_1(k_S), B_1(-k_S)], [B_2(k_S), B_2(-k_S)]]; they are solved exactly.  The ansatz is a
    24	  solution iff every remaining coefficient C_{B_j}(n) (n with some entry 2) vanishes.
    25	
    26	* hirota_product_solution: the classical single-function ansatz
    27	  f = sum_S prod_{i in S} e^{eta_i} prod_{i<j in S} A_ij,  A_ij = -B(k_i - k_j)/B(k_i + k_j),
    28	  for B(D) f.f = 0 (B even).  It solves the equation iff all coefficients C_B(n) vanish
    29	  (for N = 3 this is Hirota's three-soliton condition).
    30	"""
    31	from __future__ import annotations
    32	
    33	from fractions import Fraction
    34	from itertools import product
    35	
    36	import sympy as sp
    37	
    38	DX, DY, DT = sp.symbols("Dx Dy Dt")
    39	
    40	
    41	# ---------------------------------------------------------------- bilinear polynomials
    42	def bpoly(expr) -> dict:
    43	    """sympy expression in Dx, Dy, Dt (rational coefficients) -> {(a,b,c): Fraction}."""
    44	    poly = sp.Poly(sp.expand(sp.sympify(expr)), DX, DY, DT)
    45	    out = {}
    46	    for (a, b, c), co in poly.terms():
    47	        co = sp.Rational(co)
    48	        out[(a, b, c)] = Fraction(int(co.p), int(co.q))
    49	    return out
    50	
    51	
    52	def bmul(P: dict, Q: dict) -> dict:
    53	    out: dict = {}
    54	    for (a1, b1, c1), x1 in P.items():
    55	        for (a2, b2, c2), x2 in Q.items():
    56	            key = (a1 + a2, b1 + b2, c1 + c2)
    57	            out[key] = out.get(key, 0) + x1 * x2
    58	    return {k: v for k, v in out.items() if v != 0}
    59	
    60	
    61	def beval(B: dict, v):
    62	    """Evaluate B at the vector v = (kx, ky, kt) (field elements)."""
    63	    s = 0
    64	    for (a, b, c), co in B.items():
    65	        term = co
    66	        if a:
    67	            term = term * v[0] ** a
    68	        if b:
    69	            term = term * v[1] ** b
    70	        if c:
    71	            term = term * v[2] ** c
    72	        s = s + term
    73	    return s
    74	
    75	
    76	def parity(B: dict) -> str:
    77	    degs = {sum(k) % 2 for k in B}
    78	    if degs == {0}:
    79	        return "even"
    80	    if degs == {1}:
    81	        return "odd"
    82	    return "mixed"
    83	
    84	
    85	# ---------------------------------------------------------------- subset helpers
    86	def _vec_sub(u, v):
    87	    return (u[0] - v[0], u[1] - v[1], u[2] - v[2])
    88	
    89	
    90	def _kappa_table(waves):
    91	    """kappa_S for every bitmask S."""
    92	    N = len(waves)
    93	    zero = waves[0][0] * 0
    94	    tab = [(zero, zero, zero)] * (1 << N)
    95	    for S in range(1, 1 << N):
    96	        low = S & (-S)
    97	        i = low.bit_length() - 1
    98	        prev = tab[S ^ low]
    99	        w = waves[i]
   100	        tab[S] = (prev[0] + w[0], prev[1] + w[1], prev[2] + w[2])
   101	    return tab
   102	
   103	
   104	def _submasks(S):
   105	    """All submasks T of S (including 0 and S)."""
   106	    T = S
   107	    while True:
   108	        yield T
   109	        if T == 0:
   110	            return
   111	        T = (T - 1) & S
   112	
   113	
   114	class DegenerateSystem(Exception):
   115	    pass
   116	
   117	
   118	def _sym(B, kap, A, C):
   119	    """Value of the bilinear symbol B on kappa_A - kappa_C.
   120	
   121	    B is either a polynomial dict (evaluated on the difference vector) or a callable B(A, C) taking the
   122	    two bitmasks; the callable form is used for non-polynomial multipliers and for abstract symbols.
   123	    """
   124	    if callable(B):
   125	        return B(A, C)
   126	    return beval(B, _vec_sub(kap[A], kap[C]))
   127	
   128	
   129	# ---------------------------------------------------------------- two-function ansatz
   130	def two_function_solution(Bs, waves, a, b):
   131	    """Return (F, G) coefficient lists indexed by bitmask for the system Bs[0] F.G = Bs[1] F.G = 0.
   132	
   133	    waves: list of N wave vectors (k_i, l_i, w_i); a, b: lists of N one-soliton amplitudes.
   134	    The caller is responsible for the one-soliton conditions B_j(k_i) a_i + B_j(-k_i) b_i = 0
   135	    (they are reported by residuals() at n = e_i anyway).
   136	    """
   137	    assert len(Bs) == 2
   138	    N = len(waves)
   139	    kap = _kappa_table(waves)
   140	    one = waves[0][0] ** 0
   141	    F = [None] * (1 << N)
   142	    G = [None] * (1 << N)
   143	    F[0] = one
   144	    G[0] = one
   145	    for i in range(N):
   146	        F[1 << i] = a[i]
   147	        G[1 << i] = b[i]
   148	    order = sorted(range(1, 1 << N), key=lambda m: bin(m).count("1"))
   149	    for S in order:
   150	        if bin(S).count("1") < 2:
   151	            continue
   152	        rhs = []
   153	        for B in Bs:
   154	            r = 0
   155	            for T in _submasks(S):
   156	                if T == 0 or T == S:
   157	                    continue
   158	                U = S ^ T
   159	                r = r + F[T] * G[U] * _sym(B, kap, T, U)
   160	            rhs.append(r)
   161	        m11, m12 = _sym(Bs[0], kap, S, 0), _sym(Bs[0], kap, 0, S)
   162	        m21, m22 = _sym(Bs[1], kap, S, 0), _sym(Bs[1], kap, 0, S)
   163	        det = m11 * m22 - m12 * m21
   164	        if det == 0:
   165	            raise DegenerateSystem(f"singular 2x2 system at subset mask {S:b}")
   166	        # solve [[m11, m12], [m21, m22]] [F_S, G_S]^T = -[rhs0, rhs1]^T
   167	        F[S] = (-rhs[0] * m22 + rhs[1] * m12) / det
   168	        G[S] = (-rhs[1] * m11 + rhs[0] * m21) / det
   169	    return F, G
   170	
   171	
   172	def coefficient(B, kap, F, G, n):
   173	    """C_B(n) for n in {0,1,2}^N given as a tuple."""
   174	    S2 = 0
   175	    S1 = 0
   176	    for i, ni in enumerate(n):
   177	        if ni == 2:
   178	            S2 |= 1 << i
   179	        elif ni == 1:
   180	            S1 |= 1 << i
   181	    s = 0
   182	    for A in _submasks(S1):
   183	        mu = S2 | A
   184	        nu = S2 | (S1 ^ A)
   185	        s = s + F[mu] * G[nu] * _sym(B, kap, A, S1 ^ A)
   186	    return s
   187	
   188	
   189	def residuals(Bs, waves, F, G, only_nonzero=True):
   190	    """Map n -> [C_{B_j}(n)] over all n in {0,1,2}^N."""
   191	    N = len(waves)
   192	    kap = _kappa_table(waves)
   193	    out = {}
   194	    for n in product((0, 1, 2), repeat=N):
   195	        vals = [coefficient(B, kap, F, G, n) for B in Bs]
   196	        if not only_nonzero or any(v != 0 for v in vals):
   197	            out[n] = vals
   198	    return out
   199	
   200	
   201	# ---------------------------------------------------------------- single-function (Hirota) ansatz
   202	def hirota_product_solution(B, waves, amps=None):
   203	    """f-coefficients (by bitmask) of f = sum_S prod a_i prod A_ij exp(eta_S)."""
   204	    N = len(waves)
   205	    one = waves[0][0] ** 0
   206	    if amps is None:
   207	        amps = [one] * N
   208	    A = {}
   209	    for i in range(N):
   210	        for j in range(i + 1, N):
   211	            ki, kj = waves[i], waves[j]
   212	            num = beval(B, _vec_sub(ki, kj))
   213	            den = beval(B, (ki[0] + kj[0], ki[1] + kj[1], ki[2] + kj[2]))
   214	            if den == 0:
   215	                raise DegenerateSystem(f"B(k_{i}+k_{j}) = 0")
   216	            A[(i, j)] = -num / den
   217	    f = [None] * (1 << N)
   218	    for S in range(1 << N):
   219	        val = one
   220	        idx = [i for i in range(N) if S >> i & 1]
   221	        for i in idx:
   222	            val = val * amps[i]
   223	        for p in range(len(idx)):
   224	            for q in range(p + 1, len(idx)):
   225	                val = val * A[(idx[p], idx[q])]
   226	        f[S] = val
   227	    return f, A
   228	
   229	
   230	# ---------------------------------------------------------------- rational helpers
   231	def Q(x) -> Fraction:
   232	    return Fraction(x)
   233	
   234	
   235	def dispersion_D_t_plus(pcoeffs, k):
   236	    """w for P = D_t + sum_j c_j D_x^j, i.e. w = -sum c_j k^j (exact)."""
   237	    return -sum(Fraction(c) * k ** j for j, c in pcoeffs.items())
