   166	def hankel_controls() -> dict:
   167	    records = []
   168	    for m in (1,3):
   169	        for z in (1.5,8.0):
   170	            for radius in (0.625,1.25,2.0):
   171	                for n in (0,1):
   172	                    def integrand(r: float) -> complex:
   173	                        initial = r**m*np.exp(-r*r/2)/np.sqrt(np.pi*math.factorial(m))
   174	                        if n:
   175	                            initial *= (m+1-r*r)/np.sqrt(m+1)
   176	                        return r*initial*np.exp(1j*7*r*r/(2*z))*jv(m,7*radius*r/z)
   177	                    real,_ = quad(lambda r: integrand(r).real,0,12,epsabs=2e-11,epsrel=2e-11,limit=400)
   178	                    imag,_ = quad(lambda r: integrand(r).imag,0,12,epsabs=2e-11,epsrel=2e-11,limit=400)
   179	                    integrated = 7/(1j*z)*(-1j)**m*np.exp(1j*7*radius**2/(2*z))*(real+1j*imag)
   180	                    expected = radial_modes(np.array(radius),z,7,m)[n]
   181	                    error = float(abs(integrated-expected))
   182	                    assert error < 2e-9, (m,n,z,radius,error)
   183	                    records.append({"m":m,"n":n,"z":z,"r":radius,"amplitude_error":error})
   184	    return {"status":"PASS","integrals":records,
   185	            "max_amplitude_error":max(r["amplitude_error"] for r in records),
   186	            "quadrature_is_not_an_interval_bound":True}
