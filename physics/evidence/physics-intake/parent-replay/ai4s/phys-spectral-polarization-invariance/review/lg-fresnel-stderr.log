   189	def physical_smoke(cases: dict) -> dict:
   190	    ngrid,length,k = 256,24.,7.
   191	    axis = (np.arange(ngrid)-ngrid//2)*length/ngrid
   192	    xx,yy = np.meshgrid(axis,axis,indexing="ij")
   193	    radius = np.hypot(xx,yy)
   194	    angle = np.arctan2(yy,xx)
   195	    dx = length/ngrid
   196	    spatial_q = 2*np.pi*np.fft.fftfreq(ngrid,dx)
   197	    q2 = spatial_q[:,None]**2+spatial_q[None,:]**2
   198	    region = radius <= 4
   199	    records = []
   200	    for m in (1,3):
   201	        initial_radial = radial_modes(radius,0,k,m)
   202	        angular = {sign:np.exp(1j*sign*m*angle) for sign in (1,-1)}
   203	        for name,(gplus,gminus,p2) in cases.items():
   204	            gamma_sum = np.array(gplus+gminus,dtype=complex)
   205	            # Independent physical realization of each sector covariance.
   206	            coherent_fields = []
   207	            for sign,g in ((1,gplus),(-1,gminus)):
   208	                numeric = np.array(g,dtype=complex)
   209	                eigenvalues,eigenvectors = np.linalg.eigh(numeric)
   210	                assert eigenvalues.min() > -1e-12
   211	                # Exact PSD was checked above; only roundoff-negative zeros are clipped.
   212	                factors = (eigenvectors*np.sqrt(np.maximum(eigenvalues,0))[None,:]).reshape(2,2,4)
   213	                sector = np.einsum("xyn,nil->xyil",initial_radial,factors)
   214	                coherent_fields.append(sector*angular[sign][:,:,None,None])
   215	            fields = np.concatenate(coherent_fields,axis=-1)
   216	            spectrum = np.fft.fft2(fields,axes=(0,1))
   217	            for z in (1.5,4.0,8.0):
   218	                propagated = np.fft.ifft2(spectrum*np.exp(-1j*z*q2/(2*k))[:,:,None,None],axes=(0,1))
   219	                actual = np.einsum("xyil,xyjl->xyij",propagated,propagated.conj())
   220	                predicted = apply_choi(gamma_sum,radial_modes(radius,z,k,m))
   221	                error = float(np.max(np.abs(actual[region]-predicted[region])))
   222	                intensity = np.trace(predicted,axis1=-2,axis2=-1).real
   223	                reliable = region & (intensity > 1e-6*intensity[region].max())
   224	                p_expected = float(sp.sqrt(p2))
   225	                p_error = float(np.max(np.abs(degree(actual[reliable])-p_expected)))
   226	                assert error < 2e-9 and p_error < 5e-8, (name,m,z,error,p_error)
   227	                records.append({"case":name,"m":m,"z":z,"matrix_max_error":error,
   228	                                "degree_max_error":p_error,"degree_sample_count":int(reliable.sum())})
   229	        # Physical negative control: independent radial polarization populations.
   230	        bad = np.diag([3.,1.,1.,3.])
   231	        bad_j = apply_choi(bad,radial_modes(radius,4,k,m))
   232	        intensity = np.trace(bad_j,axis1=-2,axis2=-1).real
   233	        mask = region & (intensity > 1e-6*intensity[region].max())
   234	        bad_p = degree(bad_j[mask])
   235	        assert bad_p.max()-bad_p.min() > .4
   236	        records.append({"case":"noninvariant_negative_control","m":m,
   237	                        "degree_range":[float(bad_p.min()),float(bad_p.max())]})
   238	    return {"status":"PASS","grid":{"n":ngrid,"length":length,"k":k,"waist_a":1,
   239	                "m":[1,3],"z":[1.5,4.,8.],"comparison_radius_max":4,
   240	                "degree_relative_intensity_floor":1e-6},
   241	            "records":records,
   242	            "max_matrix_error":max(r["matrix_max_error"] for r in records if "matrix_max_error" in r),
   243	            "max_degree_error":max(r["degree_max_error"] for r in records if "degree_max_error" in r)}
