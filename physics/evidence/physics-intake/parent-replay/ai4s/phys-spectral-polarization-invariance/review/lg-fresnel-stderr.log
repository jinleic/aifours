    71	def exact_controls(cases: dict) -> dict:
    72	    m = sp.symbols("m", integer=True, positive=True)
    73	    t, rr, rho = sp.symbols("t rr rho", real=True, positive=True)
    74	    mm = m+1
    75	    q = 1+sp.I*t
    76	    ratio = (mm*(1+t*t)-rr*rr)/(sp.sqrt(mm)*q*q)
    77	    # Check the paraxial radial PDE without numerical propagation.
    78	    # Log-derivatives of q0; radial Laplacian includes -m^2/r^2.
    79	    lr = m/rr-rr/q
    80	    lrr = -m/rr**2-1/q
    81	    lt = -mm*sp.I/q+sp.I*rr**2/(2*q*q)
    82	    assert sp.simplify(lt-sp.I*(lrr+lr**2+lr/rr-m*m/rr**2)/2) == 0
    83	    ratio_pde = sp.diff(ratio,t)-sp.I*(sp.diff(ratio,rr,2)
    84	                 +(2*lr+1/rr)*sp.diff(ratio,rr))/2
    85	    assert sp.simplify(ratio_pde) == 0
    86	    assert sp.simplify(ratio.subs(t,0)-(mm-rr*rr)/sp.sqrt(mm)) == 0
    87	    radial_cross = (mm*sp.factorial(m)-sp.factorial(m+1))/(sp.sqrt(mm)*sp.factorial(m))
    88	    radial_norm = (mm**2*sp.factorial(m)-2*mm*sp.factorial(m+1)
    89	                   +sp.factorial(m+2))/(mm*sp.factorial(m))
    90	    assert sp.simplify(radial_cross) == 0 and sp.simplify(radial_norm) == 1
    91	    # Explicit parametrization of the attained upper half-plane.
    92	    w = sp.simplify(ratio.subs(rr**2,(1+t*t)*(mm+sp.sqrt(mm)*rho)))
    93	    u = rho*(t*t-1)/(1+t*t)
    94	    v = 2*rho*t/(1+t*t)
