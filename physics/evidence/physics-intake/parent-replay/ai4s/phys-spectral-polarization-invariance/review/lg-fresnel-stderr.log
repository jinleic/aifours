    31	def symbolic_j(k: sp.Matrix, f: sp.Matrix) -> sp.Matrix:
    32	    return sum((f[b] * sp.conjugate(f[c]) * k[2*b:2*b+2, 2*c:2*c+2]
    33	                for b in range(2) for c in range(2)), sp.zeros(2))
