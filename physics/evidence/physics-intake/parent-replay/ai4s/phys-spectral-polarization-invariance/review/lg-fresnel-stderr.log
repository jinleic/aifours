    98	    # Example proving forward projective density cannot be assumed:
    99	    # Im(w)<0 forces tau>0, and radius>0 forces tau<sqrt(m+1).
   100	    missing_radius_gap = sp.simplify(2*sp.sqrt(mm)-sp.sqrt(mm))
   101	    assert missing_radius_gap.is_positive
