    40	def covariance_cases() -> dict:
    41	    r = sp.Rational
    42	    omega = sp.Matrix([1, 0, 0, 1])
    43	    swap = sp.Matrix([[1, 0, 0, 0], [0, 0, 1, 0],
    44	                      [0, 1, 0, 0], [0, 0, 0, 1]])
    45	    a = sp.Matrix([[1, sp.I/4], [-sp.I/4, r(3, 2)]])
    46	    transform = sp.kronecker_product(a.T, sp.diag(1, sp.I))
    47	    b0 = sp.eye(4)/4 + omega*omega.T/2
    48	    bplus0 = sp.diag(r(1, 16), 0, 0, 0)
    49	    bsum = transform*b0*transform.H
    50	    bplus = transform*bplus0*transform.H
    51	    c0 = sp.eye(4)/3 + swap/3
    52	    csum = transform*c0*transform.H
    53	    cp = sp.Matrix([[r(3, 5), (1+2*sp.I)/10],
    54	                    [(1-2*sp.I)/10, r(2, 5)]])
    55	    replacement = sp.kronecker_product((a*a).T, cp)
