   158	def radial_modes(radius: np.ndarray, z: float, k: float, m: int) -> np.ndarray:
   159	    t = z/k  # frozen waist a=1 for physical smokes
   160	    q = 1+1j*t
   161	    q0 = radius**m*np.exp(-radius**2/(2*q))/(np.sqrt(np.pi*math.factorial(m))*q**(m+1))
   162	    ratio = ((m+1)*(1+t*t)-radius**2)/(np.sqrt(m+1)*q*q)
   163	    return np.stack((q0,ratio*q0),axis=-1)
