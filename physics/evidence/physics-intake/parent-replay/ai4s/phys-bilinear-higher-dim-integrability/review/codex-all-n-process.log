import sympy as S
from itertools import product
k1,k2,l1,l2,a1,a2,b1,b2=S.symbols(\"k1 k2 l1 l2 a1 a2 b1 b2\")
ks=[k1,k2]; ls=[l1,l2]
rho=(k1-k2)/(k1+k2)
f12=rho*(l1*a1*b2-l2*a2*b1)/(l1+l2)
g12=rho*(l1*b1*a2-l2*b2*a1)/(l1+l2)
def residual(F,G,n,gy=False,dy=False):
    out={}
    for U,fu in F.items():
        for V,gv in G.items():
            e=tuple(int(i in U)+int(i in V) for i in range(n))
            dk=sum(ks[i] for i in U)-sum(ks[i] for i in V)
            ds=sum(ks[i]**3 for i in U)-sum(ks[i]**3 for i in V)
            dl=sum(ls[i] for i in U)-sum(ls[i] for i in V)
            w=(dk**3-ds)*(dl if dy else 1)
            if gy:
                w*=sum(ls[i] for i in V)
            out[e]=out.get(e,0)+fu*gv*w
    return all(S.cancel(x)==0 for x in out.values())
for n in range(3):
    F={():S.Integer(1)}
    G={():S.Integer(1)}
    if n:
        F[(0,)]=a1; G[(0,)]=b1
    if n==2:
        F[(1,)]=a2; G[(1,)]=b2
        F[(0,1)]=f12; G[(0,1)]=g12
    print(\"symbolic N=\",n,{\"Q(F,G)\":residual(F,G,n),
        \"DyQ(F,G)\":residual(F,G,n,dy=True),
        \"Q(F,G_y)\":residual(F,G,n,gy=True)})
def pf(M):
    n=M.rows
    if n==0: return S.Integer(1)
    return sum((-1)**(j+1)*M[0,j]*pf(M.extract(
        [i for i in range(n) if i not in (0,j)],
        [i for i in range(n) if i not in (0,j)]))
        for j in range(1,n))
def border(M,u,v):
    V=S.Matrix.hstack(u,v)
    return pf(M.row_join(V).col_join((-V.T).row_join(S.zeros(2))))
for n in range(3):
    fs=S.symbols(\"f1:\"+str(n+1))
    hs=S.symbols(\"h1:\"+str(n+1))
    aa=[a1,a2][:n]; bb=[b1,b2][:n]
    al=S.Matrix([aa[i]*hs[i] for i in range(n)])
    be=S.Matrix([bb[i]*hs[i] for i in range(n)])
    A=S.zeros(n); B=S.zeros(n)
    for i in range(n):
        for j in range(i+1,n):
            A[i,j]=(ks[i]-ks[j])*fs[i]*fs[j]/(ks[i]+ks[j]); A[j,i]=-A[i,j]
            B[i,j]=(ls[i]*al[i]*be[j]-ls[j]*al[j]*be[i])/(ls[i]+ls[j]); B[j,i]=-B[i,j]
    K=A.row_join(S.eye(n)).col_join((-S.eye(n)).row_join(-B))
    q=S.Matrix(list(fs)+[0]*n) if n else S.zeros(0,1)
    av=S.Matrix([0]*n+list(al)) if n else S.zeros(0,1)
    bv=S.Matrix([0]*n+list(be)) if n else S.zeros(0,1)
    by=S.Matrix([0]*n+[ls[i]*be[i] for i in range(n)]) if n else S.zeros(0,1)
    L=K+q*av.T-av*q.T
    r=q+av; sig=(-1)**(n*(n-1)//2)
    expectedF=1+sum(aa[i]*fs[i]*hs[i] for i in range(n))
    expectedG=1+sum(bb[i]*fs[i]*hs[i] for i in range(n))
    expectedGy=sum(ls[i]*bb[i]*fs[i]*hs[i] for i in range(n))
    if n==2:
        expectedF+=f12*fs[0]*fs[1]*hs[0]*hs[1]
        expectedG+=g12*fs[0]*fs[1]*hs[0]*hs[1]
        expectedGy+=(l1+l2)*g12*fs[0]*fs[1]*hs[0]*hs[1]
    actualF=sig*pf(L)
    actualG=actualF+sig*border(L,r,av-bv)
    actualGy=-sig*border(L,r,by)
    print(\"block dictionary N=\",n,{\"F\":S.cancel(actualF-expectedF)==0,
        \"G\":S.cancel(actualG-expectedG)==0,
        \"G_y\":S.cancel(actualGy-expectedGy)==0})
print(\"Zero-wave-number and zero-amplitude specializations are legal in these symbolic identities whenever the two physical pair sums remain nonzero.\")
