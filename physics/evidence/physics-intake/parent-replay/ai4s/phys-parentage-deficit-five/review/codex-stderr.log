   229	def tensor_amplitudes(poly, degree, spin):
   230	    """Ordered first-quantized tensor, independently normalized by direct sum."""
   231	    amplitudes = {}
   232	    for values in product(range(-spin, spin + 1), repeat=degree):
   233	        counts = tuple(values.count(m) for m in range(-spin, spin + 1))
   234	        coefficient = poly.get(counts)
   235	        if coefficient:
   236	            weight = sp.prod(sp.Rational(1, comb(2 * spin, spin + m)) ** a
   237	                             for m, a in zip(range(-spin, spin + 1), counts))
   238	            amplitudes[values] = as_rational(coefficient) * sp.prod(factorial(a) for a in counts) * sp.sqrt(weight)
   239	    norm = sp.sqrt(sum(a * a for a in amplitudes.values()))
   240	    return {key: sp.simplify(value / norm) for key, value in amplitudes.items()}
