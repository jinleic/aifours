   243	def first_quantized_control():
   244	    spin, degree = 3, 3
   245	    B = SpinBosons(spin)
   246	    (p,) = occupation_basis(5, degree, B)
   247	    parent = tensor_amplitudes(p, degree, spin)
   248	    L = spin * degree - 5
   249	    signs_checked = 0
   250	    for k in (0, 2, 4):
   251	        (daughter,) = occupation_basis(k, degree - 1, B)
   252	        Lp = spin * (degree - 1) - k
   253	        overlap = 0
   254	        lowered = dict(daughter)
   255	        for M in range(Lp, -Lp - 1, -1):
   256	            m = L - M
   257	            if -spin <= m <= spin:
   258	                tensor = tensor_amplitudes(lowered, degree - 1, spin)
   259	                cg = clebsch_gordan(spin, Lp, L, m, M, L)
   260	                overlap += cg * sum(parent.get((m,) + key, 0) * value for key, value in tensor.items())
   261	            lowered = B.sminus(lowered)
   262	        overlap = sp.simplify(overlap)
   263	        square, sign = B.cfp_sq_sign(p, degree, L, daughter, Lp)
   264	        assert sp.simplify(overlap ** 2 - as_rational(square)) == 0
   265	        assert int(sp.sign(overlap)) == sign
   266	        assert overlap != -overlap, "odd-phase negative control not detected"
   267	        signs_checked += 1
   268	    return signs_checked
