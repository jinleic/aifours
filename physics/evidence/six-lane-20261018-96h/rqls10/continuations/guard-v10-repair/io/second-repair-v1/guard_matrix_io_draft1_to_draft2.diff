+def spawn_refused(s, attempt, role, exc):
+    """Retain a pre-spawn source ledger record (source19 exports neither s.keep nor pid-less helper reports) and
+    natively observe, under FD_LOCK, that the original cleanup released every descriptor it allocated for the attempt."""
+    record = s.keep[attempt] if len(s.keep) > attempt else None
+    if record is None or record.get("pid") is not None:
+        return  # A registered PID is retained by source19 itself; only pid-less attempts need this record.
+    snapshot = {k: record.get(k) for k in ("pid", "role", "settled", "leader_reaped", "rc", "wait_lost", "term_attempted",
+                                         "identity", "spawn_error", "stdout_fd", "stdin_fd", "stderr_fd")}
+    snapshot["parent_close_fds"] = list(record.get("parent_close_fds") or [])
+    fds = sorted({snapshot[k] for k in ("stdout_fd", "stdin_fd", "stderr_fd") if snapshot[k] is not None} | set(snapshot["parent_close_fds"]))
+    descriptors = []
+    with FD_LOCK:
+        for fd in fds:
+            try:
+                value = os.fstat(fd)
+            except OSError as error:
+                descriptors.append({"fd": fd, "released": error.errno == errno.EBADF, "errno": error.errno, "inode": None})
+            else:
+                descriptors.append({"fd": fd, "released": False, "errno": None, "inode": [value.st_dev, value.st_ino]})
+    event("native_spawn_refused_before_pid", role=role, record=snapshot, descriptors=descriptors, error=exception(exc))
+
