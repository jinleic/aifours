+def authorization_case(case, events, summary, request, cfg, outcome):
+    changed = only(events, "authorization_copy_mutated")
+    phase = case.rsplit("_", 1)[1]
+    need(changed["phase"] == phase, "exact preceding-preparation mutation phase")
+    archive = only(events, "archive_replace")
+    wanted = request["created_facts"]["GO"]
+    need(all(archive["original"][k] == wanted[k] for k in ("path", "inode", "sha256", "bytes", "nlink")) and
+         archive["archive"]["inode"] == wanted["inode"] and archive["archive"]["sha256"] == wanted["sha256"], "only approved fresh GO copy archived, original approval untouched")
+    refusal = [v for v in pick(events, "final_binding_read_exception") if v["seq"] > changed["seq"] and v["after_mutation"] is True]
+    need(bool(refusal), "actual original final binding reread after prepIO mutation")
+    expected = "GO_NOT_FOR_ITEM" if "_revoke_" in case else "AUTHORIZATION_CHANGED"
+    if refusal:
+        need(error_text(refusal[0]["error"]) == expected, "exact final binding exception")
+    forbidden_commit = {"helper": "HELPER", "main": "LAUNCH", "go": "GO", "ack": "ACK"}[phase]
+    need(not any(v["seq"] > changed["seq"] and v["phase"] == forbidden_commit for v in pick(events, "source_commit_return")), "superseded binding never committed")
+    if phase in ("helper", "main"):
+        role = "helper" if phase == "helper" else "child"
+        need(not any(v["seq"] > changed["seq"] and v["role"] == role for v in pick(events, "native_spawn_registered")), "no spawn under superseded authority")
+    need(summary.get("acknowledged") is False and summary.get("reason") == "ACK_REFUSED" and summary.get("error_code") == expected,
+         "exact final source ACK refusal, no success under replaced/revoked binding")
+    state = outcome["source_state"]
+    expected_failures = {"HELPER_CALL_FAILED"} if phase in ("helper", "main") else \
+                        {"POST_SPAWN_FAILURE", "GO_NOT_DELIVERED"} if phase == "go" else set()
+    if phase == "go" and state["rec"]["artifacts"].get(cfg["outputs"][0]["path"]) is None:
+        expected_failures.add("REQUIRED_OUTPUT_MISSING")  # Supervisor's ORIGINAL observation, not checker-time existence.
+    need(set(state["failure_codes"]) == expected_failures and state["trips"] == {}, "exact causally derived authorization failure set, no unrelated extras")
+    if phase == "ack":
+        healthy_native_baseline(cfg, request, outcome)
