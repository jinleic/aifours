+            return
+        labels = ["FIXTURE_POST_MAIN_PROBE_0", "FIXTURE_POST_MAIN_PROBE_1"] if "persistent" in self.case else ["FIXTURE_ONE_SHOT_RECOVERY_PROBE"]
+        for label in labels:
