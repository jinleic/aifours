+# ====================================================================== v9: Z_9 + 1 anchors, enumeration and helpers
+OMEGA9 = np.exp(2j * np.pi / 9)
+R9_MAX_CLASSES = 256
+R9_TARGET_RUNS = 2048
+
+
+def enc9(sym_):
+    z = np.zeros(10, dtype=complex)
+    if sym_ < 9:
+        z[:9] = OMEGA9 ** (np.arange(9) * sym_) / 3.0
+    else:
+        z[9] = 1.0
+    return z
+
+
+def z9_array(d_inf, beta, gamma, delta):
+    """Z_9 + 1 square (symbol 9 = inf); identical to build() of code/z9p1_classical_search_v1.py."""
+    X = [[None] * 10 for _ in range(10)]
+    for i in range(9):
+        for d in range(9):
+            X[i][(i + d) % 9] = 9 if d == d_inf else (i + beta[d]) % 9
+    for j in range(9):
+        X[9][j] = (j + gamma) % 9
+    for i in range(9):
+        X[i][9] = (i + delta) % 9
+    X[9][9] = 9
+    return X
+
+
+def z9p1_reduced(hit, role, mstar=0):
+    """Classical Z_9 + 1 anchor, constructed as parker_reduced (n = 9, h = 1). role 'A': resolution A, vectors from
+    the mate B; role 'B': the reverse. Returns (R, theta_c, exact_orthogonal_pair, Q array)."""
+    bA = {int(k): int(v) for k, v in hit["betaA"].items()}
+    bB = {int(k): int(v) for k, v in hit["betaB"].items()}
+    A = z9_array(0, bA, int(hit["gammaA"]), int(hit["deltaA"]))
+    B = z9_array(int(hit["e"]), bB, int(hit["gammaB"]), int(hit["deltaB"]))
+    orth = latin(A) and latin(B) and len({(A[i][j], B[i][j]) for i in range(10) for j in range(10)}) == 100
+    if role == "A":
+        d_inf, beta, gam, dlt, Q = 0, bA, int(hit["gammaA"]), int(hit["deltaA"]), B
+    else:
+        d_inf, beta, gam, dlt, Q = int(hit["e"]), bB, int(hit["gammaB"]), int(hit["deltaB"]), A
+    R = Reduced(9, 1, [d_inf], beta, [gam], [dlt], [[0]], list(range(9)) + [mstar], [[mstar]])
+    th = np.zeros(R.npar)
+    k = R.nv * R.v
+    for j, d in enumerate(R.Dfin):
+        z = enc9(Q[0][d])
+        th[j * R.v:(j + 1) * R.v] = z.real
+        th[k + j * R.v:k + (j + 1) * R.v] = z.imag
+    base = 2 * k
+    th[base] = math.pi / 2                     # the single corner ray: t = pi/2, f = 0, i.e. e_inf
+    th[base + 1] = 0.0
+    base2 = base + 2 * R.ncorner
+    syms = {("u", 0): Q[0][d_inf], ("w", 0): Q[9][0], ("wp", 0): Q[0][9]}
+    twos = set(int(x) for x in R.MI)
+    for fi, fl in enumerate(R.flats):
+        s_ = syms[fl]
+        for m in range(9):
+            ph = 2 * math.pi * m * s_ / 9
+            if m in twos:
+                ph += math.pi
+            th[base2 + fi * 9 + m] = ph
+    return R, th, orth, Q
+
+
+def z9_mutant(R, th, Q):
+    """A9m: replace v_(Dfin[0]) by the encoding of another symbol of row 0 (a duplicate ray in R0)."""
+    th2 = th.copy()
+    s0 = Q[0][R.Dfin[0]]
+    z = enc9((s0 + 1) % 9 if s0 < 9 else 0)
+    k = R.nv * R.v
+    th2[0:R.v] = z.real
+    th2[k:k + R.v] = z.imag
+    return th2
+
+
+def z9_all_betas():
+    """every beta on D_fin = {1..8} with beta and beta - id injective (Z_9 + 1 squares with D_inf = {0})."""
+    out, vals, usedv, usedw = [], [None] * 8, set(), set()
+
+    def rec(k):
+        if k == 8:
+            out.append(tuple(vals))
+            return
+        d = k + 1
+        for x in range(9):
+            w = (x - d) % 9
+            if x in usedv or w in usedw:
+                continue
+            usedv.add(x)
+            usedw.add(w)
+            vals[k] = x
+            rec(k + 1)
+            usedv.discard(x)
+            usedw.discard(w)
+    rec(0)
+    return out
+
+
+def z9_canon(bt):
+    """canonical form of beta (tuple over d = 1..8) under symbol translation beta + c, multipliers
+    beta'(u d) = u beta(d) (u in Z_9^*) and transposition beta^T(d) = d + beta(-d)."""
+    best = None
+    for tr in (False, True):
+        b0 = {d: bt[d - 1] for d in range(1, 9)}
+        if tr:
+            b0 = {d: (d + b0[(-d) % 9]) % 9 for d in range(1, 9)}
+        for u in (1, 2, 4, 5, 7, 8):
+            bu = {(u * d) % 9: (u * b0[d]) % 9 for d in range(1, 9)}
+            for c in range(9):
+                key = tuple((bu[d] + c) % 9 for d in range(1, 9))
+                if best is None or key < best:
+                    best = key
+    return best
+
+
+def z9_config(bt):
+    beta = {d: bt[d - 1] for d in range(1, 9)}
+    gam = sorted(set(range(9)) - {(beta[d] - d) % 9 for d in range(1, 9)})
+    dlt = sorted(set(range(9)) - set(beta.values()))
+    return beta, gam, dlt
+
+
+def mismatches(recs):
+    """LM-converged endpoints (reduced residual < 1e-13) that fail the full verification: a model defect, not a result."""
+    return [r for r in recs if r != "SKIPPED" and r["status"] == "CONVERGED" and r["maxdev"] >= 1e-8]
+
 
