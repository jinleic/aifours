+def run_perturbed(R, thc, amp, seed, iters, end, extra):
+    rng = np.random.default_rng(seed)
+    th0 = thc + amp * rng.standard_normal(len(thc))
+    r_start = float(np.linalg.norm(R.resid(th0)))
+    t0 = time.monotonic()
+    th, res, it, status = lm(R, th0, iters, end)
+    Z = R.Z_full(th)
+    maxdev, rays, minsep = R.P.verify(Z)
+    rec = {"tag": "KP_perturbed_classical", "amp": amp, "seed": seed, "start_resid": r_start, "status": status, "iters": it,
+           "resid": res, "maxdev": maxdev, "rays": rays, "minsep": minsep, "verified": bool(maxdev < 1e-8),
+           "secs": round(time.monotonic() - t0, 3), "config": extra}
+    W.write(rec)
+    return rec
+
