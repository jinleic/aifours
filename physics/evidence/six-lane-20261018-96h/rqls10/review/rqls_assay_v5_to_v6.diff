+# ====================================================================== v6: Weyl-Heisenberg orbit ansatz (R4 open case), dimension d
+def wh_resid_batch(TH, d, lam):
+    q = TH[:, :d] + 1j * TH[:, d:]
+    t = np.arange(d)
+    w = np.exp(2j * np.pi / d)
+    out = [np.sum(np.abs(q) ** 2, axis=1)[:, None] - 1.0]
+    for kind in ("X", "Z", "XZ"):
+        for k in range(1, d):
+            if kind == "X":
+                Aq = np.roll(q, k, axis=1)
+            elif kind == "Z":
+                Aq = (w ** (k * t))[None] * q
+            else:
+                Aq = np.roll((w ** (lam * k * t))[None] * q, k, axis=1)
+            ip = np.sum(q.conj() * Aq, axis=1)
+            out.append(ip.real[:, None])
+            out.append(ip.imag[:, None])
+    return np.concatenate(out, axis=1)
+
+
+def wh_lm(d, lam, th, iters, end, tol=1e-13):
+    lamd = 1e-3
+    f = wh_resid_batch(th[None], d, lam)[0]
+    nf = float(f @ f)
+    for it in range(1, iters + 1):
+        if over(end) or nf < tol * tol:
+            break
+        E = np.eye(2 * d) * 1e-6
+        J = ((wh_resid_batch(th[None] + E, d, lam) - wh_resid_batch(th[None] - E, d, lam)) / 2e-6).T
+        A = J.T @ J
+        g = J.T @ f
+        D = np.diag(A) + 1e-12
+        while True:
+            step = np.linalg.solve(A + lamd * np.diag(D), -g)
+            th2 = th + step
+            f2 = wh_resid_batch(th2[None], d, lam)[0]
+            n2 = float(f2 @ f2)
+            if n2 < nf:
+                th, f, nf = th2, f2, n2
+                lamd = max(lamd / 3, 1e-12)
+                break
+            lamd *= 4
+            if lamd > 1e10:
+                return th, math.sqrt(nf)
+    return th, math.sqrt(nf)
+
+
+def stage_WH(end, nstarts, d, lams, tag):
+    t_start = time.monotonic()
+    for li, lam in enumerate(lams):
+        lam_end = t_start + (end - t_start) * (li + 1) / len(lams)
+        rng = np.random.default_rng(10000 + 100 * d + lam)
+        res_list = []
+        nsol = 0
+        k = 0
+        while k < nstarts and not over(lam_end):
+            th, res = wh_lm(d, lam, rng.standard_normal(2 * d), 300, lam_end)
+            res_list.append(res)
+            if res < 1e-10:
+                nsol += 1
+                if d == 10:
+                    q = th[:10] + 1j * th[10:]
+                    B = [[(b - lam * a) % 10 for b in range(10)] for a in range(10)]
+                    Z = np.zeros((100, 10), dtype=complex)
+                    tt = np.arange(10)
+                    w = np.exp(2j * np.pi / 10)
+                    for a in range(10):
+                        for b in range(10):
+                            Z[a * 10 + b] = np.roll((w ** (b * tt)) * q, a)
+                    P = unsym("wh10", B)
+                    md, ry, ms = P.verify(Z / np.linalg.norm(Z, axis=1, keepdims=True))
+                    W.write({"tag": tag + "_solution", "lam": lam, "resid": res, "maxdev": md, "rays": ry, "minsep": ms,
+                             "maximal_candidate": bool(md < 1e-8 and ry == 100 and ms > 1e-6),
+                             "q_re": np.round(q.real, 15).tolist(), "q_im": np.round(q.imag, 15).tolist()})
+            k += 1
+        rl = sorted(res_list)
+        W.write({"tag": tag + "_summary", "d": d, "lam": lam, "starts": len(rl), "solutions": nsol, "min_resid": rl[0] if rl else None,
+                 "quantiles": [rl[int(x * (len(rl) - 1))] for x in (0.0, 0.01, 0.1, 0.5)] if rl else None})
+        if TERM[0]:
+            return
