+               "minsep": minsep, "raw": {"maxdev": raw[0], "rays": raw[1], "minsep": raw[2]}, "polished": polished,
+               "polish_resid": presid, "polish_iters": pit, "secs": round(time.monotonic() - t0, 3), "maximal_candidate": maximal}
+        if extra is not None:
+            rec["config"] = extra
+        if maximal:
+            rec["Z_re"] = np.round(Z.real, 15).tolist()
+            rec["Z_im"] = np.round(Z.imag, 15).tolist()
+            rec["B"] = R.P.B
