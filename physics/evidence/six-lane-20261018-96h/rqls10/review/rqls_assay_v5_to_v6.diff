+# ====================================================================== v6: reduced RRR (inf-lines built into the projection)
+class ReducedRRR:
+    """Divide-and-concur on the three lines R0, C0, S0 of a forced Z_n + h ansatz. Representatives: the general v_d and
+    the 3h flat vectors (u_c, w_a, w'_b); corners are implicit. P_A: nearest unitary per line. P_B: per-representative
+    phase-aligned consensus, then the flat structure: modulus 1/sqrt(n) on 1-dim eigenspaces and, for every corner
+    cell kappa, a common direction phi_kappa (best rank-1 fit) for the three 2-dim components it feeds; the corner ray is
+    phi_kappa's orthogonal complement in its eigenspace."""
+
+    def __init__(self, R):
+        self.R = R
+        v = R.v
+        self.v = v
+        self.nrows = R.nv + R.nflat
+        self.addr = [[] for _ in range(self.nrows)]
+        for L in range(3):
+            for s in range(v):
+                self.addr[int(R.LI[L, s])].append((L, s))
+        self.aL = [np.array([a[0] for a in ad]) for ad in self.addr]
+        self.aS = [np.array([a[1] for a in ad]) for ad in self.addr]
+        self.back = np.conj(R.fwd)
+        # corner triples: for each corner index kappa, the list of (flat index, i0, i1)
+        self.trip = {}
+        for fi, mi, i0, i1, ka in zip(R.FI, R.MI, R.I0, R.I1, R.KA):
+            self.trip.setdefault(int(ka), []).append((int(fi), int(i0), int(i1)))
+        assert all(len(x) == 3 for x in self.trip.values()) or R.h != 3 or True
+
+    def consensus(self, Y):
+        S = Y.T @ Y.conj()
+        ev, V = np.linalg.eigh(S)
+        z = V[:, -1]
+        for _ in range(3):
+            ov = Y.conj() @ z
+            ph = ov / np.maximum(np.abs(ov), 1e-300)
+            z = Y.T @ ph
+            z = z / max(np.linalg.norm(z), 1e-300)
+        return z
+
+    def project_B(self, X, want=False):
+        R, v = self.R, self.v
+        Xb = X * self.back
+        Zr = np.zeros((self.nrows, v), dtype=complex)
+        for r in range(self.nrows):
+            Zr[r] = self.consensus(Xb[self.aL[r], self.aS[r]])
+        n = R.n
+        s = 1.0 / math.sqrt(n)
+        for f, p in zip(R.F1, R.P1):
+            zz = Zr[R.nv + f, p]
+            Zr[R.nv + f, p] = s * zz / max(abs(zz), 1e-300)
+        phis = {}
+        for ka, lst in self.trip.items():
+            Y = np.array([[Zr[R.nv + f, i0], Zr[R.nv + f, i1]] for (f, i0, i1) in lst])
+            phi = self.consensus(Y)
+            phis[ka] = (phi, lst[0][1], lst[0][2])
+            for (f, i0, i1) in lst:
+                ov = np.vdot(phi, np.array([Zr[R.nv + f, i0], Zr[R.nv + f, i1]]))
+                ph = ov / max(abs(ov), 1e-300)
+                Zr[R.nv + f, i0] = s * ph * phi[0]
+                Zr[R.nv + f, i1] = s * ph * phi[1]
+        out = np.empty_like(X)
+        for r in range(self.nrows):
+            Y = Xb[self.aL[r], self.aS[r]]
+            ov = Y.conj() @ Zr[r]
+            ph = ov / np.maximum(np.abs(ov), 1e-300)
+            out[self.aL[r], self.aS[r]] = np.conj(ph)[:, None] * Zr[r][None, :]
+        out *= R.fwd
+        return (out, Zr, phis) if want else out
+
+    def project_A(self, X):
+        M = np.swapaxes(X, 1, 2)
+        Wm, sv, Vh = np.linalg.svd(M)
+        return np.swapaxes(Wm @ Vh, 1, 2)
+
+    def Z_full(self, Zr, phis):
+        R = self.R
+        n, h, v = R.n, R.h, R.v
+        Z = np.zeros((R.P.nrep, v), dtype=complex)
+        fidx = {fl: R.nv + k for k, fl in enumerate(R.flats)}
+        for d in range(n):
+            Z[d] = Zr[fidx[("u", R.Dinf.index(d))]] if d in R.Dinf else Zr[R.Dfin.index(d)]
+        for a in range(h):
+            Z[n + a] = Zr[fidx[("w", a)]]
+            Z[n + h + a] = Zr[fidx[("wp", a)]]
+        for ka, (phi, i0, i1) in phis.items():
+            c = np.zeros(v, dtype=complex)
+            c[i0], c[i1] = -np.conj(phi[1]), np.conj(phi[0])
+            Z[n + 2 * h + ka] = c
+        nr = np.linalg.norm(Z, axis=1, keepdims=True)
+        return Z / np.maximum(nr, 1e-300)
+
+
+def rrrr_run(RR, rng, max_iter, end, beta=0.5, tol=1e-10):
+    v = RR.v
+    X = rng.standard_normal((3, v, v)) + 1j * rng.standard_normal((3, v, v))
+    X /= np.linalg.norm(X, axis=2, keepdims=True)
+    err, status, it = float("inf"), "MAX_ITER", 0
+    for it in range(1, max_iter + 1):
+        pb = RR.project_B(X)
+        pa = RR.project_A(2.0 * pb - X)
+        d = pa - pb
+        err = float(np.sqrt(np.mean(np.sum(np.abs(d) ** 2, axis=2))))
+        X = X + beta * d
+        if err < tol:
+            status = "CONVERGED"
+            break
+        if (it & 127) == 0 and over(end):
+            status = "TERM" if TERM[0] else "TIME"
+            break
+    pb, Zr, phis = RR.project_B(X, want=True)
+    return status, it, err, RR.Z_full(Zr, phis)
+
+
